<main class="landing-page">

<!-- ═══ NAV ═══ -->
<header class="lp-nav" id="site-nav">
  <div class="lp-container">
    <nav class="lp-nav-inner">
      <a href="<%= landing_root_path %>" class="lp-nav-logo" aria-label="Vittio">
        <%= image_tag "/vittio_new_without_background.png", alt: "Vittio", height: 28 %>
      </a>

      <ul class="lp-nav-links" id="lp-nav-links">
        <li><a href="#como-funciona"><%= t("landing.nav.how_it_works") %></a></li>
        <li><a href="#producto"><%= t("landing.nav.product") %></a></li>
        <li><a href="#bancos"><%= t("landing.nav.banks") %></a></li>
        <li class="lp-mobile-nav-signin"><a href="<%= app_sign_in_url %>"><%= t("landing.nav.sign_in") %></a></li>
        <li class="lp-mobile-nav-cta"><a href="#lista-espera"><%= t("landing.nav.join_waitlist") %></a></li>
      </ul>

      <div class="lp-nav-actions">
        <%= render "shared/language_switcher" %>
        <%= link_to t("landing.nav.sign_in"), app_sign_in_url, class: "lp-nav-signin" %>
        <a href="#lista-espera" class="lp-nav-cta"><%= t("landing.nav.join_waitlist") %></a>
        <button class="lp-nav-hamburger" aria-label="<%= t("landing.nav.menu") %>"
                onclick="document.getElementById('lp-nav-links').classList.toggle('open')">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </nav>
  </div>
</header>

<!-- ═══ HERO ═══ -->
<section class="lp-hero" id="hero">
  <div class="lp-container">
    <div class="lp-hero-inner">
      <!-- Left: Copy -->
      <div class="lp-hero-copy">
        <div class="lp-hero-eyebrow reveal">
          <span class="label-tag">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            <%= t("landing.hero.badge") %>
          </span>
        </div>

        <h1 class="lp-hero-headline" id="hero-headline">
          <%= t("landing.hero.title_line1") %><br /><em><%= t("landing.hero.title_line2") %></em>
        </h1>

        <p class="lp-hero-sub reveal reveal-delay-2">
          <%= t("landing.hero.subtitle") %>
        </p>

        <div class="lp-hero-waitlist-status reveal reveal-delay-3" role="status">
          <span class="lp-pulse-dot" aria-hidden="true"></span>
          <span class="lp-hero-waitlist-status-text">
            <% if @waitlist_count.to_i >= 50 %>
              <%= t("landing.trust_bar.waitlist_count_html", count: number_with_delimiter(@waitlist_count)).html_safe %>
            <% else %>
              <%= t("landing.trust_bar.waitlist_open") %>
            <% end %>
          </span>
        </div>

        <div class="reveal reveal-delay-3" id="waitlist-form">
          <%= turbo_frame_tag "waitlist-form" do %>
            <%= form_with model: @waitlist, url: waitlists_path do |f| %>
              <div style="display:flex;gap:10px;max-width:440px;flex-wrap:wrap;">
                <%= f.email_field :email,
                      placeholder: t("landing.hero.email_placeholder"),
                      required: true,
                      autocomplete: "email" %>
                <% if @waitlist.errors[:email].any? %>
                  <p style="width:100%;margin-top:4px;font-size:13px;color:#dc2626;"><%= @waitlist.errors[:email].first %></p>
                <% end %>
                <%= f.submit t("landing.hero.join_button") %>
              </div>
            <% end %>
          <% end %>
        </div>

        <p class="lp-hero-note reveal reveal-delay-3">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <%= t("landing.hero.disclaimer") %>
        </p>
        <p class="lp-hero-perk reveal reveal-delay-3">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <%= t("landing.hero.early_access_perk") %>
        </p>
      </div>

      <!-- Right: Product screenshot — desktop shows browser frame, mobile shows phone -->
      <div class="lp-hero-visual lp-hero-visual-desktop">
        <div style="position:relative;">
          <div class="phone-glow-halo"></div>
          <div class="browser-frame phone-float">
            <div class="browser-chrome">
              <div class="browser-dots">
                <div class="browser-dot browser-dot-r"></div>
                <div class="browser-dot browser-dot-y"></div>
                <div class="browser-dot browser-dot-g"></div>
              </div>
              <div class="browser-bar">
                <div class="browser-bar-icon"></div>
                <span class="browser-bar-text">app.vitt.io</span>
              </div>
            </div>
            <%= image_tag "landing/dashboard.png",
                  alt: t("landing.hero.screenshot_alt"),
                  class: "browser-screenshot",
                  loading: "eager",
                  fetchpriority: "high" %>
          </div>
        </div>
      </div>

      <div class="lp-hero-visual lp-hero-visual-mobile">
        <div class="hero-phone-wrap">
          <div class="hero-phone-frame">
            <%= image_tag "landing/mobile-home.png",
                  alt: t("landing.hero.screenshot_alt"),
                  loading: "eager",
                  fetchpriority: "high" %>
          </div>
          <div class="hero-phone-glow"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ TRUST BAR (bank logos — horizontal scroll; waitlist status lives in hero) ═══ -->
<div class="lp-trust-bar">
  <div class="lp-container">
    <div class="lp-trust-bar-inner lp-trust-bar-inner--banks-only">
      <span class="trust-label"><%= t("landing.trust_bar.compatible_with") %></span>
      <div class="bank-list bank-list--scroll" aria-label="<%= t("landing.trust_bar.compatible_with") %>">
        <% landing_bank_slugs.each do |bank| %>
          <div class="bank-chip bank-chip-trust-logo bank-logo-grayscale">
            <%= image_tag "banks/#{bank}.svg",
                  alt: t("landing.trust_bar.bank_logo_alt", name: t("landing.trust_bar.bank_names.#{bank}")),
                  class: "bank-chip-logo bank-chip-logo--trust",
                  loading: "lazy" %>
          </div>
        <% end %>
        <div class="bank-chip bank-chip-more"><%= t("landing.trust_bar.and_more") %></div>
      </div>
    </div>
  </div>
</div>

<!-- ═══ MOBILE APP SHOWCASE ═══ -->
<section class="lp-mobile-section" id="app">
  <div class="lp-container">

    <div class="lp-section-header lp-mobile-section-header">
      <div class="section-label reveal">
        <span class="label-tag" style="background:var(--color-brand-light);color:var(--color-brand-primary);">iOS &amp; Android</span>
      </div>
      <h2 class="section-title reveal reveal-delay-1"><%= t("landing.mobile_showcase.title") %></h2>
      <p class="section-sub reveal reveal-delay-2"><%= t("landing.mobile_showcase.subtitle") %></p>
    </div>

    <div class="mobile-showcase-grid">

      <!-- Left features -->
      <div class="mobile-feat-col mobile-feat-col-left reveal">
        <div class="mobile-feat-item">
          <div class="mobile-feat-icon" style="background:#e0e7ff;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
          </div>
          <div>
            <div class="mobile-feat-title"><%= t("landing.mobile_showcase.features.balance.title") %></div>
            <div class="mobile-feat-desc"><%= t("landing.mobile_showcase.features.balance.desc") %></div>
          </div>
        </div>
        <div class="mobile-feat-item">
          <div class="mobile-feat-icon" style="background:#d1fae5;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <div>
            <div class="mobile-feat-title"><%= t("landing.mobile_showcase.features.categories.title") %></div>
            <div class="mobile-feat-desc"><%= t("landing.mobile_showcase.features.categories.desc") %></div>
          </div>
        </div>
        <div class="mobile-feat-item">
          <div class="mobile-feat-icon" style="background:#ede9fe;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          </div>
          <div>
            <div class="mobile-feat-title"><%= t("landing.mobile_showcase.features.upload.title") %></div>
            <div class="mobile-feat-desc"><%= t("landing.mobile_showcase.features.upload.desc") %></div>
          </div>
        </div>
      </div>

      <!-- Center phones — overlapping cascade -->
      <div class="mobile-phones-center reveal reveal-delay-1">
        <div class="phone-wrap phone-wrap-side phone-wrap-left">
          <div class="phone-frame">
            <%= image_tag "landing/mobile-upload.png", alt: t("landing.mobile_showcase.features.upload.title"), class: "phone-screen", loading: "lazy" %>
          </div>
        </div>
        <div class="phone-wrap phone-center-main">
          <div class="phone-frame phone-frame-center">
            <%= image_tag "landing/mobile-home.png", alt: t("landing.mobile_showcase.title"), class: "phone-screen phone-screen-center", loading: "lazy" %>
          </div>
        </div>
        <div class="phone-wrap phone-wrap-side phone-wrap-right">
          <div class="phone-frame">
            <%= image_tag "landing/mobile-transactions.png", alt: t("landing.mobile_showcase.features.categories.title"), class: "phone-screen", loading: "lazy" %>
          </div>
        </div>
      </div>

      <!-- Right features -->
      <div class="mobile-feat-col mobile-feat-col-right reveal reveal-delay-2">
        <div class="mobile-feat-item">
          <div class="mobile-feat-icon" style="background:#fef3c7;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div>
            <div class="mobile-feat-title"><%= t("landing.mobile_showcase.features.manual.title") %></div>
            <div class="mobile-feat-desc"><%= t("landing.mobile_showcase.features.manual.desc") %></div>
          </div>
        </div>
        <div class="mobile-feat-item">
          <div class="mobile-feat-icon" style="background:#d1fae5;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <div>
            <div class="mobile-feat-title"><%= t("landing.mobile_showcase.features.goals.title") %></div>
            <div class="mobile-feat-desc"><%= t("landing.mobile_showcase.features.goals.desc") %></div>
          </div>
        </div>
        <div class="mobile-feat-item">
          <div class="mobile-feat-icon" style="background:#fee2e2;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#e11d48" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <div>
            <div class="mobile-feat-title"><%= t("landing.mobile_showcase.features.debts.title") %></div>
            <div class="mobile-feat-desc"><%= t("landing.mobile_showcase.features.debts.desc") %></div>
          </div>
        </div>
      </div>

    </div>

    <!-- Mobile-only: horizontal snap-scroll feature pills (desktop shows feat cols above) -->
    <div class="mobile-feat-strip">
      <div class="mobile-feat-pill">
        <div class="mobile-feat-pill-icon" style="background:#e0e7ff;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2.5" stroke-linecap="round"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
        </div>
        <%= t("landing.mobile_showcase.features.balance.title") %>
      </div>
      <div class="mobile-feat-pill">
        <div class="mobile-feat-pill-icon" style="background:#d1fae5;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5" stroke-linecap="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        </div>
        <%= t("landing.mobile_showcase.features.categories.title") %>
      </div>
      <div class="mobile-feat-pill">
        <div class="mobile-feat-pill-icon" style="background:#ede9fe;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2.5" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        </div>
        <%= t("landing.mobile_showcase.features.upload.title") %>
      </div>
      <div class="mobile-feat-pill">
        <div class="mobile-feat-pill-icon" style="background:#fef3c7;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <%= t("landing.mobile_showcase.features.manual.title") %>
      </div>
      <div class="mobile-feat-pill">
        <div class="mobile-feat-pill-icon" style="background:#d1fae5;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5" stroke-linecap="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        </div>
        <%= t("landing.mobile_showcase.features.goals.title") %>
      </div>
      <div class="mobile-feat-pill">
        <div class="mobile-feat-pill-icon" style="background:#fee2e2;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#e11d48" stroke-width="2.5" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <%= t("landing.mobile_showcase.features.debts.title") %>
      </div>
    </div>

    <!-- Store badges -->
    <div class="mobile-stores-row reveal reveal-delay-2">
      <div class="store-badge-light">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0;color:var(--color-text-secondary);"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
        <div>
          <span class="store-badge-pre-light"><%= t("landing.mobile_showcase.stores.coming_soon") %></span>
          <span class="store-badge-name-light">App Store</span>
        </div>
      </div>
      <div class="store-badge-light">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0;color:var(--color-text-secondary);"><path d="M3.18 23.76c.3.17.64.19.96.08L13.64 12 3.32.16C3 .05 2.64.07 2.34.24 1.76.57 1.43 1.2 1.43 2.02v19.96c0 .82.33 1.45.91 1.78h.84zm14.96-8.3L5.9 23.15l8.97-8.97 3.27 1.28zM5.9.85l12.24 7.69-3.27 1.28L5.9.85zm14.17 8.86L17.82 8.1 21.23 12l-1.16 1.71z"/></svg>
        <div>
          <span class="store-badge-pre-light"><%= t("landing.mobile_showcase.stores.coming_soon") %></span>
          <span class="store-badge-name-light">Google Play</span>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- ═══ HOW IT WORKS — SCROLL DRIVEN (desktop) / STATIC STEPS (mobile) ═══ -->
<div class="how-scroll-container" id="como-funciona">

  <!-- Mobile-only: numbered static steps (hidden on desktop via CSS) -->
  <div class="how-mobile-steps">
    <div class="how-mobile-header">
      <span class="label-tag"><%= t("landing.how_it_works.eyebrow") %></span>
      <h2 class="how-section-title" style="margin-top:16px;"><%= t("landing.how_it_works.title") %></h2>
      <p style="font-size:15px;line-height:1.6;color:var(--color-text-secondary);margin-top:8px;max-width:340px;margin-left:auto;margin-right:auto;"><%= t("landing.how_it_works.subtitle") %></p>
    </div>
    <div class="how-mobile-showcase">
      <div class="how-mobile-phone-wrap">
        <div class="how-mobile-phone-frame">
          <%= image_tag "landing/step-upload.jpeg", alt: t("landing.how_it_works.step1.title"), class: "how-mobile-phone-img", id: "how-mobile-phone-img" %>
        </div>
        <div class="how-mobile-phone-glow"></div>
      </div>

      <div class="how-mobile-selector" role="tablist" aria-label="<%= t("landing.how_it_works.title") %>">
        <button type="button" class="how-mobile-tab active" data-how-mobile-step="0" aria-pressed="true"><%= t("landing.how_it_works.mobile_step_labels.step1") %></button>
        <button type="button" class="how-mobile-tab" data-how-mobile-step="1" aria-pressed="false"><%= t("landing.how_it_works.mobile_step_labels.step2") %></button>
        <button type="button" class="how-mobile-tab" data-how-mobile-step="2" aria-pressed="false"><%= t("landing.how_it_works.mobile_step_labels.step3") %></button>
      </div>

      <div class="how-mobile-copy">
        <div class="how-mobile-card-title" id="how-mobile-step-title"><%= t("landing.how_it_works.step1.title") %></div>
        <p class="how-mobile-card-desc" id="how-mobile-step-desc"><%= t("landing.how_it_works.step1.desc_short") %></p>
      </div>
    </div>
  </div>

  <div class="how-sticky" id="how-sticky">

    <!-- Left: steps -->
    <div class="how-left">
      <div class="how-section-tag">
        <span class="label-tag"><%= t("landing.how_it_works.eyebrow") %></span>
      </div>
      <h2 class="how-section-title"><%= t("landing.how_it_works.title") %></h2>
      <p class="how-section-sub"><%= t("landing.how_it_works.subtitle") %></p>

      <div class="how-steps" id="how-steps">
        <div class="how-steps-fill" id="how-steps-fill"></div>

        <div class="how-step active" data-step="0" id="how-step-0">
          <div class="how-step-dot">
            <div class="how-step-badge">1</div>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><polyline points="9 15 12 12 15 15"/></svg>
          </div>
          <div class="how-step-body">
            <div class="how-step-title"><%= t("landing.how_it_works.step1.title") %></div>
            <div class="how-step-desc"><%= t("landing.how_it_works.step1.desc") %></div>
          </div>
        </div>

        <div class="how-step" data-step="1" id="how-step-1">
          <div class="how-step-dot">
            <div class="how-step-badge">2</div>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L9.5 9.5 2 12l7.5 2.5L12 22l2.5-7.5L22 12l-7.5-2.5z"/></svg>
          </div>
          <div class="how-step-body">
            <div class="how-step-title"><%= t("landing.how_it_works.step2.title") %></div>
            <div class="how-step-desc"><%= t("landing.how_it_works.step2.desc") %></div>
          </div>
        </div>

        <div class="how-step" data-step="2" id="how-step-2">
          <div class="how-step-dot">
            <div class="how-step-badge">3</div>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          </div>
          <div class="how-step-body">
            <div class="how-step-title"><%= t("landing.how_it_works.step3.title") %></div>
            <div class="how-step-desc"><%= t("landing.how_it_works.step3.desc") %></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: phone -->
    <div class="how-right">
      <div class="how-phone-wrap" id="how-phone-wrap">
        <div class="how-phone-frame">
          <%= image_tag "landing/step-upload.jpeg", alt: t("landing.how_it_works.step1.title"), class: "how-phone-img", id: "how-phone-img" %>
        </div>
        <div class="how-phone-glow"></div>
      </div>
    </div>

  </div>
