# Test environment configuration
# dotenv-rails automatically loads this for RAILS_ENV=test

# NOTE: deliberately no DATABASE_URL here.
#
# dotenv loads this inside Rails, and DATABASE_URL overrides config/database.yml
# entirely — including the TEST_ENV_NUMBER suffix parallel_tests relies on. With
# it set, every parallel process shares one database and DatabaseCleaner's
# before(:suite) truncation in one process wipes tables another is mid-example
# on. The test database name lives in config/database.yml instead.
PGHOST=localhost

# OAuth credentials for testing (dummy values to ensure middleware loads)
GOOGLE_OAUTH_CLIENT_ID=test_client_id
GOOGLE_OAUTH_CLIENT_SECRET=test_client_secret
