<div id="category-rule-mobile-<%= rule.id %>" class="p-4">
  <div class="flex items-start justify-between">
    <div class="flex-1 min-w-0">
      <div class="flex items-center space-x-2 mb-1">
        <code class="text-sm text-slate-800 dark:text-slate-200 bg-slate-100 dark:bg-slate-700 px-2 py-0.5 rounded font-mono truncate"><%= rule.pattern %></code>
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium flex-shrink-0
                     <%= case rule.match_type
                         when 'exact' then 'bg-purple-100 text-purple-700'
                         when 'contains' then 'bg-blue-100 text-blue-700'
                         when 'starts_with' then 'bg-green-100 text-green-700'
                         end %>">
          <%= t("category_rules.match_types.#{rule.match_type}") %>
        </span>
      </div>
      <div class="text-sm text-slate-600 dark:text-slate-400 mt-1">
        <%= rule.category.name %>
        <% if rule.category.parent %>
          <span class="text-slate-400">(<%= rule.category.parent.name %>)</span>
        <% end %>
      </div>
      <div class="flex items-center space-x-3 mt-2 text-xs text-slate-500 dark:text-slate-400">
        <span><%= t('category_rules.table.hits') %>: <%= rule.hits_count %></span>
      </div>
    </div>
    <div class="flex items-center space-x-2 ml-3">
      <div data-controller="toggle-active" data-toggle-active-url-value="<%= category_rule_path(rule) %>">
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox"
                 class="sr-only peer"
                 <%= 'checked' if rule.active? %>
                 data-action="change->toggle-active#toggle"
                 data-toggle-active-target="checkbox">
          <div class="w-9 h-5 bg-slate-200 peer-focus:ring-2 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white dark:bg-slate-800 after:border-slate-300 dark:border-slate-600 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-blue-600"></div>
        </label>
      </div>
      <%= link_to edit_category_rule_path(rule),
          class: "p-1.5 text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:bg-slate-700 dark:hover:bg-slate-700 rounded-lg transition-colors",
          title: t("category_rules.edit"),
          data: { turbo_stream: true } do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
        </svg>
      <% end %>
      <%= button_to category_rule_path(rule), method: :delete, class: "p-1.5 text-red-500 hover:bg-red-50 rounded-lg transition-colors", data: { turbo_confirm: t('category_rules.delete_confirm') } do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
        </svg>
      <% end %>
    </div>
  </div>
</div>
