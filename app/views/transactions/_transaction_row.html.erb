<tr id="transaction-<%= transaction.id %>"
    class="transactions-table-row hover:bg-slate-50 dark:hover:bg-slate-700 dark:bg-slate-900 transition-colors"
    data-controller="transaction-row"
    data-transaction-id="<%= transaction.id %>"
    data-transaction-row-url-value="<%= transaction_path(transaction) %>"
    data-transaction-row-original-concept-value="<%= raw_concept(transaction) %>"
    data-transaction-row-original-amount-value="<%= number_with_precision(transaction.amount.abs, precision: 2) %>"
    data-transaction-row-original-type-value="<%= transaction.transaction_type %>">

  <%# Row number %>
  <td class="transactions-table-cell">
    <span class="transactions-table-cell-text text-slate-500 dark:text-slate-400 font-medium">
      <%= index.present? ? index : "–" %>
    </span>
  </td>

  <%# Date (read-only inline; edit via full edit page) %>
  <td class="transactions-table-cell">
    <span class="transactions-table-cell-text" data-date="<%= transaction.date.to_date.strftime('%Y-%m-%d') %>">
      <%= format_local_time(transaction.date, format: 'short_date') %>
    </span>
  </td>

  <%# Bank account (read-only inline) %>
  <td class="transactions-table-cell">
    <span class="transactions-table-cell-text text-slate-700 dark:text-slate-300">
      <%= transaction.bank_account&.custom_name %>
    </span>
  </td>

  <%# Description (click to edit) %>
  <td class="transactions-table-cell cursor-text group/description"
      data-action="click->transaction-row#activateDescription">
    <div>
      <div class="transactions-table-cell-text group-hover/description:ring-1 group-hover/description:ring-blue-300 group-hover/description:rounded px-1 -mx-1 transition-shadow"
           title="<%= raw_concept(transaction) %>"
           data-transaction-row-target="descriptionDisplay">
        <%= truncate(display_concept(transaction), length: 60) %>
      </div>
      <input type="text"
             class="hidden w-full px-2 py-0.5 border border-blue-500 rounded text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
             data-transaction-row-target="descriptionInput"
             data-action="input->transaction-row#checkDirty keydown.enter->transaction-row#save keydown.esc->transaction-row#cancel click->transaction-row#stopPropagation"
             placeholder="<%= t('transactions.concept') %>"
             title="<%= t('transactions.inline_edit.concept_hint') %>"
             required>
      <% if transaction.merchant.present? || transaction.reference.present? %>
        <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">
          <% if transaction.merchant.present? %>
            <span><%= transaction.merchant %></span>
          <% end %>
          <% if transaction.reference.present? %>
            <span> • <%= transaction.reference %></span>
          <% end %>
        </div>
      <% end %>
    </div>
  </td>

  <%# Amount (click to edit) %>
  <td class="transactions-table-cell cursor-text group/amount"
      data-action="click->transaction-row#activateAmount">
    <div class="flex items-center">
      <span class="font-medium group-hover/amount:ring-1 group-hover/amount:ring-blue-300 group-hover/amount:rounded px-1 -mx-1 transition-shadow
                   <%= (transaction.transaction_type == 'income' || transaction.transaction_type == 'transfer_in') ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400' %>"
            data-transaction-row-target="amountDisplay">
        <%= transaction.amount >= 0 ? '+' : '-' %>$<%= number_with_precision(transaction.amount.abs, precision: 2, delimiter: ',') %>
      </span>
      <div class="hidden items-center" data-transaction-row-target="amountInputWrapper">
        <span class="text-sm font-medium mr-0.5 <%= (transaction.transaction_type == 'income' || transaction.transaction_type == 'transfer_in') ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400' %>"
              data-transaction-row-target="amountSign">
          <%= (transaction.transaction_type == 'income' || transaction.transaction_type == 'transfer_in') ? '+' : '-' %>
        </span>
        <span class="text-sm text-slate-500 dark:text-slate-400 mr-1">$</span>
        <input type="text"
               class="w-28 px-2 py-0.5 border border-blue-500 rounded text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
               data-transaction-row-target="amountInput"
               data-action="input->transaction-row#checkDirty keydown.enter->transaction-row#save keydown.esc->transaction-row#cancel click->transaction-row#stopPropagation"
               inputmode="decimal"
               required>
      </div>
    </div>
  </td>

  <%# Transaction type (click to edit) %>
  <td class="transactions-table-cell cursor-pointer group/type"
      data-action="click->transaction-row#activateType">
    <span class="transactions-table-transaction-type transactions-table-transaction-type-<%= transaction.transaction_type %> group-hover/type:ring-1 group-hover/type:ring-blue-300 group-hover/type:rounded transition-shadow"
          data-transaction-type="<%= transaction.transaction_type %>"
          data-transaction-row-target="typeDisplay">
      <%= t("transaction_types.#{transaction.transaction_type}") %>
    </span>
    <select class="hidden w-full px-2 py-1 border border-blue-500 rounded text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-transaction-row-target="typeSelect"
            data-action="change->transaction-row#handleTypeChange keydown.esc->transaction-row#cancel click->transaction-row#stopPropagation">
      <% Transaction.transaction_types.keys.each do |type| %>
        <option value="<%= type %>" <%= "selected" if transaction.transaction_type == type %>>
          <%= t("transaction_types.#{type}") %>
        </option>
      <% end %>
    </select>
  </td>

  <%# Category (existing inline-category controller — saves immediately) %>
  <td class="transactions-table-cell">
    <%= render partial: "transactions/inline_category_cell", locals: { transaction: transaction } %>
  </td>

  <%# Actions %>
  <td class="transactions-table-cell">
    <div class="flex items-center space-x-1">
      <%# Save button (hidden until dirty) %>
      <button type="button"
              class="hidden p-1.5 text-green-600 hover:bg-green-50 rounded-lg transition-colors"
              data-transaction-row-target="saveBtn"
              data-action="click->transaction-row#save"
              title="<%= t('form_actions.save') %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
      </button>

      <%# Cancel button (hidden until in edit mode) %>
      <button type="button"
              class="hidden p-1.5 text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:bg-slate-700 dark:hover:bg-slate-700 rounded-lg transition-colors"
              data-transaction-row-target="cancelBtn"
              data-action="click->transaction-row#cancel"
              title="<%= t('form_actions.cancel') %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <%# Action buttons (hidden while in edit mode) %>
      <div class="flex items-center space-x-1" data-transaction-row-target="actionButtons">
        <%= link_to edit_transaction_path(transaction, return_to: filter_params.to_query),
              data: { turbo_frame: "_top" },
              class: "transactions-action-button transactions-action-edit",
              title: t("transactions.edit") do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
        <% end %>

        <% if transaction.statement_file %>
          <%= link_to statement_file_path(transaction.statement_file),
                data: { turbo_frame: "_top" },
                class: "transactions-action-button transactions-action-statement",
                title: t("transactions.view_statement_file") do %>
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          <% end %>
        <% end %>

        <button onclick="deleteTransaction('<%= transaction.id %>', this.dataset.returnTo)"
                data-return-to="<%= safe_return_query_string %>"
                class="transactions-action-button transactions-action-delete"
                title="<%= t('transactions.delete_transaction') %>">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </td>
</tr>
