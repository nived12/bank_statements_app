<!-- ═══ HERO ═══ -->
<section class="pricing-hero" data-screen-label="01 Pricing hero">
  <div class="container">
    <span class="tag" style="margin-top:0;">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
      <span data-lang-es>PLANES</span><span data-lang-en>PLANS</span>
    </span>
    <h1>
      <span data-lang-es>Empieza gratis. <em>Mejora cuando quieras.</em></span>
      <span data-lang-en>Start free. <em>Upgrade when you want.</em></span>
    </h1>
    <p class="lead">
      <span data-lang-es>Un plan Gratis para siempre y un Premium con IA para automatizar todo. Cancela cuando quieras, sin letra chiquita.</span>
      <span data-lang-en>A Free forever plan and a Premium plan with AI to automate everything. Cancel anytime, no fine print.</span>
    </p>

    <div class="billing-toggle" id="billing-toggle">
      <button data-billing="monthly" class="on"><span data-lang-es>Mensual</span><span data-lang-en>Monthly</span></button>
      <button data-billing="annual">
        <span data-lang-es>Anual</span><span data-lang-en>Annual</span>
        <span class="save-pill">−33%</span>
      </button>
    </div>

    <div class="plans">
      <div class="plans-grid">

        <!-- FREE -->
        <div class="plan plan--center reveal">
          <div class="plan-name"><span data-lang-es>Gratis</span><span data-lang-en>Free</span></div>
          <p class="plan-tagline">
            <span data-lang-es>Para quienes empiezan a organizar sus finanzas.</span>
            <span data-lang-en>For those starting to organize their finances.</span>
          </p>

          <div class="plan-price">
            <span class="currency">$</span>
            <span class="amount">0</span>
            <span class="period"><span data-lang-es>MXN/mes</span><span data-lang-en>MXN/mo</span></span>
          </div>
          <div class="plan-note">
            <span data-lang-es>Siempre gratis. Sin tarjeta de crédito.</span>
            <span data-lang-en>Always free. No credit card.</span>
          </div>

          <a class="plan-cta" href="<%= free_cta_path %>">
            <span data-lang-es><%= free_cta_es %></span><span data-lang-en><%= free_cta_en %></span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>

          <div class="plan-features-head"><span data-lang-es>Incluye</span><span data-lang-en>Includes</span></div>
          <ul class="plan-features">
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span><span data-lang-es>Registro manual de transacciones</span><span data-lang-en>Manual transaction entry</span></span></li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span><span data-lang-es>Cuentas bancarias ilimitadas</span><span data-lang-en>Unlimited bank accounts</span></span></li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span><span data-lang-es>Dashboard y reportes mensuales</span><span data-lang-en>Dashboard and monthly reports</span></span></li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span><span data-lang-es>Metas de ahorro, deudas y ahorros</span><span data-lang-en>Savings goals, debts and savings</span></span></li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span><span data-lang-es>Categorización manual</span><span data-lang-en>Manual categorization</span></span></li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span><span data-lang-es>Exportar a CSV</span><span data-lang-en>Export to CSV</span></span></li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span><span data-lang-es>App iOS y Android (próximamente)</span><span data-lang-en>iOS and Android app (coming soon)</span></span></li>
          </ul>
        </div>

        <!-- PREMIUM -->
        <div class="plan plan--featured plan--center reveal d1">
          <div class="plan-badge"><span data-lang-es>Más popular</span><span data-lang-en>Most popular</span></div>
          <div class="plan-name">Premium</div>
          <p class="plan-tagline">
            <span data-lang-es>Tu coach financiero con IA + las herramientas que ahorran horas cada mes.</span>
            <span data-lang-en>Your AI financial coach + the tools that save you hours every month.</span>
          </p>

          <% if @subscription_state != :premium %>
          <span class="plan-trial">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15 8 22 9 17 14 18 21 12 18 6 21 7 14 2 9 9 8 12 2"/></svg>
            <% if @subscription_state == :on_trial %>
              <span data-lang-es><%= @trial_days_remaining %> días restantes de prueba</span><span data-lang-en><%= @trial_days_remaining %> trial days left</span>
            <% else %>
              <span data-lang-es>30 días gratis al registrarte</span><span data-lang-en>30 days free on signup</span>
            <% end %>
          </span>
          <% end %>

          <div class="plan-price">
            <span class="currency">$</span>
            <span class="amount" data-price-monthly="149" data-price-annual="99">149</span>
            <span class="period"><span data-lang-es>MXN/mes</span><span data-lang-en>MXN/mo</span></span>
          </div>
          <div class="plan-note">
            <span data-billing-show="monthly">
              <span data-lang-es>IVA incluido. Facturación mensual.</span>
              <span data-lang-en>VAT included. Billed monthly.</span>
            </span>
            <span data-billing-show="annual" style="display:none;">
              <span data-lang-es><span class="plan-strike">$149</span> Ahorras $600/año · Facturado anual ($1,188 MXN).</span>
              <span data-lang-en><span class="plan-strike">$149</span> Save $600/yr · Billed annually ($1,188 MXN).</span>
            </span>
          </div>

          <% if @subscription_state == :premium %>
            <a class="plan-cta" href="<%= prem_cta_path %>">
              <span data-lang-es><%= prem_cta_es %></span><span data-lang-en><%= prem_cta_en %></span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          <% elsif @subscription_state.in?([:on_trial, :expired]) %>
            <%= form_tag(prem_cta_path, method: :post) do %>
              <input type="hidden" name="plan" value="premium">
              <button type="submit" class="plan-cta" style="width:100%; cursor:pointer; border:none;">
                <span data-lang-es><%= prem_cta_es %></span><span data-lang-en><%= prem_cta_en %></span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </button>
            <% end %>
          <% else %>
            <a class="plan-cta" href="<%= new_user_path %>">
              <span data-lang-es><%= prem_cta_es %></span><span data-lang-en><%= prem_cta_en %></span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          <% end %>

          <div class="plan-features-head"><span data-lang-es>Todo lo de Gratis, más</span><span data-lang-en>Everything in Free, plus</span></div>
          <ul class="plan-features">
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span><span data-lang-es><strong>Vittbot</strong>, tu coach de finanzas reales</span><span data-lang-en><strong>Vittbot</strong>, your real-finance coach</span><span class="feat-sub" data-lang-es>Pregúntale en lenguaje natural: "¿en qué se me fue el dinero?"</span><span class="feat-sub" data-lang-en>Ask in plain language: "where did my money go?"</span></span></li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span><span data-lang-es><strong>Importa tu estado de cuenta</strong> en PDF o CSV</span><span data-lang-en><strong>Import your bank statement</strong> in PDF or CSV</span><span class="feat-sub" data-lang-es>14+ bancos mexicanos · 70 transacciones en 30 seg</span><span class="feat-sub" data-lang-en>14+ Mexican banks · 70 transactions in 30 sec</span></span></li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span><span data-lang-es><strong>Encuentra suscripciones que no usas</strong></span><span data-lang-en><strong>Find subscriptions you don't use</strong></span><span class="feat-sub" data-lang-es>Gestión automática de pagos recurrentes · Premium se paga solo</span><span class="feat-sub" data-lang-en>Auto-management of recurring payments · Premium pays for itself</span></span></li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span><span data-lang-es>Categorización automática con IA (120+ categorías)</span><span data-lang-en>AI auto-categorization (120+ categories)</span></span></li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span><span data-lang-es>Registra transacciones por voz</span><span data-lang-en>Voice transaction entry</span></span></li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span><span data-lang-es>Escanea recibos con la cámara</span><span data-lang-en>Scan receipts with the camera</span></span></li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span><span data-lang-es>Soporte prioritario en menos de 24 hrs</span><span data-lang-en>Priority support in under 24 hrs</span></span></li>
          </ul>
        </div>

      </div>

      <div style="margin-top:42px; text-align:center;">
        <div class="pricing-trust">
          <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span data-lang-es>Sin tarjeta de crédito</span><span data-lang-en>No credit card</span></span>
          <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span data-lang-es>Cancela cuando quieras</span><span data-lang-en>Cancel anytime</span></span>
          <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span data-lang-es>IVA incluido</span><span data-lang-en>VAT included</span></span>
          <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span data-lang-es>Datos cifrados</span><span data-lang-en>Encrypted data</span></span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ COMPARE TABLE ═══ -->
<section class="pricing-compare" data-screen-label="02 Compare table">
  <div class="container">
    <h2>
      <span data-lang-es>Compara <em>al detalle</em></span>
      <span data-lang-en>Compare <em>in detail</em></span>
    </h2>
    <p class="lead">
      <span data-lang-es>Todo lo que incluye cada plan, organizado por categoría.</span>
      <span data-lang-en>Everything in each plan, organized by category.</span>
    </p>

    <div class="pricing-table">

      <div class="pt-row pt-head">
        <div class="col"><span data-lang-es>FUNCIÓN</span><span data-lang-en>FEATURE</span></div>
