<%# Belvo Connect Widget — SDK requires <div id="belvo"> as its render target %>
<div data-controller="belvo-connect"
     data-belvo-connect-access-token-value="<%= @access_token %>"
     data-belvo-connect-callback-url-value="<%= belvo_links_path %>"
     data-belvo-connect-environment-value="<%= @belvo_environment %>">
  <div id="belvo" class="min-h-[500px]"></div>
  <p class="text-xs text-slate-400 text-center mt-2"><%= t("belvo.remaining_connections", count: current_user.remaining_bank_connections) %></p>
</div>
