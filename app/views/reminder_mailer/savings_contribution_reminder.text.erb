<%= t('.header', saving_name: @saving.name) %>

<%= t('.greeting', name: @user.email.split('@').first.capitalize) %>

<%= t('.message', saving_name: @saving.name, achieved: number_to_currency(@progress[:achieved], unit: "$"), target: number_to_currency(@progress[:target], unit: "$"), percentage: number_to_percentage(@progress[:percentage], precision: 0)) %>

<%= t('.shortfall', amount: number_to_currency(@shortfall, unit: "$"), days: @days_left) %>

<%= t('.footer') %>
