<div class="min-h-screen bg-slate-50 dark:bg-slate-900 flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-lg">
    <!-- Logo -->
    <div class="flex justify-center mb-8">
      <%= render "shared/logo", image_class: "h-10 w-auto" %>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 p-8">
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-indigo-100 dark:bg-indigo-900/30 mb-4">
          <%= icon("shield-check", library: "lucide", variant: "outline", class: "w-6 h-6 text-indigo-600 dark:text-indigo-400") %>
        </div>
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white"><%= t("legal_consent.new.title") %></h1>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400"><%= t("legal_consent.new.subtitle") %></p>
      </div>

      <%= form_with url: legal_consent_path, method: :post,
            data: { controller: "legal-consent" } do |f| %>

        <div class="space-y-4 mb-8">
          <!-- Terms of Service -->
          <label class="flex items-start gap-3 p-4 rounded-xl border border-slate-200 dark:border-slate-600 cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors">
            <input type="checkbox" name="consent[terms]" value="1" required
                   data-legal-consent-target="checkbox"
                   data-action="change->legal-consent#checkboxChanged"
                   class="mt-0.5 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500">
            <div class="flex-1">
              <span class="block text-sm font-medium text-slate-900 dark:text-white">
                <%= t("legal_consent.new.accept_terms") %>
              </span>
              <%= link_to t("legal_consent.new.read_link"), legal_terms_path,
                    target: "_blank", rel: "noopener noreferrer",
                    class: "text-xs text-indigo-600 dark:text-indigo-400 hover:underline" %>
            </div>
          </label>

          <!-- Privacy Policy -->
          <label class="flex items-start gap-3 p-4 rounded-xl border border-slate-200 dark:border-slate-600 cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors">
            <input type="checkbox" name="consent[privacy]" value="1" required
                   data-legal-consent-target="checkbox"
                   data-action="change->legal-consent#checkboxChanged"
                   class="mt-0.5 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500">
            <div class="flex-1">
              <span class="block text-sm font-medium text-slate-900 dark:text-white">
                <%= t("legal_consent.new.accept_privacy") %>
              </span>
              <%= link_to t("legal_consent.new.read_link"), legal_privacy_path,
                    target: "_blank", rel: "noopener noreferrer",
                    class: "text-xs text-indigo-600 dark:text-indigo-400 hover:underline" %>
            </div>
          </label>

          <!-- Financial Data Consent -->
          <label class="flex items-start gap-3 p-4 rounded-xl border border-slate-200 dark:border-slate-600 cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors">
            <input type="checkbox" name="consent[financial_data]" value="1" required
                   data-legal-consent-target="checkbox"
                   data-action="change->legal-consent#checkboxChanged"
                   class="mt-0.5 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500">
            <div class="flex-1">
              <span class="block text-sm font-medium text-slate-900 dark:text-white">
                <%= t("legal_consent.new.accept_financial") %>
              </span>
              <%= link_to t("legal_consent.new.read_link"), legal_financial_data_path,
                    target: "_blank", rel: "noopener noreferrer",
                    class: "text-xs text-indigo-600 dark:text-indigo-400 hover:underline" %>
            </div>
          </label>
        </div>

        <button type="submit"
                data-legal-consent-target="submit"
                disabled
                class="w-full flex items-center justify-center gap-2 px-6 py-3 rounded-xl font-semibold text-white
                       bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2
                       disabled:opacity-40 disabled:cursor-not-allowed transition-colors">
          <%= icon("circle-check", library: "lucide", variant: "outline", class: "w-5 h-5") %>
          <%= t("legal_consent.new.submit") %>
        </button>

      <% end %>

      <p class="mt-4 text-center text-xs text-slate-400 dark:text-slate-500">
        <%= t("legal_consent.new.version_notice", version: LegalDocument::CURRENT_VERSION) %>
      </p>
    </div>

    <!-- Sign out link if user wants to leave -->
    <p class="mt-6 text-center text-sm text-slate-500 dark:text-slate-400">
      <%= button_to t("session.sign_out"), session_path, method: :delete,
            class: "text-indigo-600 dark:text-indigo-400 hover:underline bg-transparent border-none cursor-pointer" %>
    </p>
  </div>
</div>
