<h1 class="email-title"><%= t(".header", saving_name: @saving.name) %></h1>

<p class="email-text"><%= t(".greeting", name: @user.first_name) %></p>

<p class="email-text">
  <%= t(".message",
         saving_name: @saving.name,
         achieved: number_to_currency(@progress[:achieved], unit: "$"),
         target: number_to_currency(@progress[:target], unit: "$"),
         percentage: number_to_percentage(@progress[:percentage], precision: 0)) %>
</p>

<div class="email-highlight">
  <%= t(".shortfall", amount: number_to_currency(@shortfall, unit: "$"), days: @days_left) %>
</div>

<p class="email-text"><%= t(".footer") %></p>
