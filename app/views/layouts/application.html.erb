<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title>Bank Statements App</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="csrf-token" content="<%= form_authenticity_token %>">
    <meta name="view-transition" content="same-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/icon.svg">
  </head>

  <body class="bg-slate-50 font-sans antialiased" data-controller="mobile-menu sidebar">
    <!-- Session Timeout Warning Modal -->
    <div data-session-timeout-target="warning" class="hidden fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true" style="display: none !important;">
      <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 bg-slate-500 bg-opacity-75 transition-opacity" aria-hidden="true"></div>

        <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
          <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
            <div class="sm:flex sm:items-start">
              <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-yellow-100 sm:mx-0 sm:h-10 sm:w-10">
                <svg class="h-6 w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                </svg>
              </div>
              <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
                <h3 class="text-lg leading-6 font-medium text-slate-900" id="modal-title">
                  <%= t('session.session_expiring_soon') %>
                </h3>
                <div class="mt-2">
                  <p class="text-sm text-slate-500">
                    <%= t('session_will_expire_in', time: '<span class="font-mono font-semibold text-red-600" data-session-timeout-target="countdown">0:00</span>').html_safe %>
                  </p>
                </div>
              </div>
            </div>
          </div>
          <div class="bg-slate-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
            <button type="button" data-action="click->session-timeout#extendSession" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-blue-600 text-base font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 sm:ml-3 sm:w-auto sm:text-sm">
              <%= t('session.stay_logged_in') %>
            </button>
            <button type="button" data-action="click->session-timeout#expireSession" class="mt-3 w-full inline-flex justify-center rounded-md border border-slate-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-slate-700 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
              <%= t('session.sign_out_now') %>
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="flex h-screen bg-slate-50">
      <!-- Desktop Sidebar -->
      <aside class="hidden md:flex md:w-56 md:flex-col md:fixed md:inset-y-0 z-50">
        <div class="flex flex-col flex-grow bg-white border-r border-slate-200 pt-5 pb-4 overflow-y-auto">
          <!-- Logo -->
          <div class="flex items-center justify-center flex-shrink-0 px-4">
            <a href="<%= root_path %>" class="flex items-center hover:opacity-80 transition-opacity">
              <img src="/vittio1.png" alt="Vittio" class="h-8 w-auto">
            </a>
          </div>
          
          <!-- Navigation -->
          <nav class="mt-8 flex-1 px-2 space-y-1">
            <!-- Main Navigation -->
            <a href="<%= url_for(locale: I18n.locale, controller: 'dashboard', action: 'index') %>"
               class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200">
              <%= icon("layout-dashboard", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
              <%= t('navigation.dashboard') %>
            </a>

            <a href="<%= url_for(locale: I18n.locale, controller: 'bank_accounts', action: 'index') %>"
               class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200">
              <%= icon("credit-card", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
              <%= t('navigation.bank_accounts') %>
            </a>

            <a href="<%= url_for(locale: I18n.locale, controller: 'categories', action: 'index') %>"
               class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200">
              <%= icon("folder", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
              <%= t('navigation.categories') %>
            </a>

            <a href="<%= url_for(locale: I18n.locale, controller: 'transactions', action: 'index') %>"
               class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200">
              <%= icon("receipt", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
              <%= t('navigation.transactions') %>
            </a>

            <!-- Goals Section -->
            <div class="pt-6">
              <div class="px-2 mb-2">
                <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider"><%= t('navigation.goals') %></h3>
              </div>

              <a href="<%= url_for(locale: I18n.locale, controller: 'goals', action: 'index') %>"
                 class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200">
                <%= icon("target", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
                <%= t('navigation.goals') %>
              </a>

              <a href="<%= url_for(locale: I18n.locale, controller: 'savings', action: 'index') %>"
                 class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200">
                <%= icon("piggy-bank", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
                <%= t('navigation.savings') %>
              </a>

              <a href="<%= url_for(locale: I18n.locale, controller: 'debts', action: 'index') %>"
                 class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200">
                <%= icon("wallet", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
                <%= t('navigation.debts') %>
              </a>
            </div>
          </nav>
          
          <!-- User Section -->
          <% if current_user %>
            <div class="flex-shrink-0 flex border-t border-slate-200 p-4">
              <div class="flex items-center w-full">
                <img src="<%= current_user.avatar_url %>?t=<%= Time.current.to_i %>"
                     alt="<%= current_user.full_name %>"
                     class="w-8 h-8 rounded-full object-cover">
                <div class="ml-3 flex-1">
                  <p class="text-sm font-medium text-slate-900 truncate"><%= current_user.full_name %></p>
                  <div class="flex items-center space-x-2">
                    <%= render 'shared/language_switcher' %>
                    <form action="/session" method="post" class="inline">
                      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                      <input type="hidden" name="_method" value="delete" />
                      <button type="submit" class="p-1 text-slate-500 hover:text-slate-700 transition-colors" title="<%= t('session.sign_out') %>">
                        <%= icon("log-out", library: "lucide", variant: "outline", class: "w-4 h-4") %>
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </aside>

      <!-- Main Content Area -->
      <div class="flex flex-col flex-1 md:ml-56">
        <!-- Mobile Header -->
        <header class="md:hidden bg-white shadow-sm border-b border-slate-200">
          <div class="px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center py-4">
              <div class="flex items-center">
                <button type="button"
                        data-action="click->mobile-menu#open"
                        class="p-2 rounded-md text-slate-400 hover:text-slate-500 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-blue-500">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                  </svg>
                </button>
                <a href="<%= root_path %>" class="ml-3 flex items-center hover:opacity-80 transition-opacity">
                  <img src="/vittio1.png" alt="Vittio" class="h-6 w-auto">
                </a>
              </div>
            </div>
          </div>
        </header>

        <!-- Main Content -->
        <main class="flex-1 overflow-y-auto">
          <%= yield %>
        </main>
      </div>
    </div>

    <!-- Mobile Menu Overlay -->
    <div data-mobile-menu-target="overlay"
         class="fixed inset-0 z-[9999] hidden mobile-menu-overlay lg:hidden"
         style="pointer-events: auto;">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-black bg-opacity-60"
             data-action="click->mobile-menu#close"></div>

        <!-- Menu Panel -->
        <div data-mobile-menu-target="panel"
             class="fixed top-0 left-0 h-full w-80 bg-white shadow-2xl mobile-menu-panel transform -translate-x-full transition-transform duration-300 ease-in-out z-[10000] flex flex-col overflow-hidden">

          <!-- Menu Header -->
          <div class="mobile-menu-header flex items-center justify-between bg-white border-b border-slate-200 p-6">
            <div class="flex items-center">
              <img src="/vittio1.png" alt="Vittio" class="h-8 w-auto">
            </div>
            <button type="button"
                    data-action="click->mobile-menu#close"
                    class="mobile-menu-close-btn p-2 rounded-lg hover:bg-slate-100 transition-colors">
              <svg class="w-6 h-6 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>

          <!-- Menu Items -->
          <nav class="mobile-menu-nav p-4 space-y-2 flex-1 overflow-y-auto">
            <a href="<%= url_for(locale: I18n.locale, controller: 'dashboard', action: 'index') %>"
               class="mobile-menu-item flex items-center px-4 py-4 rounded-xl text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200">
              <%= icon("layout-dashboard", library: "lucide", variant: "outline", class: "w-5 h-5 mr-3") %>
              <span><%= t('navigation.dashboard') %></span>
            </a>

            <a href="<%= url_for(locale: I18n.locale, controller: 'bank_accounts', action: 'index') %>"
               class="mobile-menu-item flex items-center px-4 py-4 rounded-xl text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200">
              <%= icon("credit-card", library: "lucide", variant: "outline", class: "w-5 h-5 mr-3") %>
              <span><%= t('navigation.bank_accounts') %></span>
            </a>

            <a href="<%= url_for(locale: I18n.locale, controller: 'categories', action: 'index') %>"
               class="mobile-menu-item flex items-center px-4 py-4 rounded-xl text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200">
              <%= icon("folder", library: "lucide", variant: "outline", class: "w-5 h-5 mr-3") %>
              <span><%= t('navigation.categories') %></span>
            </a>

            <a href="<%= url_for(locale: I18n.locale, controller: 'transactions', action: 'index') %>"
               class="mobile-menu-item flex items-center px-4 py-4 rounded-xl text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200">
              <%= icon("receipt", library: "lucide", variant: "outline", class: "w-5 h-5 mr-3") %>
              <span><%= t('navigation.transactions') %></span>
            </a>

            <a href="<%= url_for(locale: I18n.locale, controller: 'goals', action: 'index') %>"
               class="mobile-menu-item flex items-center px-4 py-4 rounded-xl text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200">
              <%= icon("target", library: "lucide", variant: "outline", class: "w-5 h-5 mr-3") %>
              <span><%= t('navigation.goals') %></span>
            </a>

            <a href="<%= url_for(locale: I18n.locale, controller: 'savings', action: 'index') %>"
               class="mobile-menu-item flex items-center px-4 py-4 rounded-xl text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200">
              <%= icon("piggy-bank", library: "lucide", variant: "outline", class: "w-5 h-5 mr-3") %>
              <span><%= t('navigation.savings') %></span>
            </a>

            <a href="<%= url_for(locale: I18n.locale, controller: 'debts', action: 'index') %>"
               class="mobile-menu-item flex items-center px-4 py-4 rounded-xl text-slate-700 hover:text-red-600 hover:bg-red-50 transition-all duration-200">
              <%= icon("wallet", library: "lucide", variant: "outline", class: "w-5 h-5 mr-3") %>
              <span><%= t('navigation.debts') %></span>
            </a>
          </nav>

          <!-- Mobile User Section -->
          <% if current_user %>
            <div class="flex-shrink-0 flex border-t border-slate-200 p-3">
              <div class="flex items-center w-full">
                <img src="<%= current_user.avatar_url %>?t=<%= Time.current.to_i %>"
                     alt="<%= current_user.full_name %>"
                     class="w-8 h-8 rounded-full object-cover">
                <div class="ml-3 flex-1">
                  <p class="text-sm font-medium text-slate-900 truncate"><%= current_user.full_name %></p>
                  <div class="flex items-center space-x-2">
                    <%= render 'shared/language_switcher' %>
                    <form action="/session" method="post" class="inline">
                      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                      <input type="hidden" name="_method" value="delete" />
                      <button type="submit" class="p-1 text-slate-500 hover:text-slate-700 transition-colors" title="<%= t('session.sign_out') %>">
                        <%= icon("log-out", library: "lucide", variant: "outline", class: "w-4 h-4") %>
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

    <!-- Toast Notifications -->
    <div id="toast-container" class="fixed top-4 right-4 z-50 space-y-2"></div>

    <!-- Session Timeout Controller -->
        <div data-controller="session-timeout" 
             data-session-timeout-warning-time-value="300"
             data-session-timeout-expiry-time-value="1800"
             data-session-timeout-check-interval-value="60">
    </div>
  </body>
</html>
