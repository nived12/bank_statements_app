<script>
// Bank Account Edit Modal JavaScript Functions

// Track form changes for bank account edit modal
let bankAccountEditFormHasChanges = false;

function closeBankAccountEditModalIfNoChanges(event) {
  // Only close if clicking on the backdrop (overlay), not the modal content
  if (event.target === event.currentTarget) {
    if (bankAccountEditFormHasChanges) {
      // Show confirmation dialog if there are unsaved changes
      if (confirm('You have unsaved changes. Are you sure you want to close?')) {
        bankAccountEditFormHasChanges = false;
        closeBankAccountEditModal();
      }
    } else {
      closeBankAccountEditModal();
    }
  }
}

function trackBankAccountEditFormChanges() {
  const form = document.querySelector('#mobileBankAccountEditModal form');
  if (form) {
    // Track all form inputs
    const inputs = form.querySelectorAll('input, select, textarea');
    inputs.forEach(input => {
      input.addEventListener('change', () => {
        bankAccountEditFormHasChanges = true;
      });
      input.addEventListener('input', () => {
        bankAccountEditFormHasChanges = true;
      });
    });
  }
}

// Open bank account edit modal
function openBankAccountEditModal() {
  // Reset changes tracking
  bankAccountEditFormHasChanges = false;

  // Dispatch Hotwire Native event
  window.dispatchEvent(new CustomEvent('modal:open', {
    detail: { type: 'bank_account_edit' }
  }));

  // Get modal and content elements
  const modal = document.getElementById('mobileBankAccountEditModal');
  const content = document.getElementById('mobileEditContent');

  if (!modal || !content) {
    console.error('Bank account edit modal elements not found');
    return;
  }

  // Populate form with current bank account data
  populateBankAccountEditForm();

  // Show modal
  modal.classList.remove('hidden');
  modal.style.display = 'block';

  // Setup form change tracking
  setTimeout(() => {
    trackBankAccountEditFormChanges();
  }, 100);

  // Animate content slide up
  setTimeout(() => {
    content.style.transform = 'translateY(0)';
  }, 10);
}

// Close bank account edit modal
function closeBankAccountEditModal() {
  // Dispatch Hotwire Native event
  window.dispatchEvent(new CustomEvent('modal:close', {
    detail: { type: 'bank_account_edit' }
  }));

  const modal = document.getElementById('mobileBankAccountEditModal');
  const content = document.getElementById('mobileEditContent');

  if (!modal || !content) return;

  // Animate content slide down
  content.style.transform = 'translateY(100%)';

  // Hide modal after animation
  setTimeout(() => {
    modal.style.display = 'none';
    modal.classList.add('hidden');
  }, 200);
}

// Populate edit form with current bank account data
function populateBankAccountEditForm() {
  // Get bank account data from the page
  const bankAccount = {
    bank_id: '<%= @bank_account.bank_id %>',
    account_type: '<%= @bank_account.account_type %>',
    custom_name: '<%= @bank_account.custom_name %>',
    account_number: '<%= @bank_account.account_number %>',
    currency: '<%= @bank_account.currency %>',
    opening_balance_date: '<%= @bank_account.opening_balance_date&.strftime("%Y-%m-%d") %>',
    opening_balance: '<%= @bank_account.opening_balance %>'
  };

  // Populate form fields
  const bankSelect = document.getElementById('mobile_edit_bank_id');
  const accountTypeSelect = document.getElementById('mobile_edit_account_type');
  const customNameField = document.getElementById('mobile_edit_custom_name');
  const accountNumberField = document.getElementById('mobile_edit_account_number');
  const currencyField = document.getElementById('mobile_edit_currency');
  const balanceDateField = document.getElementById('mobile_edit_opening_balance_date');
  const balanceField = document.getElementById('mobile_edit_opening_balance');

  // Populate supported banks select - we need to load this dynamically
  loadBankOptions(bankSelect, bankAccount.bank_id);

  if (accountTypeSelect) accountTypeSelect.value = bankAccount.account_type;
  if (customNameField) customNameField.value = bankAccount.custom_name || '';
  if (accountNumberField) accountNumberField.value = bankAccount.account_number || '';
  if (currencyField) currencyField.value = bankAccount.currency || '';
  if (balanceDateField) balanceDateField.value = bankAccount.opening_balance_date || '';
  if (balanceField) balanceField.value = bankAccount.opening_balance || '';
}

// Load bank options dynamically
function loadBankOptions(selectElement, selectedBankId) {
  // For now, we'll use a simple approach. In a real app, you might fetch this via API
  const supportedBanks = [
    <% (@supported_banks || []).each do |bank| %>
      { id: '<%= bank.id %>', name: '<%= bank.display_name %>' },
    <% end %>
  ];

  // Clear existing options
  selectElement.innerHTML = '<option value="">Select Bank</option>';

  // Add bank options
  supportedBanks.forEach(bank => {
    const option = document.createElement('option');
    option.value = bank.id;
    option.textContent = bank.name;
    if (bank.id === selectedBankId) {
      option.selected = true;
    }
    selectElement.appendChild(option);
  });
}

// Save bank account edit
function saveBankAccountEdit() {
  // Dispatch Hotwire Native event
  window.dispatchEvent(new CustomEvent('form:submit', {
    detail: { type: 'bank_account_edit' }
  }));

  const form = document.getElementById('mobileBankAccountEditForm');
  const saveButton = document.getElementById('mobileSaveBankAccountButton');

  if (!form) {
    console.error('Bank account edit form not found');
    return;
  }

  // Disable save button and show loading state
  if (saveButton) {
    saveButton.disabled = true;
    saveButton.innerHTML = `
      <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
    `;
  }

  // Submit form via Turbo
  form.requestSubmit();
}

// Handle form submission success (can be called from Turbo response)
function handleBankAccountUpdateSuccess() {
  // Close modal
  closeBankAccountEditModal();

  // Dispatch success event
  window.dispatchEvent(new CustomEvent('bank_account:updated', {
    detail: { success: true }
  }));

  // Reload page to show updated data (or use Turbo to update specific parts)
  setTimeout(() => {
    window.location.reload();
  }, 300);
}

// Handle form submission error
function handleBankAccountUpdateError(errors) {
  const saveButton = document.getElementById('mobileSaveBankAccountButton');

  // Re-enable save button
  if (saveButton) {
    saveButton.disabled = false;
    saveButton.innerHTML = `
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
    `;
  }

  // Dispatch error event
  window.dispatchEvent(new CustomEvent('bank_account:update_error', {
    detail: { errors: errors }
  }));

  // You could also show error messages in the modal here
  console.error('Bank account update failed:', errors);
}
</script>

