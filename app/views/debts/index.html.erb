<div>
  <%= render 'common/section_header', title: t('debts.title') do %>
    <%= link_to new_debt_path, class: "btn-primary flex items-center space-x-2", data: { turbo_frame: "_top" } do %>
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
      </svg>
      <%= t('debts.add_debt') %>
    <% end %>
  <% end %>

  <%= render 'common/planning/tabs', planning_type: 'debts' %>

  <section class="w-full flex justify-center">
    <div class="container p-8">
      <% if @debts.any? %>
        <div id="debts-list" class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6">
          <% @debts.each do |debt| %>
            <%= render 'common/planning/card', item: debt %>
          <% end %>
      <% else %>
        <%= render 'common/empty_section',
              title: t('goals.no_goals_yet'),
              description: t('goals.create_first_description'),
              button_text: t('goals.create_first'),
              button_path: new_goal_path %>
      <% end %>
    </div>
  </section>
</div>