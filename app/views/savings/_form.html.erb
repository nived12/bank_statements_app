<div id="saving-form" class="bg-white rounded-xl border border-slate-200 p-6" data-controller="saving-form">
  <%= form_with(model: saving, local: true, class: "space-y-6") do |f| %>
    <% if saving.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <div class="flex">
          <svg class="w-5 h-5 text-red-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414l8.586 10l-1.293 1.293a1 1 0 101.414 1.414L11 7.586 8.707 7.293z" clip-rule="evenodd"></path>
          </svg>
          <div>
            <h3 class="text-sm font-medium text-red-800">
              <%= t('errors.messages.form_errors', count: saving.errors.count) %>
            </h3>
            <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
              <% saving.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Saving Name -->
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-slate-700 mb-2" do %>
        <%= t('savings.name') %> <span class="text-red-500">*</span>
      <% end %>
      <%= f.text_field :name,
          placeholder: t('savings.name_placeholder'),
          class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
          required: true %>
      <p class="mt-1 text-sm text-slate-500"><%= t('savings.name_help') %></p>
    </div>

    <!-- Target Amount and Current Amount -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label :target_amount, class: "block text-sm font-medium text-slate-700 mb-2" do %>
          <%= t('savings.target_amount') %> <span class="text-red-500">*</span>
        <% end %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <span class="text-slate-500 sm:text-sm">$</span>
          </div>
          <%= f.text_field :target_amount,
              inputmode: "decimal",
              class: "w-full pl-7 pr-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
              placeholder: "0.00",
              data: { action: "input->saving-form#enforceDecimalPlaces blur->saving-form#formatDecimal" },
              required: true %>
        </div>
        <p class="mt-1 text-sm text-slate-500"><%= t('savings.target_amount_help') %></p>
      </div>

      <div>
        <%= f.label :current_amount, class: "block text-sm font-medium text-slate-700 mb-2" do %>
          <%= t('savings.current_amount') %>
        <% end %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <span class="text-slate-500 sm:text-sm">$</span>
          </div>
          <%= f.text_field :current_amount,
              inputmode: "decimal",
              class: "w-full pl-7 pr-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
              placeholder: "0.00",
              data: { action: "input->saving-form#enforceDecimalPlaces blur->saving-form#formatDecimal" } %>
        </div>
        <p class="mt-1 text-sm text-slate-500"><%= t('savings.current_amount_help') %></p>
      </div>
    </div>

    <!-- Icon Picker -->
    <div data-controller="icon-picker"
         data-icon-picker-selected-value="<%= saving.icon || 'piggy-bank' %>"
         data-action="icon-picker:changed->saving-form#iconChanged">
      <%= f.hidden_field :icon,
          data: {
            icon_picker_target: "input",
            saving_form_target: "iconInput"
          },
          value: saving.icon || 'piggy-bank' %>

      <%= f.label :icon, t('savings.icon'), class: "block text-sm font-medium text-slate-700 mb-2" %>

      <div class="flex items-center space-x-3 mb-3">
        <!-- Icon Button (click to show picker) -->
        <button type="button"
                data-action="click->icon-picker#togglePicker"
                data-icon-picker-target="iconDisplay"
                class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center border-2 border-blue-200 hover:border-blue-400 transition-colors flex-shrink-0">
          <%= icon_svg(saving.icon || 'piggy-bank', css_classes: "w-6 h-6 text-blue-600") %>
        </button>
        <p class="text-sm text-slate-500"><%= t('savings.icon_help') %></p>
      </div>

      <!-- Icon Picker (hidden by default) -->
      <div data-icon-picker-target="pickerContainer" class="hidden mb-4">
        <div class="p-3 bg-slate-50 rounded-lg border border-slate-200">
          <div class="grid grid-cols-6 gap-2 max-h-64 overflow-y-auto">
            <% IconsHelper::ICONS_LIBRARY.each do |icon_name, lucide_icon| %>
              <button type="button"
                      data-action="click->icon-picker#select"
                      data-icon-picker-icon-param="<%= icon_name %>"
                      data-icon-name="<%= icon_name %>"
                      class="p-2 rounded-lg border-2 transition-all hover:border-blue-300 flex items-center justify-center <%= icon_name == (saving.icon || 'piggy-bank') ? 'border-blue-500 bg-blue-50' : 'border-slate-200 bg-white' %>"
                      data-icon-picker-target="iconButton">
                <%= icon(lucide_icon, library: "lucide", variant: "outline", class: "w-5 h-5 #{icon_name == (saving.icon || 'piggy-bank') ? 'text-blue-600' : 'text-slate-600'}") %>
              </button>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Color Picker -->
    <div data-controller="color-picker">
      <%= f.label :color, t('savings.color'), class: "block text-sm font-medium text-slate-700 mb-2" %>
      <%= f.hidden_field :color, value: saving.color || '#3B82F6', data: { color_picker_target: "input" } %>

      <div class="flex gap-3 flex-wrap">
        <% [
          ['#EF4444', 'Red'],
          ['#F97316', 'Orange'],
          ['#F59E0B', 'Amber'],
          ['#10B981', 'Green'],
          ['#3B82F6', 'Blue'],
          ['#6366F1', 'Indigo'],
          ['#8B5CF6', 'Purple'],
          ['#EC4899', 'Pink'],
          ['#64748B', 'Slate'],
          ['#0EA5E9', 'Sky']
        ].each do |color, name| %>
          <button type="button"
                  data-action="click->color-picker#select"
                  data-color="<%= color %>"
                  data-color-picker-target="button"
                  class="w-10 h-10 rounded-full transition-all hover:scale-110 <%= (saving.color || '#3B82F6') == color ? 'ring-4 ring-offset-2' : '' %>"
                  style="background-color: <%= color %>;"
                  title="<%= name %>">
          </button>
        <% end %>
      </div>
      <p class="mt-2 text-sm text-slate-500"><%= t('savings.color_help') %></p>
    </div>

    <!-- Auto-Link Configuration -->
    <div data-controller="auto-link-toggle">
      <div class="flex items-start">
        <div class="flex items-center h-5">
          <%= f.check_box :auto_link_category,
              class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-slate-300 rounded",
              data: {
                auto_link_toggle_target: "checkbox",
                action: "change->auto-link-toggle#toggle"
              } %>
        </div>
        <div class="ml-3 text-sm">
          <%= f.label :auto_link_category, t('savings.auto_link_enable'),
              class: "font-medium text-slate-700" %>
          <p class="text-slate-500"><%= t('savings.auto_link_description') %></p>
        </div>
      </div>

      <!-- Auto-link Fields (shown when enabled) -->
      <div id="auto-link-fields"
           class="mt-4 space-y-4 pl-7 <%= 'hidden' unless saving.auto_link_category? %>"
           data-auto-link-toggle-target="fields">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Category -->
          <div>
            <%= f.label :category_id, t('savings.category'), 
                class: "block text-sm font-medium text-slate-700 mb-2" %>
            <%= f.select :category_id, 
                options_from_collection_for_select(@categories, :id, :name, saving.category_id),
                { prompt: t('savings.select_category') },
                { class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" } %>
          </div>

          <!-- Bank Account -->
          <div>
            <%= f.label :bank_account_id, t('savings.bank_account'), 
                class: "block text-sm font-medium text-slate-700 mb-2" %>
            <%= f.select :bank_account_id, 
                options_from_collection_for_select(@bank_accounts, :id, :custom_name, saving.bank_account_id),
                { prompt: t('savings.select_bank_account') },
                { class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Calculation Settings -->
    <div data-controller="saving-calculation-settings"
         data-saving-calculation-settings-hide-text-value="<%= t('savings.hide_advanced_settings') %>"
         data-saving-calculation-settings-show-text-value="<%= t('savings.show_advanced_settings') %>">
      <!-- Toggle Button -->
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-slate-900"><%= t('savings.calculation_settings_label') %></h3>
        <button type="button" 
                class="text-sm text-blue-600 hover:text-blue-800 font-medium"
                data-saving-calculation-settings-target="toggleButton"
                data-action="click->saving-calculation-settings#toggle">
          <%= t('savings.show_advanced_settings') %>
        </button>
      </div>
      
      <p class="text-sm text-slate-500 mb-4"><%= t('savings.calculation_settings_help') %></p>

      <!-- Advanced Settings Content (hidden by default) -->
      <div class="hidden" data-saving-calculation-settings-target="content">
        <div class="space-y-6 p-4 bg-slate-50 rounded-lg border border-slate-200">
          <% %w[income expense transfer_in transfer_out].each do |type| %>
            <div class="border-b border-slate-200 pb-4 last:border-b-0 last:pb-0">
              <h4 class="text-sm font-medium text-slate-700 mb-3">
                <%= t("savings.calculation_settings.#{type}") %>
              </h4>
              <div class="flex space-x-6">
                <% %w[positive negative ignore].each do |option| %>
                  <label class="flex items-center">
                    <%= f.radio_button "calculation_settings_#{type}", option,
                        checked: saving.calculation_settings&.dig(type) == option,
                        class: "w-4 h-4 text-blue-600 border-slate-300 focus:ring-blue-500" %>
                    <span class="ml-2 text-xs text-slate-700">
                      <%= t("savings.calculation_settings.#{option}") %>
                    </span>
                  </label>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Notes -->
    <div>
      <%= f.label :notes, t('savings.notes'), class: "block text-sm font-medium text-slate-700 mb-2" %>
      <%= f.text_area :notes, rows: 3,
          class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
          placeholder: t('savings.notes_placeholder') %>
      <p class="mt-1 text-sm text-slate-500"><%= t('savings.notes_help') %></p>
    </div>

    <!-- Form Actions -->
    <div class="flex items-center justify-end space-x-3 pt-6 border-t border-slate-200">
      <%= link_to t('savings.cancel'), savings_path, 
          class: "inline-flex items-center px-4 py-2 border border-slate-300 text-sm font-medium rounded-lg text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
      <%= f.submit t('savings.save'),
          class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
    </div>
  <% end %>
</div>
