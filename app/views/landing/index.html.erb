<% content_for :body_class, "theme-dark is-hero-dark intensity-bold" %>

<% content_for :head do %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Vittio",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Web",
  "inLanguage": ["es-MX", "en"],
  "url": "https://app.vitt.io",
  "description": "Personal finance platform for Mexico — upload bank statements, AI categorizes transactions, track accounts, savings goals, and debts.",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "MXN" },
  "screenshot": "https://vitt.io/vittio_new_with_description.jpg",
  "brand": { "@type": "Brand", "name": "Vittio" }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Necesito dar mis credenciales bancarias?",
      "acceptedAnswer": { "@type": "Answer", "text": "No. Vittio no se conecta a tu banco. Solo lees el PDF que descargas de la app de tu banco. Nunca nos das contraseñas, NIPs ni tokens." }
    },
    {
      "@type": "Question",
      "name": "¿Qué bancos mexicanos son compatibles?",
      "acceptedAnswer": { "@type": "Answer", "text": "Banorte, BBVA, Santander, Citibanamex, HSBC, Scotiabank, Nu, Hey Banco, Klar, Albo, Inbursa, Banco Azteca y más." }
    },
    {
      "@type": "Question",
      "name": "¿Mis datos están seguros?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sí. Cifrado de extremo a extremo, almacenamiento seguro, y jamás vendemos o compartimos tus datos." }
    },
    {
      "@type": "Question",
      "name": "¿Es gratis? ¿Qué incluye el plan Premium?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sí, hay un plan Gratis para siempre. Si creas tu cuenta antes del 31 de diciembre de 2026, el plan Gratis se queda para ti tal como está hoy, permanentemente. Premium ($99 MXN/mes o $75/mes anual) agrega importación de PDF/CSV con IA, entrada por voz, escaneo de recibos y categorización automática." }
    },
    {
      "@type": "Question",
      "name": "¿Puedo probar Premium antes de pagar?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sí. Al crear tu cuenta, recibes 30 días de Premium gratis automáticamente. Sin tarjeta." }
    },
    {
      "@type": "Question",
      "name": "¿Vittio tiene app para iPhone y Android?",
      "acceptedAnswer": { "@type": "Answer", "text": "La versión web está disponible ahora. La app nativa para iOS y Android llega en agosto 2026." }
    }
  ]
}
</script>
<% end %>

