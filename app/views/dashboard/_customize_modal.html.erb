<!-- Dashboard Customization Modal -->
<div data-dashboard-customizer-target="modal" class="hidden fixed inset-0 z-[9999] flex items-center justify-center p-4">
  <!-- Backdrop with blur effect -->
  <div class="absolute inset-0 bg-slate-500/75 backdrop-blur-sm" data-action="click->dashboard-customizer#closeModal"></div>
  
  <!-- Modal Content Container -->
  <div class="relative bg-white rounded-lg shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-hidden flex flex-col z-10">
    <div class="p-6 overflow-y-auto flex-1">
      <!-- Modal Header -->
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-xl font-semibold text-slate-900"><%= t('dashboard.customize_layout') %></h3>
        <button type="button" data-action="click->dashboard-customizer#closeModal" class="text-slate-400 hover:text-slate-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Available Widgets List -->
      <div class="space-y-3 mb-6">
        <% DashboardLayout::DEFAULT_WIDGETS.each do |widget| %>
          <% enabled = @widgets.find { |w| w["id"] == widget["id"] }&.dig("enabled") || false %>
          <div class="flex items-center justify-between p-4 border border-slate-200 rounded-lg hover:bg-slate-50">
            <div class="flex items-center">
              <label class="cursor-pointer">
                <input 
                  type="checkbox" 
                  data-action="change->dashboard-customizer#toggleWidget"
                  data-widget-id="<%= widget["id"] %>"
                  <%= "checked" if enabled %>
                  class="w-5 h-5 text-blue-600 border-slate-300 rounded focus:ring-blue-500">
                <span class="ml-3 text-slate-900 font-medium">
                  <%= case widget["id"]
                  when "financial_health"
                    t('dashboard.widgets.financial_health')
                  when "income_expenses"
                    t('dashboard.widgets.income_expenses')
                  when "category_breakdown"
                    t('spending_trends.by_category')
                  when "cash_flow_timeline"
                    t('spending_trends.title')
                  when "account_balances"
                    t('account_balances.title')
                  when "recent_transactions"
                    t('recent_transactions.title')
                  end %>
                </span>
              </label>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Modal Footer -->
      <div class="flex items-center justify-end space-x-3 pt-6 border-t border-slate-200">
        <button type="button" data-action="click->dashboard-customizer#closeModal" class="px-4 py-2 border border-slate-300 rounded-lg text-slate-700 hover:bg-slate-50">
          <%= t('form_actions.cancel') %>
        </button>
        <button type="button" data-action="click->dashboard-customizer#saveLayout" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
          <%= t('form_actions.save') %>
        </button>
      </div>
    </div>
  </div>
</div>

