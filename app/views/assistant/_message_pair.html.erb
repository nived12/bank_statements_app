<%# Renders a user bubble + optional assistant bubble pair %>
<%# Locals: user_message, assistant_message (may be nil), disclaimer (string or nil) %>

<% if user_message %>
  <div class="flex justify-end" id="msg-user-<%= user_message.id %>">
    <div class="max-w-[80%] sm:max-w-[70%]">
      <div class="bg-indigo-600 text-white rounded-2xl rounded-tr-sm px-4 py-3 text-sm leading-relaxed shadow-sm">
        <%= simple_format(h(user_message.content), {}, wrapper_tag: :div, paragraph_tag: nil) %>
      </div>
      <p class="text-xs text-slate-400 dark:text-slate-500 mt-1 text-right pr-1">
        <%= l(user_message.created_at, format: :time_only) %>
      </p>
    </div>
  </div>
<% end %>

<% if assistant_message %>
  <div class="flex justify-start" id="msg-asst-<%= assistant_message.id %>">
    <div class="flex items-start gap-3 max-w-[85%] sm:max-w-[75%]">
      <%# Avatar %>
      <div class="flex-shrink-0 w-8 h-8 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center shadow-sm mt-0.5">
        <%= icon("bot-message-square", library: "lucide", variant: "outline", class: "w-4 h-4 text-white") %>
      </div>

      <div class="flex-1 min-w-0">
        <%# Disclaimer banner (injected on first turn only) %>
        <% if disclaimer.present? %>
          <div class="mb-2 flex items-start gap-1.5 px-3 py-2 rounded-xl bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700">
            <%= icon("info", library: "lucide", variant: "outline", class: "w-3.5 h-3.5 text-amber-500 flex-shrink-0 mt-0.5") %>
            <p class="text-xs text-amber-700 dark:text-amber-400"><%= disclaimer %></p>
          </div>
        <% end %>

        <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl rounded-tl-sm px-4 py-3 shadow-sm">
          <div class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed prose prose-sm dark:prose-invert max-w-none">
            <%= simple_format(h(assistant_message.content)) %>
          </div>

        </div>

        <p class="text-xs text-slate-400 dark:text-slate-500 mt-1 pl-1">
          <%= l(assistant_message.created_at, format: :time_only) %>
        </p>
      </div>
    </div>
  </div>
<% end %>
