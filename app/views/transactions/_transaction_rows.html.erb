<% transactions.each.with_index(1) do |transaction, index| %>
  <tr class="transactions-table-row" data-transaction-id="<%= transaction.id %>">
    <td class="transactions-table-cell">
      <span class="transactions-table-cell-text text-slate-500 font-medium">
        <%= (page_offset || 0) + index %>
      </span>
    </td>
    <td class="transactions-table-cell">
      <span class="transactions-table-cell-text" data-date="<%= transaction.date.to_date.strftime('%Y-%m-%d') %>">
        <%= format_local_time(transaction.date, format: 'short_date') %>
      </span>
    </td>
    <td class="transactions-table-cell">
      <span class="transactions-table-cell-text text-slate-700">
        <%= transaction.bank_account&.custom_name %>
      </span>
    </td>
    <td class="transactions-table-cell">
      <div>
        <div class="transactions-table-cell-text" title="<%= transaction.description %>" data-description="<%= transaction.description %>">
          <%= short_description(transaction.description) %>
        </div>
        <% if transaction.merchant.present? || transaction.reference.present? %>
          <div class="text-xs text-slate-500 mt-1">
            <% if transaction.merchant.present? %>
              <span data-merchant="<%= transaction.merchant %>"><%= transaction.merchant %></span>
            <% end %>
            <% if transaction.reference.present? %>
              <span data-reference="<%= transaction.reference %>"> • <%= transaction.reference %></span>
            <% end %>
          </div>
        <% end %>
      </div>
    </td>
    <td class="transactions-table-cell">
      <div class="flex items-center">
        <span class="transactions-table-cell-text <%= (transaction.transaction_type == 'income' || transaction.transaction_type == 'transfer_in') ? 'text-green-600' : 'text-red-600' %>" data-amount="<%= transaction.amount %>">
          <%= transaction.amount >= 0 ? '+' : '-' %>$<%= number_with_precision(transaction.amount.abs, precision: 2, delimiter: ',') %>
        </span>
      </div>
    </td>
    <td class="transactions-table-cell">
      <span class="transactions-table-transaction-type transactions-table-transaction-type-<%= transaction.transaction_type %>" data-transaction-type="<%= transaction.transaction_type %>">
        <%= t("transaction_types.#{transaction.transaction_type}") %>
      </span>
    </td>
    <td class="transactions-table-cell">
      <% if transaction.category %>
        <div class="flex items-center space-x-2">
          <span class="transactions-category-name" data-category-id="<%= transaction.category.id %>">
            <%= transaction.category.name %>
          </span>
          <% if transaction.category.parent %>
            <span class="transactions-category-parent">
              (<%= transaction.category.parent.name %>)
            </span>
          <% end %>
        </div>
      <% else %>
        <span class="transactions-category-empty" data-category-id=""><%= t('transactions.no_category') %></span>
      <% end %>
    </td>
    <td class="transactions-table-cell">
      <div class="flex space-x-2">
        <%= link_to edit_transaction_path(transaction), data: { turbo_frame: "_top" }, class: "transactions-action-button transactions-action-edit" do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
        <% end %>
        <% if transaction.statement_file %>
          <%= link_to statement_file_path(transaction.statement_file), class: "transactions-action-button transactions-action-statement", title: t('transactions.view_statement_file') do %>
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          <% end %>
        <% end %>
        <% if transaction.source == "manual" %>
          <button onclick="deleteTransaction('<%= transaction.id %>')" class="transactions-action-button transactions-action-delete">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          </button>
        <% end %>
      </div>
    </td>
  </tr>
<% end %>

<!-- Mobile date groups (hidden on desktop) -->
<div class="block md:hidden">
  <%= render partial: "transactions/mobile_transaction_groups", locals: { transactions: transactions } %>
</div>

