<%#
  Colour swatch picker shared by the savings, debts, and goals forms.

  The ring colours live here rather than in color_picker_controller.js, which only
  toggles `ring-4 ring-offset-2` — with a zero-width ring they are inert, so keeping
  them on every swatch means the controller needs no colour knowledge.

  Locals: form, record, default_color, label, change_action (optional)
%>
<%
  selected_color = record.color.presence || default_color
  swatches = {
    "#EF4444" => "red",
    "#F97316" => "orange",
    "#F59E0B" => "amber",
    "#10B981" => "green",
    "#3B82F6" => "blue",
    "#6366F1" => "indigo",
    "#8B5CF6" => "purple",
    "#EC4899" => "pink",
    "#64748B" => "slate",
    "#0EA5E9" => "sky"
  }
%>
<div data-controller="color-picker">
  <%= form.label :color, label, class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2" %>
  <%= form.hidden_field :color, value: selected_color, data: { color_picker_target: "input" } %>

  <div class="flex gap-2.5 flex-wrap">
    <% swatches.each do |color, name| %>
      <% selected = selected_color.casecmp?(color) %>
      <button type="button"
              data-action="<%= ["click->color-picker#select", local_assigns[:change_action]].compact.join(" ") %>"
              data-color="<%= color %>"
              data-color-picker-target="button"
              aria-label="<%= t("colors.#{name}") %>"
              aria-pressed="<%= selected %>"
              class="w-9 h-9 rounded-full transition-all hover:scale-110 ring-slate-900 dark:ring-white ring-offset-white dark:ring-offset-slate-800 <%= "ring-4 ring-offset-2" if selected %>"
              style="background-color: <%= color %>;"
              title="<%= t("colors.#{name}") %>">
      </button>
    <% end %>
  </div>
</div>
