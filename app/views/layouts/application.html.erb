<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title>Bank Statements App</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="csrf-token" content="<%= form_authenticity_token %>">
    <meta name="view-transition" content="same-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/icon.svg">
    <% if ENV["VAPID_PUBLIC_KEY"].present? %>
      <meta name="vapid-public-key" content="<%= ENV["VAPID_PUBLIC_KEY"] %>">
    <% end %>
    <script nonce="<%= content_security_policy_nonce %>">
      (function() {
        try {
          var theme = localStorage.getItem('vittio-theme') ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>
  </head>

  <body class="bg-slate-50 dark:bg-slate-900 font-sans antialiased" data-controller="profile-sheet sidebar web-push">
    <%= render "shared/flash" %>

    <div class="mobile-app-root md:h-screen md:overflow-x-hidden bg-slate-50 dark:bg-slate-900">
      <div class="mobile-app-body md:flex-row md:h-screen md:overflow-x-hidden">
      <!-- Desktop Sidebar -->
      <aside class="hidden md:flex md:w-72 md:flex-col md:fixed md:inset-y-0 z-50">
        <div class="flex flex-col flex-grow bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-700 pt-5 pb-4 overflow-y-auto">
          <!-- Logo -->
          <div class="flex items-center justify-center flex-shrink-0 px-3 w-full min-w-0">
            <a href="<%= root_path %>" class="flex w-full min-w-0 max-w-full items-center justify-center hover:opacity-80 transition-opacity">
              <%= render "shared/logo", image_class: "h-20 w-auto max-w-full object-contain shrink-0" %>
            </a>
          </div>

          <!-- Navigation -->
          <nav class="mt-8 flex-1 px-2 space-y-1">
            <!-- Main Navigation -->
            <a href="<%= dashboard_path %>"
               class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200 <%= 'active' if controller_name == 'dashboard' %>">
              <%= icon("layout-dashboard", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
              <%= t('navigation.dashboard') %>
            </a>

            <a href="<%= bank_accounts_path %>"
               class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200 <%= 'active' if controller_name == 'bank_accounts' %>">
              <%= icon("credit-card", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
              <%= t('navigation.bank_accounts') %>
            </a>

            <a href="<%= categories_path %>"
               class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200 <%= 'active' if %w[categories category_rules].include?(controller_name) %>">
              <%= icon("folder", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
              <%= t('navigation.categories') %>
            </a>

            <a href="<%= transactions_path %>"
               class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200 <%= 'active' if %w[transactions recurring_series].include?(controller_name) %>">
              <%= icon("receipt", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
              <%= t('navigation.transactions') %>
            </a>

            <a href="<%= statement_files_path %>"
               class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200 <%= 'active' if controller_name == 'statement_files' %>">
              <%= icon("file-text", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
              <%= t('navigation.statement_files') %>
            </a>

            <!-- Goals Section -->
            <div class="pt-6">
              <div class="px-2 mb-2">
                <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider"><%= t('navigation.goals') %></h3>
              </div>

              <a href="<%= goals_path %>"
                 class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200 <%= 'active' if controller_name == 'goals' %>">
                <%= icon("target", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
                <%= t('navigation.goals') %>
              </a>

              <a href="<%= savings_path %>"
                 class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200 <%= 'active' if controller_name == 'savings' %>">
                <%= icon("piggy-bank", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
                <%= t('navigation.savings') %>
              </a>

              <a href="<%= debts_path %>"
                 class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200 <%= 'active' if controller_name == 'debts' %>">
                <%= icon("wallet", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
                <%= t('navigation.debts') %>
              </a>
            </div>
          </nav>

          <!-- User Section -->
          <% if current_user %>
            <div class="flex-shrink-0 border-t border-slate-200 dark:border-slate-700 p-3">
              <% if current_user.active_paid_subscription? || current_user.active_trial? %>
                <a href="<%= assistant_path %>"
                   class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200 mb-1 <%= 'active' if controller_name == 'assistant' %>">
                  <%= icon("bot-message-square", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
                  <%= t("navigation.assistant") %>
                </a>
              <% end %>
              <a href="<%= subscription_path %>"
                 class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200 mb-1 <%= 'active' if controller_name == 'subscriptions' %>">
                <%= icon("crown", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
                <%= t("navigation.subscription") %>
              </a>
              <a href="<%= settings_path %>"
                 class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200 mb-1 <%= 'active' if controller_name == 'settings' %>">
                <%= icon("settings", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
                <%= t("navigation.settings") %>
              </a>
              <%= link_to profile_path,
                  class: "flex items-center gap-2 w-full p-1 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors group" do %>
                <div class="relative flex-shrink-0">
                  <img src="<%= user_avatar_url(current_user) %>"
                       alt="<%= current_user.full_name %>"
                       class="w-8 h-8 rounded-full object-cover">
                  <% if current_user.active_paid_subscription? %>
                    <span class="absolute z-10 w-4 h-4 bg-amber-500 rounded-full flex items-center justify-center ring-1 ring-white dark:ring-slate-900" style="bottom: -2px; right: -2px;">
                      <%= icon("crown", library: "lucide", variant: "outline", class: "w-2.5 h-2.5 text-white") %>
                    </span>
                  <% end %>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-slate-900 dark:text-slate-100 truncate group-hover:text-indigo-600"><%= current_user.full_name %></p>
                  <p class="text-xs text-slate-400 dark:text-slate-500 truncate"><%= t("profile.edit_profile") %></p>
                </div>
              <% end %>
              <div class="flex items-center justify-between mt-2 px-1">
                <%= render 'shared/language_switcher' %>
                <div class="flex items-center gap-1">
                  <div data-controller="dark-mode">
                    <button data-action="click->dark-mode#toggle"
                            class="p-1 text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 transition-colors"
                            title="<%= t('layouts.dark_mode_toggle') %>">
                      <span data-dark-mode-target="moon"><%= icon("moon", library: "lucide", variant: "outline", class: "w-4 h-4") %></span>
                      <span data-dark-mode-target="sun" style="display:none"><%= icon("sun", library: "lucide", variant: "outline", class: "w-4 h-4") %></span>
                    </button>
                  </div>
                  <form action="/session" method="post" class="inline">
                    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                    <input type="hidden" name="_method" value="delete" />
                    <button type="submit" class="p-1 text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 transition-colors" title="<%= t('session.sign_out') %>">
                      <%= icon("log-out", library: "lucide", variant: "outline", class: "w-4 h-4") %>
                    </button>
                  </form>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </aside>

      <!-- Main Content Area -->
      <div class="flex flex-col flex-1 min-h-0 md:ml-72 w-full min-w-0">
        <!-- Mobile Header -->
        <% unless content_for?(:hide_mobile_header) %>
        <header class="mobile-app-header md:hidden">
          <div class="mobile-app-header-spacer"></div>
          <a href="<%= root_path %>" class="mobile-app-header-logo flex items-center justify-center">
            <%= render "shared/logo", image_class: "h-16 w-auto max-w-[140px] object-contain" %>
          </a>
          <% if current_user %>
            <button type="button"
                    data-action="click->profile-sheet#open"
                    class="mobile-app-avatar-btn"
                    aria-label="<%= t('profile.edit_profile') %>">
              <img src="<%= user_avatar_url(current_user) %>"
                   alt="<%= current_user.full_name %>">
            </button>
          <% else %>
            <div class="mobile-app-header-spacer"></div>
          <% end %>
        </header>
        <% end %>

        <!-- Main Content -->
        <% mobile_main_stack = content_for?(:mobile_stack_screen) || content_for?(:hide_mobile_header) %>
        <main class="flex-1 min-h-0 w-full overflow-x-hidden md:overflow-y-auto md:pb-0 <%= mobile_main_stack ? 'mobile-main-stack' : 'overflow-y-auto' %> <%= 'mobile-main-stack-no-header' if content_for?(:hide_mobile_header) %>">
          <%= yield %>
        </main>
      </div>
      </div>

      <!-- Mobile Bottom Navigation (in flex column — always pinned below content) -->
      <% if current_user %>
      <div class="mobile-bottom-nav-shell md:hidden"
           data-controller="fab-speed-dial"
           data-fab-speed-dial-new-transaction-path-value="<%= new_transaction_path %>"
           data-fab-speed-dial-upload-path-value="<%= new_statement_file_path %>"
           data-fab-speed-dial-assistant-path-value="<%= assistant_path %>">

        <div data-fab-speed-dial-target="backdrop"
             class="mobile-fab-dial-backdrop hidden"
             data-action="click->fab-speed-dial#closeOnBackdrop"></div>

        <div data-fab-speed-dial-target="dial"
             class="mobile-fab-dial hidden"
             role="menu"
             aria-hidden="true">
          <%= link_to assistant_path,
                class: "mobile-fab-dial-row",
                data: { action: "click->fab-speed-dial#navigate" },
                role: "menuitem" do %>
            <span class="mobile-fab-dial-label"><%= t("navigation.fab.ai_assistant") %></span>
            <span class="mobile-fab-dial-mini mobile-fab-dial-mini-indigo">
              <%= icon("bot-message-square", library: "lucide", variant: "outline", class: "w-5 h-5") %>
            </span>
          <% end %>
          <%= link_to new_statement_file_path,
                class: "mobile-fab-dial-row",
                data: { action: "click->fab-speed-dial#navigate" },
                role: "menuitem" do %>
            <span class="mobile-fab-dial-label"><%= t("navigation.fab.upload_statement") %></span>
            <span class="mobile-fab-dial-mini mobile-fab-dial-mini-cyan">
              <%= icon("upload", library: "lucide", variant: "outline", class: "w-5 h-5") %>
            </span>
          <% end %>
          <%= link_to new_transaction_path,
                class: "mobile-fab-dial-row",
                data: { action: "click->fab-speed-dial#navigate" },
                role: "menuitem" do %>
            <span class="mobile-fab-dial-label"><%= t("navigation.fab.new_transaction") %></span>
            <span class="mobile-fab-dial-mini mobile-fab-dial-mini-indigo">
              <%= icon("plus", library: "lucide", variant: "outline", class: "w-5 h-5") %>
            </span>
          <% end %>
        </div>

        <nav class="mobile-bottom-nav">
          <%= link_to dashboard_path, class: "mobile-nav-item #{'mobile-nav-item-active' if controller_name == 'dashboard'}" do %>
            <div class="mobile-nav-icon">
              <%= mobile_nav_icon("home", active: controller_name == 'dashboard') %>
            </div>
            <span class="mobile-nav-label"><%= t('navigation.home') %></span>
          <% end %>

          <%= link_to transactions_path, class: "mobile-nav-item #{'mobile-nav-item-active' if %w[transactions recurring_series].include?(controller_name)}" do %>
            <div class="mobile-nav-icon">
              <%= mobile_nav_icon("receipt", active: %w[transactions recurring_series].include?(controller_name)) %>
            </div>
            <span class="mobile-nav-label"><%= t('navigation.activity') %></span>
          <% end %>

          <% if content_for?(:hide_fab) %>
            <div class="mobile-nav-fab-spacer" aria-hidden="true"></div>
          <% else %>
            <div class="mobile-nav-fab-item">
              <%= link_to new_transaction_path,
                    class: "mobile-nav-fab-button",
                    data: {
                      turbo_frame: "_top",
                      fab_speed_dial_target: "fabLink",
                      action: "pointerdown->fab-speed-dial#pointerDown pointerup->fab-speed-dial#pointerUp pointerleave->fab-speed-dial#pointerLeave contextmenu->fab-speed-dial#contextMenu click->fab-speed-dial#click"
                    } do %>
                <%= ionicon_svg("add", variant: "outline", css_class: "w-7 h-7 text-white") %>
              <% end %>
            </div>
          <% end %>

          <%= link_to bank_accounts_path, class: "mobile-nav-item #{'mobile-nav-item-active' if controller_name == 'bank_accounts'}" do %>
            <div class="mobile-nav-icon">
              <%= mobile_nav_icon("wallet", active: controller_name == 'bank_accounts') %>
            </div>
            <span class="mobile-nav-label"><%= t('navigation.accounts') %></span>
          <% end %>

          <%= link_to finances_path, class: "mobile-nav-item #{'mobile-nav-item-active' if finances_nav_active?}" do %>
            <div class="mobile-nav-icon">
              <%= mobile_nav_icon("trending-up", active: finances_nav_active?) %>
            </div>
            <span class="mobile-nav-label"><%= t('navigation.finances') %></span>
          <% end %>
        </nav>
      </div>
      <% end %>
    </div>

    <%= render "shared/profile_sheet" %>

    <%# Global VITTBOT AI FAB — hidden on /assistant via content_for(:hide_vittbot_fab) %>
    <% if current_user && !content_for?(:hide_vittbot_fab) %>
      <%= render "shared/vittbot_fab" %>
    <% end %>
  </body>
</html>
