<tr id="category-rule-<%= rule.id %>"
    class="hover:bg-slate-50 transition-colors"
    data-controller="rule-row"
    data-rule-row-url-value="<%= category_rule_path(rule) %>"
    data-rule-row-original-pattern-value="<%= rule.pattern %>"
    data-rule-row-original-match-type-value="<%= rule.match_type %>"
    data-rule-row-original-category-id-value="<%= rule.category_id %>">

  <!-- Pattern (click to edit) -->
  <td class="px-4 py-3 cursor-text group/pattern" data-action="click->rule-row#activatePattern">
    <div class="flex items-center space-x-2">
      <code class="text-sm text-slate-800 bg-slate-100 px-2 py-0.5 rounded font-mono group-hover/pattern:ring-1 group-hover/pattern:ring-blue-300 transition-shadow"
            data-rule-row-target="patternDisplay">
        <%= rule.pattern %>
      </code>
      <input type="text"
             class="hidden w-full px-2 py-0.5 border border-blue-500 rounded text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-500"
             data-rule-row-target="patternInput"
             data-action="input->rule-row#checkDirty keydown.esc->rule-row#cancel"
             required>
      <% if rule.auto_generated? %>
        <span class="text-xs text-slate-400 flex-shrink-0" title="<%= t('category_rules.auto_generated') %>">
          <svg class="w-3.5 h-3.5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </span>
      <% end %>
    </div>
  </td>

  <!-- Match type (click to edit) -->
  <td class="px-4 py-3 cursor-pointer" data-action="click->rule-row#activateMatch">
    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium transition-shadow hover:ring-1 hover:ring-blue-300
                 <%= case rule.match_type
                     when 'exact' then 'bg-purple-100 text-purple-700'
                     when 'contains' then 'bg-blue-100 text-blue-700'
                     when 'starts_with' then 'bg-green-100 text-green-700'
                     end %>"
          data-rule-row-target="matchDisplay">
      <%= t("category_rules.match_types.#{rule.match_type}") %>
    </span>
    <select class="hidden w-full px-2 py-1 border border-blue-500 rounded text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-rule-row-target="matchSelect"
            data-action="change->rule-row#checkDirty keydown.esc->rule-row#cancel">
      <option value="contains" <%= "selected" if rule.match_type == "contains" %>><%= t("category_rules.match_types.contains") %></option>
      <option value="exact" <%= "selected" if rule.match_type == "exact" %>><%= t("category_rules.match_types.exact") %></option>
      <option value="starts_with" <%= "selected" if rule.match_type == "starts_with" %>><%= t("category_rules.match_types.starts_with") %></option>
    </select>
  </td>

  <!-- Category (click to edit) -->
  <td class="px-4 py-3 cursor-pointer" data-action="click->rule-row#activateCategory">
    <span class="text-sm text-slate-700 hover:underline hover:decoration-blue-400 decoration-dotted"
          data-rule-row-target="categoryDisplay">
      <%= rule.category.name %>
      <% if rule.category.parent %>
        <span class="text-xs text-slate-500">(<%= rule.category.parent.name %>)</span>
      <% end %>
    </span>
    <select class="hidden w-full px-2 py-1 border border-blue-500 rounded text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-rule-row-target="categorySelect"
            data-action="change->rule-row#checkDirty keydown.esc->rule-row#cancel">
      <%= grouped_options_for_select(
        categories.map { |parent| [parent.name, parent.children.map { |c| [c.name, c.id] }.unshift([parent.name, parent.id])] },
        rule.category_id
      ) %>
    </select>
  </td>

  <!-- Hits -->
  <td class="px-4 py-3 text-center">
    <span class="text-sm text-slate-600 font-medium"><%= rule.hits_count %></span>
  </td>

  <!-- Active toggle -->
  <td class="px-4 py-3 text-center">
    <div data-controller="toggle-active" data-toggle-active-url-value="<%= category_rule_path(rule) %>">
      <label class="relative inline-flex items-center cursor-pointer">
        <input type="checkbox"
               class="sr-only peer"
               <%= "checked" if rule.active? %>
               data-action="change->toggle-active#toggle"
               data-toggle-active-target="checkbox">
        <div class="w-9 h-5 bg-slate-200 peer-focus:ring-2 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-blue-600"></div>
      </label>
    </div>
  </td>

  <!-- Actions -->
  <td class="px-4 py-3 text-right">
    <div class="flex items-center justify-end gap-1">
      <button type="button"
              class="hidden p-1.5 text-green-600 hover:bg-green-50 rounded-lg transition-colors"
              data-rule-row-target="saveBtn"
              data-action="click->rule-row#save"
              title="<%= t('form_actions.save') %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
      </button>
      <button type="button"
              class="hidden p-1.5 text-slate-500 hover:bg-slate-100 rounded-lg transition-colors"
              data-rule-row-target="cancelBtn"
              data-action="click->rule-row#cancel"
              title="<%= t('form_actions.cancel') %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
      <%= button_to category_rule_path(rule), method: :delete,
          class: "p-1.5 text-red-500 hover:bg-red-50 rounded-lg transition-colors",
          data: { turbo_confirm: t("category_rules.delete_confirm") } do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
        </svg>
      <% end %>
    </div>
  </td>
</tr>
