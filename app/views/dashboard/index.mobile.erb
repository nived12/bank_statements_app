<!-- MOBILE DASHBOARD: Optimized for mobile devices -->
<div class="mobile-dashboard mobile-performance-optimized mobile-touch-optimized"
     data-controller="mobile-dashboard mobile-performance mobile-touch"
     data-mobile-dashboard-is-mobile-value="true"
     data-mobile-performance-enable-lazy-loading-value="true"
     data-mobile-performance-enable-image-optimization-value="true"
     data-mobile-performance-enable-chart-optimization-value="true"
     data-mobile-performance-enable-preloading-value="true">
  
  <!-- MOBILE HEADER: Balance Overview -->
  <section class="mobile-balance-section">
    <div class="mobile-balance-card">
      <div class="mobile-balance-header">
        <h1 class="mobile-balance-title"><%= t('mobile.dashboard.total_balance') %></h1>
        <div class="mobile-balance-amount">
          <%= format_currency(@total_balance) %>
        </div>
        <p class="mobile-balance-subtitle">
          <%= t('mobile.dashboard.across_accounts', count: @bank_accounts.count) %>
        </p>
      </div>
      
      <!-- Quick Stats Row -->
      <div class="mobile-stats-row">
        <div class="mobile-stat-item">
          <span class="mobile-stat-label"><%= t('mobile.dashboard.income') %></span>
          <span class="mobile-stat-value mobile-stat-income">
            <%= format_currency(@monthly_summary[:income] || 0) %>
          </span>
        </div>
        <div class="mobile-stat-item">
          <span class="mobile-stat-label"><%= t('mobile.dashboard.expenses') %></span>
          <span class="mobile-stat-value mobile-stat-expenses">
            <%= format_currency(@monthly_summary[:expenses] || 0) %>
          </span>
        </div>
        <div class="mobile-stat-item">
          <span class="mobile-stat-label"><%= t('mobile.dashboard.net') %></span>
          <span class="mobile-stat-value <%= (@monthly_summary[:net] || 0) >= 0 ? 'mobile-stat-positive' : 'mobile-stat-negative' %>">
            <%= format_currency(@monthly_summary[:net] || 0) %>
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- MOBILE NAVIGATION TABS -->
  <nav class="mobile-tabs">
    <button class="mobile-tab mobile-tab-active" data-mobile-dashboard-target="tab" data-tab="overview">
      <%= t('mobile.dashboard.overview') %>
    </button>
    <button class="mobile-tab" data-mobile-dashboard-target="tab" data-tab="transactions">
      <%= t('mobile.dashboard.transactions') %>
    </button>
    <button class="mobile-tab" data-mobile-dashboard-target="tab" data-tab="categories">
      <%= t('mobile.dashboard.categories') %>
    </button>
  </nav>

  <!-- OVERVIEW TAB -->
  <div class="mobile-tab-content mobile-tab-content-active" data-mobile-dashboard-target="content" data-content="overview">
    
    <!-- Account Balances -->
    <section class="mobile-section">
      <h2 class="mobile-section-title"><%= t('mobile.dashboard.accounts') %></h2>
      <div class="mobile-accounts-list">
        <% @bank_summaries.each do |summary| %>
          <div class="mobile-account-card">
            <div class="mobile-account-info">
              <h3 class="mobile-account-name"><%= summary[:account].bank_display_name %></h3>
              <p class="mobile-account-number">••••<%= summary[:account].account_number.last(4) %></p>
            </div>
            <div class="mobile-account-balance">
              <%= format_currency(summary[:balance]) %>
            </div>
          </div>
        <% end %>
      </div>
    </section>

    <!-- Top Categories -->
    <% if @category_summary&.any? %>
      <section class="mobile-section">
        <h2 class="mobile-section-title"><%= t('mobile.dashboard.top_categories') %></h2>
        <div class="mobile-categories-list">
          <% @category_summary.first(5).each_with_index do |category, index| %>
            <div class="mobile-category-item">
              <div class="mobile-category-rank">#<%= index + 1 %></div>
              <div class="mobile-category-info">
                <h4 class="mobile-category-name"><%= category[0] %></h4>
                <div class="mobile-category-amount"><%= format_currency(category[1].abs) %></div>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <!-- Spending Chart (Mobile Optimized) -->
    <% if @spending_trends&.any? %>
      <section class="mobile-section">
        <h2 class="mobile-section-title"><%= t('mobile.dashboard.spending_trends') %></h2>
        <div class="mobile-chart-container">
          <canvas data-mobile-dashboard-target="spendingChart" width="300" height="200"></canvas>
        </div>
      </section>
    <% end %>

    <!-- Balance Chart (Mobile Optimized) -->
    <% if @bank_summaries&.any? %>
      <section class="mobile-section">
        <h2 class="mobile-section-title"><%= t('mobile.dashboard.balance_by_account') %></h2>
        <div class="mobile-chart-container">
          <canvas data-mobile-dashboard-target="balanceChart" width="300" height="200"></canvas>
        </div>
      </section>
    <% end %>
  </div>

  <!-- TRANSACTIONS TAB -->
  <div class="mobile-tab-content" data-mobile-dashboard-target="content" data-content="transactions">
    <section class="mobile-section">
      <div class="mobile-section-header">
        <h2 class="mobile-section-title"><%= t('mobile.dashboard.recent_transactions') %></h2>
        <%= link_to transactions_path, class: "mobile-section-link" do %>
          <%= t('mobile.dashboard.view_all') %>
        <% end %>
      </div>
      
      <% if @recent_transactions&.any? %>
        <div class="mobile-transactions-list">
          <% @recent_transactions.first(10).each do |transaction| %>
            <div class="mobile-transaction-item">
              <div class="mobile-transaction-info">
                <h4 class="mobile-transaction-description">
                  <%= short_description(transaction.description) %>
                </h4>
                <p class="mobile-transaction-meta">
                  <%= format_local_time(transaction.date, format: 'date') %> • 
                  <%= transaction.bank_account.custom_name %>
                </p>
                <% if transaction.category %>
                  <span class="mobile-transaction-category">
                    <%= transaction.category.name %>
                  </span>
                <% end %>
              </div>
              <div class="mobile-transaction-amount <%= transaction.amount.positive? ? 'mobile-amount-income' : 'mobile-amount-expense' %>">
                <%= format_currency(transaction.amount) %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="mobile-empty-state">
          <svg class="mobile-empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
          <h3 class="mobile-empty-title"><%= t('mobile.dashboard.no_transactions') %></h3>
          <p class="mobile-empty-description"><%= t('mobile.dashboard.upload_statements_help') %></p>
        </div>
      <% end %>
    </section>
  </div>

  <!-- CATEGORIES TAB -->
  <div class="mobile-tab-content" data-mobile-dashboard-target="content" data-content="categories">
    <section class="mobile-section">
      <div class="mobile-section-header">
        <h2 class="mobile-section-title"><%= t('mobile.dashboard.categories') %></h2>
        <%= link_to categories_path, class: "mobile-section-link" do %>
          <%= t('mobile.dashboard.manage') %>
        <% end %>
      </div>
      
      <% if @category_summary&.any? %>
        <div class="mobile-categories-chart">
          <canvas data-mobile-dashboard-target="categoryChart" width="300" height="200"></canvas>
        </div>
      <% else %>
        <div class="mobile-empty-state">
          <svg class="mobile-empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
          </svg>
          <h3 class="mobile-empty-title"><%= t('mobile.dashboard.no_categories') %></h3>
          <p class="mobile-empty-description"><%= t('mobile.dashboard.create_categories_help') %></p>
        </div>
      <% end %>
    </section>
  </div>

</main>

<!-- Hidden data for JavaScript -->
<input type="hidden" id="mobile-spending-data" value="<%= (@spending_trends || []).to_json %>">
<input type="hidden" id="mobile-category-data" value="<%= (@category_summary || []).to_json %>">
<input type="hidden" id="mobile-balance-data" value="<%= (@bank_summaries&.map { |s| { name: s[:account].bank_display_name, balance: s[:balance] } } || []).to_json %>">

<!-- Stimulus Data Values -->
<div data-mobile-dashboard-spending-data-value="<%= (@spending_trends || []).to_json %>" style="display: none;"></div>
<div data-mobile-dashboard-category-data-value="<%= (@category_summary || []).to_json %>" style="display: none;"></div>
<div data-mobile-dashboard-balance-data-value="<%= (@bank_summaries&.map { |s| { name: s[:account].bank_display_name, balance: s[:balance] } } || []).to_json %>" style="display: none;"></div>

</div> <!-- Close mobile-dashboard -->
