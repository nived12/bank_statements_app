<%= form_with model: category,
    url: category.persisted? ? category_path(category) : categories_path,
    method: category.persisted? ? :patch : :post,
    html: { id: local_assigns[:form_id] }.compact,
    class: "space-y-6",
    data: { category_form_target: "form" } do |f| %>

  <!-- Category Name with Icon -->
  <div data-controller="icon-picker"
       data-icon-picker-selected-value="<%= category.icon || 'tag' %>"
       data-action="icon-picker:changed->category-form#iconChanged">
    <%= f.hidden_field :icon,
        data: {
          icon_picker_target: "input",
          category_form_target: "iconInput"
        },
        value: category.icon || 'tag' %>

    <%= required_field_label(f, :name, t('categories.name')) %>

    <div class="flex items-center space-x-3 mb-3">
      <!-- Icon Button (click to show picker) -->
      <button type="button"
              data-action="click->icon-picker#togglePicker"
              data-icon-picker-target="iconDisplay"
              class="w-12 h-12 bg-indigo-50 dark:bg-indigo-900/20 rounded-lg flex items-center justify-center border-2 border-indigo-200 dark:border-indigo-800 hover:border-indigo-400 transition-colors flex-shrink-0">
        <%= icon_svg(category.icon || 'tag', css_classes: "w-6 h-6 text-indigo-600 dark:text-indigo-400") %>
      </button>

      <!-- Name Input -->
      <%= f.text_field :name,
          data: {
            category_form_target: "nameInput",
            action: "input->category-form#checkChanges"
          },
          class: "flex-1 px-4 py-2.5 border #{category.errors[:name].any? ? 'border-red-500' : 'border-slate-200 dark:border-slate-700'} rounded-xl text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 focus:ring-2 focus:ring-indigo-500 focus:bg-white dark:bg-slate-800 dark:focus:bg-slate-800 transition-colors",
          placeholder: t('categories.name_placeholder'),
          required: true %>
    </div>

    <% if category.errors[:name].any? %>
      <p class="text-sm text-red-600 mt-1"><%= category.errors[:name].first %></p>
    <% else %>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1"><%= t('categories.name_help') %></p>
    <% end %>

    <!-- Icon Picker (hidden by default) -->
    <div data-icon-picker-target="pickerContainer" class="hidden mb-4">
      <%= render 'icon_picker_grid', category: category %>
    </div>
  </div>

  <!-- Parent Category (for subcategories) -->
  <% if params[:parent_id].present? %>
    <%= f.hidden_field :parent_id, value: params[:parent_id] %>
  <% end %>

  <!-- Desktop: Text buttons (mobile buttons in page header) -->
  <div class="hidden md:flex items-center justify-end space-x-3 pt-6 border-t border-slate-200 dark:border-slate-700">
    <%= link_to (category.parent_id.present? ? category_path(category.parent) : categories_path), class: "px-6 py-2 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 rounded-lg font-medium hover:bg-slate-50 dark:hover:bg-slate-700 dark:bg-slate-900 transition-colors inline-flex items-center" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      <%= t('form_actions.cancel') %>
    <% end %>

    <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition-colors inline-flex items-center">
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
      <%= category.persisted? ? t('form_actions.save_changes') : t('categories.create') %>
    </button>
  </div>
<% end %>
