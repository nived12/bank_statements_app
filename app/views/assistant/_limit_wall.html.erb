<%#
  Limit wall — shown inside the Vittbot FAB panel when the user has a
  subscription (trial or paid) but has exhausted their AI quota for the
  current period. Mirrors mobile `limitWall` (assistant.tsx:599-616).
%>
<% is_trial = current_user.active_trial? && !current_user.active_paid_subscription? %>
<div class="flex-1 flex flex-col items-center justify-center px-8 py-10 text-center gap-3 bg-gradient-to-br from-indigo-500 to-purple-600 text-white">
  <%= icon("bot-message-square", library: "lucide", variant: "outline", class: "w-12 h-12 opacity-90 mb-2") %>
  <h3 class="text-xl font-semibold leading-snug">
    <%= t("assistant.limit.title") %>
  </h3>
  <p class="text-sm text-indigo-100 max-w-xs">
    <%= is_trial ? t("assistant.limit.subtitle_trial") : t("assistant.limit.subtitle_premium") %>
  </p>
  <%= link_to (is_trial ? t("assistant.limit.cta_trial") : t("assistant.limit.cta_premium")),
        is_trial ? pricing_path : subscription_path,
        class: "mt-4 inline-flex items-center justify-center px-6 py-2.5 rounded-full bg-white text-indigo-600 text-sm font-semibold hover:bg-indigo-50 transition-colors",
        data: { turbo_frame: "_top" } %>
</div>
