<turbo-frame id="subcategory-modal">
  <div class="fixed inset-0 bg-black bg-opacity-50 z-[10001] flex items-end justify-center md:items-center">
    <div class="bg-white w-full max-w-md rounded-t-2xl md:rounded-2xl shadow-xl"
         data-controller="category-form">

      <%= form_with model: category,
          url: category.persisted? ? category_path(category) : categories_path,
          method: category.persisted? ? :patch : :post,
          data: { turbo_frame: "_top" },
          class: "space-y-0" do |f| %>

        <!-- Header -->
        <div class="flex items-center justify-between p-4 border-b border-slate-200">
          <h2 class="text-lg font-semibold text-slate-900">
            <%= t('mobile.categories.subcategory') %>
            <% if category.persisted? %>
              <span class="text-sm font-normal text-slate-500 ml-2">• <%= category.transactions.count %> <%= category.transactions.count == 1 ? t('mobile.transactions.transaction') : t('mobile.transactions.transactions') %></span>
            <% end %>
          </h2>
          <div class="flex items-center space-x-2">
            <!-- Checkmark Submit Button -->
            <button type="button"
                    data-category-form-target="submitButton"
                    data-action="click->category-form#submit"
                    disabled
                    class="flex items-center justify-center p-2 text-slate-400 opacity-50 cursor-not-allowed rounded-lg transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
              </svg>
            </button>

            <!-- Close Button -->
            <button type="button"
                    onclick="Turbo.visit('<%= category.parent_id ? category_path(category.parent_id) : (params[:parent_id] ? category_path(params[:parent_id]) : categories_path) %>')"
                    class="p-2 hover:bg-slate-100 rounded-lg transition-colors">
              <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Form Content -->
        <div class="p-4 space-y-4">

          <!-- Error Messages -->
          <% if category.errors.any? %>
            <div class="p-3 bg-red-50 border border-red-200 rounded-lg">
              <p class="text-sm font-medium text-red-800 mb-1"><%= t('errors.form_errors') %></p>
              <ul class="text-sm text-red-700 list-disc list-inside">
                <% category.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <!-- Subcategory Name with Icon -->
          <div data-controller="icon-picker"
               data-icon-picker-selected-value="<%= category.icon || 'tag' %>"
               data-action="icon-picker:changed->category-form#iconChanged">
            <%= f.hidden_field :icon,
                data: {
                  icon_picker_target: "input",
                  category_form_target: "iconInput"
                },
                value: category.icon || 'tag' %>

            <%= f.label :name, t('mobile.categories.subcategory_name'), class: "block text-sm font-medium text-slate-700 mb-2" %>

            <div class="flex items-center space-x-3 mb-3">
              <!-- Icon Button (click to show picker) -->
              <button type="button"
                      data-action="click->icon-picker#togglePicker"
                      data-icon-picker-target="iconDisplay"
                      class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center border-2 border-blue-200 hover:border-blue-400 transition-colors flex-shrink-0">
                <%= category_icon_svg(category.icon, css_classes: "w-6 h-6 text-blue-600") %>
              </button>

              <!-- Name Input -->
              <%= f.text_field :name,
                  data: {
                    category_form_target: "nameInput",
                    action: "input->category-form#checkChanges"
                  },
                  class: "flex-1 px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
                  placeholder: t('mobile.categories.subcategory_name_placeholder'),
                  required: true %>
            </div>

            <!-- Icon Picker (hidden by default) -->
            <div data-icon-picker-target="pickerContainer" class="hidden mb-4">
              <%= render 'icon_picker_grid', category: category %>
            </div>
          </div>

          <!-- Parent Category (hidden field) -->
          <%= f.hidden_field :parent_id, value: category.parent_id || params[:parent_id] %>

        </div><!-- End Form Content -->
      <% end %><!-- End Form -->

      <!-- Delete Button (if editing) - Outside form to prevent conflicts -->
      <% if category.persisted? %>
        <%
          transactions_count = category.transactions.count
          confirm_message = if transactions_count > 0
            t('categories.delete_confirm_with_transactions', name: category.name, count: transactions_count)
          else
            t('categories.delete_confirm', name: category.name)
          end
        %>
        <div class="p-4 pt-0">
          <%= button_to category_path(category),
              method: :delete,
              form: {
                data: {
                  turbo_confirm: confirm_message,
                  turbo_frame: "_top"
                }
              },
              class: "w-full px-4 py-2 border border-red-300 text-red-600 rounded-lg font-medium hover:bg-red-50 transition-colors flex items-center justify-center space-x-2" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
            <span><%= t('mobile.categories.delete_subcategory') %></span>
          <% end %>
        </div>
      <% end %>

    </div><!-- End Modal Container -->
  </div><!-- End Modal Backdrop -->
</turbo-frame>
