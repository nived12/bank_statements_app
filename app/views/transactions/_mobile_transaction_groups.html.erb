<%
  # Group transactions by date
  transactions_by_date = transactions.group_by(&:date)
%>
<% transactions_by_date.each do |date, transactions_for_date| %>
  <div class="mobile-date-group">
    <!-- Date Header -->
    <div class="mobile-date-header" onclick="toggleDateGroup('<%= date.strftime('%Y-%m-%d') %>')">
      <div class="mobile-date-info">
        <h3 class="mobile-date-title">
          <%= date == Date.current ? t('mobile.transactions.today') :
              date == Date.current - 1.day ? t('mobile.transactions.yesterday') :
              I18n.l(date, format: '%B %d, %Y') %>
        </h3>
        <span class="mobile-date-count"><%= transactions_for_date.count %> <%= transactions_for_date.count == 1 ? t('mobile.transactions.transaction').downcase : t('mobile.transactions.transactions').downcase %></span>
      </div>
      <div class="mobile-date-total">
        <% day_total = transactions_for_date.sum(&:amount) %>
        <span class="mobile-date-total-amount <%= day_total >= 0 ? 'text-green-600' : 'text-red-600' %>">
          <%= day_total >= 0 ? '+' : '-' %>$<%= number_with_precision(day_total.abs, precision: 2, delimiter: ',') %>
        </span>
        <svg class="mobile-date-chevron h-5 w-5 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </div>
    </div>

    <!-- Transactions for this date -->
    <div class="mobile-date-transactions" id="transactions-<%= date.strftime('%Y-%m-%d') %>">
      <% transactions_for_date.each do |transaction| %>
        <div class="mobile-transaction-card"
             data-controller="row-link"
             data-row-link-url-value="<%= edit_transaction_path(transaction) %>"
             data-action="click->row-link#visit">

          <!-- Description at top level for better text display -->
          <div class="mobile-transaction-description">
            <%= display_concept(transaction) %>
          </div>

          <div class="mobile-transaction-main">
            <div class="mobile-transaction-content">
              <div class="mobile-transaction-details">
                <%= render partial: "transactions/inline_category_mobile", locals: { transaction: transaction, categories: @categories || [] } %>
              </div>
            </div>

            <div class="mobile-transaction-amount">
              <span class="mobile-amount-value <%= (transaction.transaction_type == 'income' || transaction.transaction_type == 'transfer_in') ? 'text-green-600' : 'text-red-600' %>">
                <%= transaction.amount >= 0 ? '+' : '-' %>$<%= number_with_precision(transaction.amount.abs, precision: 2, delimiter: ',') %>
              </span>
            </div>
          </div>

          <!-- Meta information including bank account name -->
          <div class="mobile-transaction-meta">
            <% if transaction.bank_account&.custom_name.present? %>
              <span class="mobile-meta-item">🏦 <%= transaction.bank_account.custom_name %></span>
            <% elsif transaction.bank_account %>
              <span class="mobile-meta-item">🏦 <%= transaction.bank_account.bank_display_name %> - ••••<%= transaction.bank_account.account_number&.last(4) %></span>
            <% end %>
            <% if transaction.merchant.present? %>
              <span class="mobile-meta-item">📍 <%= transaction.merchant %></span>
            <% end %>
            <% if transaction.reference.present? %>
              <span class="mobile-meta-item">#<%= transaction.reference %></span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

