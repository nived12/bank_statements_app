<div class="desktop-top-nav h-20 w-full flex items-center justify-between" data-controller="desktop-top-nav">
  <!-- Logo -->
  <div class="flex items-center justify-center md:flex md:w-56 md:flex-col md:inset-y-0 min-w-56">
    <a href="<%= root_path %>" class="hover:opacity-80 transition-opacity">
      <img src="/vittio1.png" alt="Vittio" class="h-8 w-auto">
    </a>
  </div>

  <!-- Notifications -->
  <div class="flex items-center space-x-2">
    <%= icon("bell", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
    <%= render 'common/language_switcher' %>
    <!-- User Section -->
    <% if current_user %>
      <div class="flex items-center w-full">
        <img src="<%= current_user.avatar_url %>?t=<%= Time.current.to_i %>"
              alt="<%= current_user.full_name %>"
              class="w-8 h-8 rounded-full object-cover">
        <div class="flex items-center space-x-2 ml-3">
          <p class="text-sm font-medium text-slate-900 truncate"><%= current_user.full_name %></p>
          <form action="/session" method="post" class="inline">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <input type="hidden" name="_method" value="delete" />
            <button type="submit" class="p-1 text-slate-500 hover:text-slate-700 transition-colors" title="<%= t('session.sign_out') %>">
              <%= icon("log-out", library: "lucide", variant: "outline", class: "w-4 h-4") %>
            </button>
          </form>
        </div>
      </div>
    <% end %>
  </div>
</div>