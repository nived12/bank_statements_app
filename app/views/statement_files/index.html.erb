<!-- STATEMENT FILES INDEX PAGE: All Statement Files -->
<main class="statement-files-page">
  <div class="statement-files-container">
    
    <!-- HEADER SECTION -->
    <header class="statement-files-header">
      <div class="statement-files-header-content">
        <h1 class="statement-files-header-title"><%= t('statement_files.overview') %></h1>
        <p class="statement-files-header-subtitle"><%= t('dashboard.manage_your_bank_statements') %></p>
      </div>
      <div class="statement-files-header-actions">
        <a href="/statement_files/new" class="statement-files-upload-button">
          <svg class="statement-files-upload-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <%= t('quick_actions.upload_statement') %>
        </a>
      </div>
    </header>

    <!-- STATEMENT FILES LIST -->
    <% if @statement_files.any? %>
      <div class="statement-files-grid">
        <% @statement_files.each do |statement_file| %>
          <div class="statement-file-card">
            <div class="statement-file-content">
              <div class="statement-file-icon">
                <svg class="statement-file-icon-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
              </div>
              
              <div class="statement-file-info">
                <h4 class="statement-file-name"><%= statement_file.file.filename.to_s %></h4>
                <p class="statement-file-details">
                  <%= statement_file.bank_account.bank.name %> • 
                  <%= statement_file.created_at.strftime("%b %d, %Y") %> • 
                  <%= statement_file.transactions.count %> <%= t('table_headers.transactions') %>
                </p>
                <p class="statement-file-status">
                  <%= t('dashboard.status') %>: 
                  <span class="<%= statement_file.status == 'processed' ? 'text-green-600' : statement_file.status == 'error' ? 'text-red-600' : 'text-yellow-600' %>">
                    <%= statement_file.status.humanize %>
                  </span>
                </p>
              </div>
              
              <div class="statement-file-actions">
                <a href="/statement_files/<%= statement_file.id %>" class="statement-file-view-btn" title="<%= t('dashboard.view_statement') %>">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                </a>
                
                <% if statement_file.status == 'error' %>
                  <button class="statement-file-retry-btn" 
                          data-controller="statement-retry"
                          data-statement-id="<%= statement_file.id %>"
                          title="<%= t('statement_file_status.retry_processing') %>">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                  </button>
                <% end %>
                
                <%= button_to statement_file_path(statement_file), 
                            method: :delete,
                            class: "statement-file-delete-btn",
                            data: { 
                              confirm: t('delete_statement_confirmation', count: statement_file.transactions.count),
                              turbo_method: :delete
                            },
                            title: t('dashboard.delete_statement') do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="statement-files-empty">
        <svg class="statement-files-empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <h3 class="statement-files-empty-title"><%= t('dashboard.no_statement_files_yet') %></h3>
        <p class="statement-files-empty-description"><%= t('dashboard.upload_your_first_statement') %></p>
        <a href="/statement_files/new" class="statement-files-empty-action">
          <%= t('quick_actions.upload_statement') %>
        </a>
      </div>
    <% end %>
  </div>
</main>
