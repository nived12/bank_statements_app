<!-- DASHBOARD PAGE: Financial Overview -->
<main class="dashboard-page" data-controller="dashboard-charts">
  
  <!-- HIDDEN DATA: Chart Data for JavaScript -->
  <input type="hidden" id="spending-data" value="<%= (@chart_data[:spending_trends] || []).to_json %>">
  <input type="hidden" id="category-data" value="<%= (@chart_data[:category_summary] || []).to_json %>">
  <input type="hidden" id="balance-data" value="<%= (@chart_data[:bank_summaries] || []).to_json %>">
  
  <!-- HIDDEN TRANSLATIONS: Chart Labels for JavaScript -->
  <input type="hidden" id="translations" value="<%= {
        account_balances: t('account_balances.title'),
        spending_by_category: t('spending_trends.by_category'),
        monthly_spending: t('spending_trends.title')
  }.to_json %>">

  <!-- HEADER SECTION: Dashboard Header with Navigation -->
  <header class="dashboard-header">
    <div class="dashboard-header-container">
      <div class="dashboard-header-content">
        
        <!-- HEADER LEFT: Brand and Title -->
        <div class="dashboard-header-left">
          <div class="dashboard-header-brand">
            <div class="dashboard-header-logo">
              <svg class="dashboard-header-logo-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
              </svg>
            </div>
            <div>
                      <h1 class="dashboard-header-title"><%= t('dashboard.title') %></h1>
        <p class="dashboard-header-subtitle"><%= t('dashboard.welcome_back') %>, <%= current_user.full_name %></p>
            </div>
          </div>
        </div>
        
        <!-- HEADER RIGHT: Month Picker and Upload Button -->
        <div class="dashboard-header-right">
          <div class="dashboard-month-picker">
            <label for="month-selector" class="dashboard-month-picker-label"><%= t('dashboard.select_month') %></label>

            <div class="dashboard-month-controls">
              <div class="dashboard-month-navigation">
                <button type="button" onclick="previousMonth()" class="dashboard-nav-btn" title="<%= t('month_picker.previous_month') %>">
                  <svg class="dashboard-nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                  </svg>
                </button>
                <button type="button" onclick="nextMonth()" class="dashboard-nav-btn" title="<%= t('month_picker.next_month') %>">
                  <svg class="dashboard-nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </button>
              </div>
              <select id="month-selector" class="dashboard-month-selector" onchange="changeMonth(this.value)">
                <% if @available_months && @available_months.any? %>
                  <% @available_months.each do |month| %>
                    <option value="<%= month.strftime('%Y-%m') %>" 
                            <%= 'selected' if month.strftime('%Y-%m') == @selected_month.strftime('%Y-%m') %>>
                      <%= l(month, format: :month_year) %>
                    </option>
                  <% end %>
                <% else %>
                  <option value="<%= Date.current.strftime('%Y-%m') %>" selected>
                    <%= l(Date.current, format: :month_year) %>
                  </option>
                <% end %>
              </select>
              <button type="button" onclick="jumpToCurrentMonth()" class="dashboard-current-month-btn" title="<%= t('month_picker.jump_to_current_month') %>">
                <svg class="dashboard-current-month-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                </svg>
              </button>
            </div>
          </div>
          <div class="dashboard-header-divider"></div>
          <a href="/statement_files/new" class="dashboard-header-upload-button">
            <svg class="dashboard-header-upload-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <%= t('quick_actions.upload_statement') %>
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- MAIN CONTENT: Dashboard Content Area -->
  <div class="dashboard-main">
    
    <!-- ERROR DISPLAY: Error Messages -->
    <% if @error %>
      <div class="dashboard-error">
        <div class="dashboard-error-content">
          <div class="dashboard-error-icon">
            <svg class="dashboard-error-icon-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
            </svg>
          </div>
          <div>
            <h3 class="dashboard-error-text"><%= t('flash.dashboard_error') %></h3>
            <p class="dashboard-error-description"><%= @error %></p>
          </div>
        </div>
      </div>
    <% end %>

    <!-- TOTAL BALANCE CARD: Portfolio Balance Overview -->
    <section class="dashboard-balance-section">
      <div class="dashboard-balance-card">
        <div class="dashboard-balance-content">
          <div>
            <h2 class="dashboard-balance-left"><%= t('dashboard.total_portfolio_balance') %></h2>
            <div class="dashboard-balance-amount">
              <%= format_currency(@total_balance) %>
            </div>
            <p class="dashboard-balance-subtitle">
              <%= t('dashboard.across_accounts', count: @bank_accounts.count) %>
            </p>
          </div>
          <div class="dashboard-balance-right">
            <div class="dashboard-balance-icon-container">
              <svg class="dashboard-balance-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- MONTHLY SUMMARY CARDS: Income, Expenses, Net Flow -->
    <section class="dashboard-metrics-grid">
      
      <!-- INCOME METRIC CARD -->
      <div class="dashboard-metric-card">
        <div class="dashboard-metric-content">
          <div>
            <p class="dashboard-metric-label"><%= t('monthly_summary.income') %></p>
            <% if @monthly_summary[:has_data] %>
              <p class="dashboard-metric-value dashboard-metric-value-income">
                <%= format_currency(@monthly_summary[:income]) %>
              </p>
              <p class="dashboard-metric-subtitle"><%= @monthly_summary[:count] %> <%= t('table_headers.transactions') %></p>
            <% else %>
              <p class="dashboard-metric-value dashboard-metric-value-no-data">
                <%= t('dashboard.no_data') %>
              </p>
              <p class="dashboard-metric-subtitle"><%= t('dashboard.no_transactions_this_month') %></p>
            <% end %>
          </div>
          <div class="dashboard-metric-icon dashboard-metric-icon-income">
            <svg class="dashboard-metric-icon-svg dashboard-metric-icon-svg-income" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11l5-5m0 0l5 5m-5-5v12"></path>
            </svg>
          </div>
        </div>
      </div>

      <!-- EXPENSES METRIC CARD -->
      <div class="dashboard-metric-card">
        <div class="dashboard-metric-content">
          <div>
            <p class="dashboard-metric-label"><%= t('monthly_summary.expenses') %></p>
            <% if @monthly_summary[:has_data] %>
              <p class="dashboard-metric-value dashboard-metric-value-expenses">
                <%= format_currency(@monthly_summary[:expenses]) %>
              </p>
              <p class="dashboard-metric-subtitle"><%= @monthly_summary[:count] %> <%= t('table_headers.transactions') %></p>
            <% else %>
              <p class="dashboard-metric-value dashboard-metric-value-no-data">
                <%= t('dashboard.no_data') %>
              </p>
              <p class="dashboard-metric-subtitle"><%= t('dashboard.no_transactions_this_month') %></p>
            <% end %>
          </div>
          <div class="dashboard-metric-icon dashboard-metric-icon-expenses">
            <svg class="dashboard-metric-icon-svg dashboard-metric-icon-svg-expenses" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 13l5-5m0 0l-5-5m5 5V6"></path>
            </svg>
          </div>
        </div>
      </div>

      <!-- NET FLOW METRIC CARD -->
      <div class="dashboard-metric-card">
        <div class="dashboard-metric-content">
          <div>
            <p class="dashboard-metric-label"><%= t('monthly_summary.net_flow') %></p>
            <% if @monthly_summary[:has_data] %>
              <p class="dashboard-metric-value <%= @monthly_summary[:net] >= 0 ? 'dashboard-metric-value-net' : 'dashboard-metric-value-net-negative' %>">
                <%= format_currency(@monthly_summary[:net]) %>
              </p>
              <p class="dashboard-metric-subtitle"><%= @monthly_summary[:net] >= 0 ? t('monthly_summary.positive_flow') : t('monthly_summary.negative_flow') %></p>
            <% else %>
              <p class="dashboard-metric-value dashboard-metric-value-no-data">
                <%= t('dashboard.no_data') %>
              </p>
              <p class="dashboard-metric-subtitle"><%= t('dashboard.no_transactions_this_month') %></p>
            <% end %>
          </div>
          <div class="dashboard-metric-icon <%= @monthly_summary[:has_data] && @monthly_summary[:net] >= 0 ? 'dashboard-metric-icon-net' : 'dashboard-metric-icon-net-negative' %>">
            <svg class="dashboard-metric-icon-svg <%= @monthly_summary[:has_data] && @monthly_summary[:net] >= 0 ? 'dashboard-metric-icon-svg-net' : 'dashboard-metric-icon-svg-net-negative' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
            </svg>
          </div>
        </div>
      </div>
    </section>

    <!-- OVERALL STATS CARDS: Total Transactions, Statements, Accounts -->
    <section class="dashboard-metrics-grid">
      
      <!-- TOTAL TRANSACTIONS CARD -->
      <a href="/transactions" class="dashboard-metric-card hover:shadow-lg transition-all duration-200 cursor-pointer">
        <div class="dashboard-metric-content">
          <div>
            <p class="dashboard-metric-label"><%= t('monthly_summary.total_transactions') %></p>
            <p class="dashboard-metric-value dashboard-metric-value-total">
              <%= @total_transactions %>
            </p>
            <p class="dashboard-metric-subtitle"><%= t('monthly_summary.across_all_accounts') %></p>
          </div>
          <div class="dashboard-metric-icon dashboard-metric-icon-total">
            <svg class="dashboard-metric-icon-svg dashboard-metric-icon-svg-total" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
        </div>
      </a>

      <!-- TOTAL STATEMENTS CARD -->
      <a href="/statement_files" class="dashboard-metric-card hover:shadow-lg transition-all duration-200 cursor-pointer">
        <div class="dashboard-metric-content">
          <div>
            <p class="dashboard-metric-label"><%= t('monthly_summary.total_statements') %></p>
            <p class="dashboard-metric-value dashboard-metric-value-statements">
              <%= @total_statements %>
            </p>
            <p class="dashboard-metric-subtitle"><%= t('monthly_summary.processed_files') %></p>
          </div>
          <div class="dashboard-metric-icon dashboard-metric-icon-statements">
            <svg class="dashboard-metric-icon-svg dashboard-metric-icon-svg-statements" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
        </div>
      </a>

      <!-- TOTAL ACCOUNTS CARD -->
      <a href="/bank_accounts" class="dashboard-metric-card hover:shadow-lg transition-all duration-200 cursor-pointer">
        <div class="dashboard-metric-content">
          <div>
            <p class="dashboard-metric-label"><%= t('monthly_summary.total_accounts') %></p>
            <p class="dashboard-metric-value dashboard-metric-value-accounts">
              <%= @bank_accounts.count %>
            </p>
            <p class="dashboard-metric-subtitle"><%= t('navigation.bank_accounts') %></p>
          </div>
          <div class="dashboard-metric-icon dashboard-metric-icon-accounts">
            <svg class="dashboard-metric-icon-svg dashboard-metric-icon-svg-accounts" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
            </svg>
          </div>
        </div>
      </a>
    </section>

    <!-- MONTHLY DETAILED STATS: Additional Insights for Selected Month -->
    <% if @monthly_stats && @monthly_stats[:has_data] %>
      <section class="dashboard-metrics-grid">
        
        <!-- MONTHLY TRANSACTIONS COUNT -->
        <div class="dashboard-metric-card">
          <div class="dashboard-metric-content">
            <div>
              <p class="dashboard-metric-label"><%= t('dashboard.monthly_transactions') %></p>
              <p class="dashboard-metric-value dashboard-metric-value-monthly">
                <%= @monthly_stats&.dig(:total_transactions) || 0 %>
              </p>
              <p class="dashboard-metric-subtitle">
                                  <%= @monthly_stats&.dig(:income_transactions) || 0 %> <%= t('transaction_types.income') %> •
                  <%= @monthly_stats&.dig(:expense_transactions) || 0 %> <%= t('transaction_types.expenses') %>
              </p>
            </div>
            <div class="dashboard-metric-icon dashboard-metric-icon-monthly">
              <svg class="dashboard-metric-icon-svg dashboard-metric-icon-svg-monthly" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
            </div>
          </div>
        </div>

        <!-- AVERAGE INCOME -->
        <div class="dashboard-metric-card">
          <div class="dashboard-metric-content">
            <div>
              <p class="dashboard-metric-label"><%= t('dashboard.average_income') %></p>
              <p class="dashboard-metric-value dashboard-metric-value-average">
                <%= format_currency(@monthly_stats&.dig(:average_income) || 0) %>
              </p>
              <p class="dashboard-metric-subtitle">
                                  <%= t('dashboard.largest') %>: <%= format_currency(@monthly_stats&.dig(:largest_income) || 0) %>
              </p>
            </div>
            <div class="dashboard-metric-icon dashboard-metric-icon-average">
              <svg class="dashboard-metric-icon-svg dashboard-metric-icon-svg-average" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11l5-5m0 0l5 5m-5-5v12"></path>
              </svg>
            </div>
          </div>
        </div>

        <!-- AVERAGE EXPENSE -->
        <div class="dashboard-metric-card">
          <div class="dashboard-metric-content">
            <div>
              <p class="dashboard-metric-label"><%= t('dashboard.average_expense') %></p>
              <p class="dashboard-metric-value dashboard-metric-value-average-expense">
                <%= format_currency(@monthly_stats&.dig(:average_expense) || 0) %>
              </p>
            <p class="dashboard-metric-subtitle">
                                <%= t('dashboard.largest') %>: <%= format_currency(@monthly_stats&.dig(:largest_expense) || 0) %>
            </p>
          </div>
          <div class="dashboard-metric-icon dashboard-metric-icon-average-expense">
            <svg class="dashboard-metric-icon-svg dashboard-metric-icon-svg-average-expense" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 13l-5 5m0 0l-5-5m5 5V6"></path>
            </svg>
          </div>
        </div>
      </div>
    </section>
    <% end %>

    <!-- TOP CATEGORIES FOR SELECTED MONTH -->
    <% if @monthly_stats && @monthly_stats[:has_data] && @monthly_stats[:top_categories]&.any? %>
      <section class="dashboard-top-categories">
        <h3 class="dashboard-top-categories-title"><%= t('dashboard.top_categories_for_month', month: @selected_month.strftime('%B %Y')) %></h3>
        <div class="dashboard-top-categories-grid">
          <% @monthly_stats[:top_categories].each_with_index do |category, index| %>
            <div class="dashboard-top-category-card">
              <div class="dashboard-top-category-rank">#<%= index + 1 %></div>
              <div class="dashboard-top-category-content">
                <h4 class="dashboard-top-category-name"><%= category[:name] %></h4>
                <p class="dashboard-top-category-amount"><%= format_currency(category[:amount]) %></p>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% elsif @monthly_stats && !@monthly_stats[:has_data] %>
      <section class="dashboard-top-categories">
        <h3 class="dashboard-top-categories-title"><%= t('dashboard.top_categories_for_month', month: @selected_month.strftime('%B %Y')) %></h3>
        <div class="dashboard-no-data">
          <p><%= t('dashboard.no_transactions_in_selected_month') %></p>
        </div>
      </section>
    <% end %>

    <!-- CHARTS ROW: Bank Accounts and Spending Trends -->
    <div class="dashboard-charts-grid">
      
      <!-- BANK ACCOUNTS OVERVIEW: Account List -->
      <div class="dashboard-card">
        <div class="dashboard-card-header">
          <h3 class="dashboard-card-title"><%= t('bank_accounts.overview') %></h3>
          <a href="/bank_accounts" class="dashboard-card-link"><%= t('bank_accounts.view_all') %></a>
        </div>
        
        <% if @bank_summaries.any? %>
          <div class="dashboard-accounts-list">
            <% @bank_summaries.each do |summary| %>
              <div class="dashboard-account-item">
                <div class="dashboard-account-left">
                  <div class="dashboard-account-icon">
                    <svg class="dashboard-account-icon-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                    </svg>
                  </div>
                  <div>
                    <p class="dashboard-account-name"><%= summary[:account].bank_display_name %></p>
                    <p class="dashboard-account-number"><%= summary[:account].account_number %></p>
                  </div>
                </div>
                <div class="dashboard-account-right">
                  <p class="dashboard-account-balance">
                    <%= format_currency(summary[:balance]) %>
                  </p>
                  <p class="dashboard-account-transactions">
                    <%= summary[:transaction_count] %> <%= t('table_headers.transactions') %>
                  </p>
                  <% if summary[:last_processed] %>
                    <p class="dashboard-account-last-processed text-xs text-slate-500">
                      <%= t('monthly_summary.last_processed') %>: <%= summary[:last_processed].strftime("%b %d") %>
                    </p>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="dashboard-empty-state">
            <svg class="dashboard-empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
            </svg>
            <p class="dashboard-empty-title"><%= t('bank_accounts.no_accounts_yet') %></p>
            <p class="dashboard-empty-description"><%= t('bank_accounts.add_first_account') %></p>
            <a href="/bank_accounts/new" class="dashboard-empty-action">
              <%= t('bank_accounts.add_account') %>
            </a>
          </div>
        <% end %>
      </div>

      <!-- SPENDING TRENDS CHART: Monthly Spending Visualization -->
      <div class="dashboard-card">
        <div class="dashboard-card-header">
          <h3 class="dashboard-card-title"><%= t('spending_trends.title') %></h3>
          <span class="dashboard-card-subtitle"><%= t('spending_trends.last_6_months') %></span>
        </div>
        
        <% if @chart_data[:spending_trends].any? %>
          <div class="dashboard-chart-container">
            <canvas data-dashboard-charts-target="spendingChart"></canvas>
          </div>
          
          <div class="dashboard-chart-total">
            <p class="dashboard-chart-total-text">
              <%= t('spending_trends.total') %>: <%= format_currency(@chart_data[:spending_trends].sum { |t| t[:amount] }) %>
            </p>
          </div>
        <% else %>
          <div class="dashboard-chart-container flex items-center justify-center text-slate-500">
            <div class="dashboard-empty-state">
              <svg class="dashboard-empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
              <p class="dashboard-empty-title"><%= t('spending_trends.no_data_yet') %></p>
              <p class="dashboard-empty-description"><%= t('spending_trends.upload_statements_to_see') %></p>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- CHARTS ROW: Category Breakdown and Account Balances -->
    <div class="dashboard-charts-grid">
      
      <!-- CATEGORY BREAKDOWN CHART: Spending by Category -->
      <div class="dashboard-card">
        <div class="dashboard-card-header">
          <h3 class="dashboard-card-title"><%= t('spending_trends.by_category') %></h3>
          <a href="/categories" class="dashboard-card-link"><%= t('categories.manage') %></a>
        </div>
        
        <% if @chart_data[:category_summary].any? %>
          <div class="dashboard-chart-container">
            <canvas data-dashboard-charts-target="categoryChart"></canvas>
          </div>
        <% else %>
          <div class="dashboard-chart-container flex items-center justify-center text-slate-500">
            <div class="dashboard-empty-state">
              <svg class="dashboard-empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
              <p class="dashboard-empty-title"><%= t('dashboard.no_spending_data_this_month') %></p>
              <p class="dashboard-empty-description"><%= t('dashboard.no_transactions_in_selected_month') %></p>
            </div>
          </div>
        <% end %>
      </div>

      <!-- ACCOUNT BALANCES CHART: Account Balance Visualization -->
      <div class="dashboard-card">
        <div class="dashboard-card-header">
          <h3 class="dashboard-card-title"><%= t('account_balances.title') %></h3>
          <span class="dashboard-card-subtitle"><%= t('account_balances.current') %></span>
        </div>
        
        <% if @chart_data[:bank_summaries].any? %>
          <div class="dashboard-chart-container">
            <canvas data-dashboard-charts-target="balanceChart"></canvas>
          </div>
        <% else %>
          <div class="dashboard-chart-container flex items-center justify-center text-slate-500">
            <div class="dashboard-empty-state">
              <svg class="dashboard-empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
              <p class="dashboard-empty-title"><%= t('bank_accounts.no_accounts_yet') %></p>
              <p class="dashboard-empty-description"><%= t('bank_accounts.add_accounts_to_see_balance_chart') %></p>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- RECENT TRANSACTIONS: Latest Transaction History -->
    <section class="dashboard-card mb-8">
      <div class="dashboard-card-header">
        <h3 class="dashboard-card-title"><%= t('recent_transactions.title') %></h3>
        <a href="/transactions" class="dashboard-card-link"><%= t('bank_accounts.view_all') %></a>
      </div>
      
      <% if @recent_transactions.any? %>
        <div class="dashboard-transactions-table">
          <div class="dashboard-transactions-scroll-wrapper">
            <table class="dashboard-transactions-table-main">
            <thead class="dashboard-transactions-header">
              <tr>
                <th class="dashboard-transactions-header-row"><%= t('table_headers.date') %></th>
                <th class="dashboard-transactions-header-row"><%= t('table_headers.description') %></th>
                <th class="dashboard-transactions-header-row"><%= t('table_headers.category') %></th>
                <th class="dashboard-transactions-header-row"><%= t('table_headers.account') %></th>
                <th class="dashboard-transactions-header-row text-right"><%= t('table_headers.amount') %></th>
              </tr>
            </thead>
            <tbody class="dashboard-transactions-body">
              <% @recent_transactions.each do |transaction| %>
                <tr class="dashboard-transactions-row">
                  <td class="dashboard-transactions-cell">
                    <span class="dashboard-transactions-cell-text">
                      <%= transaction.date.strftime("%b %d, %Y") %>
                    </span>
                  </td>
                  <td class="dashboard-transactions-cell">
                    <span class="dashboard-transactions-cell-text dashboard-transactions-cell-text-truncate" title="<%= transaction.description %>">
                      <%= short_description(transaction.description) %>
                    </span>
                  </td>
                  <td class="dashboard-transactions-cell">
                    <% if transaction.category %>
                      <span class="dashboard-transactions-category">
                        <%= transaction.category.name %>
                      </span>
                    <% else %>
                      <span class="dashboard-transactions-category-empty">
                        <%= t('dashboard.no_category') %>
                      </span>
                    <% end %>
                  </td>
                  <td class="dashboard-transactions-cell">
                    <span class="dashboard-transactions-cell-account">
                      <%= transaction.bank_account.custom_name %>
                    </span>
                  </td>
                  <td class="dashboard-transactions-cell dashboard-transactions-cell-amount">
                    <span class="<%= transaction.amount.positive? ? 'dashboard-transactions-cell-amount-income' : 'dashboard-transactions-cell-amount-expense' %>">
                      <%= format_currency(transaction.amount) %>
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
          </div>
        </div>
      <% else %>
        <div class="dashboard-empty-state">
          <svg class="dashboard-empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
          <p class="dashboard-empty-title"><%= t('empty_states.no_transactions_yet') %></p>
          <p class="dashboard-empty-description"><%= t('empty_states.upload_statements_to_see_history') %></p>
        </div>
      <% end %>
    </section>

    <!-- RECENT STATEMENT FILES: Recent Uploads with Management -->
    <% if @recent_statement_files.any? %>
      <section class="dashboard-recent-files">
        <div class="dashboard-recent-files-header">
          <h3 class="dashboard-recent-files-title"><%= t('dashboard.recent_statement_files') %></h3>
          <a href="/statement_files" class="dashboard-recent-files-link"><%= t('bank_accounts.view_all') %></a>
        </div>
        <div class="dashboard-recent-files-grid">
          <% @recent_statement_files.each do |statement_file| %>
            <div class="dashboard-recent-file-card">
              <div class="dashboard-recent-file-content">
                <div class="dashboard-recent-file-icon">
                  <svg class="dashboard-recent-file-icon-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                </div>
                <div class="dashboard-recent-file-info">
                  <h4 class="dashboard-recent-file-name"><%= statement_file.file.filename.to_s %></h4>
                  <p class="dashboard-recent-file-meta">
                    <%= statement_file.bank_account.bank_display_name %> • 
                    <%= statement_file.created_at.strftime("%b %d, %Y") %> • 
                    <%= statement_file.transactions.count %> <%= t('table_headers.transactions') %>
                  </p>
                  <p class="dashboard-recent-file-status">
                    <%= t('dashboard.status_label') %> <span class="<%= %w[parsed processed].include? statement_file.status ? 'text-green-600' : statement_file.status == 'error' ? 'text-red-600' : 'text-yellow-600' %>">
                      <%= t("statement_file_status.#{statement_file.status}") %>
                    </span>
                  </p>
                </div>
                <div class="dashboard-recent-file-actions">
                  <a href="/statement_files/<%= statement_file.id %>" class="dashboard-recent-file-view-btn" title="<%= t('dashboard.view_statement') %>">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                  </a>
                  <button onclick="openDeleteModal('<%= statement_file.id %>', '<%= statement_file.file.filename.to_s %>', <%= statement_file.transactions.count %>)" 
                          class="dashboard-recent-file-delete-btn"
                          title="<%= t('dashboard.delete_statement') %>">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</main>

<!-- DELETE CONFIRMATION MODAL -->
<div id="deleteModal" class="fixed inset-0 bg-slate-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-50">
  <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
    <div class="mt-3">
      <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-red-100 mb-4">
        <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
        </svg>
      </div>
      <h3 class="text-lg font-medium text-slate-900 mb-2 text-center"><%= t('statement_files.confirm_delete_title') %></h3>
      <div class="mt-2 px-7 pt-1">
        <p class="text-sm text-slate-500 text-center" id="deleteModalMessage">
          <!-- Message will be populated by JavaScript -->
        </p>
        <p class="text-sm text-red-600 font-medium text-center mt-2">
          <%= t('statement_files.cannot_undo') %>
        </p>
      </div>
      <div class="flex justify-end space-x-3 pt-4">
        <button type="button" onclick="closeDeleteModal()" class="px-4 py-2 border border-slate-300 text-sm font-medium rounded-lg text-slate-700 bg-white hover:bg-slate-50 transition-colors duration-200">
          <%= t('form_actions.cancel') %>
        </button>
        <form id="deleteForm" method="post" style="display: inline;">
          <input type="hidden" name="_method" value="delete">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
          <button type="submit" class="px-4 py-2 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700 transition-colors duration-200">
            <%= t('statement_files.delete') %>
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  // Show toast notifications for actions
  document.addEventListener('DOMContentLoaded', function() {

    // Check URL parameters for action feedback
    const urlParams = new URLSearchParams(window.location.search);
    const action = urlParams.get('action');
    const fileName = urlParams.get('fileName');
    
    if (action === 'deleted' && fileName) {
      if (window.showToast) {
        window.showToast(`<%= t('flash.statement_deleted', filename: '${fileName}') %>`, 'notice');
      }
    }
    
    // Check if user just logged in (no referrer or referrer is login page)
    if (!document.referrer || document.referrer.includes('/session')) {
      if (window.showToast) {
        window.showToast('<%= t('flash.signed_in') %>', 'notice');
      }
    }
  });

  // Delete confirmation modal functions
  function openDeleteModal(statementId, fileName, transactionCount) {
    const message = `<%= t('confirm_delete_statement', count: 'PLACEHOLDER') %>`.replace('PLACEHOLDER', transactionCount);
    document.getElementById('deleteModalMessage').innerHTML = message;
    
    const form = document.getElementById('deleteForm');
    form.action = `/statement_files/${statementId}`;
    
    document.getElementById('deleteModal').classList.remove('hidden');
  }

  function closeDeleteModal() {
    document.getElementById('deleteModal').classList.add('hidden');
  }

  // Month picker functionality
  function changeMonth(monthValue) {
    if (monthValue) {

      window.location.href = `/dashboard?month=${monthValue}`;
    }
  }

  // Jump to current month
  function jumpToCurrentMonth() {
    const currentMonth = new Date().toISOString().slice(0, 7); // YYYY-MM format
    window.location.href = `/dashboard?month=${currentMonth}`;
  }

  // Navigate to previous month
  function previousMonth() {
    const currentValue = document.getElementById('month-selector').value;
    const [year, month] = currentValue.split('-');
    let newYear = parseInt(year);
    let newMonth = parseInt(month) - 1;
    
    if (newMonth < 1) {
      newMonth = 12;
      newYear -= 1;
    }
    
    const newMonthStr = newMonth.toString().padStart(2, '0');
    const newMonthValue = `${newYear}-${newMonthStr}`;
    
    // Check if the new month exists in the dropdown
    const monthSelector = document.getElementById('month-selector');
    const option = monthSelector.querySelector(`option[value="${newMonthValue}"]`);
    
    if (option) {
      monthSelector.value = newMonthValue;
      changeMonth(newMonthValue);
    } else {
      // If the month doesn't exist, navigate to it anyway
      window.location.href = `/dashboard?month=${newMonthValue}`;
    }
  }

  // Navigate to next month
  function nextMonth() {
    const currentValue = document.getElementById('month-selector').value;
    const [year, month] = currentValue.split('-');
    let newYear = parseInt(year);
    let newMonth = parseInt(month) + 1;
    
    if (newMonth > 12) {
      newMonth = 1;
      newYear += 1;
    }
    
    const newMonthStr = newMonth.toString().padStart(2, '0');
    const newMonthValue = `${newYear}-${newMonthStr}`;
    
    // Check if the new month exists in the dropdown
    const monthSelector = document.getElementById('month-selector');
    const option = monthSelector.querySelector(`option[value="${newMonthValue}"]`);
    
    if (option) {
      monthSelector.value = newMonthValue;
      changeMonth(newMonthValue);
    } else {
      // If the month doesn't exist, navigate to it anyway
      window.location.href = `/dashboard?month=${newMonthValue}`;
    }
  }


</script>
