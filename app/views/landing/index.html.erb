<script>
(function() {
  /* ── Word stagger ── */
  const headline = document.getElementById('hero-headline');
  if (headline) {
    const nodes = Array.from(headline.childNodes);
    headline.innerHTML = '';
    nodes.forEach(node => {
      if (node.nodeType === Node.ELEMENT_NODE && node.tagName === 'BR') {
        headline.appendChild(document.createElement('br'));
      } else if (node.nodeType === Node.TEXT_NODE) {
        node.textContent.split(/\s+/).filter(Boolean).forEach(w => {
          const span = document.createElement('span');
          span.className = 'hero-word';
          span.style.marginRight = '0.22em';
          span.textContent = w;
          headline.appendChild(span);
        });
      } else if (node.nodeType === Node.ELEMENT_NODE) {
        const span = document.createElement('span');
        span.className = 'hero-word';
        span.style.marginRight = '0.22em';
        span.appendChild(node.cloneNode(true));
        headline.appendChild(span);
      }
    });
    headline.querySelectorAll('.hero-word').forEach((w, i) => {
      setTimeout(() => w.classList.add('visible'), 120 + i * 80);
    });
  }

  /* ── Animated counter ── */
  const counterEl = document.getElementById('txn-counter');
  if (counterEl) {
    let fired = false;
    const fmt = new Intl.NumberFormat('es-MX');
    const target = parseInt(counterEl.dataset.target, 10);
    const cObs = new IntersectionObserver(entries => {
      if (entries[0].isIntersecting && !fired) {
        fired = true;
        const start = performance.now();
        (function tick(now) {
          const p = Math.min((now - start) / 2000, 1);
          const ease = 1 - Math.pow(1 - p, 3);
          counterEl.textContent = fmt.format(Math.round(target * ease));
          if (p < 1) requestAnimationFrame(tick);
        })(performance.now());
        cObs.disconnect();
      }
    }, { threshold: 0.5 });
    cObs.observe(counterEl);
  }

  /* ── Feature card stagger ── */
  const featureGrid = document.getElementById('features-grid');
  if (featureGrid) {
    const cards = featureGrid.querySelectorAll('.feature-card');
    cards.forEach(c => {
      c.style.opacity = '0';
      c.style.transform = 'translateY(20px)';
      c.style.transition = 'opacity 0.45s cubic-bezier(0.4,0,0.2,1), transform 0.45s cubic-bezier(0.4,0,0.2,1), border-color 200ms ease, box-shadow 200ms ease';
    });
    const fObs = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const idx = [...cards].indexOf(entry.target);
          setTimeout(() => {
            entry.target.style.opacity = '1';
            entry.target.style.transform = 'translateY(0)';
          }, idx * 70);
          fObs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    cards.forEach(c => fObs.observe(c));
  }

  /* ── Nav scroll state ── */
  const nav = document.getElementById('site-nav');
  if (nav) {
    window.addEventListener('scroll', () => {
      nav.classList.toggle('scrolled', window.scrollY > 10);
    }, { passive: true });
  }

  /* ── Scroll reveal ── */
  const revealEls = document.querySelectorAll('.reveal');
  const revObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        revObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
  revealEls.forEach(el => revObs.observe(el));

  /* ── Scroll-driven How It Works ── */
  (function() {
    const container = document.getElementById('como-funciona');
    const phoneWrap = document.getElementById('how-phone-wrap');
    const phoneImg  = document.getElementById('how-phone-img');
    if (!container || !phoneWrap || !phoneImg) return;

    const stepEls = [0,1,2].map(i => document.getElementById('how-step-' + i));
    const fillEl  = document.getElementById('how-steps-fill');
    const mobilePhoneImg = document.getElementById('how-mobile-phone-img');
    const mobileTabs = Array.from(document.querySelectorAll('[data-how-mobile-step]'));
    const mobileTitleEl = document.getElementById('how-mobile-step-title');
    const mobileDescEl = document.getElementById('how-mobile-step-desc');
    const imgs    = [
      '<%= asset_path("landing/step-upload.jpeg") %>',
      '<%= asset_path("landing/step-analyzing.jpeg") %>',
      '<%= asset_path("landing/step-imported.jpeg") %>'
    ];
    const alts = [
      '<%= t("landing.how_it_works.step1.title").gsub("'", "\\'") %>',
      '<%= t("landing.how_it_works.step2.title").gsub("'", "\\'") %>',
      '<%= t("landing.how_it_works.step3.title").gsub("'", "\\'") %>'
    ];
    const shortDescs = [
      '<%= t("landing.how_it_works.step1.desc_short").gsub("'", "\\'") %>',
      '<%= t("landing.how_it_works.step2.desc_short").gsub("'", "\\'") %>',
      '<%= t("landing.how_it_works.step3.desc_short").gsub("'", "\\'") %>'
    ];
    let currentStep = -1;

    imgs.forEach(src => { const img = new Image(); img.src = src; });

    const revealObs = new IntersectionObserver(entries => {
      if (entries[0].isIntersecting) {
        setTimeout(() => {
          phoneWrap.classList.add('visible');
          phoneImg.classList.add('loaded');
        }, 100);
        revealObs.disconnect();
      }
    }, { threshold: 0.2 });
    revealObs.observe(container);

    function setStep(idx) {
      if (idx === currentStep) return;
      currentStep = idx;
      stepEls.forEach((el, i) => el && el.classList.toggle('active', i === idx));
      const stepsEl = fillEl.parentElement;
      const stepDots = stepsEl.querySelectorAll('.how-step-dot');
      if (stepDots[0] && stepDots[idx]) {
        const stepsRect = stepsEl.getBoundingClientRect();
        const centerY = (dot) => {
          const r = dot.getBoundingClientRect();
          return r.top + r.height / 2 - stepsRect.top;
        };
        const firstY = centerY(stepDots[0]);
        const currY = centerY(stepDots[idx]);
        fillEl.style.top = firstY + 'px';
        fillEl.style.height = Math.max(0, currY - firstY) + 'px';
      }
      phoneImg.style.opacity = '0';
      setTimeout(() => {
        phoneImg.src = imgs[idx];
        phoneImg.alt = alts[idx];
        phoneImg.classList.add('loaded');
        phoneImg.style.opacity = '1';
      }, 200);
    }

    function setMobileStep(idx) {
      if (!mobilePhoneImg || !mobileTitleEl || !mobileDescEl) return;

      mobilePhoneImg.style.opacity = '0';
      setTimeout(() => {
        mobilePhoneImg.src = imgs[idx];
        mobilePhoneImg.alt = alts[idx];
        mobilePhoneImg.style.opacity = '1';
      }, 120);

      mobileTitleEl.textContent = alts[idx];
      mobileDescEl.textContent = shortDescs[idx];

      mobileTabs.forEach((tab, tabIdx) => {
        const isActive = tabIdx === idx;
        tab.classList.toggle('active', isActive);
        tab.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
    }

    mobileTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const idx = Number(tab.dataset.howMobileStep || 0);
        setMobileStep(Math.max(0, Math.min(2, idx)));
      });
    });

    setStep(0);
    setMobileStep(0);

    window.addEventListener('scroll', () => {
      const rect     = container.getBoundingClientRect();
      const total    = container.offsetHeight - window.innerHeight;
      if (total <= 0) return;
      const scrolled = -rect.top;
      const progress = Math.max(0, Math.min(1, scrolled / total));
      setStep(progress < 0.33 ? 0 : progress < 0.66 ? 1 : 2);
    }, { passive: true });

  })();

  /* ── Product tabs ── */
  window.lpSwitchTab = function(btn, panelId) {
    document.querySelectorAll('.product-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.product-panel').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById(panelId).classList.add('active');
  };

  /* ── Sticky bottom CTA: show after hero, hide when final CTA is visible ── */
  (function() {
    const stickyCta   = document.getElementById('lp-sticky-cta');
    const heroSection = document.getElementById('hero');
    const finalCta    = document.getElementById('lista-espera');
    if (!stickyCta || !heroSection) return;

    const showObs = new IntersectionObserver(([entry]) => {
      const show = !entry.isIntersecting;
      stickyCta.classList.toggle('visible', show);
      stickyCta.setAttribute('aria-hidden', show ? 'false' : 'true');
    }, { threshold: 0.1 });
    showObs.observe(heroSection);

    if (finalCta) {
      const hideObs = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          stickyCta.classList.remove('visible');
          stickyCta.setAttribute('aria-hidden', 'true');
        }
      }, { threshold: 0.3 });
      hideObs.observe(finalCta);
    }
  })();
})();
</script>
