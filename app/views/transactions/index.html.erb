<script>
function openEditModal(transactionId) {
  // Store the transaction ID for editing mode
  window.editingTransactionId = transactionId;

  // Find the transaction - try desktop table row first, then mobile card
  let transactionRow = document.querySelector(`tr.transactions-table-row[data-transaction-id="${transactionId}"]`);

  // If not found in desktop table, try mobile card
  if (!transactionRow) {
    transactionRow = document.querySelector(`.mobile-transaction-card[data-transaction-id="${transactionId}"]`);
  }

  if (transactionRow) {
    // Check if it's a mobile card or desktop row
    const isMobileCard = transactionRow.classList.contains('mobile-transaction-card');

    let merchant, reference, transactionType, categoryId, description, amount, date, bankAccountId, transferAccountId;

    if (isMobileCard) {
      // Extract from mobile card data attributes
      merchant = transactionRow.dataset.merchant || '';
      reference = transactionRow.dataset.reference || '';
      transactionType = transactionRow.dataset.transactionType || '';
      categoryId = transactionRow.dataset.categoryId || '';
      description = transactionRow.dataset.description || '';
      amount = transactionRow.dataset.amount || '';
      date = transactionRow.dataset.date || '';
      bankAccountId = transactionRow.dataset.accountId || '';
      transferAccountId = transactionRow.dataset.transferAccountId || '';
    } else {
      // Extract from desktop table row
      const merchantElement = transactionRow.querySelector('[data-merchant]');
      const referenceElement = transactionRow.querySelector('[data-reference]');
      const transactionTypeElement = transactionRow.querySelector('[data-transaction-type]');
      const categoryElement = transactionRow.querySelector('[data-category-id]');
      const descriptionElement = transactionRow.querySelector('[data-description]');
      const amountElement = transactionRow.querySelector('[data-amount]');
      const dateElement = transactionRow.querySelector('[data-date]');

      merchant = merchantElement?.textContent?.trim() || '';
      reference = referenceElement?.textContent?.trim() || '';
      transactionType = transactionTypeElement?.getAttribute('data-transaction-type') || '';
      categoryId = categoryElement?.getAttribute('data-category-id') || '';
      description = descriptionElement?.textContent?.trim() || '';
      amount = amountElement?.getAttribute('data-amount') || '';
      date = dateElement?.getAttribute('data-date') || '';

      // For desktop, get the bank account IDs from the row data attributes
      bankAccountId = transactionRow.dataset.bankAccountId || '';
      transferAccountId = transactionRow.dataset.transferAccountId || '';
    }

    // Update modal title
    const modalTitle = document.querySelector('#createTransactionModal h3');
    if (modalTitle) {
      modalTitle.textContent = '<%= j t("transactions.edit_transaction") %>';
    }

    // Update button text
    const submitButton = document.querySelector('#createTransactionModal button[type="submit"]');
    if (submitButton) {
      submitButton.textContent = '<%= j t("form_actions.save_changes") %>';
    }

    // Change form action to PATCH for updating
    const form = document.getElementById('createTransactionForm');
    form.action = `<%= root_path %>transactions/${transactionId}`;

    // Add method override for PATCH
    let methodInput = form.querySelector('input[name="_method"]');
    if (!methodInput) {
      methodInput = document.createElement('input');
      methodInput.type = 'hidden';
      methodInput.name = '_method';
      form.appendChild(methodInput);
    }
    methodInput.value = 'patch';

    // Populate form fields
    // Convert transfer_in to transfer_out for editing (users edit from source perspective)
    let transactionTypeValue = transactionType || 'variable_expense';
    let sourceBankAccountId = bankAccountId;
    let destinationAccountId = transferAccountId;

    if (transactionType === 'transfer_in') {
      transactionTypeValue = 'transfer_out';
      // Swap the bank accounts since we're viewing from opposite perspective
      sourceBankAccountId = transferAccountId;
      destinationAccountId = bankAccountId;
    }

    console.log('Setting transaction type to:', transactionTypeValue);
    console.log('Category ID:', categoryId);
    console.log('Source Bank Account ID:', sourceBankAccountId);
    console.log('Destination Account ID:', destinationAccountId);

    document.getElementById('create_transaction_type').value = transactionTypeValue;
    document.getElementById('create_bank_account_id').value = sourceBankAccountId;
    document.getElementById('create_date').value = date;
    document.getElementById('create_amount').value = Math.abs(parseFloat(amount) || 0);
    document.getElementById('create_description').value = description;
    document.getElementById('create_category_id').value = categoryId || '';
    document.getElementById('create_merchant').value = merchant;
    document.getElementById('create_reference').value = reference;

    // Handle transfer fields
    handleCreateTransferFieldVisibility(transactionTypeValue);

    // For transfers, populate the transfer destination account
    if (transactionTypeValue === 'transfer_out' && destinationAccountId) {
      document.getElementById('create_transfer_account_id').value = destinationAccountId;
    }

    // Disable transaction type, bank account, and transfer account fields when editing
    // These fields should not be changed after creation
    document.getElementById('create_transaction_type').disabled = true;
    document.getElementById('create_bank_account_id').disabled = true;
    if (transactionTypeValue === 'transfer_out') {
      document.getElementById('create_transfer_account_id').disabled = true;
    }

    // Open the create transaction modal (which is now being reused for editing)
    document.getElementById('createTransactionModal').classList.remove('hidden');

    // Ensure dropdown is properly hidden and re-initialize
    setTimeout(() => {
      resetDropdownState('create_category_dropdown');
      initializeDropdown('create_category_id', 'create_category_dropdown');
    }, 100);
  }
}

function closeEditModal() {
  document.getElementById('editModal').classList.add('hidden');
}

function handleEditTransferFieldVisibility(transactionType) {
  const transferField = document.getElementById('edit_transfer_account_field');
  const transferAccountSelect = document.getElementById('edit_transfer_account_id');
  const transferAccountLabel = document.getElementById('edit_transfer_account_label');
  const transferAccountHelp = document.getElementById('edit_transfer_account_help');

  if (transactionType === 'transfer_out' || transactionType === 'transfer_in') {
    transferField.classList.remove('hidden');
    transferAccountSelect.required = true;

    // Update labels based on direction
    if (transactionType === 'transfer_out') {
      transferAccountLabel.textContent = '<%= t("transactions.transfer_to") %>';
      transferAccountHelp.textContent = '<%= t("transactions.select_destination_account_help") %>';
    } else {
      // For transfer_in, the linked account is the source
      transferAccountLabel.textContent = '<%= t("transactions.transfer_from") %>';
      transferAccountHelp.textContent = '<%= t("transactions.select_source_account_help") %>';
    }
  } else {
    transferField.classList.add('hidden');
    transferAccountSelect.required = false;
    transferAccountSelect.value = ''; // Clear selection
  }
}

function deleteTransaction(transactionId) {
  if (confirm('<%= t("transactions.confirm_delete") %>')) {
    // Create a form to submit the DELETE request
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = `<%= root_path %>transactions/${transactionId}`;
    
    // Add CSRF token
    const csrfToken = document.createElement('input');
    csrfToken.type = 'hidden';
    csrfToken.name = 'authenticity_token';
    csrfToken.value = '<%= form_authenticity_token %>';
    form.appendChild(csrfToken);
    
    // Add method override for DELETE
    const methodInput = document.createElement('input');
    methodInput.type = 'hidden';
    methodInput.name = '_method';
    methodInput.value = 'delete';
    form.appendChild(methodInput);
    
    // Submit the form
    document.body.appendChild(form);
    form.submit();
  }
}

// Close modal when clicking outside
document.getElementById('editModal').addEventListener('click', function(e) {
  if (e.target === this) {
    closeEditModal();
  }
});

// Create Transaction Modal Functions
function openCreateTransactionModal() {
  // Store the current date value before resetting
  const dateInput = document.getElementById('create_date');
  const currentDateValue = dateInput.value;
  
  // Reset form
  document.getElementById('createTransactionForm').reset();
  
  // Set the max date to today in user's local timezone
  const today = new Date();
  const year = today.getFullYear();
  const month = String(today.getMonth() + 1).padStart(2, '0');
  const day = String(today.getDate()).padStart(2, '0');
  const todayString = `${year}-${month}-${day}`;
  
  // Set max date to prevent future dates
  dateInput.max = todayString;
  
  // Set default value to today's date in user's local timezone
  // Restore the date if it was previously set, otherwise use today's date
  dateInput.value = currentDateValue || todayString;
  
  // Re-enable fields that may have been disabled during edit
  document.getElementById('create_transaction_type').disabled = false;
  document.getElementById('create_bank_account_id').disabled = false;
  document.getElementById('create_transfer_account_id').disabled = false;

  // Set default transaction type to variable_expense
  document.getElementById('create_transaction_type').value = 'variable_expense';

  // Apply amount sign handling for the default transaction type
  handleAmountSign();

  // Ensure event listeners are properly attached
  const transactionTypeSelect = document.getElementById('create_transaction_type');
  const amountInput = document.getElementById('create_amount');

  if (transactionTypeSelect && amountInput) {
    // Remove existing listeners to avoid duplicates
    transactionTypeSelect.removeEventListener('change', handleAmountSign);
    amountInput.removeEventListener('blur', handleAmountSign);

    // Add fresh listeners
    transactionTypeSelect.addEventListener('change', handleAmountSign);
    amountInput.addEventListener('blur', handleAmountSign);
  }
  
  // Show the modal
  document.getElementById('createTransactionModal').classList.remove('hidden');
  
  // Ensure dropdown is properly hidden and re-initialize
  setTimeout(() => {
    resetDropdownState('create_category_dropdown');
    initializeDropdown('create_category_id', 'create_category_dropdown');
  }, 100);
}

function closeCreateTransactionModal() {
  document.getElementById('createTransactionModal').classList.add('hidden');

  // Reset the modal back to "create" mode
  window.editingTransactionId = null;

  // Reset form action to POST for creating
