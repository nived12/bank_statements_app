<section class="py-20 md:py-28 bg-slate-50/80" id="how-it-works">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16" data-landing-scroll-target="section">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        <%= t("landing.how_it_works.title") %>
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-8 lg:gap-12 relative">
      <!-- Connector line (desktop only) -->
      <div class="hidden md:block absolute top-16 left-1/6 right-1/6 h-0.5 bg-gradient-to-r from-sky-300 via-indigo-300 to-emerald-300"></div>

      <!-- Step 1 -->
      <div class="relative text-center" data-landing-scroll-target="section">
        <div class="w-14 h-14 rounded-2xl bg-sky-100 flex items-center justify-center mx-auto mb-6 relative z-10 border-4 border-white shadow-sm">
          <span class="text-xl font-extrabold text-sky-600">1</span>
        </div>
        <div class="w-14 h-14 rounded-xl bg-sky-50 flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2"><%= t("landing.how_it_works.step1.title") %></h3>
        <p class="text-slate-600"><%= t("landing.how_it_works.step1.description") %></p>
      </div>

      <!-- Step 2 -->
      <div class="relative text-center" data-landing-scroll-target="section">
        <div class="w-14 h-14 rounded-2xl bg-indigo-100 flex items-center justify-center mx-auto mb-6 relative z-10 border-4 border-white shadow-sm">
          <span class="text-xl font-extrabold text-indigo-600">2</span>
        </div>
        <div class="w-14 h-14 rounded-xl bg-indigo-50 flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2"><%= t("landing.how_it_works.step2.title") %></h3>
        <p class="text-slate-600"><%= t("landing.how_it_works.step2.description") %></p>
      </div>

      <!-- Step 3 -->
      <div class="relative text-center" data-landing-scroll-target="section">
        <div class="w-14 h-14 rounded-2xl bg-emerald-100 flex items-center justify-center mx-auto mb-6 relative z-10 border-4 border-white shadow-sm">
          <span class="text-xl font-extrabold text-emerald-600">3</span>
        </div>
        <div class="w-14 h-14 rounded-xl bg-emerald-50 flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2"><%= t("landing.how_it_works.step3.title") %></h3>
        <p class="text-slate-600"><%= t("landing.how_it_works.step3.description") %></p>
      </div>
    </div>
  </div>
</section>
