<!DOCTYPE html>
<%#
  Marketing layout (landing + pricing). Self-contained design:
  loads only landing.css + landing.js (no Tailwind/Turbo). Copy is
  rendered inline-bilingual (data-lang-es / data-lang-en) and toggled
  client-side; @locale (from ?locale=) sets the initial language + SEO head.
%>
<% lang = (@locale || "es").to_s %>
<html lang="<%= lang %>" data-lang="<%= lang %>">
  <head>
    <% page_title = content_for?(:page_title) ? yield(:page_title) : (lang == "en" ? "Vittio — AI-powered personal finance for Mexico" : "Vittio — Control financiero personal con IA") %>
    <% page_description = content_for?(:page_description) ? yield(:page_description) : (lang == "en" ? "Upload your bank statement PDF and Vittio categorizes everything with AI. Full control of your money. No banking credentials. Made in Mexico." : "Sube tu estado de cuenta en PDF y Vittio categoriza todo con IA. Control total de tu dinero. Sin credenciales bancarias. Hecho en México.") %>
    <% base_url = request.original_url.split("?").first %>
    <% canonical_url = lang == "en" ? "#{base_url}?locale=en" : base_url %>
    <% og_image = "#{request.protocol}#{request.host_with_port}/vittio_new_with_description.jpg" %>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= page_title %></title>
    <meta name="description" content="<%= page_description %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="canonical" href="<%= canonical_url %>">

    <!-- Open Graph -->
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Vittio">
    <meta property="og:locale" content="<%= lang == "en" ? "en_US" : "es_MX" %>">
    <meta property="og:image" content="<%= og_image %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@VittioMX">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= page_description %>">
    <meta name="twitter:image" content="<%= og_image %>">

    <!-- hreflang -->
    <link rel="alternate" hreflang="es" href="<%= base_url %>">
    <link rel="alternate" hreflang="en" href="<%= base_url %>?locale=en">
    <link rel="alternate" hreflang="x-default" href="<%= base_url %>">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "landing" %>
    <%= javascript_include_tag "landing", defer: true %>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/icon.svg">
    <link rel="icon" type="image/png" href="/icon.png">

    <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"WebSite","name":"Vittio","url":"https://vitt.io"}
    </script>

    <%= yield :head %>
  </head>

  <body class="<%= content_for?(:body_class) ? yield(:body_class) : "" %>">
    <%= yield %>
  </body>
</html>
