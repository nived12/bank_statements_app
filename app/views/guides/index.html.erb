<% content_for :page_title, "Guías — Vittio | Cómo usar la plataforma y tus bancos" %>
<% content_for :page_description, "Guías paso a paso: cómo descargar tu estado de cuenta de cualquier banco mexicano y cómo usar Vittio para organizar tus finanzas — sin conectar tu banco." %>
<% content_for :body_class, "blog-page" %>

<% content_for :head do %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Guías de Vittio",
  "url": "https://vitt.io/guides",
  "description": "Guías prácticas para bancos mexicanos y uso de Vittio.",
  "publisher": { "@type": "Organization", "name": "Vittio", "url": "https://vitt.io" }
}
</script>
<% end %>

<%= render "shared/blog_nav" %>

<main class="blog-index">
  <header class="blog-index-head">
    <div class="container">
      <span class="blog-eyebrow">GUÍAS · VITTIO</span>
      <h1 class="blog-index-title">Paso a paso, <em>sin perderte.</em></h1>
      <p class="blog-index-sub">Cómo descargar y leer tu estado de cuenta de cualquier banco mexicano, y cómo usar Vittio para categorizar tus gastos — sin conectar tu banco ni compartir contraseñas. ¿Buscas artículos de educación financiera? Ve al <a href="<%= blog_path %>">Blog</a>.</p>
    </div>
  </header>

  <div class="container">
    <% if @articles.any? %>
      <% featured = @articles.first %>
      <a class="blog-featured" href="<%= article_link_path(featured) %>">
        <div class="blog-featured-body">
          <% if featured.category.present? %><span class="blog-card-cat">Destacado · <%= featured.category %></span><% end %>
          <h2 class="blog-featured-title"><%= featured.title %></h2>
          <p class="blog-featured-desc"><%= featured.description %></p>
          <div class="blog-card-meta">
            <span><%= spanish_date(featured.date) %></span>
            <span>·</span>
            <span><%= featured.reading_time %> min de lectura</span>
          </div>
        </div>
      </a>

      <% rest = @articles.drop(1) %>
      <% if rest.any? %>
        <div class="blog-grid">
          <% rest.each do |article| %>
            <%= render "shared/article_card", article: article %>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <p class="blog-empty">Pronto publicaremos las primeras guías.</p>
    <% end %>
  </div>

  <%= render "shared/blog_cta" %>
</main>

<%= render "shared/blog_footer" %>
