<!-- AUTHENTICATION PAGE: Sign In Form -->
<main class="auth-page">
  
  <!-- LANGUAGE SWITCHER: Top Right Corner -->
  <aside class="auth-language-switcher">
    <%= render 'shared/language_switcher', fixed_position: true %>
  </aside>

  <!-- BRAND SECTION: Left Side Logo and Title -->
  <section class="auth-brand-section">
    <div class="auth-brand-container">
      <div class="auth-brand-logo">
        <%= image_tag '/vittio1.png', alt: 'BankStatements', class: 'auth-brand-logo-icon' %>
      </div>
      <p class="auth-brand-subtitle"><%= t('brand.tagline') %></p>
    </div>
  </section>

  <!-- FORM SECTION: Center Login Form -->
  <section class="auth-form-section">
    <div class="auth-form-container">

      <!-- LOGO: Above Form Card (Mobile Only) -->
      <div class="auth-brand-logo md:hidden" style="margin-bottom: 2rem; text-align: center;">
        <%= image_tag '/vittio1.png', alt: 'VITTIO', class: 'auth-brand-logo-icon' %>
      </div>

      <!-- FORM CARD: Main Container -->
      <div class="auth-form-card">

        <!-- FORM HEADER: Title and Subtitle -->
        <header class="auth-form-header">
          <h2 class="auth-form-title"><%= t('session.sign_in') %></h2>
        </header>

        <!-- FORM CONTENT: All Form Elements -->
        <div class="auth-form">
          
          <!-- LOGIN FORM: Email and Password -->
          <form action="/session" method="post" class="auth-form-field">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            
            <!-- EMAIL FIELD -->
            <div class="auth-field-group">
              <label for="email" class="auth-field-label">
                <%= t('session.email') %>
              </label>
              <input 
                id="email" 
                name="email" 
                type="email" 
                autocomplete="email" 
                required 
                class="auth-field-input" 
                placeholder="<%= t('session.email_placeholder') %>"
                value="<%= params[:email] %>"
              >
            </div>

            <!-- PASSWORD FIELD -->
            <div class="auth-field-group">
              <label for="password" class="auth-field-label">
                <%= t('session.password') %>
              </label>
              <input 
                id="password" 
                name="password" 
                type="password" 
                autocomplete="current-password" 
                required 
                class="auth-field-input" 
                placeholder="<%= t('session.password_placeholder') %>"
              >
            </div>

            <!-- ERROR MESSAGES: Flash Alerts -->
            <% if flash[:alert] %>
              <div class="auth-field-error" style="display: none;">
                <div class="flex items-center">
                  <div class="flex-shrink-0">
                    <svg class="auth-field-error-icon" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                    </svg>
                  </div>
                  <div class="ml-3 flex-1">
                    <p class="auth-field-error-text">
                      <%= flash[:alert] %>
                    </p>
                  </div>
                  <div class="ml-auto pl-3">
                    <button type="button" class="inline-flex text-red-400 hover:text-red-600" onclick="this.closest('[data-flash-message]').remove()">
                      <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            <% end %>

            <!-- SUBMIT BUTTON: Sign In -->
            <div class="auth-submit-container">
              <button type="submit" class="auth-submit-button">
                <%= t('session.sign_in') %>
              </button>
            </div>
          </form>

          <!-- DIVIDER: OR Separator -->
          <% if ENV['GOOGLE_OAUTH_CLIENT_ID'].present? %>
            <div class="auth-divider">
              <div class="auth-divider-line">
                <div class="auth-divider-border"></div>
              </div>
              <div class="auth-divider-text">
                <span class="auth-divider-label"><%= t('session.or') %></span>
              </div>
            </div>
          <% end %>

          <!-- OAUTH SECTION: Social Login Options -->
          <% if ENV['GOOGLE_OAUTH_CLIENT_ID'].present? %>
            <div class="auth-oauth-section">
              <!-- GOOGLE OAUTH -->
              <%= button_to "/auth/google_oauth2", method: :post, class: "auth-oauth-button", data: { turbo: false } do %>
                <svg class="auth-oauth-icon" viewBox="0 0 24 24">
                  <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                  <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                  <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                  <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
                <%= t('session.continue_with_google') %>
              <% end %>
            </div>
          <% end %>

          <!-- ACCOUNT LINKS: Sign Up and Navigation -->
          <div class="auth-account-links">
            <p class="auth-account-text">
              <%= t('session.dont_have_account') %> 
              <a href="/users/new" class="auth-account-link">
                <%= t('user_registration.sign_up_here') %>
              </a>
            </p>
          </div>
        </div>

        <!-- FOOTER: Terms and Privacy -->
        <footer class="auth-footer">
          <p class="auth-footer-text">
            <%= t('session.terms_privacy') %>
          </p>
        </footer>
      </div>
    </div>
  </section>

  <!-- PLACEHOLDER SECTION: Right Side Image and Text -->
  <section class="auth-placeholder-section">
    <div class="auth-placeholder-container">
      <div class="auth-placeholder-image">
        <svg class="auth-placeholder-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
        </svg>
      </div>
      <h3 class="auth-placeholder-title"><%= t('session.financial_dashboard') %></h3>
      <p class="auth-placeholder-description"><%= t('session.financial_dashboard_description') %></p>
    </div>
  </section>
</main>

<script>
  // Show toast notification for flash messages
  document.addEventListener('DOMContentLoaded', function() {
    <% if flash[:alert] %>
      if (window.showToast) {
        window.showToast('<%= j flash[:alert] %>', 'alert');
      }
    <% end %>
  });
</script>
