<!-- TRANSACTIONS PAGE: Transaction Management -->
<div class="transactions-page">
  <div class="transactions-main">
    
    <!-- HEADER SECTION: Responsive Page Title and Actions -->
    <turbo-frame id="transactions-header" class="transactions-header-frame">
      <!-- DESKTOP HEADER -->
      <header class="transactions-header hidden md:block">
        <div class="transactions-header-actions">
          <div class="transactions-header-left">
            <h1 class="transactions-header-title"><%= t('navigation.transactions') %></h1>
            <p class="transactions-header-subtitle"><%= t('transactions.description') %></p>
          </div>
          <div class="transactions-header-right">
            <div class="flex space-x-3">
              <button id="duplicatesButton" onclick="checkForDuplicates()" class="transactions-button transactions-button-warning hidden">
                <svg class="transactions-button-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                </svg>
                <%= t('transactions.review_duplicates') %>
                <span id="duplicatesBadge" class="absolute -top-2 -right-2 bg-red-500 text-white text-xs rounded-full h-5 w-5 flex items-center justify-center hidden">0</span>
              </button>
              <button onclick="openCreateTransactionModal()" class="transactions-button transactions-button-secondary">
                <svg class="transactions-button-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
                <%= t('transactions.add_transaction') %>
              </button>
              <%= link_to new_statement_file_path, class: "transactions-button transactions-button-primary" do %>
                <svg class="transactions-button-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
                </svg>
                <%= t('quick_actions.upload_statement') %>
              <% end %>
            </div>
          </div>
        </div>
      </header>

      <!-- MOBILE HEADER -->
      <header class="mobile-transactions-header block md:hidden">
        <div class="mobile-transactions-header-content">
          <div class="mobile-transactions-header-left">
            <h1 class="mobile-transactions-title"><%= t('navigation.transactions') %></h1>
            <p class="mobile-transactions-subtitle"><%= t('transactions.description') %></p>
          </div>
          <div class="mobile-transactions-header-actions">
            <button onclick="openMobileCreateTransactionModal()" class="mobile-transactions-add-btn">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
              </svg>
            </button>
          </div>
        </div>
      </header>
    </turbo-frame>

    <!-- FILTER SECTION: Responsive Filter Bar -->
    <turbo-frame id="transactions-filters" class="transactions-filters-frame">
      <!-- DESKTOP FILTERS (hidden on mobile) -->
      <section class="transactions-filters hidden md:block">
      <!-- ACTIVE FILTERS CHIPS -->
      <% total_filters_count = [params[:bank_account_id], params[:statement_file_id], params[:transaction_type], params[:from_date], params[:to_date], params[:search]].compact.length %>
      <% if total_filters_count > 0 %>
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class="text-sm font-medium text-slate-700"><%= t('transactions.active_filters') %></span>
          <% if params[:bank_account_id].present? %>
            <% bank_account = @bank_accounts.find { |ba| ba.id.to_s == params[:bank_account_id] } %>
            <div class="inline-flex items-center bg-blue-100 text-blue-800 text-sm px-3 py-1 rounded-full">
              <span><%= bank_account&.custom_name || "#{bank_account&.bank_display_name} - ••••#{bank_account&.account_number&.last(4)}" %></span>
              <button onclick="clearFilter('bank_account_id')" class="ml-2 text-blue-600 hover:text-blue-800">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
          <% end %>

          <% if params[:statement_file_id].present? %>
            <div class="inline-flex items-center bg-green-100 text-green-800 text-sm px-3 py-1 rounded-full">
              <span><%= @statement_file&.safe_filename %></span>
              <button onclick="clearFilter('statement_file_id')" class="ml-2 text-green-600 hover:text-green-800">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
          <% end %>

          <% if params[:transaction_type].present? %>
            <div class="inline-flex items-center bg-purple-100 text-purple-800 text-sm px-3 py-1 rounded-full">
              <span><%= t("transaction_types.#{params[:transaction_type]}") %></span>
              <button onclick="clearFilter('transaction_type')" class="ml-2 text-purple-600 hover:text-purple-800">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
          <% end %>

          <% if params[:from_date].present? || params[:to_date].present? %>
            <div class="inline-flex items-center bg-orange-100 text-orange-800 text-sm px-3 py-1 rounded-full">
              <span>
                <% if params[:from_date].present? && params[:to_date].present? %>
                  <%= params[:from_date] %> - <%= params[:to_date] %>
                <% elsif params[:from_date].present? %>
                  Desde <%= params[:from_date] %>
                <% else %>
                  Hasta <%= params[:to_date] %>
                <% end %>
              </span>
              <button onclick="clearDateFilter()" class="ml-2 text-orange-600 hover:text-orange-800">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
          <% end %>

          <% if params[:search].present? %>
            <div class="inline-flex items-center bg-indigo-100 text-indigo-800 text-sm px-3 py-1 rounded-full">
              <span><%= t('transactions.search_filter', query: params[:search]) %></span>
              <button onclick="window.clearSearch()" class="ml-2 text-indigo-600 hover:text-indigo-800">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
          <% end %>

          <% if total_filters_count > 0 %>
            <button onclick="clearAllFilters()" class="text-sm text-red-600 hover:text-red-800 font-medium">
              <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
              <%= t('transactions.clear_all_filters') %>
            </button>
          <% end %>
        </div>
      <% end %>

      <!-- SEARCH BAR -->
      <form data-turbo-frame="transactions-results" method="get" class="mb-4">
        <!-- Hidden inputs to preserve other filter parameters -->
        <input type="hidden" name="bank_account_id" value="<%= params[:bank_account_id] %>">
        <input type="hidden" name="statement_file_id" value="<%= params[:statement_file_id] %>">
        <input type="hidden" name="transaction_type" value="<%= params[:transaction_type] %>">
        <input type="hidden" name="from_date" value="<%= params[:from_date] %>">
        <input type="hidden" name="to_date" value="<%= params[:to_date] %>">
        <input type="hidden" name="sort" value="<%= params[:sort] %>">
        <input type="hidden" name="direction" value="<%= params[:direction] %>">

        <div class="max-w-md">
          <label for="search" class="block text-xs font-medium text-slate-600 mb-1"><%= t('transactions.search_description') %></label>
          <div class="relative">
            <input type="text"
                   id="search"
                   name="search"
                   value="<%= params[:search] %>"
                   placeholder="<%= t('transactions.search_placeholder') %>"
                   class="w-full px-3 py-2 pl-10 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                   oninput="clearTimeout(this.searchTimeout); this.searchTimeout = setTimeout(() => this.form.requestSubmit(), 300)"
                   onkeydown="if(event.key === 'Enter') { event.preventDefault(); this.form.requestSubmit(); }">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <% if params[:search].present? %>
              <button onclick="window.clearSearch()" class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            <% end %>
          </div>
        </div>

        <!-- INLINE FILTER BAR -->
        <div class="flex items-center space-x-4 mb-6">
        <!-- BANK ACCOUNT FILTER -->
        <div class="flex-1 min-w-[200px]">
          <label for="bank_account_id" class="block text-xs font-medium text-slate-600 mb-1"><%= t('transactions.bank_account_filter') %></label>
          <select name="bank_account_id" id="bank_account_id" class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" onchange="this.form.requestSubmit()">
            <option value=""><%= t('transactions.all_accounts') %></option>
            <% @bank_accounts.each do |ba| %>
              <option value="<%= ba.id %>" <%= "selected" if params[:bank_account_id].to_s == ba.id.to_s %>>
                <%= ba.custom_name || "#{ba.bank_display_name} - ••••#{ba.account_number.last(4)}" %>
              </option>
            <% end %>
          </select>
        </div>

        <!-- STATEMENT FILE FILTER -->
        <div class="flex-1 min-w-[200px]">
          <label for="statement_file_id" class="block text-xs font-medium text-slate-600 mb-1"><%= t('transactions.statement_file_filter') %></label>
          <select name="statement_file_id" id="statement_file_id" class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" onchange="this.form.requestSubmit()">
            <option value=""><%= t('transactions.all_statement_files') %></option>
            <% @statement_files.each do |sf| %>
              <option value="<%= sf.id %>" <%= "selected" if params[:statement_file_id].to_s == sf.id.to_s %>>
                <%= sf.safe_filename %> - <%= sf.bank_account.display_name %>
              </option>
            <% end %>
          </select>
        </div>

        <!-- TRANSACTION TYPE FILTER -->
        <div class="flex-1 min-w-[150px]">
          <label for="transaction_type" class="block text-xs font-medium text-slate-600 mb-1"><%= t('transactions.transaction_type_filter') %></label>
          <select name="transaction_type" id="transaction_type" class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" onchange="this.form.requestSubmit()">
            <option value=""><%= t('transactions.all_transaction_types') %></option>
            <option value="income" <%= "selected" if params[:transaction_type] == "income" %>><%= t('transaction_types.income') %></option>
            <option value="fixed_expense" <%= "selected" if params[:transaction_type] == "fixed_expense" %>><%= t('transaction_types.fixed_expense') %></option>
            <option value="variable_expense" <%= "selected" if params[:transaction_type] == "variable_expense" %>><%= t('transaction_types.variable_expense') %></option>
            <option value="transfer" <%= "selected" if params[:transaction_type] == "transfer" || params[:transaction_type] == "transfer_out" || params[:transaction_type] == "transfer_in" %>><%= t('transaction_types.transfer_out') %></option>
          </select>
        </div>

        <!-- DATE RANGE PICKER -->
        <div class="flex-1 min-w-[200px]">
          <label for="date_range" class="block text-xs font-medium text-slate-600 mb-1"><%= t('transactions.date_range_filter') %></label>
          <input type="text" 
                 id="date_range" 
                 name="date_range" 
                 placeholder="<%= t('transactions.click_to_select_range') %>"
                 class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                 readonly>
          <input type="hidden" name="from_date" id="from_date">
          <input type="hidden" name="to_date" id="to_date">
        </div>
      </div>
      </form>
      </section>

      <!-- MOBILE FILTERS (visible only on mobile) -->
      <section class="mobile-transactions-filters block md:hidden">
        <!-- Search Bar (Always Visible) -->
        <div class="mobile-search-container" data-controller="search">
          <form data-search-target="form" data-turbo-frame="transactions-results" class="mobile-search-form" method="get">
            <!-- Hidden inputs to preserve other filter parameters -->
            <input type="hidden" name="bank_account_id" value="<%= params[:bank_account_id] %>">
            <input type="hidden" name="statement_file_id" value="<%= params[:statement_file_id] %>">
            <input type="hidden" name="transaction_type" value="<%= params[:transaction_type] %>">
            <input type="hidden" name="from_date" value="<%= params[:from_date] %>">
            <input type="hidden" name="to_date" value="<%= params[:to_date] %>">

            <div class="mobile-search-wrapper">
              <div class="mobile-search-icon-left">
                <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
              </div>

              <input type="text"
                     name="search"
                     value="<%= params[:search] %>"
                     placeholder="<%= t('transactions.search_placeholder') %>"
                     class="mobile-search-input"
                     data-search-target="input"
                     data-action="input->search#search keydown->search#search">

              <button type="button"
                      data-search-target="clearButton"
                      data-action="click->search#clear"
                      class="mobile-search-clear hidden">
                <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
          </form>
        </div>

        <!-- Filter Button and Controls -->
        <div class="mobile-filter-controls" data-controller="filter-drawer">
          <button type="button"
                  data-action="click->filter-drawer#toggle"
                  class="mobile-filter-button">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.414A1 1 0 013 6.707V4z"></path>
            </svg>
            <span>Filtros</span>
            <div data-filter-drawer-target="badge" class="mobile-filter-badge hidden">0</div>
          </button>

          <!-- Filter Drawer Overlay -->
          <div data-filter-drawer-target="overlay"
               class="mobile-filter-overlay opacity-0 pointer-events-none"
               data-action="click->filter-drawer#close">
          </div>

          <!-- Filter Drawer -->
          <div data-filter-drawer-target="drawer" class="mobile-filter-drawer translate-y-full">
            <form data-filter-drawer-target="form" data-turbo-frame="transactions-results" class="mobile-filter-form" method="get">
              <!-- Search is handled separately, so we include it as hidden to preserve it -->
              <input type="hidden" name="search" value="<%= params[:search] %>">

              <div class="mobile-filter-header">
                <h3>Filtros</h3>
                <div class="mobile-filter-actions">
                  <button type="button"
                          data-action="click->filter-drawer#clearAll"
                          class="mobile-filter-clear-all">
                    Limpiar
                  </button>
                  <button type="button"
                          data-action="click->filter-drawer#close"
                          class="mobile-filter-close">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                  </button>
                </div>
              </div>

              <div class="mobile-filter-content">
                <!-- Bank Account Filter -->
                <div class="mobile-filter-section">
                  <label class="mobile-filter-label">Cuenta Bancaria</label>
                  <select name="bank_account_id"
                          data-action="change->filter-drawer#applyFilter"
                          class="mobile-filter-select">
                    <option value="">Todas las cuentas</option>
                    <% @bank_accounts.each do |ba| %>
                      <option value="<%= ba.id %>" <%= "selected" if params[:bank_account_id].to_s == ba.id.to_s %>>
                        <%= ba.custom_name || "#{ba.bank_display_name} - ••••#{ba.account_number.last(4)}" %>
                      </option>
                    <% end %>
                  </select>
                </div>

                <!-- Statement File Filter -->
                <div class="mobile-filter-section">
                  <label class="mobile-filter-label">Archivo de Estado</label>
                  <select name="statement_file_id"
                          data-action="change->filter-drawer#applyFilter"
                          class="mobile-filter-select">
                    <option value="">Todos los archivos</option>
                    <% @statement_files.each do |sf| %>
                      <option value="<%= sf.id %>" <%= "selected" if params[:statement_file_id].to_s == sf.id.to_s %>>
                        <%= sf.safe_filename %>
                      </option>
                    <% end %>
                  </select>
                </div>

                <!-- Transaction Type Filter -->
                <div class="mobile-filter-section">
                  <label class="mobile-filter-label">Tipo de Transacción</label>
                  <div class="mobile-filter-chips">
                    <label class="mobile-filter-chip <%= 'active' if params[:transaction_type].blank? %>"
                           data-action="click->filter-drawer#selectChip">
                      <input type="radio" name="transaction_type" value=""
                             <%= "checked" if params[:transaction_type].blank? %>
                             data-action="change->filter-drawer#applyFilter">
                      <span>Todos</span>
                    </label>
                    <label class="mobile-filter-chip <%= 'active' if params[:transaction_type] == 'income' %>"
                           data-action="click->filter-drawer#selectChip">
                      <input type="radio" name="transaction_type" value="income"
                             <%= "checked" if params[:transaction_type] == 'income' %>
                             data-action="change->filter-drawer#applyFilter">
                      <span>Ingresos</span>
                    </label>
                    <label class="mobile-filter-chip <%= 'active' if params[:transaction_type] == 'fixed_expense' %>"
                           data-action="click->filter-drawer#selectChip">
                      <input type="radio" name="transaction_type" value="fixed_expense"
                             <%= "checked" if params[:transaction_type] == 'fixed_expense' %>
                             data-action="change->filter-drawer#applyFilter">
                      <span>Gastos Fijos</span>
                    </label>
                    <label class="mobile-filter-chip <%= 'active' if params[:transaction_type] == 'variable_expense' %>"
                           data-action="click->filter-drawer#selectChip">
                      <input type="radio" name="transaction_type" value="variable_expense"
                             <%= "checked" if params[:transaction_type] == 'variable_expense' %>
                             data-action="change->filter-drawer#applyFilter">
                      <span>Gastos Variables</span>
                    </label>
                  </div>
                </div>

                <!-- Date Range Filter -->
                <div class="mobile-filter-section">
                  <label class="mobile-filter-label">Rango de Fechas</label>
                  <input type="text"
                         id="mobile_date_range"
                         placeholder="Seleccionar rango de fechas"
                         class="mobile-date-input w-full"
                         readonly>
                  <input type="hidden" name="from_date" id="mobile_from_date" value="<%= params[:from_date] %>">
                  <input type="hidden" name="to_date" id="mobile_to_date" value="<%= params[:to_date] %>">
                </div>
              </div>
            </form>
          </div>
        </div>
      </section>
    </turbo-frame>

    <!-- STATS OVERVIEW: Responsive Transaction Statistics -->
    <turbo-frame id="transactions-stats" class="transactions-stats-frame">
      <!-- DESKTOP STATS (hidden on mobile) -->
      <section class="transactions-stats hidden md:grid">
      
      <!-- TOTAL TRANSACTIONS STAT -->
      <div class="transactions-stat-card">
        <div class="transactions-stat-content">
          <div class="transactions-stat-icon transactions-stat-icon-total">
            <svg class="transactions-stat-icon-svg transactions-stat-icon-svg-total" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
          <div class="flex-1">
            <p class="transactions-stat-label"><%= t('table_headers.transactions') %></p>
            <p class="transactions-stat-value transactions-stat-value-total"><%= @pagy.count %></p>
            <div class="mt-2 space-y-1">
              <% 
                income_count = @filtered_transactions.where(transaction_type: 'income').count
                fixed_expense_count = @filtered_transactions.where(transaction_type: 'fixed_expense').count
                variable_expense_count = @filtered_transactions.where(transaction_type: 'variable_expense').count
              %>
              <div class="flex justify-between text-xs">
                <span class="text-green-600 flex items-center">
                  <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                  </svg>
                  <%= t('transaction_types.income') %>
                </span>
                <span class="text-green-600 font-medium"><%= income_count %></span>
              </div>
              <div class="flex justify-between text-xs">
                <span class="text-red-600 flex items-center">
                  <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path>
                  </svg>
                  <%= t('transaction_types.fixed_expense') %>
                </span>
                <span class="text-red-600 font-medium"><%= fixed_expense_count %></span>
              </div>
              <div class="flex justify-between text-xs">
                <span class="text-orange-600 flex items-center">
                  <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path>
                  </svg>
                  <%= t('transaction_types.variable_expense') %>
                </span>
                <span class="text-orange-600 font-medium"><%= variable_expense_count %></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- EQUITY/UTILIDAD STAT -->
      <div class="transactions-stat-card">
        <div class="transactions-stat-content">
          <div class="transactions-stat-icon transactions-stat-icon-equity">
            <svg class="transactions-stat-icon-svg transactions-stat-icon-svg-equity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
            </svg>
          </div>
          <div class="flex-1">
            <p class="transactions-stat-label"><%= t('transaction_types.equity') %></p>
            <% 
              income_total = @filtered_transactions.where(transaction_type: 'income').sum(:amount)
              expenses_total = @filtered_transactions.where(transaction_type: ['fixed_expense', 'variable_expense']).sum(:amount)
              equity_total = income_total + expenses_total
            %>
            <p class="transactions-stat-value <%= equity_total >= 0 ? 'text-green-600' : 'text-red-600' %>">
              <%= number_to_currency(equity_total, unit: "$") %>
            </p>
            <!-- Income and Expenses breakdown -->
            <div class="mt-2 space-y-1">
              <div class="flex justify-between items-center text-xs">
                <span class="text-green-600 flex items-center">
                  <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                  </svg>
                  <%= t('transaction_types.income') %>
                </span>
                <span class="text-green-600 font-medium">
                  <%= number_to_currency(income_total, unit: "$") %>
                </span>
              </div>
              <div class="flex justify-between items-center text-xs">
                <span class="text-red-600 flex items-center">
                  <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path>
                  </svg>
                  <%= t('transaction_types.expenses') %>
                </span>
                <span class="text-red-600 font-medium">
                  <%= number_to_currency(expenses_total, unit: "$") %>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- CATEGORIES STAT -->
      <div class="transactions-stat-card">
        <div class="transactions-stat-content">
          <div class="transactions-stat-icon transactions-stat-icon-total">
            <svg class="transactions-stat-icon-svg transactions-stat-icon-svg-total" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
            </svg>
          </div>
          <div class="flex-1">
            <p class="transactions-stat-label"><%= t('navigation.categories') %></p>
            <p class="transactions-stat-value transactions-stat-value-total">
              <%= @filtered_transactions.joins(:category).distinct.count(:category_id) + (@filtered_transactions.where(category_id: nil).count > 0 ? 1 : 0) %>
            </p>
            <div class="mt-2 space-y-1">
              <% 
                # Use a different approach to avoid GROUP BY issues
                category_counts = {}
                @filtered_transactions.includes(:category).each do |transaction|
                  if transaction.category
                    category_name = transaction.category.name
                  else
                    category_name = t('transactions.no_category')
                  end
                  category_counts[category_name] = (category_counts[category_name] || 0) + 1
                end
                top_categories = category_counts.sort_by { |name, count| -count }.first(3).to_h
              %>
              <% if top_categories.any? %>
                <% top_categories.each_with_index do |(category_name, count), index| %>
                  <div class="flex justify-between text-xs">
                    <span class="text-slate-600 flex items-center">
                      <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                      </svg>
                      <%= category_name %>
                    </span>
                    <span class="text-slate-600 font-medium"><%= count %></span>
                  </div>
                <% end %>
              <% else %>
                <div class="text-xs text-slate-500 italic">
                  Sin categorías asignadas
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
      </section>

      <!-- MOBILE STATS (visible only on mobile) -->
      <section class="mobile-transactions-stats block md:hidden" data-controller="mobile-carousel">
        <div class="mobile-stats-carousel-wrapper">
          <div class="mobile-stats-carousel" data-mobile-carousel-target="container">
            <!-- Total Transactions Slide -->
            <div class="mobile-stat-slide" data-mobile-carousel-target="slide">
              <div class="mobile-stat-card mobile-stat-card-total">
                <div class="mobile-stat-icon">
                  <svg class="w-8 h-8 mx-auto text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                  </svg>
                </div>
                <div class="mobile-stat-content">
                  <span class="mobile-stat-label"><%= t('table_headers.transactions') %></span>
                  <span class="mobile-stat-value mobile-stat-value-total">
                    <%= @pagy.count %>
                  </span>
                  <span class="mobile-stat-subtitle">
                    <%= t('mobile.dashboard.this_month') %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Equity/Net Slide -->
            <div class="mobile-stat-slide" data-mobile-carousel-target="slide">
              <div class="mobile-stat-card mobile-stat-card-equity">
                <div class="mobile-stat-icon">
                  <svg class="w-8 h-8 mx-auto text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                  </svg>
                </div>
                <div class="mobile-stat-content">
                  <span class="mobile-stat-label"><%= t('transaction_types.equity') %></span>
                  <span class="mobile-stat-value <%= equity_total >= 0 ? 'text-green-600' : 'text-red-600' %>">
                    <%= number_to_currency(equity_total, unit: "$") %>
                  </span>
                  <span class="mobile-stat-subtitle">
                    <%= equity_total >= 0 ? t('mobile.dashboard.this_month') : t('mobile.dashboard.this_month') %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Categories Slide -->
            <div class="mobile-stat-slide" data-mobile-carousel-target="slide">
              <div class="mobile-stat-card mobile-stat-card-categories">
                <div class="mobile-stat-icon">
                  <svg class="w-8 h-8 mx-auto text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                  </svg>
                </div>
                <div class="mobile-stat-content">
                  <span class="mobile-stat-label"><%= t('navigation.categories') %></span>
                  <span class="mobile-stat-value mobile-stat-value-categories">
                    <%= @filtered_transactions.joins(:category).distinct.count(:category_id) + (@filtered_transactions.where(category_id: nil).count > 0 ? 1 : 0) %>
                  </span>
                  <span class="mobile-stat-subtitle">
                    <%= t('mobile.dashboard.this_month') %>
                  </span>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Carousel Indicators -->
          <div class="mobile-carousel-indicators">
            <button class="mobile-carousel-indicator active" data-mobile-carousel-target="indicator" data-index="0" data-action="click->mobile-carousel#goToSlideAction"></button>
            <button class="mobile-carousel-indicator" data-mobile-carousel-target="indicator" data-index="1" data-action="click->mobile-carousel#goToSlideAction"></button>
            <button class="mobile-carousel-indicator" data-mobile-carousel-target="indicator" data-index="2" data-action="click->mobile-carousel#goToSlideAction"></button>
          </div>
        </div>
      </section>
    </turbo-frame>

    <!-- TRANSACTIONS RESULTS: Both Desktop and Mobile -->
    <turbo-frame id="transactions-results" class="transactions-results-frame">
      <%= render 'transactions/results',
                 transactions: @transactions,
                 pagy: @pagy,
                 current_sort: @current_sort,
                 current_direction: @current_direction %>
    </turbo-frame>
  </div>
</div>

<div id="editModal" class="fixed inset-0 bg-slate-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-50">
  <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
    <div class="mt-3">
      <h3 class="text-lg font-medium text-slate-900 mb-4"><%= t('transactions.edit_transaction') %></h3>
      <form id="editForm" method="post" class="space-y-4">
        <input type="hidden" name="_method" value="patch">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input type="hidden" name="id" id="edit_transaction_id" value="">

        <!-- Transaction Type (at top for easy selection) -->
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2"><%= t('transactions.transaction_type') %> <span class="text-red-500">*</span></label>
          <select name="transaction[transaction_type]" id="edit_transaction_type" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
            <% Transaction.transaction_types.keys.each do |opt| %>
              <option value="<%= opt %>"><%= t("transaction_types.#{opt}") %></option>
            <% end %>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2"><%= t('transactions.transaction_date') %> <span class="text-red-500">*</span></label>
          <input type="date" name="transaction[date]" id="edit_date" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
        </div>
        
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2"><%= t('transactions.transaction_description') %> <span class="text-red-500">*</span></label>
          <input type="text" name="transaction[description]" id="edit_description" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="<%= t('transactions.transaction_description_placeholder') %>">
        </div>
        
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2"><%= t('transactions.transaction_amount') %> <span class="text-red-500">*</span></label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <span class="text-slate-500 sm:text-sm">$</span>
            </div>
            <input type="number" name="transaction[amount]" id="edit_amount" required step="0.01" class="w-full pl-10 pr-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="0.00">
          </div>
          <p class="mt-1 text-xs text-slate-500"><%= t('transactions.transaction_amount_help') %></p>
        </div>

        <div>
                 <label class="block text-sm font-medium text-slate-700 mb-2"><%= t('table_headers.category') %></label>
                 <div class="grouped-category-dropdown">
                   <select name="transaction[category_id]" id="edit_category_id" class="grouped-category-select">
                     <option value=""><%= t('transactions.no_category') %></option>
                     <% current_user.categories.where(parent_id: nil).where.not(name: t('categories.uncategorized')).order(:name).each do |parent_cat| %>
                       <option value="<%= parent_cat.id %>" data-has-children="<%= parent_cat.children.any? %>"><%= parent_cat.name %></option>
                       <% parent_cat.children.order(:name).each do |child_cat| %>
                         <option value="<%= child_cat.id %>" data-parent-id="<%= parent_cat.id %>" class="child-option"><%= "  └ #{child_cat.name}" %></option>
                       <% end %>
                     <% end %>
                   </select>
                   <div class="grouped-category-dropdown-content hidden" id="edit_category_dropdown">
                     <% current_user.categories.where(parent_id: nil).where.not(name: t('categories.uncategorized')).order(:name).each do |parent_cat| %>
                       <div class="grouped-category-item parent" data-category-id="<%= parent_cat.id %>" data-has-children="<%= parent_cat.children.any? %>">
                         <span><%= parent_cat.name %></span>
                         <% if parent_cat.children.any? %>
                           <span class="grouped-category-arrow"></span>
                         <% end %>
                         <% if parent_cat.children.any? %>
                           <div class="grouped-category-submenu hidden">
                             <% parent_cat.children.order(:name).each do |child_cat| %>
                               <div class="grouped-category-item child" data-category-id="<%= child_cat.id %>" data-parent-id="<%= parent_cat.id %>">
                                 <input type="checkbox" class="grouped-category-checkbox" id="edit_child_<%= child_cat.id %>">
                                 <label for="edit_child_<%= child_cat.id %>" class="flex-1 cursor-pointer"><%= child_cat.name %></label>
                               </div>
                             <% end %>
                           </div>
                         <% end %>
                       </div>
                     <% end %>
                   </div>
                 </div>
               </div>

        <!-- Transfer Account Field (shown only for transfers) -->
        <div id="edit_transfer_account_field" class="hidden">
          <label for="edit_transfer_account_id" class="block text-sm font-medium text-slate-700 mb-2">
            <span id="edit_transfer_account_label"><%= t('transactions.transfer_to') %></span> <span class="text-red-500">*</span>
          </label>
          <select name="transaction[transfer_account_id]" id="edit_transfer_account_id" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
            <option value=""><%= t('transactions.select_destination_account') %></option>
            <% @bank_accounts.each do |ba| %>
              <option value="<%= ba.id %>"><%= ba.display_name %></option>
            <% end %>
          </select>
          <p class="text-xs text-slate-500 mt-1" id="edit_transfer_account_help"><%= t('transactions.select_destination_account_help') %></p>
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2"><%= t('transactions.merchant') %></label>
          <input type="text" name="transaction[merchant]" id="edit_merchant" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="<%= t('transactions.merchant_placeholder') %>">
        </div>
        
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2"><%= t('transactions.reference') %></label>
          <input type="text" name="transaction[reference]" id="edit_reference" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="<%= t('transactions.reference_placeholder') %>">
        </div>
        
        <div class="flex justify-end space-x-3 pt-4">
          <button type="button" onclick="closeEditModal()" class="px-4 py-2 border border-slate-300 text-sm font-medium rounded-lg text-slate-700 bg-white hover:bg-slate-50 transition-colors duration-200">
            <%= t('form_actions.cancel') %>
          </button>
          <button type="submit" class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors duration-200">
            <%= t('form_actions.save_changes') %>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- CREATE TRANSACTION MODAL: Manual Transaction Creation Form -->
<div id="createTransactionModal" class="fixed inset-0 bg-slate-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-[9999]">
  <div class="relative top-10 mx-auto p-5 border w-full max-w-2xl shadow-lg rounded-md bg-white">
    <div class="mt-3">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h3 class="text-xl font-semibold text-slate-900"><%= t('transactions.manual_transaction') %></h3>
          <p class="text-sm text-slate-600 mt-1"><%= t('transactions.manual_transaction_description') %></p>
        </div>
        <button onclick="closeCreateTransactionModal()" class="text-slate-400 hover:text-slate-600 transition-colors duration-200">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      
      <form id="createTransactionForm" method="post" action="<%= transactions_path %>" class="space-y-6">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

        <!-- Transaction Type (at top for easy selection) -->
        <div>
          <label for="create_transaction_type" class="block text-sm font-medium text-slate-700 mb-2">
            <%= t('transactions.transaction_type') %> <span class="text-red-500">*</span>
          </label>
          <select name="transaction[transaction_type]" id="create_transaction_type" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
            <% Transaction.transaction_types.keys.reject { |k| k == 'transfer_in' }.each do |opt| %>
              <option value="<%= opt %>" <%= 'selected' if opt == 'variable_expense' %>><%= t("transaction_types.#{opt}") %></option>
            <% end %>
          </select>
        </div>

        <!-- Bank Account Selection (label changes to "From:" for transfers) -->
        <div>
          <label for="create_bank_account_id" class="block text-sm font-medium text-slate-700 mb-2">
            <span id="create_bank_account_label"><%= t('transactions.select_bank_account') %></span> <span class="text-red-500">*</span>
          </label>
          <select name="transaction[bank_account_id]" id="create_bank_account_id" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
            <option value=""><%= t('transactions.select_bank_account_placeholder') %></option>
            <% @bank_accounts.each do |ba| %>
              <option value="<%= ba.id %>"><%= ba.custom_name %></option>
            <% end %>
          </select>
          <p class="text-xs text-slate-500 mt-1" id="create_bank_account_help"><%= t('transactions.select_bank_account_help') %></p>
        </div>

        <!-- Transfer Destination Field (shown only for transfers, right after bank account) -->
        <div id="create_transfer_account_field" class="hidden">
          <label for="create_transfer_account_id" class="block text-sm font-medium text-slate-700 mb-2">
            <%= t('transactions.transfer_to') %> <span class="text-red-500">*</span>
          </label>
          <select name="transaction[transfer_account_id]" id="create_transfer_account_id" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
            <option value=""><%= t('transactions.select_destination_account') %></option>
            <% @bank_accounts.each do |ba| %>
              <option value="<%= ba.id %>"><%= ba.display_name %></option>
            <% end %>
          </select>
          <p class="text-xs text-slate-500 mt-1"><%= t('transactions.select_destination_account_help') %></p>
        </div>

        <!-- Date and Amount Row -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="create_date" class="block text-sm font-medium text-slate-700 mb-2">
              <%= t('transactions.transaction_date') %> <span class="text-red-500">*</span>
            </label>
            <input type="date" name="transaction[date]" id="create_date" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
          </div>
          
          <div>
            <label for="create_amount" class="block text-sm font-medium text-slate-700 mb-2">
              <%= t('transactions.transaction_amount') %> <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <span class="text-slate-500 sm:text-sm">$</span>
              </div>
              <input type="number" name="transaction[amount]" id="create_amount" required step="0.01" class="w-full pl-10 pr-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="0.00">
            </div>
            <p class="text-xs text-slate-500 mt-1"><%= t('transactions.transaction_amount_help') %></p>
          </div>
        </div>
        
        <!-- Description -->
        <div>
          <label for="create_description" class="block text-sm font-medium text-slate-700 mb-2">
            <%= t('transactions.transaction_description') %> <span class="text-red-500">*</span>
          </label>
          <input type="text" name="transaction[description]" id="create_description" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="<%= t('transactions.transaction_description_placeholder') %>">
        </div>
        
        <!-- Category -->
        <div>
            <label for="create_category_id" class="block text-sm font-medium text-slate-700 mb-2">
              <%= t('transactions.select_category') %>
            </label>
            <div class="grouped-category-dropdown">
              <select name="transaction[category_id]" id="create_category_id" class="grouped-category-select">
                <option value=""><%= t('transactions.select_category_placeholder') %></option>
                <% current_user.categories.where(parent_id: nil).where.not(name: t('categories.uncategorized')).order(:name).each do |parent_cat| %>
                  <option value="<%= parent_cat.id %>" data-has-children="<%= parent_cat.children.any? %>"><%= parent_cat.name %></option>
                  <% parent_cat.children.order(:name).each do |child_cat| %>
                    <option value="<%= child_cat.id %>" data-parent-id="<%= parent_cat.id %>" class="child-option"><%= "  └ #{child_cat.name}" %></option>
                  <% end %>
                <% end %>
              </select>
              <div class="grouped-category-dropdown-content hidden" id="create_category_dropdown">
                <% current_user.categories.where(parent_id: nil).where.not(name: t('categories.uncategorized')).order(:name).each do |parent_cat| %>
                  <div class="grouped-category-item parent" data-category-id="<%= parent_cat.id %>" data-has-children="<%= parent_cat.children.any? %>">
                    <span><%= parent_cat.name %></span>
                    <% if parent_cat.children.any? %>
                      <span class="grouped-category-arrow"></span>
                    <% end %>
                    <% if parent_cat.children.any? %>
                      <div class="grouped-category-submenu hidden">
                        <% parent_cat.children.order(:name).each do |child_cat| %>
                          <div class="grouped-category-item child" data-category-id="<%= child_cat.id %>" data-parent-id="<%= parent_cat.id %>">
                            <input type="checkbox" class="grouped-category-checkbox" id="create_child_<%= child_cat.id %>">
                            <label for="create_child_<%= child_cat.id %>" class="flex-1 cursor-pointer"><%= child_cat.name %></label>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
            <p class="text-xs text-slate-500 mt-1"><%= t('transactions.select_category_help') %></p>
          </div>
        </div>


        <!-- Merchant and Reference Row -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="create_merchant" class="block text-sm font-medium text-slate-700 mb-2">
              <%= t('transactions.merchant') %> <span class="text-slate-400 text-xs">(opcional)</span>
            </label>
            <input type="text" name="transaction[merchant]" id="create_merchant" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="<%= t('transactions.merchant_placeholder') %>">
          </div>
          
          <div>
            <label for="create_reference" class="block text-sm font-medium text-slate-700 mb-2">
              <%= t('transactions.reference') %> <span class="text-slate-400 text-xs">(opcional)</span>
            </label>
            <input type="text" name="transaction[reference]" id="create_reference" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="<%= t('transactions.reference_placeholder') %>">
          </div>
        </div>
        
        <!-- Form Actions -->
        <div class="flex justify-end space-x-3 pt-6 border-t border-slate-200">
          <button type="button" onclick="closeCreateTransactionModal()" class="px-6 py-2 border border-slate-300 text-sm font-medium rounded-lg text-slate-700 bg-white hover:bg-slate-50 transition-colors duration-200">
            <%= t('form_actions.cancel') %>
          </button>
          <button type="submit" class="px-6 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors duration-200" style="pointer-events: auto; position: relative; z-index: 10;">
            <%= t('transactions.create_transaction') %>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

