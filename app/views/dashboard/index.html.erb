<!-- DELETE CONFIRMATION MODAL -->
<div id="deleteModal" class="fixed inset-0 bg-slate-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-50">
  <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white dark:bg-slate-800">
    <div class="mt-3">
      <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-red-100 mb-4">
        <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
        </svg>
      </div>
      <h3 class="text-lg font-medium text-slate-900 dark:text-slate-100 mb-2 text-center"><%= t('statement_files.confirm_delete_title') %></h3>
      <div class="mt-2 px-7 pt-1">
        <p class="text-sm text-slate-500 dark:text-slate-400 text-center" id="deleteModalMessage">
          <!-- Message will be populated by JavaScript -->
        </p>
        <p class="text-sm text-red-600 font-medium text-center mt-2">
          <%= t('statement_files.cannot_undo') %>
        </p>
      </div>
      <div class="flex justify-end space-x-3 pt-4">
        <button type="button" onclick="closeDeleteModal()" class="px-4 py-2 border border-slate-300 dark:border-slate-600 text-sm font-medium rounded-lg text-slate-700 dark:text-slate-300 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 dark:bg-slate-900 transition-colors duration-200">
          <%= t('form_actions.cancel') %>
        </button>
        <form id="deleteForm" method="post" style="display: inline;">
          <input type="hidden" name="_method" value="delete">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
          <button type="submit" class="px-4 py-2 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700 transition-colors duration-200">
            <%= t('statement_files.delete') %>
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
  // Show toast notifications for actions
  document.addEventListener('DOMContentLoaded', function() {

    // Check URL parameters for action feedback
    const urlParams = new URLSearchParams(window.location.search);
    const action = urlParams.get('action');
    const fileName = urlParams.get('fileName');
    
    if (action === 'deleted' && fileName) {
      if (window.showToast) {
        window.showToast(`<%= t('flash.statement_deleted', filename: '${fileName}') %>`, 'notice');
      }
    }
    
    // Check if user just logged in (no referrer or referrer is login page)
    if (!document.referrer || document.referrer.includes('/session')) {
      if (window.showToast) {
        window.showToast('<%= t('flash.signed_in') %>', 'notice');
      }
    }
  });

  // Delete confirmation modal functions
  function openDeleteModal(statementId, fileName, transactionCount) {
    const message = `<%= t('confirm_delete_statement', count: 'PLACEHOLDER') %>`.replace('PLACEHOLDER', transactionCount);
    document.getElementById('deleteModalMessage').innerHTML = message;
    
    const form = document.getElementById('deleteForm');
    form.action = `/statement_files/${statementId}`;
    
    document.getElementById('deleteModal').classList.remove('hidden');
  }

  function closeDeleteModal() {
    document.getElementById('deleteModal').classList.add('hidden');
  }

  // Month picker functionality
  function changeMonth(monthValue) {
    if (monthValue) {
      Turbo.visit(`/dashboard?month=${monthValue}`);
    }
  }

  // Jump to current month
  function jumpToCurrentMonth() {
    const currentMonth = new Date().toISOString().slice(0, 7); // YYYY-MM format
    Turbo.visit(`/dashboard?month=${currentMonth}`);
  }

  // Navigate to previous month
  function previousMonth() {
    const monthSelector = document.getElementById('month-selector');
    const currentValue = monthSelector.value;
    const [year, month] = currentValue.split('-');
    let newYear = parseInt(year);
    let newMonth = parseInt(month) - 1;
    
    if (newMonth < 1) {
      newMonth = 12;
      newYear -= 1;
    }
    
    const newMonthStr = newMonth.toString().padStart(2, '0');
    const newMonthValue = `${newYear}-${newMonthStr}`;
    
    // Navigate to the previous month regardless of whether it's in the dropdown
    changeMonth(newMonthValue);
  }

  // Navigate to next month
  function nextMonth() {
    const monthSelector = document.getElementById('month-selector');
    const currentValue = monthSelector.value;
    const [year, month] = currentValue.split('-');
    let newYear = parseInt(year);
    let newMonth = parseInt(month) + 1;
    
    if (newMonth > 12) {
      newMonth = 1;
      newYear += 1;
    }
    
    const newMonthStr = newMonth.toString().padStart(2, '0');
    const newMonthValue = `${newYear}-${newMonthStr}`;
    
    // Navigate to the next month regardless of whether it's in the dropdown
    changeMonth(newMonthValue);
  }


</script>
