<!-- Belvo Connect Widget Modal -->
<div id="belvoConnectModal" class="modal-overlay">
  <div class="modal-content max-w-lg mx-auto mt-20 bg-white rounded-2xl shadow-xl overflow-hidden">
    <!-- Modal Header -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-200">
      <div>
        <h2 class="text-lg font-semibold text-slate-900"><%= t("belvo.connect_bank") %></h2>
        <p class="text-sm text-slate-500 mt-0.5"><%= t("belvo.connect_bank_description") %></p>
      </div>
      <%= link_to bank_accounts_path, class: "p-2 text-slate-400 hover:text-slate-600 rounded-lg hover:bg-slate-100 transition-colors" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      <% end %>
    </div>

    <!-- Belvo Widget Container -->
    <div class="p-6"
         data-controller="belvo-connect"
         data-belvo-connect-access-token-value="<%= @access_token %>"
         data-belvo-connect-callback-url-value="<%= belvo_links_path %>"
         data-belvo-connect-environment-value="<%= @belvo_environment %>">
      <div id="belvo" class="min-h-[400px] flex items-center justify-center">
        <div class="text-center text-slate-400">
          <svg class="w-8 h-8 mx-auto mb-2 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <p class="text-sm"><%= t("belvo.loading_widget") %></p>
        </div>
      </div>
    </div>

    <!-- Remaining connections info -->
    <div class="px-6 py-3 bg-slate-50 border-t border-slate-200">
      <p class="text-xs text-slate-500 text-center">
        <%= t("belvo.remaining_connections", count: current_user.remaining_bank_connections) %>
      </p>
    </div>
  </div>
</div>
