<section class="py-20 md:py-28 bg-white" id="banks">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12" data-landing-scroll-target="section">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight">
        <%= t("landing.banks.title") %>
      </h2>
      <p class="mt-4 text-lg text-slate-600">
        <%= t("landing.banks.subtitle") %>
      </p>
    </div>

    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-7 gap-6 lg:gap-8 items-center justify-items-center" data-landing-scroll-target="section">
      <% %w[bbva banorte hsbc santander scotiabank banamex nu revolut banregio banbajio inbursa afirme azteca].each do |bank| %>
        <div class="bank-logo-grayscale flex items-center justify-center p-3 w-full">
          <%= image_tag "banks/#{bank}.svg",
                alt: bank.capitalize,
                class: "h-8 md:h-10 w-auto max-w-[120px] object-contain" %>
        </div>
      <% end %>
    </div>
  </div>
</section>
