// Handle amount input - simple numeric input only
function handleAmountInput(event) {
  const input = event.target;
  
  // Allow only numbers, decimal point, and commas
  let value = input.value.replace(/[^0-9.,]/g, '');
  
  // Ensure only one decimal point
  const parts = value.split('.');
  if (parts.length > 2) {
    value = parts[0] + '.' + parts.slice(1).join('');
  }
  
  // Update the value
  input.value = value;
  
  // Auto-resize input based on content
  autoResizeInput(input);
}

// Auto-resize input based on content
function autoResizeInput(input) {
  // Create a temporary span to measure text width
  const span = document.createElement('span');
  span.style.visibility = 'hidden';
  span.style.position = 'absolute';
  span.style.fontSize = '1.875rem'; // text-3xl
  span.style.fontWeight = 'bold';
  span.style.fontFamily = 'inherit';
  span.textContent = input.value || input.placeholder || '0.00';
  
  document.body.appendChild(span);
  const width = span.offsetWidth;
  document.body.removeChild(span);
  
  // Set width with some padding, but within min/max bounds
  const newWidth = Math.max(60, Math.min(150, width + 20));
  input.style.width = newWidth + 'px';
}

// Update amount styling based on transaction type
function updateAmountStyling(transactionType, amountElement) {
  if (!amountElement) return;

  const isPositive = transactionType === 'income' || transactionType === 'transfer_in';
  const colorClass = isPositive ? 'text-green-600' : 'text-red-600';

  // Update the sign display
  const signElement = document.getElementById('mobileAmountSign');
  if (signElement) {
    signElement.textContent = isPositive ? '+' : '-';
    signElement.className = `text-3xl font-bold ${colorClass}`;
  }

  // Update the currency symbol color
  const currencyElement = document.getElementById('mobileAmountCurrency');
  if (currencyElement) {
    currencyElement.className = `text-3xl font-bold ${colorClass}`;
  }

  // Update the amount input color
  amountElement.className = `text-3xl font-bold text-center bg-transparent border-0 outline-none min-w-0 ${colorClass}`;
}

// Save mobile transaction changes
function saveMobileTransaction() {
  // Get current transaction ID (we'll need to store this when opening modal)
  const transactionId = window.currentMobileTransactionId;
  if (!transactionId) {
    return;
  }

  // Get all field values
  const description = document.getElementById('mobileDetailsDescription').value;
  const date = document.getElementById('mobileDetailsDate').value;
  const categoryId = document.getElementById('mobileDetailsCategory').value;
  const bankAccountId = document.getElementById('mobileDetailsAccount').value;
  const merchant = document.getElementById('mobileDetailsMerchant').value;
  const reference = document.getElementById('mobileDetailsReference').value;
  const transactionType = document.getElementById('mobileDetailsType').value;
  const rawAmount = parseFloat(document.getElementById('mobileDetailsAmount').value.replace(/,/g, '')) || 0;

  // Map English values back to what the server expects (keeping English for now)
  const serverTransactionType = transactionType; // We'll keep English values for server

  // Apply amount sign based on transaction type
  const amount = transactionType === 'income' ? Math.abs(rawAmount) : -Math.abs(rawAmount);

  // Create form data
  const formData = new FormData();
  formData.append('_method', 'PATCH');
  formData.append('transaction[description]', description);
  formData.append('transaction[date]', date);
  formData.append('transaction[category_id]', categoryId);
  formData.append('transaction[bank_account_id]', bankAccountId);
  formData.append('transaction[merchant]', merchant);
  formData.append('transaction[reference]', reference);
  formData.append('transaction[transaction_type]', serverTransactionType);
  formData.append('transaction[amount]', amount);

  // Add CSRF token
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
  if (csrfToken) {
    formData.append('authenticity_token', csrfToken);
  }

  // Submit the update
  fetch(`/transactions/${transactionId}`, {
    method: 'POST',
    body: formData,
    headers: {
      'X-Requested-With': 'XMLHttpRequest'
    }
  })
  .then(response => {
    if (response.ok) {
      // Close modal and refresh the page to show updated data
      closeMobileTransactionDetails();
      setTimeout(() => {
        window.location.reload();
      }, 300);
    } else {
    }
  })
  .catch(error => {
  });
}

// Get transaction data from DOM
function getTransactionData(transactionId) {
  console.log('Getting transaction data for ID:', transactionId);

  // Try to find mobile card first (more specific selector)
  let element = document.querySelector(`.mobile-transaction-card[data-transaction-id="${transactionId}"]`);

  // If not found, try desktop table row
  if (!element) {
    element = document.querySelector(`.transactions-table-row[data-transaction-id="${transactionId}"]`);
  }

  console.log('Found element:', element);

  if (!element) {
    console.error('Element not found for transaction ID:', transactionId);
    return null;
  }


  // Check if it's a mobile card or desktop row
  const isMobileCard = element.classList.contains('mobile-transaction-card');
  console.log('Is mobile card:', isMobileCard);

  if (isMobileCard) {
    // Extract data from mobile card data attributes

    const data = {
      id: transactionId,
      amount: element.dataset.amount || '',
      description: element.dataset.description || '',
      date: element.dataset.date || '',
      transaction_type: element.dataset.transactionType || '',
      category_id: element.dataset.categoryId || '',
      category: element.dataset.categoryName || '',
      account_id: element.dataset.accountId || '',
      account: element.dataset.accountName || '',
      merchant: element.dataset.merchant || '',
      reference: element.dataset.reference || '',
      source: element.dataset.source || ''
    };


    return data;
  } else {
    // Extract data from desktop table row
    const dateCell = element.querySelector('[data-date]');
    const descriptionCell = element.querySelector('[data-description]');
    const amountCell = element.querySelector('[data-amount]');
    const categoryCell = element.querySelector('[data-category-id]');
    const typeCell = element.querySelector('[data-transaction-type]');
    const merchantCell = element.querySelector('[data-merchant]');
    const referenceCell = element.querySelector('[data-reference]');

    return {
      id: transactionId,
      description: descriptionCell?.dataset.description || '',
      amount: amountCell?.dataset.amount || '',
      category: categoryCell?.textContent?.trim() || 'No category',
      account: element.querySelector('.transactions-table-cell-account')?.textContent?.trim() || '',
      transaction_type: typeCell?.dataset.transactionType || '',
      source: element.querySelector('.transactions-action-btn-delete') ? 'manual' : 'imported',
      date: dateCell?.dataset.date || '',
      merchant: merchantCell?.dataset.merchant || '',
      reference: referenceCell?.dataset.reference || ''
    };
  }
}

// Populate mobile transaction details modal
function populateMobileTransactionDetails(data) {
  // Check if modal exists first
  const modal = document.getElementById('mobileTransactionDetailsModal');

  // Amount
  const amountElement = document.getElementById('mobileDetailsAmount');
  if (!amountElement) {
    return;
  }

  // Format amount as currency with proper sign
  const rawAmount = parseFloat(data.amount || 0);

  // Determine if this should be positive or negative based on transaction type
  let displayAmount;
  // Transaction type should already be in enum format
  let mappedType = data.transaction_type || 'variable_expense';

  // Set the display amount with proper sign
  displayAmount = Math.abs(rawAmount);

  // Format the amount with commas and 2 decimals
  const formattedAmount = displayAmount.toLocaleString('en-US', {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
  });

  // Set the formatted amount in the input
  amountElement.value = formattedAmount;

  // Auto-resize the input based on the initial value
  autoResizeInput(amountElement);

  // Update the sign display and currency symbol color based on transaction type
  const signElement = document.getElementById('mobileAmountSign');
  const currencyElement = document.getElementById('mobileAmountCurrency');
  const colorClass = (mappedType === 'income' || mappedType === 'transfer_in') ? 'text-green-600' : 'text-red-600';
  
  if (signElement) {
    const sign = (mappedType === 'income' || mappedType === 'transfer_in') ? '+' : '-';
    signElement.textContent = sign;
    signElement.className = `text-3xl font-bold ${colorClass}`;
  }
  
  if (currencyElement) {
    currencyElement.className = `text-3xl font-bold ${colorClass}`;
  }
  
  // Update the amount input color
  amountElement.className = `text-3xl font-bold text-center bg-transparent border-0 outline-none min-w-0 ${colorClass}`;

  // Remove the old event listeners and add new ones
  amountElement.removeEventListener('blur', updateAmountStyling);
  amountElement.removeEventListener('input', handleAmountInput);
  
  // Add new event listeners for clean typing experience
  amountElement.addEventListener('input', handleAmountInput);

  // We'll apply styling after mapping the transaction type

  // Transaction type (should already be in enum format)
  const typeElement = document.getElementById('mobileDetailsType');
  if (typeElement) {
    // Transaction type should already be in enum format
    const transactionTypeValue = data.transaction_type || 'variable_expense';

    typeElement.value = transactionTypeValue;

    // Apply color styling based on transaction type
    updateAmountStyling(transactionTypeValue, amountElement);

    // Add event listener for transaction type change
    typeElement.onchange = function() {
      updateAmountStyling(this.value, amountElement);
    };
  }

  // Description
  const descriptionElement = document.getElementById('mobileDetailsDescription');
  if (descriptionElement) {
    descriptionElement.value = data.description || '';
  }

  // Date
  const dateElement = document.getElementById('mobileDetailsDate');
  if (dateElement) {
    dateElement.value = data.date || '';
  }

  // Account (Bank Account)
  const accountElement = document.getElementById('mobileDetailsAccount');
  if (accountElement) {
    // Create an option with the account name for display
    if (data.account) {
      accountElement.innerHTML = `<option value="${data.account_id || ''}">${data.account}</option>`;
      accountElement.value = data.account_id || '';
    } else {
      accountElement.innerHTML = '<option value="">No Account</option>';
      accountElement.value = '';
    }
  }

  // Category
  const categoryElement = document.getElementById('mobileDetailsCategory');
  if (categoryElement) {
    // If we have category_id, use it, otherwise create an option with the name
    if (data.category_id) {
      categoryElement.value = data.category_id;
    } else if (data.category) {
      // Create a temporary option with the category name
      categoryElement.innerHTML = `<option value="">${data.category}</option>`;
      categoryElement.value = '';
    } else {
      categoryElement.innerHTML = '<option value="">No Category</option>';
      categoryElement.value = '';
    }
  }

  // Merchant
  const merchantSection = document.getElementById('mobileMerchantSection');
  const merchantElement = document.getElementById('mobileDetailsMerchant');
  if (merchantSection && merchantElement) {
    merchantElement.value = data.merchant || '';
    merchantSection.classList.remove('hidden');
  }

  // Reference
  const referenceSection = document.getElementById('mobileReferenceSection');
  const referenceElement = document.getElementById('mobileDetailsReference');
  if (referenceSection && referenceElement) {
    referenceElement.value = data.reference || '';
    referenceSection.classList.remove('hidden');
  }

  // Source
  const sourceElement = document.getElementById('mobileDetailsSource');
  if (sourceElement) {
    sourceElement.textContent = data.source === 'manual' ? 'Manual Entry' : 'Bank Import';
  }
}

// Initialize mobile interactions on page load
document.addEventListener('DOMContentLoaded', function() {
  initializeMobileSwipeGestures();
});

document.addEventListener('turbo:load', function() {
  initializeMobileSwipeGestures();
});

// Initialize swipe-to-delete gestures for mobile transaction cards
function initializeMobileSwipeGestures() {
  const swipeableCards = document.querySelectorAll('[data-swipeable="true"]');

  swipeableCards.forEach(card => {
    let startX = 0;
    let currentX = 0;
    let isDragging = false;
    const threshold = 100; // Minimum swipe distance to trigger delete

    // Touch start
    card.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      isDragging = true;
      card.style.transition = 'none';
    });

    // Touch move
    card.addEventListener('touchmove', (e) => {
      if (!isDragging) return;

      currentX = e.touches[0].clientX;
      const deltaX = currentX - startX;

      // Only allow left swipes (negative deltaX)
      if (deltaX < 0) {
        const translateX = Math.max(deltaX, -150); // Max swipe distance
        card.style.transform = `translateX(${translateX}px)`;

        // Show delete action when swiped enough
        const deleteAction = card.querySelector('.mobile-transaction-delete-action');
        if (deleteAction) {
          deleteAction.style.opacity = Math.min(Math.abs(deltaX) / threshold, 1);
        }
      }
    });

    // Touch end
    card.addEventListener('touchend', (e) => {
      if (!isDragging) return;
      isDragging = false;

      const deltaX = currentX - startX;
      card.style.transition = 'transform 0.3s ease, opacity 0.3s ease';

      if (Math.abs(deltaX) > threshold) {
        // Swipe was far enough - keep showing delete option
        card.style.transform = 'translateX(-80px)';
        const deleteAction = card.querySelector('.mobile-transaction-delete-action');
        if (deleteAction) {
          deleteAction.style.opacity = '1';
        }
      } else {
        // Snap back to original position
        card.style.transform = 'translateX(0)';
        const deleteAction = card.querySelector('.mobile-transaction-delete-action');
        if (deleteAction) {
          deleteAction.style.opacity = '0';
        }
      }
    });

    // Reset card position when clicking elsewhere
    document.addEventListener('click', (e) => {
      if (!card.contains(e.target)) {
        card.style.transition = 'transform 0.3s ease, opacity 0.3s ease';
        card.style.transform = 'translateX(0)';
        const deleteAction = card.querySelector('.mobile-transaction-delete-action');
        if (deleteAction) {
          deleteAction.style.opacity = '0';
        }
      }
    });
  });
}


