<% content_for :title, t('savings.edit', name: @saving.name) %>
<% content_for :hide_fab, true %>
<% content_for :hide_mobile_header, true %>

<div class="block md:hidden mobile-form-page" data-controller="saving-form">
  <%= render "shared/mobile_form_header",
      title: t('savings.edit'),
      back_url: saving_path(@saving) %>

  <div class="mobile-form-body mobile-form-fields">
    <% if flash[:alert] %>
      <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-xl">
        <p class="text-sm text-red-800"><%= flash[:alert] %></p>
      </div>
    <% end %>

    <%= render "form", saving: @saving, form_id: "mobile_saving_form" %>
  </div>

  <%= render "shared/mobile_form_footer",
      form_id: "mobile_saving_form",
      controller_name: "saving-form",
      label: t("form_actions.save", default: "Guardar") %>
</div>

<div class="hidden md:block min-h-screen bg-slate-50 dark:bg-slate-900" data-controller="saving-form">
  <header class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 px-8 py-6">
    <div class="max-w-3xl mx-auto">
      <div class="flex items-center justify-between mb-4">
        <%= link_to saving_path(@saving), class: "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:text-slate-100 flex items-center" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          <%= t('savings.back_to_saving') %>
        <% end %>
      </div>
      <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100"><%= t('savings.edit') %></h1>
      <p class="text-slate-600 dark:text-slate-400 mt-2"><%= t('savings.edit_description', name: @saving.name) %></p>
    </div>
  </header>

  <div class="max-w-3xl mx-auto px-8 py-8">
    <% if flash[:alert] %>
      <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
        <p class="text-sm text-red-800"><%= flash[:alert] %></p>
      </div>
    <% end %>

    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6">
      <%= render 'form', saving: @saving %>
    </div>
  </div>
</div>
