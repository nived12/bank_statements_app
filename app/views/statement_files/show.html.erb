<!-- STATEMENT FILE SHOW PAGE: File Details and Management -->
<% if @statement_file.nil? %>
  <div class="error-page">
    <h1><%= t('statement_file_not_found') %></h1>
    <p><%= t('statement_file_not_found_description') %></p>
    <a href="/dashboard" class="btn btn-primary"><%= t('back_to_dashboard') %></a>
  </div>
<% else %>
<main class="statement-file-page">
  <div class="statement-file-main">
    
    <!-- HEADER SECTION: Page Title and Actions -->
    <header class="statement-file-header">
      <div class="statement-file-header-actions">
        <div class="statement-file-header-left">
          <h1 class="statement-file-header-title"><%= t('statement_file_details') %></h1>
          <p class="statement-file-header-subtitle"><%= t('view_and_manage_statement') %></p>
        </div>
        <div class="statement-file-header-right">
          <a href="/dashboard" class="statement-file-button statement-file-button-secondary">
            <svg class="statement-file-button-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <%= t('back_to_dashboard') %>
          </a>
          <button onclick="openDeleteModal()" class="statement-file-button statement-file-button-danger-minimal" title="<%= t('delete_statement_file') %>" aria-label="<%= t('delete_statement_file') %>">
            <svg class="statement-file-button-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- FILE ATTACHMENT WARNING -->
    <% unless @statement_file.file.attached? %>
      <div class="statement-file-warning">
        <div class="statement-file-warning-content">
          <svg class="statement-file-warning-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="24" height="24" style="width: 24px !important; height: 24px !important; max-width: 24px !important; max-height: 24px !important;">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
          </svg>
          <div class="statement-file-warning-text">
            <h4 class="statement-file-warning-title"><%= t('file_not_attached') %></h4>
            <p class="statement-file-warning-description"><%= t('file_not_attached_description') %></p>
          </div>
        </div>
      </div>
    <% end %>

    <!-- FILE OVERVIEW CARD: Basic Information -->
    <section class="statement-file-overview">
      <div class="statement-file-card">
        <div class="statement-file-card-header">
          <h3 class="statement-file-card-title"><%= t('file_overview') %></h3>
        </div>
        <div class="statement-file-card-content">
          <div class="statement-file-info-grid">
            <div class="statement-file-info-item">
              <span class="statement-file-info-label"><%= t('filename') %></span>
              <span class="statement-file-info-value"><%= @statement_file.file.attached? ? @statement_file.file.filename.to_s : t('no_file_attached') %></span>
            </div>
            <div class="statement-file-info-item">
              <span class="statement-file-info-label"><%= t('bank_account') %></span>
              <span class="statement-file-info-value"><%= @statement_file.bank_account&.display_name || t('no_bank_account') %></span>
            </div>
            <div class="statement-file-info-item">
              <span class="statement-file-info-label"><%= t('upload_date') %></span>
              <span class="statement-file-info-value"><%= @statement_file.created_at.strftime("%B %d, %Y at %I:%M %p") %></span>
            </div>
            <div class="statement-file-info-item">
              <span class="statement-file-info-label"><%= t('status') %></span>
              <span class="statement-file-status-badge statement-file-status-<%= @statement_file.status || 'pending' %>">
                <%= (@statement_file.status || 'pending').humanize %>
              </span>
            </div>
            <% if @statement_file.parsed_json && @statement_file.parsed_json["extraction_source"] %>
              <div class="statement-file-info-item">
                <span class="statement-file-info-label"><%= t('extraction_method') %></span>
                                    <span class="statement-file-info-value"><%= t("extraction_sources.#{@statement_file.parsed_json['extraction_source']}", default: t('unknown')) %></span>
              </div>
            <% end %>
            <% if @statement_file.processed_at %>
              <div class="statement-file-info-item">
                <span class="statement-file-info-label"><%= t('processed_at') %></span>
                <span class="statement-file-info-value"><%= @statement_file.processed_at.strftime("%B %d, %Y at %I:%M %p") %></span>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESSING STATUS CARD: Current Status and Actions -->
    <section class="statement-file-status-section">
      <div class="statement-file-card">
        <div class="statement-file-card-header">
          <h3 class="statement-file-card-title"><%= t('processing_status') %></h3>
        </div>
        <div class="statement-file-card-content">
          <% status = @statement_file.status || 'pending' %>
          <% case status %>
          <% when "pending", "processing" %>
            <div class="statement-file-status-pending">
              <div class="statement-file-status-icon statement-file-status-icon-pending">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div class="statement-file-status-content">
                <h4 class="statement-file-status-title"><%= t('processing_in_progress') %></h4>
                <p class="statement-file-status-description">
                  <% if status == "processing" %>
                    <%= t('statement_is_being_processed') %>
                  <% else %>
                    <%= t('statement_is_queued_for_processing') %>
                  <% end %>
                </p>
                
                <!-- Motivational Quote -->

                <div class="statement-file-motivational-quote" 
                     data-controller="motivational-quotes"
                     data-quotes='<%= @quotes_data.to_json.html_safe %>'>
                  <div class="motivational-quote-text" data-motivational-quotes-target="quote">
                    <!-- Quote will be populated by JavaScript -->
                  </div>
                  <div class="motivational-quote-author" data-motivational-quotes-target="author">
                    <!-- Author will be populated by JavaScript -->
                  </div>

                </div>
                <% if status == "processing" %>
                  <div class="statement-file-status-progress">
                    <div class="statement-file-spinner-container">
                      <div class="statement-file-spinner"></div>
                    </div>
                    <p class="statement-file-status-progress-text"><%= t('please_wait_this_may_take_a_few_minutes') %></p>
                  </div>
                <% end %>
                <div class="statement-file-status-actions">
                  <% if @statement_file.file.attached? %>
                    <a href="<%= rails_blob_path(@statement_file.file, disposition: "attachment") %>" class="statement-file-button statement-file-button-primary">
                      <svg class="statement-file-button-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                      </svg>
                      <%= t('download_file') %>
                    </a>
                  <% end %>
                </div>
              </div>
            </div>
          <% when "parsed", "processed" %>
            <div class="statement-file-status-success">
              <div class="statement-file-status-icon statement-file-status-icon-success">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div class="statement-file-status-content">
                <h4 class="statement-file-status-title"><%= t('processing_complete') %></h4>
                <p class="statement-file-status-description">
                  <% if @statement_file.transactions.exists? %>
                    <%= t('statement_has_been_processed_successfully') %>
                    <span class="statement-file-status-transaction-count">
                      <%= t('transactions_imported', count: @statement_file.transactions.count) %>
                    </span>
                  <% else %>
                    <%= t('statement_has_been_processed_successfully') %>
                  <% end %>
                </p>
                <% if @statement_file.parsed_json && @statement_file.parsed_json["extraction_source"] %>
                  <div class="statement-file-status-method">
                    <span class="statement-file-status-method-label"><%= t('extraction_method') %>:</span>
                    <span class="statement-file-status-method-value"><%= t("extraction_sources.#{@statement_file.parsed_json['extraction_source']}", default: t('unknown')) %></span>
                  </div>
                <% end %>
                <div class="statement-file-status-actions">
                  <% if @statement_file.file.attached? %>
                    <a href="<%= rails_blob_path(@statement_file.file, disposition: "attachment") %>" class="statement-file-button statement-file-button-primary">
                      <svg class="statement-file-button-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                      </svg>
                      <%= t('download_file') %>
                    </a>
                  <% end %>
                  <% if @statement_file.transactions.exists? %>
                    <a href="/transactions" class="statement-file-button statement-file-button-secondary">
                      <svg class="statement-file-button-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                      </svg>
                      <%= t('view_transactions') %>
                    </a>
                  <% end %>
                </div>
              </div>
            </div>
          <% when "error" %>
            <div class="statement-file-status-error">
              <div class="statement-file-status-icon statement-file-status-icon-error">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                </svg>
              </div>
              <div class="statement-file-status-content">
                <h4 class="statement-file-status-title"><%= t('processing_failed') %></h4>
                <p class="statement-file-status-description"><%= t('there_was_an_error_processing_the_statement') %></p>
                <% if @statement_file.error_message.present? %>
                  <div class="statement-file-error-details">
                    <p class="statement-file-error-message"><%= @statement_file.error_message %></p>
                  </div>
                <% end %>
                <div class="statement-file-status-actions">
                  <% if @statement_file.file.attached? %>
                    <a href="<%= rails_blob_path(@statement_file.file, disposition: "attachment") %>" class="statement-file-button statement-file-button-primary">
                      <svg class="statement-file-button-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                      </svg>
                      <%= t('download_file') %>
                    </a>
                  <% end %>
                  <button onclick="retryProcessing()" class="statement-file-button statement-file-button-secondary">
                    <svg class="statement-file-button-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                    <%= t('retry_processing') %>
                  </button>
                </div>
              </div>
            </div>
          <% else %>
            <div class="statement-file-status-unknown">
              <div class="statement-file-status-icon statement-file-status-icon-unknown">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div class="statement-file-status-content">
                <h4 class="statement-file-status-title"><%= t('unknown_status') %></h4>
                <p class="statement-file-status-description"><%= t('status_is_unknown_please_contact_support') %></p>
                <div class="statement-file-status-actions">
                  <% if @statement_file.file.attached? %>
                    <a href="<%= rails_blob_path(@statement_file.file, disposition: "attachment") %>" class="statement-file-button statement-file-button-primary">
                      <svg class="statement-file-button-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                      </svg>
                      <%= t('download_file') %>
                    </a>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </section>



    <!-- TRANSACTIONS PREVIEW CARD: Extracted Data -->
    <% if @statement_file.parsed_json && @statement_file.parsed_json["transactions"] && ["parsed", "processed"].include?(@statement_file.status) %>
      <section class="statement-file-transactions">
        <div class="statement-file-card">
          <div class="statement-file-card-header">
            <h3 class="statement-file-card-title"><%= t('extracted_transactions') %></h3>
            <span class="statement-file-card-subtitle"><%= @statement_file.parsed_json["transactions"].count %> <%= t('transactions_found') %></span>
          </div>
          <div class="statement-file-card-content">
            <div class="statement-file-transactions-table">
              <table class="statement-file-table">
                <thead class="statement-file-table-header">
                  <tr>
                    <th class="statement-file-table-header-cell"><%= t('table_headers.date') %></th>
                    <th class="statement-file-table-header-cell"><%= t('table_headers.description') %></th>
                    <th class="statement-file-table-header-cell"><%= t('amount') %></th>
                    <th class="statement-file-table-header-cell"><%= t('type') %></th>
                    <th class="statement-file-table-header-cell"><%= t('category') %></th>
                  </tr>
                </thead>
                <tbody class="statement-file-table-body">
                  <% @statement_file.parsed_json["transactions"].first(10).each do |t| %>
                    <tr class="statement-file-table-row">
                      <td class="statement-file-table-cell">
                        <span class="statement-file-table-cell-text">
                          <%= t["date"] %>
                        </span>
                      </td>
                      <td class="statement-file-table-cell">
                        <span class="statement-file-table-cell-text statement-file-table-cell-text-truncate">
                          <%= t["description"] %>
                        </span>
                      </td>
                      <td class="statement-file-table-cell">
                        <span class="statement-file-table-cell-amount">
                          <%= number_to_currency(t["amount"], unit: "$") %>
                        </span>
                      </td>
                      <td class="statement-file-table-cell">
                        <span class="statement-file-table-cell-type">
                          <%= t["transaction_type"]&.humanize %>
                        </span>
                      </td>
                      <td class="statement-file-table-cell">
                        <span class="statement-file-table-cell-category">
                          <%= [t["category"], t["sub_category"]].compact.join(" / ") %>
                        </span>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
              <% if @statement_file.parsed_json["transactions"].count > 10 %>
                <div class="statement-file-transactions-footer">
                  <p class="statement-file-transactions-footer-text">
                    <%= t('showing_first_10_transactions') %>
                  </p>
                  <a href="/transactions" class="statement-file-transactions-footer-link">
                    <%= t('view_all_transactions') %>
                  </a>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </section>
    <% end %>

    <!-- DELETE ACTION CARD: Only show when processing is complete -->
    <% if ["parsed", "processed"].include?(@statement_file.status) && @statement_file.transactions.exists? %>
      <section class="statement-file-delete-section">
        <div class="statement-file-card statement-file-card-danger">
          <div class="statement-file-card-header">
            <h3 class="statement-file-card-title statement-file-card-title-danger"><%= t('delete_statement_file') %></h3>
          </div>
          <div class="statement-file-card-content">
            <div class="statement-file-delete-content">
              <div class="statement-file-delete-icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              </div>
              <div class="statement-file-delete-info">
                <p class="statement-file-delete-description">
                  <%= t('delete_statement_description', count: @statement_file.transactions.count) %>
                </p>
                <p class="statement-file-delete-warning"><%= t('this_action_cannot_be_undone') %></p>
              </div>
              <div class="statement-file-delete-action">
                <button onclick="openDeleteModal()" class="statement-file-button statement-file-button-danger">
                  <svg class="statement-file-button-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                  <%= t('delete_file') %>
                </button>
              </div>
            </div>
          </div>
        </div>
      </section>
    <% end %>
  </div>
</main>

<!-- DELETE CONFIRMATION MODAL -->
<div id="deleteModal" class="fixed inset-0 bg-slate-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-50">
  <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
    <div class="mt-3">
      <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-red-100 mb-4">
        <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
        </svg>
      </div>
      <h3 class="text-lg font-medium text-slate-900 mb-2 text-center"><%= t('confirm_delete_title') %></h3>
      <div class="mt-2 px-7 pt-1">
        <p class="text-sm text-slate-500 text-center">
          <%= t('confirm_delete_statement', count: @statement_file.transactions.count) %>
        </p>
        <p class="text-sm text-red-600 font-medium text-center mt-2">
          <%= t('this_action_cannot_be_undone') %>
        </p>
      </div>
      <div class="flex justify-end space-x-3 pt-4">
        <button type="button" onclick="closeDeleteModal()" class="px-4 py-2 border border-slate-300 text-sm font-medium rounded-lg text-slate-700 bg-white hover:bg-slate-50 transition-colors duration-200">
          <%= t('cancel') %>
        </button>
        <%= button_to statement_file_path(@statement_file), 
                    method: :delete,
                    class: "px-4 py-2 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700 transition-colors duration-200",
                    data: { turbo_method: :delete } do %>
          <%= t('delete_file') %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
  function openDeleteModal() {
    // Add subtle loading state to delete button
    const deleteBtn = document.querySelector('.statement-file-button-danger-minimal');
    if (deleteBtn) {
      deleteBtn.classList.add('opacity-75', 'cursor-not-allowed');
      deleteBtn.disabled = true;
    }
    
    document.getElementById('deleteModal').classList.remove('hidden');
    
    // Remove loading state after modal is shown
    setTimeout(() => {
      if (deleteBtn) {
        deleteBtn.classList.remove('opacity-75', 'cursor-not-allowed');
        deleteBtn.disabled = false;
      }
    }, 300);
  }

  function closeDeleteModal() {
    document.getElementById('deleteModal').classList.add('hidden');
  }

  function retryProcessing() {
    const retryBtn = event.target.closest('button');
    if (retryBtn) {
      // Show loading state
      const originalText = retryBtn.innerHTML;
      retryBtn.innerHTML = `
        <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Retrying...
      `;
      retryBtn.disabled = true;
      
      // Make API call to retry processing
      fetch('<%= retry_statement_file_path(@statement_file) %>', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
        }
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          // Show success message and reload page
          showNotification('Processing restarted successfully!', 'success');
          setTimeout(() => {
            window.location.reload();
          }, 1500);
        } else {
          // Show error message
          showNotification(data.error || 'Failed to restart processing', 'error');
          // Restore button
          retryBtn.innerHTML = originalText;
          retryBtn.disabled = false;
        }
      })
      .catch(error => {
        console.error('Error:', error);
        showNotification('Failed to restart processing. Please try again.', 'error');
        // Restore button
        retryBtn.innerHTML = originalText;
        retryBtn.disabled = false;
      });
    }
  }

  function showNotification(message, type = 'info') {
    // Create notification element
    const notification = document.createElement('div');
    notification.className = `fixed top-4 right-4 z-50 p-4 rounded-lg shadow-lg transition-all duration-300 transform translate-x-full ${
      type === 'success' ? 'bg-green-500 text-white' :
      type === 'error' ? 'bg-red-500 text-white' :
      'bg-blue-500 text-white'
    }`;
    notification.innerHTML = `
      <div class="flex items-center">
        <span class="mr-2">${message}</span>
        <button onclick="this.parentElement.parentElement.remove()" class="ml-2 text-white hover:text-gray-200">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    `;
    
    document.body.appendChild(notification);
    
    // Animate in
    setTimeout(() => {
      notification.classList.remove('translate-x-full');
    }, 100);
    
    // Auto-remove after 5 seconds
    setTimeout(() => {
      notification.classList.add('translate-x-full');
      setTimeout(() => {
        if (notification.parentElement) {
          notification.remove();
        }
      }, 300);
    }, 5000);
  }

  // Close modal when clicking outside
  document.getElementById('deleteModal').addEventListener('click', function(e) {
    if (e.target === this) {
      closeDeleteModal();
    }
  });

  // Auto-refresh page when status is "processing" to show real-time updates
  <% if @statement_file.status == "processing" %>
  setTimeout(() => {
    window.location.reload();
  }, 10000); // Refresh every 10 seconds while processing
  <% end %>
</script>
<% end %>
