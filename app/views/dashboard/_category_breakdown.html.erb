<%# app/views/dashboard/_category_breakdown.html.erb %>
<% total = categories.sum { |cat| cat[:amount] }.to_f %>
<% colors = %w[#3b82f6 #ef4444 #10b981 #f59e0b #8b5cf6 #06b6d4 #84cc16 #f97316] %>

<div class="dashboard-category-list">
  <div class="space-y-3">
    <% categories.each_with_index do |category, i| %>
      <% name = category[:name] %>
      <% amount = category[:amount] %>
      <% pct = total > 0 ? (amount / total * 100).round(1) : 0 %>
      <% color = colors[i % colors.length] %>
      <div class="group flex items-center gap-3 rounded-lg px-2 py-1.5 hover:bg-slate-50 transition-colors cursor-default">
        <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" style="background-color: <%= color %>"></span>
        <span class="flex-1 text-sm text-slate-700 truncate"><%= name %></span>
        <div class="hidden sm:flex items-center gap-2 flex-shrink-0 w-36">
          <div class="flex-1 bg-slate-100 rounded-full h-1.5 overflow-hidden">
            <div class="h-full rounded-full transition-all" style="width: <%= pct %>%; background-color: <%= color %>"></div>
          </div>
          <span class="text-xs text-slate-400 w-9 text-right"><%= pct %>%</span>
        </div>
        <span class="text-sm font-medium text-slate-800 tabular-nums flex-shrink-0">
          <%= number_to_currency(amount, precision: 0) %>
        </span>
      </div>
    <% end %>
  </div>
</div>
<div class="mt-4 pt-3 border-t border-slate-100 flex justify-between text-xs text-slate-500">
  <span><%= t("spending_trends.total_with_amount", amount: number_to_currency(total, precision: 0)) %></span>
  <span><%= t("spending_trends.top_categories", count: categories.length) %></span>
</div>
