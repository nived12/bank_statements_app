<script>
function openEditModal(transactionId) {
  
  // Set the form action
  document.getElementById('editForm').action = `<%= root_path %>transactions/${transactionId}`;
  
  // Find the transaction row and extract data
  const transactionRow = document.querySelector(`tr[data-transaction-id="${transactionId}"]`);
  
  // Alternative selector if the first one doesn't work
  if (!transactionRow) {
    const altRow = document.querySelector(`[data-transaction-id="${transactionId}"]`);
  }
  
  if (transactionRow) {
    // Extract data from the row
    const merchantElement = transactionRow.querySelector('[data-merchant]');
    const referenceElement = transactionRow.querySelector('[data-reference]');
    const transactionTypeElement = transactionRow.querySelector('[data-transaction-type]');
    const categoryElement = transactionRow.querySelector('[data-category-id]');
    const descriptionElement = transactionRow.querySelector('[data-description]');
    const amountElement = transactionRow.querySelector('[data-amount]');
    const dateElement = transactionRow.querySelector('[data-date]');
    
    
    const merchant = merchantElement?.textContent?.trim() || '';
    const reference = referenceElement?.textContent?.trim() || '';
    const transactionType = transactionTypeElement?.getAttribute('data-transaction-type') || '';
    const categoryId = categoryElement?.getAttribute('data-category-id') || '';
    const description = descriptionElement?.textContent?.trim() || '';
    const amount = amountElement?.getAttribute('data-amount') || '';
    const date = dateElement?.getAttribute('data-date') || '';
    
    
    // Map transaction type text to enum value
    const typeMapping = {
      'Ingreso': 'income',
      'Gasto Fijo': 'fixed_expense', 
      'Gasto Variable': 'variable_expense'
    };
    
    // Populate form fields
    document.getElementById('edit_merchant').value = merchant;
    document.getElementById('edit_reference').value = reference;
    document.getElementById('edit_transaction_type').value = typeMapping[transactionType] || 'variable_expense';
    document.getElementById('edit_category_id').value = categoryId;
    document.getElementById('edit_description').value = description;
    document.getElementById('edit_amount').value = amount;
    
    // Set the max date to today in user's local timezone for edit modal
    const today = new Date();
    const year = today.getFullYear();
    const month = String(today.getMonth() + 1).padStart(2, '0');
    const day = String(today.getDate()).padStart(2, '0');
    const todayString = `${year}-${month}-${day}`;
    
    const editDateInput = document.getElementById('edit_date');
    editDateInput.max = todayString;
    editDateInput.value = date;
    
    // Set the transaction ID and form action
    document.getElementById('edit_transaction_id').value = transactionId;
    document.getElementById('editForm').action = `/transactions/${transactionId}`;
    
  } else {
  }
  
  // Show the modal
  document.getElementById('editModal').classList.remove('hidden');
  
  // Ensure dropdown is properly hidden and re-initialize
  setTimeout(() => {
    resetDropdownState('edit_category_dropdown');
    initializeDropdown('edit_category_id', 'edit_category_dropdown');
  }, 100);
}

function closeEditModal() {
  document.getElementById('editModal').classList.add('hidden');
}

function deleteTransaction(transactionId) {
  if (confirm('<%= t("transactions.confirm_delete") %>')) {
    // Create a form to submit the DELETE request
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = `<%= root_path %>transactions/${transactionId}`;
    
    // Add CSRF token
    const csrfToken = document.createElement('input');
    csrfToken.type = 'hidden';
    csrfToken.name = 'authenticity_token';
    csrfToken.value = '<%= form_authenticity_token %>';
    form.appendChild(csrfToken);
    
    // Add method override for DELETE
    const methodInput = document.createElement('input');
    methodInput.type = 'hidden';
    methodInput.name = '_method';
    methodInput.value = 'delete';
    form.appendChild(methodInput);
    
    // Submit the form
    document.body.appendChild(form);
    form.submit();
  }
}

// Close modal when clicking outside
document.getElementById('editModal').addEventListener('click', function(e) {
  if (e.target === this) {
    closeEditModal();
  }
});

// Create Transaction Modal Functions
function openCreateTransactionModal() {
  // Store the current date value before resetting
  const dateInput = document.getElementById('create_date');
  const currentDateValue = dateInput.value;
  
  // Reset form
  document.getElementById('createTransactionForm').reset();
  
  // Set the max date to today in user's local timezone
  const today = new Date();
  const year = today.getFullYear();
  const month = String(today.getMonth() + 1).padStart(2, '0');
  const day = String(today.getDate()).padStart(2, '0');
  const todayString = `${year}-${month}-${day}`;
  
  // Set max date to prevent future dates
  dateInput.max = todayString;
  
  // Restore the date if it was previously set, otherwise set today's date
  if (currentDateValue) {
    dateInput.value = currentDateValue;
  } else {
    dateInput.value = todayString;
  }
  
  // Set default transaction type to variable_expense
  document.getElementById('create_transaction_type').value = 'variable_expense';
  
  // Apply amount sign handling for the default transaction type
  handleAmountSign();
  
  // Ensure event listeners are properly attached
  const transactionTypeSelect = document.getElementById('create_transaction_type');
  const amountInput = document.getElementById('create_amount');
  
  if (transactionTypeSelect && amountInput) {
    // Remove existing listeners to avoid duplicates
    transactionTypeSelect.removeEventListener('change', handleAmountSign);
    amountInput.removeEventListener('blur', handleAmountSign);
    
    // Add fresh listeners
    transactionTypeSelect.addEventListener('change', handleAmountSign);
    amountInput.addEventListener('blur', handleAmountSign);
  }
  
  // Show the modal
  document.getElementById('createTransactionModal').classList.remove('hidden');
  
  // Ensure dropdown is properly hidden and re-initialize
  setTimeout(() => {
    resetDropdownState('create_category_dropdown');
    initializeDropdown('create_category_id', 'create_category_dropdown');
  }, 100);
}

function closeCreateTransactionModal() {
  document.getElementById('createTransactionModal').classList.add('hidden');
}

// Close create modal when clicking outside
document.getElementById('createTransactionModal').addEventListener('click', function(e) {
  if (e.target === this) {
    closeCreateTransactionModal();
  }
});

// Handle amount sign based on transaction type
function handleAmountSign() {
  const transactionType = document.getElementById('create_transaction_type').value;
  const amountInput = document.getElementById('create_amount');
  let amount = parseFloat(amountInput.value);
  
  if (isNaN(amount) || amount === 0) return;
  
  if (transactionType === 'income') {
    // Income should be positive
    if (amount < 0) {
      amountInput.value = Math.abs(amount);
    }
  } else if (transactionType === 'fixed_expense' || transactionType === 'variable_expense') {
    // Expenses should be negative
    if (amount > 0) {
      amountInput.value = -amount;
    }
  }
}

// Add event listeners for amount sign handling
document.addEventListener('DOMContentLoaded', function() {
  const transactionTypeSelect = document.getElementById('create_transaction_type');
  const amountInput = document.getElementById('create_amount');
  
  if (transactionTypeSelect && amountInput) {
    transactionTypeSelect.addEventListener('change', handleAmountSign);
    amountInput.addEventListener('blur', handleAmountSign);
  }
});

// Infinite Scrolling for Transactions
let isLoading = false;
let currentObserver = null;

function setupInfiniteScroll() {
  
  const container = document.getElementById('infinite-scroll-container');
  if (!container) {
    return;
  }
  
  const nextPage = parseInt(container.dataset.nextPage);
  const totalPages = parseInt(container.dataset.totalPages);
  
  if (!nextPage || nextPage > totalPages) {
    return;
  }
  
  
  // Clean up existing observer if any
  if (currentObserver) {
    currentObserver.disconnect();
  }
  
  // Set up intersection observer for infinite scrolling
  currentObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !isLoading) {
        // Check if we still have more pages before triggering
        const container = document.getElementById('infinite-scroll-container');
        if (container) {
          const nextPage = parseInt(container.dataset.nextPage);
          const totalPages = parseInt(container.dataset.totalPages);
          
          if (nextPage && nextPage <= totalPages) {
            loadMoreTransactions();
          } else {
          }
        }
      }
    });
  }, {
    rootMargin: '100px' // Start loading 100px before reaching the trigger
  });

  // Observe the scroll trigger element
  const scrollTrigger = document.getElementById('scroll-trigger');
  if (scrollTrigger) {
    currentObserver.observe(scrollTrigger);
  } else {
  }
}

function loadMoreTransactions() {
  if (isLoading) {
    return;
  }
  
  const container = document.getElementById('infinite-scroll-container');
  if (!container) return;
  
  const nextPage = parseInt(container.dataset.nextPage);
  const totalPages = parseInt(container.dataset.totalPages);
  
  if (!nextPage || nextPage > totalPages) {
    // Hide the scroll trigger when no more pages
    const scrollTrigger = document.getElementById('scroll-trigger');
    if (scrollTrigger) {
      scrollTrigger.style.display = 'none';
    }
    return;
  }
  
  isLoading = true;
  
  // Show loading state
  const indicator = document.getElementById('infinite-scroll-indicator');
  if (indicator) {
    indicator.classList.remove('hidden');
  }

  // Build URL with current filters and sorting
  const url = new URL(window.location);
  url.searchParams.set('page', nextPage);
  
  // Preserve all current filter parameters
  const currentParams = new URLSearchParams(window.location.search);
  ['bank_account_id', 'statement_file_id', 'transaction_type', 'from_date', 'to_date', 'search', 'sort', 'direction'].forEach(param => {
    if (currentParams.has(param)) {
      url.searchParams.set(param, currentParams.get(param));
    }
  });
  
  fetch(url, {
    headers: {
      'X-Requested-With': 'XMLHttpRequest',
      'Accept': 'text/html'
    }
  })
  .then(response => {
    if (!response.ok) {
      throw new Error(`HTTP error! status: ${response.status}`);
    }
    return response.text();
  })
  .then(html => {
    
    // Append new rows to the table
    const tbody = document.getElementById('transactions-tbody');
    if (tbody) {
      tbody.insertAdjacentHTML('beforeend', html);
    }
    
    // Update container state
    container.dataset.currentPage = nextPage.toString();
    
    // Check if there are more pages
    if (nextPage >= totalPages) {
      // Hide the scroll trigger when no more pages
      const scrollTrigger = document.getElementById('scroll-trigger');
      if (scrollTrigger) {
        scrollTrigger.style.display = 'none';
      }
      // Also disconnect the observer
      if (currentObserver) {
        currentObserver.disconnect();
        currentObserver = null;
      }
    } else {
      // Update next page for next load
      const newNextPage = nextPage + 1;
      container.dataset.nextPage = newNextPage.toString();
    }
    
    // Update pagination info
    updatePaginationInfo(nextPage);
  })
  .catch(error => {
    console.error('Error loading more transactions:', error);
  })
  .finally(() => {
    // Hide loading indicator
    if (indicator) {
      indicator.classList.add('hidden');
    }
    isLoading = false;
  });
}

function updatePaginationInfo(currentPage) {
  const container = document.getElementById('infinite-scroll-container');
  const totalPages = parseInt(container.dataset.totalPages);
  const totalCount = parseInt(container.dataset.totalCount);
  
  // Count actual loaded transactions
  const tbody = document.getElementById('transactions-tbody');
  const loadedCount = tbody ? tbody.querySelectorAll('tr').length : 0;
  
  
  const paginationInfo = document.getElementById('pagination-info');
  if (paginationInfo) {
    paginationInfo.innerHTML = `
      Mostrando página ${currentPage} de ${totalPages} 
      (Transacciones cargadas: ${loadedCount} / Total de transacciones: ${totalCount})
    `;
  }
  
  // Also update the container's current page data attribute
  container.dataset.currentPage = currentPage.toString();
}

// Initialize infinite scrolling when the page loads
// This works for both direct navigation and Turbo Drive navigation
function initializeInfiniteScroll() {
  // Clean up any existing setup first
  if (currentObserver) {
    currentObserver.disconnect();
    currentObserver = null;
  }
  isLoading = false;
  
  // Set up the infinite scroll
  setupInfiniteScroll();
}

// Preserve scroll position when sorting
function preserveScrollPosition() {
  // Store current scroll position before navigation
  sessionStorage.setItem('transactionsScrollPosition', window.scrollY);
}

// Restore scroll position after page load
function restoreScrollPosition() {
  const savedPosition = sessionStorage.getItem('transactionsScrollPosition');
  if (savedPosition) {
    // Use requestAnimationFrame for smoother scrolling
    requestAnimationFrame(() => {
      window.scrollTo({
        top: parseInt(savedPosition),
        behavior: 'smooth'
      });
      // Clear the saved position after restoring
      sessionStorage.removeItem('transactionsScrollPosition');
    });
  }
}

document.addEventListener('DOMContentLoaded', initializeInfiniteScroll);
document.addEventListener('DOMContentLoaded', restoreScrollPosition);

// Also listen for Turbo Drive events to handle navigation
document.addEventListener('turbo:load', initializeInfiniteScroll);
document.addEventListener('turbo:load', restoreScrollPosition);
document.addEventListener('turbo:render', initializeInfiniteScroll);
document.addEventListener('turbo:render', restoreScrollPosition);

// Fallback: if none of the above events fire, try to set up after a short delay
setTimeout(initializeInfiniteScroll, 100);
setTimeout(restoreScrollPosition, 100);

// Initialize date range picker
function initializeDateRangePicker() {
  const dateRangeInput = document.getElementById('date_range');
  const fromDateInput = document.getElementById('from_date');
  const toDateInput = document.getElementById('to_date');
  
  if (!dateRangeInput) return;
  
  // Wait for flatpickr to be available
  if (typeof window.flatpickr === 'undefined') {
    setTimeout(initializeDateRangePicker, 100);
    return;
  }
  
  // Set initial values if they exist in the URL
  const urlParams = new URLSearchParams(window.location.search);
  const fromDate = urlParams.get('from_date');
  const toDate = urlParams.get('to_date');
  
  if (fromDate && toDate) {
    fromDateInput.value = fromDate;
    toDateInput.value = toDate;
    dateRangeInput.value = `${fromDate} - ${toDate}`;
  } else if (fromDate) {
    fromDateInput.value = fromDate;
    dateRangeInput.value = `Desde ${fromDate}`;
  } else if (toDate) {
    toDateInput.value = toDate;
    dateRangeInput.value = `Hasta ${toDate}`;
  }
  
  // Initialize flatpickr
  const picker = window.flatpickr(dateRangeInput, {
    mode: "range",
    dateFormat: "Y-m-d",
    maxDate: "today",
    allowInput: false,
    clickOpens: true,
    defaultDate: fromDate && toDate ? [fromDate, toDate] : (fromDate ? fromDate : (toDate ? toDate : null)),
    onChange: function(selectedDates, dateStr, instance) {
      if (selectedDates.length === 2) {
        const startDate = selectedDates[0];
        const endDate = selectedDates[1];
        
        // Update hidden inputs
        fromDateInput.value = startDate.toISOString().split('T')[0];
        toDateInput.value = endDate.toISOString().split('T')[0];
        
        // Update display
        dateRangeInput.value = `${startDate.toISOString().split('T')[0]} - ${endDate.toISOString().split('T')[0]}`;
        
        // Auto-submit the form
        applyFilters();
      }
    },
    onClear: function() {
      fromDateInput.value = '';
      toDateInput.value = '';
      dateRangeInput.value = '';
      // Auto-submit when cleared
      applyFilters();
    }
  });
  
}


// Initialize date range picker when page loads
document.addEventListener('DOMContentLoaded', initializeDateRangePicker);
document.addEventListener('turbo:load', initializeDateRangePicker);
document.addEventListener('turbo:render', initializeDateRangePicker);

// Inline filter functionality
function applyFilters() {
  const bankAccountId = document.getElementById('bank_account_id').value;
  const statementFileId = document.getElementById('statement_file_id').value;
  const transactionType = document.getElementById('transaction_type').value;
  const fromDate = document.getElementById('from_date').value;
  const toDate = document.getElementById('to_date').value;
  const search = document.getElementById('search').value;
  
  // Build URL with current filters
  const url = new URL(window.location);
  
  // Set or clear parameters
  if (bankAccountId) {
    url.searchParams.set('bank_account_id', bankAccountId);
  } else {
    url.searchParams.delete('bank_account_id');
  }
  
  if (statementFileId) {
    url.searchParams.set('statement_file_id', statementFileId);
  } else {
    url.searchParams.delete('statement_file_id');
  }
  
  if (transactionType) {
    url.searchParams.set('transaction_type', transactionType);
  } else {
    url.searchParams.delete('transaction_type');
  }
  
  if (fromDate) {
    url.searchParams.set('from_date', fromDate);
  } else {
    url.searchParams.delete('from_date');
  }
  
  if (toDate) {
    url.searchParams.set('to_date', toDate);
  } else {
    url.searchParams.delete('to_date');
  }
  
  if (search) {
    url.searchParams.set('search', search);
  } else {
    url.searchParams.delete('search');
  }
  
  // Preserve sorting parameters
  const currentParams = new URLSearchParams(window.location.search);
  ['sort', 'direction'].forEach(param => {
    if (currentParams.has(param)) {
      url.searchParams.set(param, currentParams.get(param));
    }
  });
  
  // Navigate to the new URL
  window.location.href = url.toString();
}

// Cascading dropdown functionality
function updateStatementFiles() {
  const bankAccountId = document.getElementById('bank_account_id').value;
  const statementFileSelect = document.getElementById('statement_file_id');
  
  // Clear current options except the first one
  statementFileSelect.innerHTML = '<option value=""><%= t('transactions.all_statement_files') %></option>';
  
  if (bankAccountId) {
    // Fetch statement files for the selected bank account
    fetch(`/transactions/statement_files?bank_account_id=${bankAccountId}`, {
      headers: {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
      }
    })
    .then(response => response.json())
    .then(data => {
      data.statement_files.forEach(file => {
        const option = document.createElement('option');
        option.value = file.id;
        option.textContent = `${file.safe_filename} - ${file.bank_account_display_name}`;
        statementFileSelect.appendChild(option);
      });
    })
    .catch(error => {
      console.error('Error fetching statement files:', error);
    });
  } else {
    // Load all statement files
    fetch('/transactions/statement_files', {
      headers: {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
      }
    })
    .then(response => response.json())
    .then(data => {
      data.statement_files.forEach(file => {
        const option = document.createElement('option');
        option.value = file.id;
        option.textContent = `${file.safe_filename} - ${file.bank_account_display_name}`;
        statementFileSelect.appendChild(option);
      });
    })
    .catch(error => {
      console.error('Error fetching statement files:', error);
    });
  }
}

// Add event listener for bank account changes
document.addEventListener('DOMContentLoaded', function() {
  const bankAccountSelect = document.getElementById('bank_account_id');
  if (bankAccountSelect) {
    bankAccountSelect.addEventListener('change', function() {
      updateStatementFiles();
      // Clear statement file selection when bank account changes
      document.getElementById('statement_file_id').value = '';
      applyFilters();
    });
  }
});

function clearFilter(filterName) {
  const element = document.getElementById(filterName);
  if (element) {
    element.value = '';
    applyFilters();
  }
}

function clearDateFilter() {
  document.getElementById('from_date').value = '';
  document.getElementById('to_date').value = '';
  document.getElementById('date_range').value = '';
  applyFilters();
}

// Search functionality
let searchTimeout;

function handleSearchInput() {
  // Clear existing timeout
  clearTimeout(searchTimeout);
  
  // Set a new timeout to search after user stops typing (500ms delay)
  searchTimeout = setTimeout(() => {
    applyFilters();
  }, 500);
}

function clearSearch() {
  document.getElementById('search').value = '';
  applyFilters();
}

function clearAllFilters() {
  // Clear all filter inputs
  document.getElementById('bank_account_id').value = '';
  document.getElementById('statement_file_id').value = '';
  document.getElementById('transaction_type').value = '';
  document.getElementById('from_date').value = '';
  document.getElementById('to_date').value = '';
  document.getElementById('date_range').value = '';
  document.getElementById('search').value = '';
  
  // Navigate to clean transactions page
  window.location.href = '/transactions';
}

// Grouped Category Dropdown Functionality
function initializeGroupedCategoryDropdowns() {
  // Initialize both create and edit dropdowns
  initializeDropdown('create_category_id', 'create_category_dropdown');
  initializeDropdown('edit_category_id', 'edit_category_dropdown');
}

function initializeDropdown(selectId, dropdownId) {
  const select = document.getElementById(selectId);
  const dropdown = document.getElementById(dropdownId);
  
  if (!select || !dropdown) {
    return;
  }
  
  // Ensure dropdown is hidden initially (CSS should handle this, but just to be sure)
  dropdown.classList.add('hidden');
  dropdown.classList.remove('show');

  // Toggle dropdown visibility
  select.addEventListener('click', function(e) {
    e.preventDefault();
    e.stopPropagation();
    toggleDropdown(dropdown);
  });

  // Handle parent category hover
  const parentItems = dropdown.querySelectorAll('.grouped-category-item.parent[data-has-children="true"]');
  
  parentItems.forEach(parentItem => {
    const submenu = parentItem.querySelector('.grouped-category-submenu');
    
    parentItem.addEventListener('mouseenter', function(e) {
      e.stopPropagation();
      if (submenu) {
        // Close all other submenus first
        dropdown.querySelectorAll('.grouped-category-submenu.show').forEach(sm => {
          sm.classList.remove('show');
        });
        submenu.classList.add('show');
      }
    });

    parentItem.addEventListener('mouseleave', function(e) {
      e.stopPropagation();
      if (submenu) {
        // Add a small delay to prevent flickering
        setTimeout(() => {
          if (!submenu.matches(':hover')) {
            submenu.classList.remove('show');
          }
        }, 100);
      }
    });

    // Also handle submenu hover to keep it open
    if (submenu) {
      submenu.addEventListener('mouseenter', function(e) {
        e.stopPropagation();
        submenu.classList.add('show');
      });

      submenu.addEventListener('mouseleave', function(e) {
        e.stopPropagation();
        submenu.classList.remove('show');
      });
    }
  });

  // Handle parent category selection
  const allParentItems = dropdown.querySelectorAll('.grouped-category-item.parent');
  allParentItems.forEach(parentItem => {
    parentItem.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      
      const categoryId = parentItem.getAttribute('data-category-id');
      const hasChildren = parentItem.getAttribute('data-has-children') === 'true';
      
      if (!hasChildren) {
        selectCategory(select, dropdown, categoryId, parentItem);
      }
    });
  });

  // Handle child category selection
  const childItems = dropdown.querySelectorAll('.grouped-category-item.child');
  childItems.forEach(childItem => {
    const checkbox = childItem.querySelector('.grouped-category-checkbox');
    const label = childItem.querySelector('label');
    
    [checkbox, label].forEach(element => {
      if (element) {
        element.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          
          const categoryId = childItem.getAttribute('data-category-id');
          selectCategory(select, dropdown, categoryId, childItem);
        });
      }
    });
  });

  // Close dropdown when clicking outside
  document.addEventListener('click', function(e) {
    if (!select.contains(e.target) && !dropdown.contains(e.target)) {
      dropdown.classList.remove('show');
      dropdown.classList.add('hidden');
    }
  });
}

function toggleDropdown(dropdown) {
  const isVisible = dropdown.classList.contains('show');
  
  // Close all other dropdowns first
  document.querySelectorAll('.grouped-category-dropdown-content.show').forEach(d => {
    d.classList.remove('show');
    d.classList.add('hidden');
  });
  
  // Toggle current dropdown
  if (!isVisible) {
    dropdown.classList.remove('hidden');
    dropdown.classList.add('show');
  } else {
    dropdown.classList.remove('show');
    dropdown.classList.add('hidden');
  }
}

function selectCategory(select, dropdown, categoryId, selectedElement) {
  // Update the select value
  select.value = categoryId;
  
  // Update visual selection
  dropdown.querySelectorAll('.grouped-category-item').forEach(item => {
    item.classList.remove('selected');
  });
  selectedElement.classList.add('selected');
  
  // Close dropdown
  dropdown.classList.remove('show');
  dropdown.classList.add('hidden');
  
  // Trigger change event
  select.dispatchEvent(new Event('change'));
}

// Function to reset dropdown state
function resetDropdownState(dropdownId) {
  const dropdown = document.getElementById(dropdownId);
  if (dropdown) {
    dropdown.classList.add('hidden');
    dropdown.classList.remove('show');
    // Close all submenus (CSS should handle this, but just to be sure)
    dropdown.querySelectorAll('.grouped-category-submenu').forEach(submenu => {
      submenu.classList.add('hidden');
      submenu.classList.remove('show');
    });
  }
}

// Initialize dropdowns when DOM is loaded
document.addEventListener('DOMContentLoaded', function() {
  initializeGroupedCategoryDropdowns();
  checkForDuplicatesOnLoad();
});

// Also run when Turbo loads content
document.addEventListener('turbo:load', function() {
  initializeGroupedCategoryDropdowns();
  checkForDuplicatesOnLoad();
});

// Duplicates functionality
let currentStatementFileId = null;
let duplicatesData = {};

function checkForDuplicatesOnLoad() {
  console.log('Checking for duplicates on load...');
  
  fetch('/transactions/check_duplicates', {
    headers: {
      'X-Requested-With': 'XMLHttpRequest',
      'Accept': 'application/json'
    }
  })
  .then(response => {
    console.log('Response received:', response.status);
    return response.json();
  })
  .then(data => {
    console.log('Duplicates data:', data);
    if (data.has_duplicates) {
      showDuplicatesButton(data.statement_files);
    } else {
      hideDuplicatesButton();
    }
  })
  .catch(error => {
    console.error('Error checking for duplicates:', error);
    hideDuplicatesButton(); // Hide on error
  });
}

function checkForDuplicates() {
  fetch('/transactions/check_duplicates', {
    headers: {
      'X-Requested-With': 'XMLHttpRequest',
      'Accept': 'application/json'
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.has_duplicates) {
      duplicatesData = data;
      showDuplicatesModal(data.statement_files);
    } else {
      hideDuplicatesButton();
    }
  })
  .catch(error => {
    console.error('Error checking for duplicates:', error);
  });
}

function showDuplicatesButton(statementFiles) {
  const button = document.getElementById('duplicatesButton');
  const badge = document.getElementById('duplicatesBadge');
  
  if (button && badge) {
    button.classList.remove('hidden');
    badge.classList.remove('hidden');
    badge.textContent = statementFiles.length;
    console.log('Duplicates button shown with', statementFiles.length, 'files');
  } else {
    console.error('Duplicates button or badge not found');
  }
}

function hideDuplicatesButton() {
  const button = document.getElementById('duplicatesButton');
  const badge = document.getElementById('duplicatesBadge');
  
  if (button && badge) {
    button.classList.add('hidden');
    badge.classList.add('hidden');
  }
}

function showDuplicatesModal(statementFiles) {
  const modal = document.getElementById('duplicatesModal');
  const statementFilesList = document.getElementById('statementFilesList');
  
  // Create statement files list
  let html = '<div class="space-y-3">';
  statementFiles.forEach(file => {
    html += `
      <div class="border border-slate-300 rounded-lg p-4 cursor-pointer hover:bg-slate-50 transition-colors duration-200" onclick="selectStatementFile(${file.id})">
        <div class="flex justify-between items-center">
          <div>
            <h5 class="font-medium text-slate-900">${file.filename}</h5>
            <p class="text-sm text-slate-600">${file.bank_name} - ••••${file.account_number}</p>
          </div>
          <div class="text-right">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
              ${file.pending_duplicates_count} duplicados
            </span>
          </div>
        </div>
      </div>
    `;
  });
  html += '</div>';
  
  statementFilesList.innerHTML = html;
  modal.classList.remove('hidden');
}

function selectStatementFile(statementFileId) {
  currentStatementFileId = statementFileId;
  
  // Find the statement file data
  const statementFile = duplicatesData.statement_files.find(sf => sf.id === statementFileId);
  
  // Update the table title
  document.getElementById('currentStatementFileTitle').textContent = statementFile.filename;
  document.getElementById('currentStatementFileInfo').textContent = `${statementFile.bank_name} - ••••${statementFile.account_number}`;
  
  // Load duplicates for this statement file
  loadDuplicatesForStatementFile(statementFileId);
}

function loadDuplicatesForStatementFile(statementFileId) {
  const tableBody = document.getElementById('duplicatesTableBody');
  const duplicatesTable = document.getElementById('duplicatesTable');
  
  // Show the table
  duplicatesTable.classList.remove('hidden');
  
  // Show loading state
  tableBody.innerHTML = `
    <tr>
      <td colspan="5" class="border border-slate-300 px-4 py-8 text-center text-slate-500">
        Cargando duplicados...
      </td>
    </tr>
  `;
  
  // Fetch duplicates for this statement file
  fetch(`/transactions/get_duplicates?statement_file_id=${statementFileId}`, {
    headers: {
      'X-Requested-With': 'XMLHttpRequest',
      'Accept': 'application/json'
    }
  })
  .then(response => response.json())
  .then(data => {
    renderDuplicatesTable(data.duplicates);
  })
  .catch(error => {
    console.error('Error loading duplicates:', error);
    tableBody.innerHTML = `
      <tr>
        <td colspan="5" class="border border-slate-300 px-4 py-8 text-center text-red-500">
          Error al cargar duplicados. Por favor intenta de nuevo.
        </td>
      </tr>
    `;
  });
}

function renderDuplicatesTable(duplicates) {
  const tableBody = document.getElementById('duplicatesTableBody');
  
  if (duplicates.length === 0) {
    tableBody.innerHTML = `
      <tr>
        <td colspan="5" class="border border-slate-300 px-4 py-8 text-center text-slate-500">
          No se encontraron duplicados para este estado de cuenta.
        </td>
      </tr>
    `;
    return;
  }
  
  let html = '';
  
  duplicates.forEach(group => {
    group.transactions.forEach((transaction, index) => {
      const isManual = transaction.source === 'manual';
      const isFirstInGroup = index === 0;
      
      html += `
        <tr class="${isFirstInGroup ? 'border-t-2 border-slate-400' : ''}">
          <td class="border border-slate-300 px-4 py-2 text-center">
            <input type="checkbox" 
                   value="${transaction.id}" 
                   ${isManual ? 'checked' : ''}
                   class="duplicate-checkbox rounded border-slate-300 text-blue-600 focus:ring-blue-500">
          </td>
          <td class="border border-slate-300 px-4 py-2">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${isManual ? 'bg-blue-100 text-blue-800' : 'bg-green-100 text-green-800'}">
              ${isManual ? 'Manual' : 'Estado de Cuenta'}
            </span>
          </td>
          <td class="border border-slate-300 px-4 py-2 text-sm">
            ${transaction.date}
          </td>
          <td class="border border-slate-300 px-4 py-2 text-sm">
            <div>
              <div class="font-medium">${transaction.description}</div>
              <div class="text-xs text-slate-500">${transaction.category_name}</div>
            </div>
          </td>
          <td class="border border-slate-300 px-4 py-2 text-right text-sm font-medium ${transaction.amount >= 0 ? 'text-green-600' : 'text-red-600'}">
            $${Math.abs(transaction.amount).toFixed(2)}
          </td>
        </tr>
      `;
    });
  });
  
  tableBody.innerHTML = html;
}

function processSelectedDuplicates() {
  const checkboxes = document.querySelectorAll('#duplicatesTableBody input[type="checkbox"]:checked');
  const selectedIds = Array.from(checkboxes).map(cb => cb.value);
  
  if (selectedIds.length === 0) {
    alert('Por favor selecciona al menos una transacción para procesar.');
    return;
  }
  
  // Process the selected duplicates
  fetch('/transactions/process_duplicates', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-Requested-With': 'XMLHttpRequest',
      'Accept': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
    },
    body: JSON.stringify({
      statement_file_id: currentStatementFileId,
      selected_transaction_ids: selectedIds
    })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      alert(`Se procesaron ${data.processed_count} transacciones exitosamente.`);
      closeDuplicatesModal();
      // Refresh the page to show updated data
      window.location.reload();
    } else {
      alert('Error al procesar duplicados: ' + data.error);
    }
  })
  .catch(error => {
    console.error('Error processing duplicates:', error);
    alert('Error al procesar duplicados. Por favor intenta de nuevo.');
  });
}

function closeDuplicatesModal() {
  const modal = document.getElementById('duplicatesModal');
  modal.classList.add('hidden');
  
  // Reset state
  currentStatementFileId = null;
  document.getElementById('duplicatesTable').classList.add('hidden');
}

// Close modal when clicking outside
document.getElementById('duplicatesModal').addEventListener('click', function(e) {
  if (e.target === this) {
    closeDuplicatesModal();
  }
});
</script>
