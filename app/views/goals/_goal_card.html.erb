<div id="goal-<%= goal.id %>"
     class="group bg-white rounded-xl border border-slate-200 hover:border-blue-300 hover:shadow-lg transition-all duration-200 relative">
  <!-- Clickable Card Content -->
  <%= link_to goal_path(goal), class: "block p-6", data: { turbo_prefetch: false } do %>
    <div class="flex items-start justify-between mb-4">
      <!-- Icon and Name -->
      <div class="flex items-center space-x-4 flex-1 min-w-0">
        <div class="w-14 h-14 rounded-xl flex items-center justify-center flex-shrink-0 text-3xl"
             style="background-color: <%= goal.color %>20">
          <%= category_icon_svg(goal.icon, css_classes: "w-6 h-6") %>
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="text-xl font-semibold text-slate-900 truncate"><%= goal.name %></h3>
          <div class="flex items-center space-x-2 mt-1">
            <span class="text-sm px-2 py-0.5 rounded-full <%= goal.type_savings_goal? ? 'bg-green-100 text-green-800' : 'bg-orange-100 text-orange-800' %>">
              <%= t("goals.types.#{goal.goal_type}") %>
            </span>
            <span class="text-sm px-2 py-0.5 rounded-full <%=
              case goal.status
              when 'active' then 'bg-blue-100 text-blue-800'
              when 'completed' then 'bg-green-100 text-green-800'
              when 'paused' then 'bg-gray-100 text-gray-800'
              when 'archived' then 'bg-slate-100 text-slate-800'
              end
            %>">
              <%= t("goals.statuses.#{goal.status}") %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Progress Bar -->
    <div class="mb-4">
      <div class="flex justify-between text-sm text-slate-600 mb-2">
        <span><%= number_to_currency(goal.current_amount) %></span>
        <span><%= number_to_currency(goal.target_amount) %></span>
      </div>
      <div class="w-full bg-slate-200 rounded-full h-3 overflow-hidden">
        <div class="h-full rounded-full transition-all duration-500"
             style="width: <%= [goal.progress_percentage, 100].min %>%; background-color: <%= goal.color %>"
             title="<%= goal.progress_percentage %>%">
        </div>
      </div>
      <div class="mt-1 text-sm text-slate-600 text-center">
        <%= goal.progress_percentage %>% <%= t('goals.progress.completed').downcase %>
      </div>
    </div>

    <!-- Goal Info -->
    <div class="text-sm text-slate-600 space-y-1">
      <div class="flex justify-between">
        <span><%= t('goals.deadline') %>:</span>
        <span class="font-medium"><%= l(goal.deadline, format: :short) %></span>
      </div>
      <div class="flex justify-between">
        <span><%= t('goals.days_remaining') %>:</span>
        <span class="font-medium <%= goal.days_remaining < 0 ? 'text-red-600' : '' %>">
          <%= goal.days_remaining %> <%= t('date.abbr_day_names')[0].downcase %>
        </span>
      </div>
      <% if goal.on_track? %>
        <div class="flex items-center space-x-1 text-green-600 mt-2">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          <span class="text-xs font-medium"><%= t('goals.progress.on_track') %></span>
        </div>
      <% else %>
        <div class="flex items-center space-x-1 text-orange-600 mt-2">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
          </svg>
          <span class="text-xs font-medium"><%= t('goals.progress.behind_schedule') %></span>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Action Buttons (positioned absolutely) -->
  <div class="absolute top-4 right-4 flex space-x-1 opacity-0 group-hover:opacity-100 transition-opacity">
    <%= link_to edit_goal_path(goal), class: "p-2 bg-white rounded-lg border border-slate-300 hover:bg-slate-50 transition-colors shadow-sm", data: { turbo_prefetch: false } do %>
      <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
      </svg>
    <% end %>
    <%= button_to goal_path(goal), method: :delete,
                  data: { turbo_confirm: t('goals.delete_confirm', name: goal.name) },
                  class: "p-2 bg-white rounded-lg border border-slate-300 hover:bg-red-50 transition-colors shadow-sm" do %>
      <svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
      </svg>
    <% end %>
  </div>
</div>
