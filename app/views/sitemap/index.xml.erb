<%- base = "https://vitt.io" -%>
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc><%= base %>/</loc>
    <xhtml:link rel="alternate" hreflang="es" href="<%= base %>/"/>
    <xhtml:link rel="alternate" hreflang="en" href="<%= base %>/?locale=en"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="<%= base %>/"/>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc><%= base %>/pricing</loc>
    <xhtml:link rel="alternate" hreflang="es" href="<%= base %>/pricing"/>
    <xhtml:link rel="alternate" hreflang="en" href="<%= base %>/pricing?locale=en"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="<%= base %>/pricing"/>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc><%= base %>/blog</loc>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc><%= base %>/guides</loc>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
<%- @blog_articles.each do |article| -%>
  <url>
    <loc><%= base %>/blog/<%= article.slug %></loc>
    <lastmod><%= (article.updated || article.date).iso8601 %></lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
<%- end -%>
<%- @guide_articles.each do |article| -%>
  <url>
    <loc><%= base %>/guides/<%= article.slug %></loc>
    <lastmod><%= (article.updated || article.date).iso8601 %></lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
<%- end -%>
  <url>
    <loc><%= base %>/legal/privacy</loc>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc><%= base %>/legal/terms</loc>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc><%= base %>/legal/financial_data</loc>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
