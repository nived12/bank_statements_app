<% content_for :title, t('bank_accounts.add_new') %>
<% content_for :hide_fab, true %>
<% content_for :hide_mobile_header, true %>

<!-- Mobile View -->
<div class="block md:hidden mobile-form-page" data-controller="bank-account-form">
  <%= render "shared/mobile_form_header",
      title: t('bank_accounts.add_new'),
      back_url: bank_accounts_path %>

  <div class="mobile-form-body">
    <%= render "bank_account_form_mobile" %>
  </div>

  <%= render "shared/mobile_form_footer",
      form_id: "bank_account_form",
      controller_name: "bank-account-form",
      label: t("form_actions.save", default: "Guardar") %>
</div>

<!-- Desktop View: unchanged -->
<div class="hidden md:block min-h-screen bg-slate-50 dark:bg-slate-900" data-controller="bank-account-form">
  <header class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 px-8 py-6">
    <div class="max-w-3xl mx-auto">
      <div class="flex items-center justify-between mb-4">
        <%= link_to bank_accounts_path, class: "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:text-slate-100 flex items-center" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          <%= t('bank_accounts.back_to_accounts') %>
        <% end %>
      </div>
      <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100"><%= t('bank_accounts.add_new') %></h1>
      <p class="text-slate-600 dark:text-slate-400 mt-2"><%= t('bank_accounts.create_new_description') %></p>
    </div>
  </header>

  <div class="max-w-3xl mx-auto px-8 py-8">
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6">
      <%= render 'form' %>
    </div>
  </div>
</div>
