<!-- MOBILE TRANSACTIONS PAGE: Mobile-Optimized Transaction Management -->
<main class="mobile-transactions-page">
  <div class="mobile-transactions-container">
    
    <!-- MOBILE HEADER: Page Title and Quick Actions -->
    <header class="mobile-transactions-header">
      <div class="mobile-transactions-header-content">
        <div class="mobile-transactions-header-left">
          <h1 class="mobile-transactions-title"><%= t('navigation.transactions') %></h1>
          <p class="mobile-transactions-subtitle"><%= t('transactions.description') %></p>
        </div>
        <div class="mobile-transactions-header-actions">
          <button onclick="openCreateTransactionModal()" class="mobile-transactions-add-btn">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- MOBILE STATS: Quick Overview Cards -->
    <section class="mobile-transactions-stats">
      <div class="mobile-stats-grid">
        <!-- Total Transactions -->
        <div class="mobile-stat-card">
          <div class="mobile-stat-icon mobile-stat-icon-total">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
          <div class="mobile-stat-content">
            <p class="mobile-stat-label"><%= t('table_headers.transactions') %></p>
            <p class="mobile-stat-value"><%= @mobile_transactions_data[:stats][:total_transactions] %></p>
          </div>
        </div>

        <!-- Equity/Net -->
        <div class="mobile-stat-card">
          <div class="mobile-stat-icon mobile-stat-icon-equity">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
            </svg>
          </div>
          <div class="mobile-stat-content">
            <p class="mobile-stat-label"><%= t('transaction_types.equity') %></p>
            <p class="mobile-stat-value <%= @mobile_transactions_data[:stats][:equity_total] >= 0 ? 'text-green-600' : 'text-red-600' %>">
              <%= number_to_currency(@mobile_transactions_data[:stats][:equity_total], unit: "$") %>
            </p>
          </div>
        </div>

        <!-- Income -->
        <div class="mobile-stat-card">
          <div class="mobile-stat-icon mobile-stat-icon-income">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
            </svg>
          </div>
          <div class="mobile-stat-content">
            <p class="mobile-stat-label"><%= t('transaction_types.income') %></p>
            <p class="mobile-stat-value text-green-600">
              <%= number_to_currency(@mobile_transactions_data[:stats][:income_total], unit: "$") %>
            </p>
          </div>
        </div>

        <!-- Expenses -->
        <div class="mobile-stat-card">
          <div class="mobile-stat-icon mobile-stat-icon-expenses">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <div class="mobile-stat-content">
            <p class="mobile-stat-label"><%= t('transaction_types.expenses') %></p>
            <p class="mobile-stat-value text-red-600">
              <%= number_to_currency(@mobile_transactions_data[:stats][:expenses_total], unit: "$") %>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- MOBILE FILTERS: Collapsible Filter Section -->
    <section class="mobile-transactions-filters">
      <button onclick="toggleMobileFilters()" class="mobile-filters-toggle">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
        </svg>
        <span><%= t('transactions.filters') %></span>
        <svg class="w-4 h-4 transform transition-transform duration-200" id="filter-arrow">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>

      <div class="mobile-filters-content" id="mobile-filters-content">
        <!-- Search -->
        <div class="mobile-filter-group">
          <label class="mobile-filter-label"><%= t('transactions.search_description') %></label>
          <div class="mobile-filter-input-group">
            <input type="text" 
                   id="mobile_search" 
                   name="search" 
                   value="<%= @mobile_transactions_data[:filters][:search] %>"
                   placeholder="<%= t('transactions.search_placeholder') %>"
                   class="mobile-filter-input"
                   onkeyup="handleMobileSearch()">
            <svg class="mobile-filter-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
        </div>

        <!-- Bank Account Filter -->
        <div class="mobile-filter-group">
          <label class="mobile-filter-label"><%= t('transactions.bank_account_filter') %></label>
          <select name="bank_account_id" id="mobile_bank_account_id" class="mobile-filter-select" onchange="applyMobileFilters()">
            <option value=""><%= t('transactions.all_accounts') %></option>
            <% @bank_accounts.each do |ba| %>
              <option value="<%= ba.id %>" <%= "selected" if @mobile_transactions_data[:filters][:bank_account_id].to_s == ba.id.to_s %>>
                <%= ba.bank_display_name %> - ••••<%= ba.account_number.last(4) %>
              </option>
            <% end %>
          </select>
        </div>

        <!-- Transaction Type Filter -->
        <div class="mobile-filter-group">
          <label class="mobile-filter-label"><%= t('transactions.transaction_type_filter') %></label>
          <select name="transaction_type" id="mobile_transaction_type" class="mobile-filter-select" onchange="applyMobileFilters()">
            <option value=""><%= t('transactions.all_transaction_types') %></option>
            <option value="income" <%= "selected" if @mobile_transactions_data[:filters][:transaction_type] == "income" %>><%= t('transaction_types.income') %></option>
            <option value="fixed_expense" <%= "selected" if @mobile_transactions_data[:filters][:transaction_type] == "fixed_expense" %>><%= t('transaction_types.fixed_expense') %></option>
            <option value="variable_expense" <%= "selected" if @mobile_transactions_data[:filters][:transaction_type] == "variable_expense" %>><%= t('transaction_types.variable_expense') %></option>
          </select>
        </div>

        <!-- Date Range Filter -->
        <div class="mobile-filter-group">
          <label class="mobile-filter-label"><%= t('transactions.date_range_filter') %></label>
          <div class="mobile-date-range">
            <input type="date" 
                   name="from_date" 
                   id="mobile_from_date"
                   value="<%= @mobile_transactions_data[:filters][:from_date] %>"
                   class="mobile-date-input"
                   onchange="applyMobileFilters()">
            <span class="mobile-date-separator">-</span>
            <input type="date" 
                   name="to_date" 
                   id="mobile_to_date"
                   value="<%= @mobile_transactions_data[:filters][:to_date] %>"
                   class="mobile-date-input"
                   onchange="applyMobileFilters()">
          </div>
        </div>

        <!-- Clear Filters -->
        <div class="mobile-filter-actions">
          <button onclick="clearMobileFilters()" class="mobile-clear-filters-btn">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
            <%= t('transactions.clear_all_filters') %>
          </button>
        </div>
      </div>
    </section>

    <!-- MOBILE TRANSACTIONS LIST: Card-based Transaction Display -->
    <% if @mobile_transactions_data[:transactions].any? %>
      <section class="mobile-transactions-list">
        <div class="mobile-transactions-header-bar">
          <h3 class="mobile-transactions-list-title">
            <%= t('transactions.recent_transactions') %>
            <span class="mobile-transactions-count">(<%= @mobile_transactions_data[:total_count] %>)</span>
          </h3>
        </div>

        <div class="mobile-transactions-cards" id="mobile-transactions-cards">
          <% @mobile_transactions_data[:transactions].each_with_index do |transaction, index| %>
            <div class="mobile-transaction-card" data-transaction-id="<%= transaction.id %>">
              <div class="mobile-transaction-main">
                <div class="mobile-transaction-info">
                  <div class="mobile-transaction-description">
                    <h4 class="mobile-transaction-title"><%= short_description(transaction.description) %></h4>
                    <% if transaction.merchant.present? %>
                      <p class="mobile-transaction-merchant"><%= transaction.merchant %></p>
                    <% end %>
                    <p class="mobile-transaction-account">
                      <%= transaction.bank_account.bank_display_name %> - ••••<%= transaction.bank_account.account_number.last(4) %>
                    </p>
                  </div>
                  <div class="mobile-transaction-amount">
                    <span class="mobile-transaction-amount-value <%= transaction.transaction_type == 'income' ? 'text-green-600' : 'text-red-600' %>">
                      <%= format_currency(transaction.amount) %>
                    </span>
                    <span class="mobile-transaction-type">
                      <%= t("transaction_types.#{transaction.transaction_type}") %>
                    </span>
                  </div>
                </div>
                
                <div class="mobile-transaction-details">
                  <div class="mobile-transaction-meta">
                    <span class="mobile-transaction-date">
                      <%= format_local_time(transaction.date, format: 'date') %>
                    </span>
                    <% if transaction.category %>
                      <span class="mobile-transaction-category">
                        <%= transaction.category.name %>
                      </span>
                    <% else %>
                      <span class="mobile-transaction-category-empty">
                        <%= t('transactions.no_category') %>
                      </span>
                    <% end %>
                  </div>
                  
                  <div class="mobile-transaction-actions">
                    <button onclick="openEditModal('<%= transaction.id %>')" class="mobile-transaction-action-btn mobile-transaction-edit-btn">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                      </svg>
                    </button>
                    <% if transaction.source == 'manual' %>
                      <button onclick="deleteTransaction('<%= transaction.id %>')" class="mobile-transaction-action-btn mobile-transaction-delete-btn">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                        </svg>
                      </button>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Load More Button -->
        <% if @mobile_transactions_data[:has_more] %>
          <div class="mobile-load-more">
            <button onclick="loadMoreMobileTransactions()" class="mobile-load-more-btn" id="mobile-load-more-btn">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
              <%= t('transactions.load_more') %>
            </button>
          </div>
        <% end %>
      </section>
    <% else %>
      <!-- EMPTY STATE: No Transactions -->
      <section class="mobile-transactions-empty">
        <div class="mobile-empty-icon">
          <svg class="w-16 h-16 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
        </div>
        <h3 class="mobile-empty-title"><%= t('empty_states.no_transactions_yet') %></h3>
        <p class="mobile-empty-description"><%= t('bank_accounts.upload_statement_help') %></p>
        <div class="mobile-empty-actions">
          <button onclick="openCreateTransactionModal()" class="mobile-empty-action-btn">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            <%= t('transactions.add_transaction') %>
          </button>
          <%= link_to new_statement_file_path, class: "mobile-empty-action-btn mobile-empty-action-secondary" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
            </svg>
            <%= t('quick_actions.upload_statement') %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</main>

<!-- Mobile-specific JavaScript -->
<script>
// Mobile filter toggle
function toggleMobileFilters() {
  const content = document.getElementById('mobile-filters-content');
  const arrow = document.getElementById('filter-arrow');
  
  if (content.classList.contains('hidden')) {
    content.classList.remove('hidden');
    arrow.style.transform = 'rotate(180deg)';
  } else {
    content.classList.add('hidden');
    arrow.style.transform = 'rotate(0deg)';
  }
}

// Mobile search with debounce
let mobileSearchTimeout;
function handleMobileSearch() {
  clearTimeout(mobileSearchTimeout);
  mobileSearchTimeout = setTimeout(() => {
    applyMobileFilters();
  }, 500);
}

// Apply mobile filters
function applyMobileFilters() {
  const search = document.getElementById('mobile_search').value;
  const bankAccountId = document.getElementById('mobile_bank_account_id').value;
  const transactionType = document.getElementById('mobile_transaction_type').value;
  const fromDate = document.getElementById('mobile_from_date').value;
  const toDate = document.getElementById('mobile_to_date').value;
  
  const url = new URL(window.location);
  
  // Set or clear parameters
  if (search) url.searchParams.set('search', search);
  else url.searchParams.delete('search');
  
  if (bankAccountId) url.searchParams.set('bank_account_id', bankAccountId);
  else url.searchParams.delete('bank_account_id');
  
  if (transactionType) url.searchParams.set('transaction_type', transactionType);
  else url.searchParams.delete('transaction_type');
  
  if (fromDate) url.searchParams.set('from_date', fromDate);
  else url.searchParams.delete('from_date');
  
  if (toDate) url.searchParams.set('to_date', toDate);
  else url.searchParams.delete('to_date');
  
  // Navigate to the new URL
  window.location.href = url.toString();
}

// Clear mobile filters
function clearMobileFilters() {
  document.getElementById('mobile_search').value = '';
  document.getElementById('mobile_bank_account_id').value = '';
  document.getElementById('mobile_transaction_type').value = '';
  document.getElementById('mobile_from_date').value = '';
  document.getElementById('mobile_to_date').value = '';
  
  window.location.href = '/transactions';
}

// Load more mobile transactions
function loadMoreMobileTransactions() {
  const button = document.getElementById('mobile-load-more-btn');
  const currentPage = <%= @mobile_transactions_data[:current_page] %>;
  const nextPage = currentPage + 1;
  
  if (nextPage > <%= @mobile_transactions_data[:total_pages] %>) return;
  
  // Show loading state
  button.innerHTML = `
    <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
    <%= t('transactions.loading') %>
  `;
  button.disabled = true;
  
  // Build URL with current filters and next page
  const url = new URL(window.location);
  url.searchParams.set('page', nextPage);
  
  fetch(url, {
    headers: {
      'X-Requested-With': 'XMLHttpRequest',
      'Accept': 'text/html'
    }
  })
  .then(response => response.text())
  .then(html => {
    // Parse the response to extract transaction cards
    const parser = new DOMParser();
    const doc = parser.parseFromString(html, 'text/html');
    const newCards = doc.querySelectorAll('.mobile-transaction-card');
    
    // Append new cards to the existing list
    const cardsContainer = document.getElementById('mobile-transactions-cards');
    newCards.forEach(card => {
      cardsContainer.appendChild(card);
    });
    
    // Update button state
    if (nextPage >= <%= @mobile_transactions_data[:total_pages] %>) {
      button.style.display = 'none';
    } else {
      button.innerHTML = `
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
        <%= t('transactions.load_more') %>
      `;
      button.disabled = false;
    }
  })
  .catch(error => {
    console.error('Error loading more transactions:', error);
    button.innerHTML = `
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
      </svg>
      <%= t('transactions.load_more') %>
    `;
    button.disabled = false;
  });
}

// Initialize mobile transactions page
document.addEventListener('DOMContentLoaded', function() {
  // Close filters by default on mobile
  document.getElementById('mobile-filters-content').classList.add('hidden');
});
</script>
