<%= turbo_frame_tag "waitlist-form" do %>
  <%= form_with model: waitlist, url: waitlists_path, class: "flex flex-col sm:flex-row gap-3" do |f| %>
    <div class="flex-1">
      <%= f.email_field :email,
            placeholder: t("landing.hero.email_placeholder"),
            required: true,
            autofocus: false,
            class: "w-full px-4 py-3.5 rounded-xl border #{waitlist.errors[:email].any? ? 'border-red-300 ring-2 ring-red-100' : 'border-slate-300'} text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all text-base" %>
      <% if waitlist.errors[:email].any? %>
        <p class="mt-1.5 text-sm text-red-500"><%= waitlist.errors[:email].first %></p>
      <% end %>
    </div>
    <%= f.submit t("landing.hero.join_button"),
          class: "px-6 py-3.5 rounded-xl text-base font-semibold text-white bg-indigo-600 hover:bg-indigo-700 shadow-md shadow-indigo-500/25 transition-all hover:shadow-lg hover:shadow-indigo-500/30 hover:-translate-y-0.5 cursor-pointer whitespace-nowrap" %>
  <% end %>
<% end %>
