<% content_for :title, @series.name %>

<%
  status_pill_class =
    case @series.status
    when "active"    then "bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200"
    when "paused"    then "bg-slate-100 text-slate-800 dark:bg-slate-700 dark:text-slate-200"
    when "cancelled" then "bg-rose-100 text-rose-800 dark:bg-rose-900 dark:text-rose-200"
    when "detected"  then "bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200"
    end

  type_pill_class =
    case @series.transaction_type
    when "income"           then "bg-emerald-100 text-emerald-800 dark:bg-emerald-900 dark:text-emerald-200"
    when "fixed_expense"    then "bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200"
    when "variable_expense" then "bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200"
    end

  amount_color_class = @series.transaction_type == "income" ? "text-emerald-600" : "text-slate-900 dark:text-slate-100"

  last_charged_text = @series.last_charged_at ? l(@series.last_charged_at, format: :long) : t("recurring.show.never")
%>

<!-- Mobile View -->
<div class="block md:hidden min-h-screen bg-slate-50 dark:bg-slate-900 pb-24" >
  <!-- Mobile Header -->
  <header class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 px-4 py-4 sticky top-0 z-10">
    <div class="flex items-center justify-between mb-3">
      <%= link_to recurring_series_index_path,
                  class: "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      <% end %>
      <h1 class="text-xl font-bold text-slate-900 dark:text-slate-100 flex-1 text-center px-2 truncate"><%= @series.name %></h1>
      <%= link_to edit_recurring_series_path(@series), class: "text-indigo-600 hover:text-indigo-700" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
        </svg>
      <% end %>
    </div>
    <div class="flex items-center justify-center space-x-2">
      <span class="text-xs px-2 py-1 rounded-full <%= status_pill_class %>">
        <%= t("recurring.statuses.#{@series.status}") %>
      </span>
      <span class="text-xs px-2 py-1 rounded-full <%= type_pill_class %>">
        <%= t("recurring.form.types.#{@series.transaction_type}") %>
      </span>
    </div>
  </header>

  <!-- Mobile Content -->
  <div class="px-4 py-4 space-y-4">
    <!-- Hero: amount + monthly/annual stats -->
    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-4">
      <div class="flex justify-center mb-4">
        <div class="w-20 h-20 rounded-xl flex items-center justify-center bg-indigo-50 dark:bg-indigo-900/30">
          <svg class="w-10 h-10 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
        </div>
      </div>

      <p class="text-center text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-1">
        <%= t("recurring.form.amount_label") %> · <%= t("recurring.frequencies.#{@series.frequency}") %>
      </p>
      <p class="text-center text-3xl font-bold <%= amount_color_class %> mb-4">
        <%= number_to_currency(@series.expected_amount, unit: "$") %>
      </p>

      <div class="grid grid-cols-2 gap-3">
        <div class="text-center p-3 bg-slate-50 dark:bg-slate-900 rounded-lg">
          <div class="text-xl font-bold text-slate-900 dark:text-slate-100"><%= number_to_currency(@series.monthly_estimate, unit: "$") %></div>
          <div class="text-xs text-slate-600 dark:text-slate-400"><%= t("recurring.monthly_total") %></div>
        </div>
        <div class="text-center p-3 bg-slate-50 dark:bg-slate-900 rounded-lg">
          <div class="text-xl font-bold text-slate-900 dark:text-slate-100"><%= number_to_currency(@series.annual_estimate, unit: "$") %></div>
          <div class="text-xs text-slate-600 dark:text-slate-400"><%= t("recurring.annual_total") %></div>
        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="flex flex-col gap-2">
      <% if @series.status == "active" %>
        <%= button_to recurring_series_path(@series), method: :patch,
              params: { recurring_series: { status: "paused" } },
              class: "w-full inline-flex items-center justify-center px-4 py-3 bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-slate-100 rounded-lg font-medium hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors border border-slate-200 dark:border-slate-700" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <%= t("recurring.actions.pause") %>
        <% end %>
        <p class="text-xs text-slate-500 dark:text-slate-400 px-1 -mt-1"><%= t("recurring.action_hints.pause") %></p>
      <% elsif @series.status == "paused" %>
        <%= button_to recurring_series_path(@series), method: :patch,
              params: { recurring_series: { status: "active" } },
              class: "w-full inline-flex items-center justify-center px-4 py-3 bg-indigo-600 text-white rounded-lg font-medium hover:bg-indigo-700 transition-colors" do %>
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
          </svg>
          <%= t("recurring.actions.resume") %>
        <% end %>
      <% elsif @series.status == "detected" %>
        <%= button_to recurring_series_path(@series), method: :patch,
              params: { recurring_series: { status: "active" } },
              class: "w-full inline-flex items-center justify-center px-4 py-3 bg-indigo-600 text-white rounded-lg font-medium hover:bg-indigo-700 transition-colors" do %>
          <%= t("recurring.actions.promote") %>
        <% end %>
      <% elsif @series.status == "cancelled" %>
        <%= button_to recurring_series_path(@series), method: :patch,
              params: { recurring_series: { status: "active" } },
              class: "w-full inline-flex items-center justify-center px-4 py-3 bg-indigo-600 text-white rounded-lg font-medium hover:bg-indigo-700 transition-colors" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
          <%= t("recurring.actions.restore") %>
        <% end %>
      <% end %>

      <% unless %w[cancelled detected].include?(@series.status) %>
        <%= button_to recurring_series_path(@series), method: :patch,
              params: { recurring_series: { status: "cancelled" } },
              class: "w-full inline-flex items-center justify-center px-4 py-3 bg-white dark:bg-slate-800 text-rose-700 dark:text-rose-300 rounded-lg font-medium border border-rose-300 dark:border-rose-700 hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-colors" do %>
          <%= t("recurring.actions.cancel") %>
        <% end %>
        <p class="text-xs text-slate-500 dark:text-slate-400 px-1 -mt-1"><%= t("recurring.action_hints.cancel") %></p>
      <% end %>
    </div>

    <!-- Details -->
    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-4">
      <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-3"><%= t("recurring.show.details") %></h3>
      <dl class="space-y-3">
        <div>
          <dt class="text-sm text-slate-600 dark:text-slate-400"><%= t("recurring.show.next_due") %></dt>
          <dd class="text-base font-medium text-slate-900 dark:text-slate-100"><%= l(@series.next_due_date, format: :long) %></dd>
        </div>
        <div>
          <dt class="text-sm text-slate-600 dark:text-slate-400"><%= t("recurring.show.last_charged") %></dt>
          <dd class="text-base font-medium text-slate-900 dark:text-slate-100"><%= last_charged_text %></dd>
        </div>
        <div>
          <dt class="text-sm text-slate-600 dark:text-slate-400"><%= t("recurring.show.category") %></dt>
          <dd class="text-base font-medium text-slate-900 dark:text-slate-100">
            <% if @series.category %>
              <span class="inline-flex items-center px-2 py-1 rounded-md bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200 text-xs font-medium">
                <%= @series.category.name %>
              </span>
            <% else %>
              <span class="text-sm text-slate-500 dark:text-slate-400"><%= t("recurring.show.no_category") %></span>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="text-sm text-slate-600 dark:text-slate-400"><%= t("recurring.show.source") %></dt>
          <dd class="text-base font-medium text-slate-900 dark:text-slate-100"><%= t("recurring.sources.#{@series.source}") %></dd>
        </div>
        <div>
          <dt class="text-sm text-slate-600 dark:text-slate-400"><%= t("recurring.show.occurrences") %></dt>
          <dd class="text-base font-medium text-slate-900 dark:text-slate-100"><%= @series.occurrences_count %></dd>
        </div>
        <% if @series.confidence_score.present? %>
          <div>
            <dt class="text-sm text-slate-600 dark:text-slate-400"><%= t("recurring.show.confidence") %></dt>
            <dd class="text-base font-medium text-slate-900 dark:text-slate-100"><%= @series.confidence_score %>/100</dd>
          </div>
        <% end %>
        <% if @series.notes.present? %>
          <div>
            <dt class="text-sm text-slate-600 dark:text-slate-400"><%= t("recurring.show.notes") %></dt>
            <dd class="text-base text-slate-900 dark:text-slate-100"><%= simple_format(@series.notes) %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <!-- Recent Transactions -->
    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-4">
      <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-3"><%= t("recurring.show.recent_transactions") %></h3>
      <% if @transactions.any? %>
        <div class="space-y-2">
          <% @transactions.first(5).each do |tx| %>
            <div class="flex items-center justify-between p-3 bg-slate-50 dark:bg-slate-900 rounded-lg">
              <div class="flex-1 min-w-0">
                <div class="font-medium text-slate-900 dark:text-slate-100 truncate"><%= tx.description %></div>
                <div class="text-xs text-slate-500 dark:text-slate-400"><%= l(tx.date, format: :short) %></div>
              </div>
              <div class="text-sm font-semibold <%= tx.amount.negative? ? 'text-rose-600' : 'text-emerald-600' %>">
                <%= number_to_currency(tx.amount, unit: "$") %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-8">
          <div class="w-16 h-16 bg-indigo-50 dark:bg-indigo-900/30 rounded-full flex items-center justify-center mx-auto mb-3">
            <svg class="w-8 h-8 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
          </div>
          <h4 class="text-sm font-medium text-slate-900 dark:text-slate-100 mb-1"><%= t("recurring.show.no_transactions") %></h4>
          <p class="text-sm text-slate-600 dark:text-slate-400"><%= t("recurring.show.no_transactions_description") %></p>
        </div>
      <% end %>
    </div>

    <!-- Cancelled-on indicator -->
    <% if @series.status == "cancelled" && @series.cancelled_at %>
      <p class="text-xs text-slate-500 dark:text-slate-400 text-center">
        <%= t("recurring.show.cancelled_on", date: l(@series.cancelled_at.to_date, format: :long)) %>
      </p>
    <% end %>

    <!-- Destructive: Delete -->
    <%= button_to recurring_series_path(@series), method: :delete,
          data: { turbo_confirm: t("recurring.delete_confirm", name: @series.name) },
          class: "w-full inline-flex items-center justify-center px-4 py-3 bg-rose-600 text-white rounded-lg font-medium hover:bg-rose-700 transition-colors" do %>
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
      </svg>
      <%= t("recurring.actions.delete") %>
    <% end %>
    <p class="text-xs text-slate-500 dark:text-slate-400 text-center px-1"><%= t("recurring.action_hints.delete") %></p>
  </div>
</div>

<!-- Desktop View -->
<div class="hidden md:block min-h-screen bg-slate-50 dark:bg-slate-900">
  <!-- Header -->
  <header class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 px-8 py-6">
    <div class="max-w-7xl mx-auto flex items-start justify-between gap-4">
      <div class="flex items-center space-x-4 min-w-0">
        <%= link_to recurring_series_index_path, class: "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:text-slate-100 flex-shrink-0" do %>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        <% end %>
        <div class="w-16 h-16 rounded-xl flex items-center justify-center bg-indigo-50 dark:bg-indigo-900/30 flex-shrink-0">
          <svg class="w-8 h-8 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
        </div>
        <div class="min-w-0">
          <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100 truncate"><%= @series.name %></h1>
          <div class="flex items-center flex-wrap gap-2 mt-1">
            <span class="text-sm px-2 py-1 rounded-full <%= status_pill_class %>">
              <%= t("recurring.statuses.#{@series.status}") %>
            </span>
            <span class="text-sm px-2 py-1 rounded-full <%= type_pill_class %>">
              <%= t("recurring.form.types.#{@series.transaction_type}") %>
            </span>
            <span class="text-sm text-slate-500 dark:text-slate-400">
              <%= t("recurring.frequencies.#{@series.frequency}") %> · <%= number_to_currency(@series.expected_amount, unit: "$") %>
            </span>
          </div>
        </div>
      </div>
      <div class="flex items-center space-x-3 flex-shrink-0">
        <%= link_to edit_recurring_series_path(@series),
                    class: "inline-flex items-center px-4 py-2 bg-indigo-600 text-white rounded-lg font-medium hover:bg-indigo-700 transition-colors shadow-sm" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          <%= t("recurring.actions.edit") %>
        <% end %>
        <%= button_to recurring_series_path(@series), method: :delete,
                    data: { turbo_confirm: t("recurring.delete_confirm", name: @series.name) },
                    class: "inline-flex items-center px-4 py-2 bg-rose-600 text-white rounded-lg font-medium hover:bg-rose-700 transition-colors shadow-sm" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
          <%= t("recurring.actions.delete") %>
        <% end %>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Left Column -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Summary -->
        <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6">
          <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-100 mb-6"><%= t("recurring.show.summary") %></h2>
          <div class="grid grid-cols-3 gap-4">
            <div class="text-center p-4 bg-slate-50 dark:bg-slate-900 rounded-lg">
              <div class="text-2xl font-bold <%= amount_color_class %>"><%= number_to_currency(@series.expected_amount, unit: "$") %></div>
              <div class="text-sm text-slate-600 dark:text-slate-400"><%= t("recurring.form.amount_label") %></div>
            </div>
            <div class="text-center p-4 bg-slate-50 dark:bg-slate-900 rounded-lg">
              <div class="text-2xl font-bold text-slate-900 dark:text-slate-100"><%= number_to_currency(@series.monthly_estimate, unit: "$") %></div>
              <div class="text-sm text-slate-600 dark:text-slate-400"><%= t("recurring.monthly_total") %></div>
            </div>
            <div class="text-center p-4 bg-slate-50 dark:bg-slate-900 rounded-lg">
              <div class="text-2xl font-bold text-slate-900 dark:text-slate-100"><%= number_to_currency(@series.annual_estimate, unit: "$") %></div>
              <div class="text-sm text-slate-600 dark:text-slate-400"><%= t("recurring.annual_total") %></div>
            </div>
          </div>
        </div>

        <!-- Status Actions -->
        <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6">
          <div class="flex flex-wrap gap-3">
            <% if @series.status == "active" %>
              <%= button_to recurring_series_path(@series), method: :patch,
                    params: { recurring_series: { status: "paused" } },
                    class: "inline-flex items-center px-4 py-2 bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-slate-100 rounded-lg font-medium hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 transition-colors" do %>
                <%= t("recurring.actions.pause") %>
              <% end %>
            <% elsif @series.status == "paused" %>
              <%= button_to recurring_series_path(@series), method: :patch,
                    params: { recurring_series: { status: "active" } },
                    class: "inline-flex items-center px-4 py-2 bg-indigo-600 text-white rounded-lg font-medium hover:bg-indigo-700 transition-colors" do %>
                <%= t("recurring.actions.resume") %>
              <% end %>
            <% elsif @series.status == "detected" %>
              <%= button_to recurring_series_path(@series), method: :patch,
                    params: { recurring_series: { status: "active" } },
                    class: "inline-flex items-center px-4 py-2 bg-indigo-600 text-white rounded-lg font-medium hover:bg-indigo-700 transition-colors" do %>
                <%= t("recurring.actions.promote") %>
              <% end %>
            <% elsif @series.status == "cancelled" %>
              <%= button_to recurring_series_path(@series), method: :patch,
                    params: { recurring_series: { status: "active" } },
                    class: "inline-flex items-center px-4 py-2 bg-indigo-600 text-white rounded-lg font-medium hover:bg-indigo-700 transition-colors" do %>
                <%= t("recurring.actions.restore") %>
              <% end %>
            <% end %>
            <% unless %w[cancelled detected].include?(@series.status) %>
              <%= button_to recurring_series_path(@series), method: :patch,
                    params: { recurring_series: { status: "cancelled" } },
                    class: "inline-flex items-center px-4 py-2 bg-white dark:bg-slate-800 text-rose-700 dark:text-rose-300 rounded-lg font-medium border border-rose-300 dark:border-rose-700 hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-colors" do %>
                <%= t("recurring.actions.cancel") %>
              <% end %>
            <% end %>
          </div>
          <% hint_key = @series.status == "active" ? "pause" : (@series.status == "paused" ? "pause" : nil) %>
          <% if hint_key %>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-3"><%= t("recurring.action_hints.#{hint_key}") %></p>
          <% end %>
          <% if @series.status == "cancelled" && @series.cancelled_at %>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-3">
              <%= t("recurring.show.cancelled_on", date: l(@series.cancelled_at.to_date, format: :long)) %>
            </p>
          <% end %>
        </div>

        <!-- Linked Transactions -->
        <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-100"><%= t("recurring.show.recent_transactions") %></h2>
            <% if @transactions.any? %>
              <%= link_to t("recurring.show.view_all"),
                          transactions_path(recurring_series_id: @series.id),
                          class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
            <% end %>
          </div>
          <% if @transactions.any? %>
            <div class="space-y-3">
              <% @transactions.first(10).each do |tx| %>
                <div class="flex items-center justify-between p-3 bg-slate-50 dark:bg-slate-900 rounded-lg">
                  <div class="min-w-0">
                    <div class="text-sm font-medium text-slate-900 dark:text-slate-100 truncate"><%= tx.description %></div>
                    <div class="text-xs text-slate-500 dark:text-slate-400"><%= l(tx.date, format: :long) %></div>
                  </div>
                  <div class="text-sm font-semibold <%= tx.amount.negative? ? 'text-rose-600' : 'text-emerald-600' %>">
                    <%= number_to_currency(tx.amount, unit: "$") %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-12">
              <div class="w-20 h-20 bg-indigo-50 dark:bg-indigo-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-10 h-10 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-2"><%= t("recurring.show.no_transactions") %></h3>
              <p class="text-slate-600 dark:text-slate-400"><%= t("recurring.show.no_transactions_description") %></p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Right Sidebar -->
      <div class="space-y-6">
        <!-- Details -->
        <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6">
          <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-4"><%= t("recurring.show.details") %></h3>
          <dl class="space-y-3">
            <div>
              <dt class="text-sm text-slate-600 dark:text-slate-400"><%= t("recurring.show.next_due") %></dt>
              <dd class="text-base font-medium text-slate-900 dark:text-slate-100"><%= l(@series.next_due_date, format: :long) %></dd>
            </div>
            <div>
              <dt class="text-sm text-slate-600 dark:text-slate-400"><%= t("recurring.show.last_charged") %></dt>
              <dd class="text-base font-medium text-slate-900 dark:text-slate-100"><%= last_charged_text %></dd>
            </div>
            <div>
              <dt class="text-sm text-slate-600 dark:text-slate-400"><%= t("recurring.show.frequency") %></dt>
              <dd class="text-base font-medium text-slate-900 dark:text-slate-100"><%= t("recurring.frequencies.#{@series.frequency}") %></dd>
            </div>
            <div>
              <dt class="text-sm text-slate-600 dark:text-slate-400"><%= t("recurring.show.type") %></dt>
              <dd class="text-base font-medium text-slate-900 dark:text-slate-100"><%= t("recurring.form.types.#{@series.transaction_type}") %></dd>
            </div>
            <div>
              <dt class="text-sm text-slate-600 dark:text-slate-400"><%= t("recurring.show.category") %></dt>
              <dd class="text-base font-medium text-slate-900 dark:text-slate-100">
                <% if @series.category %>
                  <span class="inline-flex items-center px-2 py-1 rounded-md bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200 text-xs font-medium">
                    <%= @series.category.name %>
                  </span>
                <% else %>
                  <span class="text-sm text-slate-500 dark:text-slate-400"><%= t("recurring.show.no_category") %></span>
                <% end %>
              </dd>
            </div>
            <div>
              <dt class="text-sm text-slate-600 dark:text-slate-400"><%= t("recurring.show.source") %></dt>
              <dd class="text-base font-medium text-slate-900 dark:text-slate-100"><%= t("recurring.sources.#{@series.source}") %></dd>
            </div>
            <div>
              <dt class="text-sm text-slate-600 dark:text-slate-400"><%= t("recurring.show.occurrences") %></dt>
              <dd class="text-base font-medium text-slate-900 dark:text-slate-100"><%= @series.occurrences_count %></dd>
            </div>
            <% if @series.confidence_score.present? %>
              <div>
                <dt class="text-sm text-slate-600 dark:text-slate-400"><%= t("recurring.show.confidence") %></dt>
                <dd class="text-base font-medium text-slate-900 dark:text-slate-100"><%= @series.confidence_score %>/100</dd>
              </div>
            <% end %>
          </dl>
        </div>

        <!-- Notes -->
        <% if @series.notes.present? %>
          <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-4"><%= t("recurring.show.notes") %></h3>
            <p class="text-sm text-slate-600 dark:text-slate-400"><%= simple_format(@series.notes) %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
