<div class="goal-new-page">
  <div class="goal-main">
    <!-- Mobile View -->
    <div class="block md:hidden min-h-screen bg-slate-50 pb-24">
      <!-- Mobile Header -->
      <header class="bg-white border-b border-slate-200 px-4 py-4 sticky top-0 z-10">
        <div class="flex items-center mb-3">
          <%= link_to goals_path, class: "mr-3 text-slate-600 hover:text-slate-900" do %>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
          <% end %>
          <div>
            <h1 class="text-xl font-bold text-slate-900"><%= t('goals.new') %></h1>
            <p class="text-xs text-slate-600"><%= t('goals.add_new_description') %></p>
          </div>
        </div>
      </header>

      <!-- Mobile Content -->
      <div class="px-4 py-4">
        <%= render 'form', goal: @goal, categories: @categories %>
      </div>
    </div>

    <!-- Desktop View -->
    <div class="hidden md:block min-h-screen bg-slate-50">
      <!-- Header -->
      <header class="bg-white border-b border-slate-200 px-8 py-6">
        <div class="max-w-3xl mx-auto">
          <div class="flex items-center justify-between mb-4">
            <%= link_to goals_path, class: "text-slate-600 hover:text-slate-900 flex items-center" do %>
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
              <%= t('goals.back_to_goals') %>
            <% end %>
          </div>
          <h1 class="text-3xl font-bold text-slate-900"><%= t('goals.new') %></h1>
          <p class="text-slate-600 mt-2"><%= t('goals.add_new_description') %></p>
        </div>
      </header>

      <!-- Content -->
      <div class="max-w-3xl mx-auto px-8 py-8">
        <%= render 'form', goal: @goal, categories: @categories %>
      </div>
    </div>
  </div>
</div>
