<% content_for :title, t('transactions.edit_transaction') %>
<% content_for :hide_fab, true %>

<%# Two delete buttons exist below — one in the mobile header (icon), one in the desktop footer (labeled).
    Each lives inside its own responsive wrapper (block md:hidden / hidden md:block) and is never
    visible at the same time. This mirrors the existing pattern used for the rest of this page. %>

<!-- Mobile View: Full-width -->
<div class="block md:hidden min-h-screen bg-white pb-20" data-controller="transaction-form page-transition">
  <!-- Header -->
  <header class="bg-white border-b border-slate-200 px-4 py-4 sticky top-0 z-50">
    <div class="flex items-center justify-between">
      <%= link_to transactions_return_path(@return_to), class: "text-slate-600 hover:text-slate-900", data: { action: "click->page-transition#navigateBack" } do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      <% end %>

      <div class="flex-1 mx-3">
        <h1 class="text-xl font-bold text-slate-900"><%= t('transactions.edit_transaction') %></h1>
        <p class="text-xs text-slate-600"><%= @transaction.description %></p>
      </div>

      <div class="flex items-center space-x-2">
        <%= link_to transactions_return_path(@return_to), class: "p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-50 rounded-lg transition-colors", data: { action: "click->page-transition#navigateBack" } do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        <% end %>

        <%= button_to transaction_path(@transaction),
              method: :delete,
              params: { return_to: @return_to },
              form: { data: { turbo_confirm: t("transactions.confirm_delete") } },
              class: "p-2 text-red-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors",
              title: t("transactions.delete_transaction") do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
        <% end %>

        <button type="submit"
                form="transaction_form"
                data-transaction-form-target="submitButton"
                disabled
                class="p-2 text-slate-400 cursor-not-allowed rounded-lg transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Content -->
  <div class="space-y-6">
    <!-- Flash Messages -->
    <% if flash[:alert] %>
      <div class="mx-4 mt-4 p-4 bg-red-50 border border-red-200 rounded-lg">
        <p class="text-sm text-red-800"><%= flash[:alert] %></p>
      </div>
    <% end %>

    <!-- Mobile: Amount at top with visual styling -->
    <div class="text-center py-6 border-b border-slate-100">
      <div class="flex items-center justify-center space-x-1">
        <!-- Sign Display (non-editable) -->
        <span data-transaction-form-target="amountSign" class="text-3xl font-bold">-</span>

        <!-- Currency Symbol -->
        <span data-transaction-form-target="amountCurrency" class="text-3xl font-bold">$</span>

        <!-- Amount Input (auto-width based on content) -->
        <input type="text"
               form="transaction_form"
               name="transaction[amount]"
               value="<%= number_with_delimiter(@transaction.amount.abs, delimiter: ',') %>"
               data-transaction-form-target="amount"
               data-action="input->transaction-form#handleAmountInput blur->transaction-form#handleAmountBlur focus->transaction-form#clearPlaceholder blur->transaction-form#restorePlaceholder"
               data-controller="currency-input"
               inputmode="decimal"
               required
               style="width: 5ch; min-width: 5ch; max-width: 15ch;"
               class="text-3xl font-bold text-center bg-transparent border-0 outline-none"
               placeholder="0.00">
      </div>
    </div>

    <div class="px-4">
      <%= render 'transaction_form', transaction: @transaction, bank_accounts: @bank_accounts, show_amount: false, show_submit: false, return_to: @return_to %>
    </div>
  </div>
</div>

<!-- Desktop View: Centered card -->
<div class="hidden md:block min-h-screen bg-slate-50" data-controller="transaction-form page-transition">
  <!-- Header -->
  <header class="bg-white border-b border-slate-200 px-8 py-6">
    <div class="max-w-3xl mx-auto">
      <div class="flex items-center justify-between mb-4">
        <%= link_to transactions_return_path(@return_to), class: "text-slate-600 hover:text-slate-900 flex items-center", data: { action: "click->page-transition#navigateBack" } do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          <%= t('transactions.back_to_transactions') %>
        <% end %>
      </div>
      <h1 class="text-3xl font-bold text-slate-900"><%= t('transactions.edit_transaction') %></h1>
      <p class="text-slate-600 mt-2"><%= @transaction.description %></p>
    </div>
  </header>

  <!-- Content -->
  <div class="max-w-3xl mx-auto px-8 py-8">
    <!-- Flash Messages -->
    <% if flash[:alert] %>
      <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
        <p class="text-sm text-red-800"><%= flash[:alert] %></p>
      </div>
    <% end %>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
      <%= render 'transaction_form', transaction: @transaction, bank_accounts: @bank_accounts, return_to: @return_to %>
    </div>

    <div class="mt-6 pt-6 border-t border-slate-200">
      <%= button_to transaction_path(@transaction),
            method: :delete,
            params: { return_to: @return_to },
            form: { data: { turbo_confirm: t("transactions.confirm_delete") } },
            class: "flex items-center gap-2 px-4 py-2 text-sm font-medium text-red-600 hover:text-red-700 hover:bg-red-50 border border-red-200 rounded-lg transition-colors" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
        </svg>
        <%= t("transactions.delete_transaction") %>
      <% end %>
    </div>
  </div>
</div>
