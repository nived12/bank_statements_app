<section class="py-20 md:py-28 bg-slate-50/80" id="showcase">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16" data-landing-scroll-target="section">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        <%= t("landing.showcase.title") %>
      </h2>
      <p class="mt-4 text-lg text-slate-600">
        <%= t("landing.showcase.subtitle") %>
      </p>
    </div>

    <div class="space-y-20 md:space-y-28">
      <!-- Transactions -->
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center" data-landing-scroll-target="section">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl shadow-slate-900/10 border border-slate-200/50 bg-white">
          <%= image_tag "landing/transactions.png",
                alt: t("landing.showcase.transactions.alt"),
                class: "w-full h-auto",
                loading: "lazy" %>
        </div>
        <div class="max-w-lg">
          <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
            <%= t("landing.showcase.transactions.title") %>
          </h3>
          <p class="mt-4 text-lg text-slate-600 leading-relaxed">
            <%= t("landing.showcase.transactions.description") %>
          </p>
        </div>
      </div>

      <!-- Categories (reversed) -->
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center" data-landing-scroll-target="section">
        <div class="max-w-lg lg:order-1">
          <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
            <%= t("landing.showcase.categories.title") %>
          </h3>
          <p class="mt-4 text-lg text-slate-600 leading-relaxed">
            <%= t("landing.showcase.categories.description") %>
          </p>
        </div>
        <div class="relative rounded-2xl overflow-hidden shadow-2xl shadow-slate-900/10 border border-slate-200/50 bg-white lg:order-2">
          <%= image_tag "landing/categories.png",
                alt: t("landing.showcase.categories.alt"),
                class: "w-full h-auto",
                loading: "lazy" %>
        </div>
      </div>

      <!-- Accounts -->
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center" data-landing-scroll-target="section">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl shadow-slate-900/10 border border-slate-200/50 bg-white">
          <%= image_tag "landing/accounts.png",
                alt: t("landing.showcase.accounts.alt"),
                class: "w-full h-auto",
                loading: "lazy" %>
        </div>
        <div class="max-w-lg">
          <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
            <%= t("landing.showcase.accounts.title") %>
          </h3>
          <p class="mt-4 text-lg text-slate-600 leading-relaxed">
            <%= t("landing.showcase.accounts.description") %>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
