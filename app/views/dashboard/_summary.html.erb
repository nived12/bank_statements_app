<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

  <!-- TOTAL BALANCE CARD: Portfolio Balance Overview -->
  <div class="app-card md:col-span-2 lg:col-span-3">
    <h2 class="text-lg font-medium text-slate-900 mb-4">Total Balance</h2>
    <p class="text-2xl font-bold text-slate-900"><%= format_currency(@total_balance) %></p>
    <p class="text-sm text-slate-500"><%= t('dashboard.across_accounts', count: @bank_accounts.count) %></p>
  </div>

  <!-- INCOME METRIC CARD -->
  <div class="app-card md:col-span-1">
    <h2 class="text-lg font-medium text-slate-900 mb-4"><%= t('monthly_summary.income') %></h2>
    <p class="text-2xl font-bold text-slate-900"><%= format_currency(@monthly_summary[:income]) %></p>
    <p class="text-sm text-slate-500"><%= @monthly_summary[:count] %> <%= t('table_headers.transactions') %></p>
  </div>

  <!-- EXPENSES METRIC CARD -->
  <div class="app-card md:col-span-1">
    <h2 class="text-lg font-medium text-slate-900 mb-4"><%= t('monthly_summary.expenses') %></h2>
    <p class="text-2xl font-bold text-slate-900"><%= format_currency(@monthly_summary[:expenses]) %></p>
    <p class="text-sm text-slate-500"><%= @monthly_summary[:count] %> <%= t('table_headers.transactions') %></p>
  </div>

  <!-- NET FLOW METRIC CARD -->
  <div class="app-card md:col-span-1">
    <h2 class="text-lg font-medium text-slate-900 mb-4"><%= t('monthly_summary.net_flow') %></h2>
    <p class="text-2xl font-bold text-slate-900"><%= format_currency(@monthly_summary[:net]) %></p>
    <p class="text-sm text-slate-500"><%= @monthly_summary[:count] %> <%= t('table_headers.transactions') %></p>
  </div>

  <!-- TOTAL TRANSACTIONS CARD -->
  <div class="app-card md:col-span-1">
    <h2 class="text-lg font-medium text-slate-900 mb-4"><%= t('monthly_summary.total_transactions') %></h2>
    <p class="text-2xl font-bold text-slate-900"><%= @total_transactions %></p>
    <p class="text-sm text-slate-500"><%= t('table_headers.transactions') %></p>
  </div>

  <!-- TOTAL STATEMENTS CARD -->
  <div class="app-card md:col-span-1">
    <h2 class="text-lg font-medium text-slate-900 mb-4"><%= t('monthly_summary.total_statements') %></h2>
    <p class="text-2xl font-bold text-slate-900"><%= @total_statements %></p>
    <p class="text-sm text-slate-500"><%= t('table_headers.statements') %></p>
  </div>

  <!-- TOTAL ACCOUNTS CARD -->
  <div class="app-card md:col-span-1">
    <h2 class="text-lg font-medium text-slate-900 mb-4"><%= t('monthly_summary.total_accounts') %></h2>
    <p class="text-2xl font-bold text-slate-900"><%= @bank_accounts.count %></p>
    <p class="text-sm text-slate-500"><%= t('table_headers.accounts') %></p>
  </div>

  <% if @monthly_stats && @monthly_stats[:has_data] %>
    <!-- MONTHLY TRANSACTIONS COUNT -->
    <div class="app-card md:col-span-1">
      <h2 class="text-lg font-medium text-slate-900 mb-4"><%= t('monthly_summary.monthly_transactions_count') %></h2>
      <p class="text-2xl font-bold text-slate-900"><%= @monthly_stats&.dig(:total_transactions) || 0 %></p>
      <p class="text-sm text-slate-500"><%= t('table_headers.transactions') %></p>
    </div>

    <!-- AVERAGE INCOME -->
    <div class="app-card md:col-span-1">
      <h2 class="text-lg font-medium text-slate-900 mb-4"><%= t('monthly_summary.average_income') %></h2>
      <p class="text-2xl font-bold text-slate-900"><%= format_currency(@monthly_stats&.dig(:average_income) || 0) %></p>
      <p class="text-sm text-slate-500"><%= t('table_headers.transactions') %></p>
    </div>

    <!-- AVERAGE EXPENSE -->
    <div class="app-card md:col-span-1">
      <h2 class="text-lg font-medium text-slate-900 mb-4"><%= t('monthly_summary.average_expense') %></h2>
      <p class="text-2xl font-bold text-slate-900"><%= format_currency(@monthly_stats&.dig(:average_expense) || 0) %></p>
      <p class="text-sm text-slate-500"><%= t('table_headers.transactions') %></p>
    </div>
  <% end %>

  <!-- TOP CATEGORIES FOR SELECTED MONTH -->
  <% if @monthly_stats && @monthly_stats[:has_data] && @monthly_stats[:top_categories]&.any? %>
    <div class="col-span-3 bg-slate-100 p-4 rounded-lg">
      <h2 class="text-lg font-medium text-slate-900 mb-4"><%= t('monthly_summary.top_categories_for_month', month: l(@selected_month, format: :month_year)) %></h2>
      <% @monthly_stats[:top_categories].each_with_index do |category, index| %>
        <div class="app-card md:col-span-1">
          <h2 class="text-lg font-medium text-slate-900 mb-4"><%= category[:name] %></h2>
          <p class="text-2xl font-bold text-slate-900"><%= format_currency(category[:amount]) %></p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>