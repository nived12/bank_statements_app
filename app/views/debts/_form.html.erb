<%= form_with(model: debt, id: local_assigns[:form_id] || "debt_form", class: "space-y-8", data: { debt_form_target: "form", controller: "payment-mode" }) do |f| %>

  <%= render layout: "shared/form_section", locals: { title: t("form_sections.basics"), description: t("debts.sections.basics_help"), first: true } do %>
    <!-- Icon and Debt Name -->
    <div data-controller="icon-picker"
         data-icon-picker-selected-value="<%= debt.icon || 'credit-card' %>"
         data-action="icon-picker:changed->debt-form#iconChanged">
      <%= f.hidden_field :icon,
          data: {
            icon_picker_target: "input",
            debt_form_target: "iconInput"
          },
          value: debt.icon || 'credit-card' %>

      <div class="flex gap-3 items-start">
        <!-- Icon Button (click to show picker) -->
        <div class="relative">
          <button type="button"
                  data-action="click->icon-picker#togglePicker"
                  data-icon-picker-target="iconDisplay"
                  class="w-12 h-12 bg-red-50 dark:bg-red-900/30 rounded-xl flex items-center justify-center border-2 border-red-200 dark:border-red-800 hover:border-red-400 dark:hover:border-red-600 transition-colors flex-shrink-0 mt-7">
            <%= icon_svg(debt.icon || 'credit-card', css_classes: "w-6 h-6 text-red-600 dark:text-red-400") %>
          </button>

          <!-- Icon Picker Overlay (absolute positioned) -->
          <div data-icon-picker-target="pickerContainer" class="hidden absolute top-7 left-0 z-50 w-72 shadow-xl">
            <div class="p-3 bg-white dark:bg-slate-800 rounded-xl border-2 border-red-300 dark:border-red-700">
              <div class="grid grid-cols-6 gap-2 max-h-64 overflow-y-auto">
                <% IconsHelper::ICONS_LIBRARY.each do |icon_name, lucide_icon| %>
                  <button type="button"
                          data-action="click->icon-picker#select"
                          data-icon-picker-icon-param="<%= icon_name %>"
                          data-icon-name="<%= icon_name %>"
                          class="p-2 rounded-lg border-2 transition-all hover:border-red-300 dark:hover:border-red-700 flex items-center justify-center <%= icon_name == (debt.icon || 'credit-card') ? 'border-red-500 bg-red-50 dark:bg-red-900/30' : 'border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800' %>"
                          data-icon-picker-target="iconButton">
                    <%= icon(lucide_icon, library: "lucide", variant: "outline", class: "w-5 h-5 #{icon_name == (debt.icon || 'credit-card') ? 'text-red-600 dark:text-red-400' : 'text-slate-600 dark:text-slate-400'}") %>
                  </button>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- Name Field -->
        <div class="flex-1">
          <%= required_field_label(f, :name, t('debts.name')) %>
          <%= f.text_field :name,
              placeholder: t('debts.name_placeholder'),
              class: "w-full px-4 py-2.5 border #{debt.errors[:name].any? ? 'border-red-500' : 'border-slate-200 dark:border-slate-700'} rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500",
              required: true,
              data: { action: "input->debt-form#checkChanges" } %>
          <% if debt.errors[:name].any? %>
            <p class="mt-1 text-sm text-red-600 dark:text-red-400"><%= debt.errors[:name].first %></p>
          <% end %>
        </div>
      </div>
    </div>

    <%= render "shared/color_picker",
        form: f,
        record: debt,
        default_color: "#EF4444",
        label: t("debts.color"),
        change_action: "click->debt-form#checkChanges" %>
  <% end %>

  <%= render layout: "shared/form_section", locals: { title: t("form_sections.amounts"), description: t("debts.sections.amounts_help") } do %>
    <!-- Original Amount and Current Balance -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-y-0 md:grid-rows-[auto_auto_auto]">
      <div class="md:grid md:grid-rows-subgrid md:row-span-3">
        <%= required_field_label(f, :original_amount, t('debts.original_amount')) %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <span class="text-slate-500 dark:text-slate-400 sm:text-sm">$</span>
          </div>
          <%= f.text_field :original_amount,
              inputmode: "decimal",
              placeholder: "0.00",
              data: {
                controller: "currency-input",
                action: "input->debt-form#checkChanges change->debt-form#checkChanges"
              },
              class: "w-full pl-7 pr-3 py-2.5 border #{debt.errors[:original_amount].any? ? 'border-red-500' : 'border-slate-200 dark:border-slate-700'} rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500",
              required: true %>
        </div>
        <% if debt.errors[:original_amount].any? %>
          <p class="mt-1 text-sm text-red-600 dark:text-red-400"><%= debt.errors[:original_amount].first %></p>
        <% else %>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= t('debts.original_amount_help') %></p>
        <% end %>
      </div>

      <div class="md:grid md:grid-rows-subgrid md:row-span-3">
        <%# Label copy stays "Current Balance": the user types what they owe today, and
            opening_balance is the column that anchors it to opening_balance_date below. %>
        <%= required_field_label(f, :opening_balance, t('debts.current_balance')) %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <span class="text-slate-500 dark:text-slate-400 sm:text-sm">$</span>
          </div>
          <%= f.text_field :opening_balance,
              inputmode: "decimal",
              placeholder: "0.00",
              data: {
                controller: "currency-input",
                action: "input->debt-form#checkChanges change->debt-form#checkChanges input->payment-mode#updateSuggestedDate change->payment-mode#updateCalculatedAmount"
              },
              class: "w-full pl-7 pr-3 py-2.5 border #{debt.errors[:opening_balance].any? ? 'border-red-500' : 'border-slate-200 dark:border-slate-700'} rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500" %>
        </div>
        <% if debt.errors[:opening_balance].any? %>
          <p class="mt-1 text-sm text-red-600 dark:text-red-400"><%= debt.errors[:opening_balance].first %></p>
        <% else %>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= t('debts.current_balance_help') %></p>
        <% end %>
      </div>
    </div>

    <!-- Dates, column-matched to the amounts above: the balance date sits under the
         balance it dates. -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-y-0 md:grid-rows-[auto_auto_auto]">
      <div class="md:grid md:grid-rows-subgrid md:row-span-3">
        <div data-payment-mode-target="targetDateLabelContainer">
          <% if debt.payment_mode == 'calculated' %>
            <%= required_field_label(f, :target_payoff_date, t('debts.target_payoff_date')) %>
          <% else %>
            <%= optional_field_label(f, :target_payoff_date, t('debts.target_payoff_date')) %>
          <% end %>
        </div>
        <%= f.date_field :target_payoff_date,
            class: "w-full px-4 py-2.5 border #{debt.errors[:target_payoff_date].any? ? 'border-red-500' : 'border-slate-200 dark:border-slate-700'} rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500",
            data: {
              payment_mode_target: "targetDateField",
              action: "change->payment-mode#checkTargetDate change->payment-mode#updateCalculatedAmount change->debt-form#checkChanges"
            } %>
        <% if debt.errors[:target_payoff_date].any? %>
          <p class="mt-1 text-sm text-red-600 dark:text-red-400"><%= debt.errors[:target_payoff_date].first %></p>
        <% else %>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= t('debts.target_payoff_date_help') %></p>
        <% end %>
      </div>

      <div class="md:grid md:grid-rows-subgrid md:row-span-3">
        <%= required_field_label(f, :opening_balance_date, t('debts.opening_balance_date')) %>
        <%= f.date_field :opening_balance_date,
            max: Date.current,
            class: "w-full px-4 py-2.5 border #{debt.errors[:opening_balance_date].any? ? 'border-red-500' : 'border-slate-200 dark:border-slate-700'} rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500",
            data: { action: "change->debt-form#checkChanges" } %>
        <% if debt.errors[:opening_balance_date].any? %>
          <p class="mt-1 text-sm text-red-600 dark:text-red-400"><%= debt.errors[:opening_balance_date].first %></p>
        <% else %>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= t('debts.opening_balance_date_help') %></p>
        <% end %>
      </div>
    </div>

    <!-- Payment terms: three related fields on one row so none is orphaned. -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-y-0 md:grid-rows-[auto_auto_auto]">
      <div class="md:grid md:grid-rows-subgrid md:row-span-3">
        <%= optional_field_label(f, :interest_rate, t('debts.interest_rate_annual')) %>
        <%= f.text_field :interest_rate,
            inputmode: "decimal",
            placeholder: t('debts.interest_rate_placeholder'),
            data: { action: "input->debt-form#checkChanges" },
            class: "w-full px-4 py-2.5 border #{debt.errors[:interest_rate].any? ? 'border-red-500' : 'border-slate-200 dark:border-slate-700'} rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500" %>
        <% if debt.errors[:interest_rate].any? %>
          <p class="mt-1 text-sm text-red-600 dark:text-red-400"><%= debt.errors[:interest_rate].first %></p>
        <% else %>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= t('debts.interest_rate_help') %></p>
        <% end %>
      </div>

      <div class="md:grid md:grid-rows-subgrid md:row-span-3">
        <%= optional_field_label(f, :minimum_payment, t('debts.minimum_payment')) %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <span class="text-slate-500 dark:text-slate-400 sm:text-sm">$</span>
          </div>
          <%= f.text_field :minimum_payment,
              inputmode: "decimal",
              placeholder: "0.00",
              data: {
                controller: "currency-input",
                action: "input->debt-form#checkChanges change->debt-form#checkChanges"
              },
              class: "w-full pl-7 pr-3 py-2.5 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500" %>
        </div>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= t('debts.minimum_payment_help') %></p>
      </div>

      <div class="md:grid md:grid-rows-subgrid md:row-span-3">
        <%= optional_field_label(f, :due_day_of_month, t('debts.due_day_of_month')) %>
        <%= f.number_field :due_day_of_month,
            min: 1,
            max: 31,
            placeholder: "15",
            data: { action: "input->debt-form#checkChanges" },
            class: "w-full px-4 py-2.5 border #{debt.errors[:due_day_of_month].any? ? 'border-red-500' : 'border-slate-200 dark:border-slate-700'} rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500" %>
        <% if debt.errors[:due_day_of_month].any? %>
          <p class="mt-1 text-sm text-red-600 dark:text-red-400"><%= debt.errors[:due_day_of_month].first %></p>
        <% else %>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= t('debts.due_day_of_month_help') %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <div data-controller="auto-link-toggle">
    <%= render layout: "shared/form_section", locals: { title: t("form_sections.tracking"), description: t("debts.sections.tracking_help") } do %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <%= render "shared/multi_select",
            form: f,
            attribute: :category_ids,
            param_name: "debt[category_ids][]",
            id_prefix: "debt_category",
            label: t("debts.categories"),
            header_label: t("debts.categories"),
            placeholder: t("debts.select_categories"),
            accent: "red",
            searchable: true,
            change_action: "change->debt-form#checkChanges",
            label_data: { auto_link_toggle_target: "categoryLabel" },
            items: @categories,
            selected_ids: debt.category_ids,
            error: debt.errors[:base].find { |e| e.include?("categor") } %>

        <%= render "shared/multi_select",
            form: f,
            attribute: :bank_account_ids,
            param_name: "debt[bank_account_ids][]",
            id_prefix: "debt_bank_account",
            label: t("debts.bank_accounts"),
            header_label: t("debts.bank_accounts"),
            placeholder: t("debts.select_bank_accounts"),
            accent: "red",
            name_method: :custom_name,
            change_action: "change->debt-form#checkChanges",
            label_data: { auto_link_toggle_target: "bankAccountLabel" },
            items: @bank_accounts,
            selected_ids: debt.bank_account_ids,
            error: debt.errors[:base].find { |e| e.include?("bank") } %>
      </div>

      <!-- Auto-Sync Configuration -->
      <div class="flex items-center justify-between gap-4 p-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700">
        <div>
          <%= f.label :auto_sync_transactions, t('debts.auto_sync_enable'),
              class: "text-sm font-medium text-slate-700 dark:text-slate-300" %>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1"><%= t('debts.auto_sync_description') %></p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer flex-shrink-0">
          <%= f.check_box :auto_sync_transactions,
              class: "sr-only peer",
              data: {
                auto_link_toggle_target: "checkbox",
                action: "change->auto-link-toggle#toggle change->debt-form#checkChanges"
              } %>
          <div class="w-11 h-6 bg-slate-200 dark:bg-slate-700 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-red-300 dark:peer-focus:ring-red-800 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border after:border-slate-300 after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-red-600"></div>
        </label>
      </div>
    <% end %>
  </div>

  <!-- Advanced Settings -->
  <div data-controller="debt-calculation-settings"
       data-debt-calculation-settings-hide-text-value="<%= t('debts.hide_advanced_settings') %>"
       data-debt-calculation-settings-show-text-value="<%= t('debts.show_advanced_settings') %>"
       class="pt-8 border-t border-slate-200 dark:border-slate-700">
    <!-- Toggle Button -->
    <div class="flex items-center justify-between gap-4">
      <div>
        <h3 class="text-base font-semibold text-slate-900 dark:text-slate-100"><%= t('debts.advanced_settings') %></h3>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= t('debts.advanced_settings_help') %></p>
      </div>
      <button type="button"
              class="flex-shrink-0 text-sm text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 font-medium"
              data-debt-calculation-settings-target="toggleButton"
              data-action="click->debt-calculation-settings#toggle">
        <%= debt.auto_sync_transactions? ? t('debts.hide_advanced_settings') : t('debts.show_advanced_settings') %>
      </button>
    </div>

    <%# Open when auto-sync is on: this panel holds the rules that decide what auto-sync
        actually does, and collapsing them is how a record ends up syncing nothing. %>
    <div class="<%= "hidden" unless debt.auto_sync_transactions? %> mt-5" data-debt-calculation-settings-target="content">
      <div class="space-y-6 p-4 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">

        <!-- Payment Tracking Section -->
        <div class="pb-6 border-b border-slate-200 dark:border-slate-700">
          <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-100 mb-3"><%= t('debts.payment_tracking') %></h4>
          <p class="text-xs text-slate-500 dark:text-slate-400 mb-4"><%= t('debts.payment_tracking_help') %></p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <!-- Payment Mode Dropdown -->
            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                <%= t('debts.payment_mode') %>
              </label>
              <div class="relative">
                <!-- Collapsed button -->
                <button type="button"
                        data-payment-mode-target="modeButton"
                        data-action="click->payment-mode#toggleDropdown"
                        class="w-full px-4 py-3 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-left flex items-center justify-between hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors">
                  <span data-payment-mode-target="modeSummary"
                        class="text-sm <%= debt.payment_mode.present? ? 'text-slate-900 dark:text-slate-100' : 'text-slate-400 dark:text-slate-500' %> truncate overflow-hidden whitespace-nowrap">
                    <%= debt.payment_mode.present? ? t("payment_modes.#{debt.payment_mode}") : t('debts.no_tracking') %>
                  </span>
                  <svg class="w-5 h-5 text-slate-400 transition-transform flex-shrink-0 ml-2" data-payment-mode-target="modeArrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </button>

                <!-- Expandable mode list -->
                <div data-payment-mode-target="modeContainer" class="hidden absolute top-full left-0 right-0 mt-2 border border-slate-200 dark:border-slate-700 rounded-xl bg-white dark:bg-slate-800 shadow-lg z-10 overflow-hidden">
                  <div class="py-1">
                    <button type="button"
                            data-action="click->payment-mode#selectMode"
                            data-mode=""
                            class="w-full text-left px-4 py-2 text-sm text-slate-900 dark:text-slate-100 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors">
                      <%= t('debts.no_tracking') %>
                    </button>
                    <button type="button"
                            data-action="click->payment-mode#selectMode"
                            data-mode="fixed"
                            class="w-full text-left px-4 py-2 text-sm text-slate-900 dark:text-slate-100 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors">
                      <%= t('payment_modes.fixed') %>
                    </button>
                    <button type="button"
                            data-action="click->payment-mode#selectMode"
                            data-mode="calculated"
                            class="w-full text-left px-4 py-2 text-sm text-slate-900 dark:text-slate-100 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors">
                      <%= t('payment_modes.calculated') %>
                    </button>
                  </div>
                </div>

                <%= f.hidden_field :payment_mode,
                    data: {
                      payment_mode_target: "modeInput",
                      action: "change->debt-form#checkChanges"
                    } %>
              </div>
            </div>

            <!-- Payment Frequency -->
            <div data-payment-mode-target="frequencyField"
                 class="<%= debt.payment_mode.nil? ? 'hidden' : '' %>">
              <div data-payment-mode-target="frequencyLabelContainer">
                <%= required_field_label(f, :payment_frequency, t('debts.payment_frequency')) %>
              </div>
              <%= f.select :payment_frequency,
                  options_for_select([
                    [t('payment_frequencies.weekly'), 'weekly'],
                    [t('payment_frequencies.biweekly'), 'biweekly'],
                    [t('payment_frequencies.semimonthly'), 'semimonthly'],
                    [t('payment_frequencies.monthly'), 'monthly']
                  ], debt.payment_frequency || 'monthly'),
                  {},
                  data: { action: "change->debt-form#checkChanges change->payment-mode#updateSuggestedDate change->payment-mode#updateCalculatedAmount" },
                  class: "w-full px-4 py-3 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm" %>
            </div>

            <!-- Payment Amount Field (changes based on mode) -->
            <div data-payment-mode-target="amountField"
                 class="<%= debt.payment_mode.blank? ? 'hidden' : '' %>">
              <div data-payment-mode-target="amountLabelContainer">
                <% if debt.payment_mode == 'fixed' %>
                  <%= required_field_label(f, :target_payment_amount, t('debts.payment_amount')) %>
                <% else %>
                  <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                    <%= t('debts.payment_amount') %>
                  </label>
                <% end %>
              </div>

              <!-- Target Amount (shown when mode is nil or empty) -->
              <div data-payment-mode-target="targetAmountDisplay"
                   class="hidden">
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <span class="text-slate-500 dark:text-slate-400 text-sm">$</span>
                  </div>
                  <input type="text" class="w-full pl-7 pr-3 py-3 border border-slate-200 dark:border-slate-700 rounded-xl bg-slate-100 dark:bg-slate-800 text-sm text-slate-400 dark:text-slate-500" disabled value="N/A">
                </div>
              </div>

              <!-- Fixed Amount Input (shown when mode is "fixed") -->
              <div data-payment-mode-target="fixedAmountInput"
                   class="<%= debt.payment_mode != 'fixed' ? 'hidden' : '' %>">
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <span class="text-slate-500 dark:text-slate-400 text-sm">$</span>
                  </div>
                  <%= f.text_field :target_payment_amount,
                      inputmode: "decimal",
                      placeholder: "0.00",
                      data: {
                        controller: "currency-input",
                        action: "input->debt-form#checkChanges change->debt-form#checkChanges input->payment-mode#updateSuggestedDate"
                      },
                      class: "w-full pl-7 pr-3 py-3 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm" %>
                </div>
                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400"><%= t('debts.fixed_amount_help') %></p>
              </div>

              <!-- Calculated Amount Display (shown when mode is "calculated") -->
              <div data-payment-mode-target="calculatedAmountDisplay"
                   class="<%= debt.payment_mode != 'calculated' ? 'hidden' : '' %>">

                <!-- Warning if target_payoff_date is blank -->
                <div data-payment-mode-target="calculatedWarning"
                     class="<%= debt.target_payoff_date.present? ? 'hidden' : '' %> p-3 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-xl">
                  <div class="flex items-start">
                    <svg class="w-5 h-5 text-amber-600 dark:text-amber-400 mt-0.5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                    <div class="text-sm text-amber-800 dark:text-amber-200">
                      <p class="font-medium"><%= t('debts.set_target_date_to_calculate') %></p>
                    </div>
                  </div>
                </div>

                <!-- Calculated amount (shown when target_payoff_date is present) -->
                <div data-payment-mode-target="calculatedAmountContent"
                     class="<%= debt.target_payoff_date.blank? ? 'hidden' : '' %>">
                  <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                      <span class="text-slate-500 dark:text-slate-400 text-sm">$</span>
                    </div>
                    <div class="w-full pl-7 pr-3 py-3 border border-slate-200 dark:border-slate-700 rounded-xl bg-slate-50 dark:bg-slate-800 text-sm text-slate-500 dark:text-slate-400"
                         data-payment-mode-target="calculatedAmountValue">
                      <%= number_to_currency(debt.calculated_monthly_payment || 0, precision: 2, strip_insignificant_zeros: false) %>
                    </div>
                  </div>
                  <p class="mt-1 text-xs text-slate-500 dark:text-slate-400"><%= t('debts.calculated_amount_help') %></p>
                </div>
              </div>
            </div>

            <!-- Suggested Payoff Date Section (spans 2 columns on the right) -->
            <div data-payment-mode-target="suggestedDateSection"
                 class="md:col-span-2 md:col-start-2">
              <div class="p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl">
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-3">
                  <%= t('debts.suggested_payoff_date') %>
                </label>
                <div class="flex items-center gap-3">
                  <div class="flex-1">
                    <input type="text"
                           data-payment-mode-target="suggestedDateDisplay"
                           data-enter-amount-text="<%= t('debts.enter_amount_to_calculate') %>"
                           data-debt-paid-off-text="<%= t('debts.debt_paid_off') %>"
                           readonly
                           value="<%= debt.suggested_payoff_date&.strftime("%B %d, %Y") || t('debts.enter_amount_to_calculate') %>"
                           class="w-full px-4 py-3 border border-red-200 dark:border-red-800 bg-white dark:bg-slate-800 rounded-xl text-base text-slate-900 dark:text-slate-100 font-medium focus:outline-none">
                  </div>
                  <button type="button"
                          data-payment-mode-target="replaceButton"
                          data-action="click->payment-mode#replaceDateWithSuggested"
                          data-suggested-date="<%= debt.suggested_payoff_date&.iso8601 %>"
                          title="<%= t('debts.replace_payoff_date_tooltip') %>"
                          class="flex-shrink-0 p-3 text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 hover:bg-red-100 dark:hover:bg-red-900/40 rounded-xl transition-colors group relative">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
                    </svg>
                    <!-- Tooltip -->
                    <span class="invisible group-hover:visible absolute bottom-full right-0 mb-2 w-48 px-3 py-2 text-xs text-white bg-slate-800 dark:bg-slate-700 rounded-lg shadow-lg z-10 whitespace-normal">
                      <%= t('debts.replace_payoff_date_tooltip') %>
                    </span>
                  </button>
                </div>
                <p class="mt-2 text-sm text-slate-600 dark:text-slate-400"><%= t('debts.suggested_payoff_date_help') %></p>
              </div>
            </div>
          </div>
        </div>

        <!-- Calculation Settings Section -->
        <div>
          <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-100 mb-3"><%= t('debts.calculation_settings_label') %></h4>
          <p class="text-xs text-slate-500 dark:text-slate-400 mb-4"><%= t('debts.calculation_settings_help') %></p>

          <div class="space-y-4">
            <% %w[income expense transfer_in transfer_out].each do |type| %>
              <div class="border-b border-slate-200 dark:border-slate-700 pb-4 last:border-b-0 last:pb-0">
                <h5 class="text-xs font-medium text-slate-700 dark:text-slate-300 mb-2">
                  <%= t("debts.calculation_settings.#{type}") %>
                </h5>
                <div class="flex space-x-4">
                  <% %w[positive negative ignore].each do |option| %>
                    <label class="flex items-center">
                      <%= f.radio_button "calculation_settings_#{type}", option,
                          checked: (debt.calculation_settings.presence || Debt::DEFAULT_CALCULATION)[type] == option,
                          class: "w-4 h-4 text-red-600 border-slate-300 dark:border-slate-600 focus:ring-red-500",
                          data: { action: "change->debt-form#checkChanges" } %>
                      <span class="ml-2 text-xs text-slate-700 dark:text-slate-300">
                        <%= t("debts.calculation_settings.#{option}") %>
                      </span>
                    </label>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>

      </div>
    </div>
  </div>

  <%= render layout: "shared/form_section", locals: { title: t("form_sections.notes") } do %>
    <div>
      <%= f.text_area :notes,
          placeholder: t('debts.notes_placeholder'),
          rows: 3,
          data: { action: "input->debt-form#checkChanges" },
          class: "w-full px-4 py-2.5 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500" %>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= t('debts.notes_help') %></p>
    </div>
  <% end %>

  <!-- Desktop Form Actions (mobile buttons in page header) -->
  <div class="hidden md:flex items-center justify-end space-x-4 pt-6 border-t border-slate-200 dark:border-slate-700">
    <%= link_to debts_path,
        class: "px-6 py-2 border border-slate-200 dark:border-slate-700 rounded-lg font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors inline-flex items-center" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      <%= t('form_actions.cancel') %>
    <% end %>
    <button type="submit" class="px-6 py-2 bg-red-600 text-white rounded-lg font-medium hover:bg-red-700 transition-colors cursor-pointer inline-flex items-center">
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
      <%= debt.persisted? ? t('debts.update_debt') : t('debts.create_debt') %>
    </button>
  </div>
<% end %>
