<!-- BANK ACCOUNTS INDEX: Responsive List of User's Bank Accounts -->
<div class="bank-accounts-container">
  <!-- HEADER SECTION: Responsive Title and Add Account Button -->
    <!-- DESKTOP HEADER -->
    <div class="bank-accounts-header hidden md:block">
      <div class="bank-accounts-header-content">
        <h1 class="bank-accounts-header-title"><%= t('navigation.bank_accounts') %></h1>
        <p class="bank-accounts-header-subtitle"><%= t('bank_accounts.subtitle') %></p>
      </div>
      <div class="bank-accounts-header-actions">
        <a href="/bank_accounts/new" class="bank-accounts-add-button">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
          </svg>
          <%= t('bank_accounts.add_account') %>
        </a>
      </div>
    </div>

    <!-- MOBILE HEADER -->
    <header class="mobile-bank-accounts-header block md:hidden">
      <div class="mobile-bank-accounts-header-content">
        <div class="mobile-bank-accounts-header-left">
          <h1 class="mobile-bank-accounts-title"><%= t('navigation.bank_accounts') %></h1>
          <p class="mobile-bank-accounts-subtitle"><%= t('bank_accounts.subtitle') %></p>
        </div>
        <div class="mobile-bank-accounts-header-actions">
          <button onclick="openBankAccountModal()" class="mobile-bank-accounts-add-btn">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

  <!-- MOBILE STATS: Quick Overview Cards (visible only on mobile) -->
    <section class="mobile-bank-accounts-stats block md:hidden" data-controller="mobile-carousel">
      <div class="mobile-stats-carousel-wrapper">
        <div class="mobile-stats-carousel" data-mobile-carousel-target="container">
          <!-- Total Balance Slide -->
          <div class="mobile-stat-slide" data-mobile-carousel-target="slide">
            <div class="mobile-stat-card mobile-stat-card-balance">
              <div class="mobile-stat-icon">
                <svg class="w-8 h-8 mx-auto text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                </svg>
              </div>
              <div class="mobile-stat-content">
                <span class="mobile-stat-label"><%= t('bank_accounts.total_balance') %></span>
                <span class="mobile-stat-value mobile-stat-value-balance">
                  <%
                    total_balance = @bank_accounts.sum { |account|
                      balance = account.effective_balance
                      balance || 0
                    }
                  %>
                  <%= number_to_currency(total_balance, unit: "$") %>
                </span>
              </div>
            </div>
          </div>

          <!-- Total Accounts Slide -->
          <div class="mobile-stat-slide" data-mobile-carousel-target="slide">
            <div class="mobile-stat-card mobile-stat-card-accounts">
              <div class="mobile-stat-icon">
                <svg class="w-8 h-8 mx-auto text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 003 3v8a3 3 0 003 3z"></path>
                </svg>
              </div>
              <div class="mobile-stat-content">
                <span class="mobile-stat-label"><%= t('mobile.bank_accounts.total_accounts') %></span>
                <span class="mobile-stat-value mobile-stat-value-accounts">
                  <%= @bank_accounts.count %>
                </span>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Carousel Indicators -->
        <div class="mobile-carousel-indicators">
          <button class="mobile-carousel-indicator active" data-mobile-carousel-target="indicator" data-index="0" data-action="click->mobile-carousel#goToSlideAction"></button>
          <button class="mobile-carousel-indicator" data-mobile-carousel-target="indicator" data-index="1" data-action="click->mobile-carousel#goToSlideAction"></button>
        </div>
      </div>
    </section>

  <!-- ACCOUNTS LIST: Responsive Display of All Bank Accounts -->
  <% if @bank_accounts.any? %>
      <!-- DESKTOP GRID (hidden on mobile) -->
      <div class="bank-accounts-grid hidden md:grid">
      <% @bank_accounts.each do |bank_account| %>
        <div class="bank-account-card">
          <!-- BANK ACCOUNT HEADER: Bank Name and Account Number -->
          <div class="bank-account-card-header">
            <div class="bank-account-icon">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 003 3v8a3 3 0 003 3z"></path>
              </svg>
            </div>
            <div class="bank-account-info">
              <h3 class="bank-account-name"><%= bank_account.display_name %></h3>
              <p class="bank-account-bank"><%= bank_account.bank_display_name %></p>
            </div>
            <div class="bank-account-actions">
              <a href="/bank_accounts/<%= bank_account.id %>" class="bank-account-action-button">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
              </a>
              <a href="/bank_accounts/<%= bank_account.id %>/edit" class="bank-account-action-button">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
              </a>
              <%= button_to bank_account_path(bank_account),
                            method: :delete,
                            class: "bank-account-action-button bank-account-delete-button",
                            data: {
                              "turbo-confirm": t('bank_accounts.delete_confirmation',
                                               account_name: bank_account.display_name,
                                               statement_files_count: bank_account.statement_files.count,
                                               transactions_count: bank_account.transactions.count)
                            } do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              <% end %>
            </div>
          </div>

          <!-- BANK ACCOUNT DETAILS: Currency and Balance -->
          <div class="bank-account-card-details">
            <div class="bank-account-detail">
              <span class="bank-account-detail-label"><%= t('bank_account_forms.currency') %>:</span>
              <span class="bank-account-detail-value"><%= bank_account.currency %></span>
            </div>
            <% if bank_account.opening_balance.present? %>
              <div class="bank-account-detail">
                <span class="bank-account-detail-label"><%= t('bank_account_forms.opening_balance') %>:</span>
                <span class="bank-account-detail-value"><%= number_to_currency(bank_account.opening_balance, unit: bank_account.currency || "$") %></span>
              </div>
            <% end %>
            <div class="bank-account-detail">
              <span class="bank-account-detail-label"><%= t('bank_accounts.parsing_support') %>:</span>
              <span class="bank-account-detail-value <%= bank_account.supported_for_parsing? ? 'text-green-600' : 'text-gray-500' %>">
                <%= bank_account.supported_for_parsing? ? t('bank_accounts.supported') : t('bank_accounts.generic_parsing') %>
              </span>
            </div>
          </div>

          <!-- BANK ACCOUNT FOOTER: Statement Files Count -->
          <div class="bank-account-card-footer">
            <span class="bank-account-statements">
              <%= bank_account.statement_files.count %> <%= t('statement_files.overview') %>
            </span>
          </div>
        </div>
      <% end %>
      </div>

      <!-- MOBILE LIST (visible only on mobile) -->
      <div class="mobile-bank-accounts-list block md:hidden">
        <% @bank_accounts.each do |bank_account| %>
          <div class="mobile-bank-account-group">
            <!-- Bank Account Header (similar to date header) -->
            <div class="mobile-bank-account-header" onclick="window.location.href='/bank_accounts/<%= bank_account.id %>'">
              <div class="mobile-bank-account-info">
                <h3 class="mobile-bank-account-title">
                  <%= bank_account.custom_name %>
                </h3>
                <div class="mobile-bank-account-subtitle">
                  ••••<%= bank_account.account_number.last(4) %>
                </div>
              </div>
              <div class="mobile-bank-account-right">
                <div class="mobile-bank-account-balance-info">
                  <%
                    balance = bank_account.effective_balance || 0
                  %>
                  <span class="mobile-bank-account-balance <%= balance >= 0 ? 'text-green-600' : 'text-red-600' %>">
                    <%= number_to_currency(balance, unit: "$") %>
                  </span>
                  <div class="mobile-bank-account-statements-count">
                    <span class="mobile-statements-count"><%= bank_account.statement_files.count %></span>
                    <span class="mobile-statements-label"><%= t('mobile.bank_accounts.statements') %></span>
                  </div>
                </div>
                <svg class="mobile-bank-account-chevron h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </div>
            </div>
          </div>
        <% end %>
      </div>
  <% else %>
    <!-- EMPTY STATE: No Bank Accounts Yet (responsive) -->
      <div class="bank-accounts-empty">
        <div class="bank-accounts-empty-icon">
          <svg class="w-16 h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 003 3v8a3 3 0 003 3z"></path>
          </svg>
        </div>
        <h3 class="bank-accounts-empty-title"><%= t('bank_accounts.no_accounts_yet') %></h3>
        <p class="bank-accounts-empty-description"><%= t('bank_accounts.no_accounts_description') %></p>
        <a href="/bank_accounts/new" class="bank-accounts-empty-button">
          <%= t('bank_accounts.add_first_account') %>
        </a>
      </div>
  <% end %>
</div>

<!-- MOBILE BANK ACCOUNT MODAL: Bank Account Creation for Mobile -->
<div id="bankAccountModal" class="modal-overlay mobile-modal hidden">
  <div class="modal-content">
    <div class="mobile-upload-modal">
        <!-- Modal Header -->
        <div class="mobile-upload-header">
          <div class="mobile-upload-header-content">
            <h2 class="mobile-upload-title"><%= t('mobile.bank_accounts.add_account') %></h2>
            <p class="mobile-upload-subtitle"><%= t('mobile.bank_accounts.add_description') %></p>
          </div>
          <button onclick="closeBankAccountModal()" class="mobile-upload-close">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <!-- Account Form -->
        <turbo-frame id="mobile-bank-account-form">
          <%= form_with model: BankAccount.new,
              url: bank_accounts_path,
              local: false,
              html: {
                id: "mobileBankAccountForm",
                class: "mobile-upload-form space-y-6",
                data: {
                  turbo_frame: "mobile-bank-account-form",
                  controller: "mobile-bank-account"
                }
              } do |f| %>

          <!-- Bank Selection -->
          <div class="mobile-form-group">
            <label for="mobile_bank_id" class="mobile-form-label">
              <div class="mobile-label-content">
                <svg class="mobile-label-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
                <%= t('mobile.bank_accounts.select_bank') %>
              </div>
            </label>
            <%= f.select :bank_id,
                options_for_select([['Select Bank', '']]),
                { required: true },
                { id: "mobile_bank_id", class: "mobile-form-select" } %>
          </div>

          <!-- Account Type Selection -->
          <div class="mobile-form-group">
            <label for="mobile_account_type" class="mobile-form-label">
              <div class="mobile-label-content">
                <svg class="mobile-label-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 003 3v8a3 3 0 003 3z"></path>
                </svg>
                <%= t('mobile.bank_accounts.account_type') %>
              </div>
            </label>
            <%= f.select :account_type,
                options_for_select([
                  ['Select Account Type', ''],
                  [t('account_type.debit'), 'debit'],
                  [t('account_type.credit'), 'credit']
                ]),
                { required: true },
                { id: "mobile_account_type", class: "mobile-form-select" } %>
          </div>

          <!-- Custom Name (Optional) -->
          <div class="mobile-form-group">
            <label for="mobile_custom_name" class="mobile-form-label">
              <div class="mobile-label-content">
                <svg class="mobile-label-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                </svg>
                <%= t('mobile.bank_accounts.custom_name') %>
              </div>
            </label>
            <%= f.text_field :custom_name,
                placeholder: t('mobile.bank_accounts.custom_name_placeholder'),
                class: "mobile-form-select",
                id: "mobile_custom_name" %>
          </div>

          <!-- Account Number -->
          <div class="mobile-form-group">
            <label for="mobile_account_number" class="mobile-form-label">
              <div class="mobile-label-content">
                <svg class="mobile-label-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 003 3v8a3 3 0 003 3z"></path>
                </svg>
                <%= t('mobile.bank_accounts.account_number') %>
              </div>
            </label>
            <%= f.text_field :account_number,
                placeholder: t('mobile.bank_accounts.account_number_placeholder'),
                required: true,
                class: "mobile-form-select",
                id: "mobile_account_number" %>
          </div>

          <!-- Currency -->
          <div class="mobile-form-group">
            <label for="mobile_currency" class="mobile-form-label">
              <div class="mobile-label-content">
                <svg class="mobile-label-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                </svg>
                <%= t('mobile.bank_accounts.currency') %>
              </div>
            </label>
            <%= f.text_field :currency,
                value: "MXN",
                placeholder: "MXN",
                class: "mobile-form-select",
                id: "mobile_currency" %>
          </div>

          <!-- Opening Balance Date -->
          <div class="mobile-form-group">
            <label for="mobile_opening_balance_date" class="mobile-form-label">
              <div class="mobile-label-content">
                <svg class="mobile-label-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <%= t('mobile.bank_accounts.opening_balance_date') %>
              </div>
            </label>
            <%= f.date_field :opening_balance_date,
                class: "mobile-form-select",
                id: "mobile_opening_balance_date" %>
          </div>

          <!-- Opening Balance -->
          <div class="mobile-form-group">
            <label for="mobile_opening_balance" class="mobile-form-label">
              <div class="mobile-label-content">
                <svg class="mobile-label-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                </svg>
                <%= t('mobile.bank_accounts.opening_balance') %>
              </div>
            </label>
            <%= f.number_field :opening_balance,
                step: 0.01,
                placeholder: "0.00",
                class: "mobile-form-select",
                id: "mobile_opening_balance" %>
          </div>

          <!-- Submit Button -->
          <div class="mobile-form-actions">
            <button type="submit" class="mobile-upload-button" id="mobileBankAccountButton">
              <svg class="mobile-button-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span><%= t('mobile.bank_accounts.create_account') %></span>
            </button>
          </div>

          <!-- Loading State -->
          <div id="mobileBankAccountProgress" class="mobile-upload-progress hidden">
            <div class="mobile-progress-content">
              <svg class="mobile-progress-spinner" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span><%= t('mobile.bank_accounts.creating') %></span>
            </div>
          </div>
        <% end %>
        </turbo-frame>
      </div>
  </div>
</div>

<script>
// Mobile Bank Account Modal Functions for Hotwire Native Compatibility

function openBankAccountModal() {
  const modal = document.getElementById('bankAccountModal');
  if (modal) {
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';

    // Load banks dynamically
    loadBanksForModal();

    // For Hotwire Native: Dispatch custom event
    window.dispatchEvent(new CustomEvent('modal:opened', {
      detail: { type: 'bank_account' }
    }));
  }
}

function closeBankAccountModal() {
  const modal = document.getElementById('bankAccountModal');
  if (modal) {
    modal.classList.add('hidden');
    document.body.style.overflow = '';

    // Reset form
    const form = modal.querySelector('form');
    if (form) form.reset();

    // For Hotwire Native: Dispatch custom event
    window.dispatchEvent(new CustomEvent('modal:closed', {
      detail: { type: 'bank_account' }
    }));
  }
}

function loadBanksForModal() {
  // In production, this would load from an API endpoint
  // For now, we'll populate with static options
  const bankSelect = document.getElementById('mobile_bank_id');
  if (bankSelect && bankSelect.options.length <= 1) {
    // Add some example banks - this should be loaded from your banks endpoint
    const banks = [
      { id: '', name: 'Select Bank' },
      { id: '1', name: 'BBVA' },
      { id: '2', name: 'Banamex' },
      { id: '3', name: 'Santander' },
      { id: '4', name: 'Banorte' }
    ];

    bankSelect.innerHTML = '';
    banks.forEach(bank => {
      const option = document.createElement('option');
      option.value = bank.id;
      option.textContent = bank.name;
      bankSelect.appendChild(option);
    });
  }
}

// Form submission handling for Hotwire Native
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('mobileBankAccountForm');
  if (form) {
    form.addEventListener('submit', function(e) {
      const button = document.getElementById('mobileBankAccountButton');
      const progress = document.getElementById('mobileBankAccountProgress');

      // Show loading state
      if (button) button.style.display = 'none';
      if (progress) progress.classList.remove('hidden');

      // For Hotwire Native: Dispatch form submission event
      window.dispatchEvent(new CustomEvent('form:submitted', {
        detail: { type: 'bank_account' }
      }));

      // Close modal after a short delay
      setTimeout(() => {
        closeBankAccountModal();
      }, 500);

      // Let Turbo handle the submission
      return true;
    });
  }

  // Handle form submission success/error
  document.addEventListener('turbo:submit-end', function(event) {
    if (event.target.id === 'mobileBankAccountForm') {
      if (!event.detail.success) {
        // Reset UI on error
        const button = document.getElementById('mobileBankAccountButton');
        const progress = document.getElementById('mobileBankAccountProgress');
        if (button) button.style.display = '';
        if (progress) progress.classList.add('hidden');
      }
    }
  });
});

// Close modal when clicking outside
document.addEventListener('click', function(e) {
  const modal = document.getElementById('bankAccountModal');
  const modalContent = document.querySelector('.modal-content');

  if (modal && !modal.classList.contains('hidden') &&
      !modalContent.contains(e.target) &&
      e.target === modal) {
    closeBankAccountModal();
  }
});
</script>
