<footer class="bg-slate-900 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8">
      <!-- Logo + tagline -->
      <div>
        <div class="flex items-center gap-2">
          <%= image_tag "/vittio_new_without_background.png", alt: "Vittio", class: "h-7 w-auto brightness-200" %>
        </div>
        <p class="mt-3 text-sm text-slate-400 max-w-xs">
          <%= t("brand.tagline") %>
        </p>
      </div>

      <!-- Links -->
      <div class="flex flex-wrap gap-6 text-sm">
        <a href="#" class="text-slate-400 hover:text-white transition-colors"><%= t("landing.footer.privacy") %></a>
        <a href="#" class="text-slate-400 hover:text-white transition-colors"><%= t("landing.footer.terms") %></a>
      </div>
    </div>

    <div class="mt-10 pt-8 border-t border-slate-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <p class="text-sm text-slate-500">
        &copy; <%= Date.current.year %> Vittio. <%= t("landing.footer.rights") %>
      </p>
      <p class="text-sm text-slate-500">
        <%= t("landing.footer.made_in") %>
      </p>
    </div>
  </div>
</footer>
