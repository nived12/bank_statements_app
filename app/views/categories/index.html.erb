<div class="categories-page">
  <!-- Desktop View (keep existing if you have one, or skip) -->
  <div class="hidden md:block">
    <h1>Categories (Desktop - To Be Implemented)</h1>
  </div>

  <!-- Mobile View -->
  <div class="block md:hidden min-h-screen bg-slate-50">
    <!-- Header -->
    <div class="bg-white border-b border-slate-200 px-4 py-4 sticky top-0 z-30">
      <h1 class="text-2xl font-bold text-slate-900"><%= t('navigation.categories') %></h1>
      <p class="text-sm text-slate-600 mt-1"><%= t('categories.manage_description') %></p>
    </div>

    <!-- Categories List -->
    <div id="categories-list" class="p-4 space-y-2">
      <% if @parents.any? %>
        <% @parents.each do |category| %>
          <%= render 'mobile_category_list_item', category: category %>
        <% end %>
      <% else %>
        <!-- Empty State -->
        <div class="text-center py-16">
          <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-900 mb-2"><%= t('categories.no_categories_yet') %></h3>
          <p class="text-slate-600 mb-6"><%= t('categories.create_first_description') %></p>
          <a href="<%= new_category_path %>"
             data-turbo-frame="category-modal"
             class="inline-block px-6 py-3 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition-colors">
            <%= t('categories.create_first') %>
          </a>
        </div>
      <% end %>
    </div>

    <!-- Floating Add Button -->
    <% if @parents.any? %>
      <a href="<%= new_category_path %>"
         data-turbo-frame="category-modal"
         class="fixed bottom-6 right-6 w-14 h-14 bg-blue-600 text-white rounded-full shadow-lg flex items-center justify-center hover:bg-blue-700 transition-all hover:scale-110 z-40">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
      </a>
    <% end %>
  </div>

  <!-- Category Modal (for create/edit parent categories) -->
  <turbo-frame id="category-modal">
    <!-- Modal content will be loaded here -->
  </turbo-frame>
</div>
