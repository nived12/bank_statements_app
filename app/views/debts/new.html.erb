<% content_for :title, t('debts.new') %>

<!-- Mobile View: Full-width -->
<div class="block md:hidden min-h-screen bg-white dark:bg-slate-900 pb-20" data-controller="debt-form page-transition">
  <!-- Header -->
  <header class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 px-4 py-4 sticky top-0 z-10">
    <div class="flex items-center justify-between">
      <%= link_to debts_path,
          class: "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:text-slate-100",
          data: { action: "click->page-transition#navigateBack" } do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      <% end %>

      <div class="flex-1 mx-3">
        <h1 class="text-xl font-bold text-slate-900 dark:text-slate-100"><%= t('debts.new') %></h1>
        <p class="text-xs text-slate-600 dark:text-slate-400"><%= t('debts.add_new_description') %></p>
      </div>

      <div class="flex items-center space-x-2">
        <%= link_to debts_path,
            class: "p-2 text-slate-400 hover:text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-700 dark:bg-slate-900 rounded-lg transition-colors",
            data: { action: "click->page-transition#navigateBack" } do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        <% end %>

        <button type="button"
                data-debt-form-target="submitButton"
                data-action="click->debt-form#submit"
                disabled
                class="p-2 text-slate-400 cursor-not-allowed rounded-lg transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Content -->
  <div class="px-4 py-4">
    <%= render 'form', debt: @debt %>
  </div>
</div>

<!-- Desktop View: Centered card -->
<div class="hidden md:block min-h-screen bg-slate-50 dark:bg-slate-900">
  <!-- Header -->
  <header class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 px-8 py-6">
    <div class="max-w-3xl mx-auto">
      <div class="flex items-center justify-between mb-4">
        <%= link_to debts_path, class: "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:text-slate-100 flex items-center" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          <%= t('debts.back_to_debts') %>
        <% end %>
      </div>
      <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100"><%= t('debts.new') %></h1>
      <p class="text-slate-600 dark:text-slate-400 mt-2"><%= t('debts.add_new_description') %></p>
    </div>
  </header>

  <!-- Content -->
  <div class="max-w-3xl mx-auto px-8 py-8">
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6">
      <%= render 'form', debt: @debt %>
    </div>
  </div>
</div>
