<header class="w-full border-b border-slate-200 px-8 py-8 mb-8">
  <div class="flex items-center justify-between">

    <div class="flex space-x-4 items-center h-full">
      <% if local_assigns[:back_path] %>
        <%= link_to back_path, class: "text-slate-400 hover:text-slate-900 flex items-center", data: { action: "click->page-transition#navigateBack" } do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          <%= t('common.back') %>
        <% end %>
      <% end %>

      <h1 class="text-2xl"><%= title %></h1>
    </div>

    <div class="flex items-center space-x-3">
      <%= yield %>
    </div>
  </div>
</header>