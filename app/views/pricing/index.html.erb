<div class="min-h-screen bg-slate-50 dark:bg-slate-900">
  <!-- Hero -->
  <div class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-indigo-100 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 mb-5">
        <%= t("pricing.badge") %>
      </span>
      <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 dark:text-slate-100 tracking-tight mb-4">
        <%= t("pricing.hero.title") %>
      </h1>
      <p class="text-lg text-slate-500 dark:text-slate-400 max-w-xl mx-auto">
        <%= t("pricing.hero.subtitle") %>
      </p>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Trial / Premium status banners -->
    <% if @subscription_state == :on_trial %>
      <div class="mb-8 rounded-xl bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700 px-5 py-4 flex items-center gap-3">
        <svg class="w-5 h-5 text-amber-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <p class="text-sm text-amber-800 dark:text-amber-300 font-medium">
          <%= t("pricing.trial_banner", count: @trial_days_remaining) %>
        </p>
      </div>
    <% elsif @subscription_state == :premium %>
      <div class="mb-8 rounded-xl bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-700 px-5 py-4 flex items-center gap-3">
        <svg class="w-5 h-5 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <p class="text-sm text-emerald-800 dark:text-emerald-300 font-medium">
          <%= t("pricing.premium_banner") %>
        </p>
      </div>
    <% end %>

    <!-- Billing Toggle + Plan Cards (single controller scope) -->
    <div data-controller="pricing-toggle">

      <!-- Toggle -->
      <div class="flex justify-center mb-10">
        <div class="inline-flex items-center bg-slate-100 dark:bg-slate-800 rounded-xl p-1 gap-1">
          <button
            data-pricing-toggle-target="monthlyBtn"
            data-action="click->pricing-toggle#showMonthly"
            class="relative px-5 py-2 rounded-lg text-sm font-medium transition-all duration-200 bg-white shadow-sm text-slate-900 dark:bg-slate-700 dark:text-slate-100">
            <%= t("pricing.toggle.monthly") %>
          </button>
          <button
            data-pricing-toggle-target="annualBtn"
            data-action="click->pricing-toggle#showAnnual"
            class="relative px-5 py-2 rounded-lg text-sm font-medium transition-all duration-200 text-slate-500 dark:text-slate-400 flex items-center gap-2">
            <%= t("pricing.toggle.annual") %>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300">
              <%= t("pricing.annual_discount") %>
            </span>
          </button>
        </div>
      </div>

      <!-- Plan Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        <!-- Free Card -->
        <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-8 flex flex-col">
          <div class="mb-6">
            <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100 mb-1"><%= t("pricing.free.name") %></h2>
            <p class="text-sm text-slate-500 dark:text-slate-400"><%= t("pricing.free.description") %></p>
          </div>
          <div class="mb-8">
            <div class="flex items-end gap-1">
              <span class="text-4xl font-bold text-slate-900 dark:text-slate-100">$0</span>
              <span class="text-slate-500 dark:text-slate-400 mb-1 text-sm">MXN/<%= t("pricing.toggle.month_abbr") %></span>
            </div>
            <p class="text-xs text-slate-400 dark:text-slate-500 mt-1"><%= t("pricing.free.forever") %></p>
          </div>
          <div class="mt-auto">
            <% if @subscription_state == :guest %>
              <%= link_to t("pricing.cta.start_free"), new_user_path,
                  class: "flex items-center justify-center w-full h-11 px-6 rounded-xl border-2 border-slate-200 dark:border-slate-600 text-slate-700 dark:text-slate-300 font-semibold text-sm hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors" %>
            <% else %>
              <span class="flex items-center justify-center w-full h-11 px-6 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-400 dark:text-slate-500 font-semibold text-sm cursor-default">
                <%= t("pricing.cta.current_plan") %>
              </span>
            <% end %>
          </div>
        </div>

        <!-- Premium Card -->
        <div class="bg-indigo-600 rounded-xl p-8 flex flex-col relative overflow-hidden">
          <div class="relative mb-6">
            <div class="flex items-center justify-between mb-1">
              <h2 class="text-xl font-bold text-white">Premium</h2>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-white/20 text-white">
                <%= t("pricing.premium.badge") %>
              </span>
            </div>
            <p class="text-sm text-indigo-200"><%= t("pricing.premium.description") %></p>
          </div>

          <!-- Price display (toggleable) -->
          <div class="relative mb-8">
            <div data-pricing-toggle-target="monthlyPrice">
              <div class="flex items-end gap-1">
                <span class="text-4xl font-bold text-white">$149</span>
                <span class="text-indigo-200 mb-1 text-sm">MXN/<%= t("pricing.toggle.month_abbr") %></span>
              </div>
              <p class="text-xs text-indigo-300 mt-1"><%= t("pricing.iva_included") %></p>
            </div>
            <div data-pricing-toggle-target="annualPrice" class="hidden">
              <div class="flex items-end gap-1">
                <span class="text-4xl font-bold text-white">$99</span>
                <span class="text-indigo-200 mb-1 text-sm">MXN/<%= t("pricing.toggle.month_abbr") %></span>
              </div>
              <p data-pricing-toggle-target="annualSubtext" class="hidden text-xs text-indigo-200 mt-0.5">
                $1,188 MXN/<%= t("pricing.toggle.year_abbr") %> &bull; <%= t("pricing.iva_included") %>
              </p>
              <div data-pricing-toggle-target="annualSavings" class="hidden mt-2">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-400/20 text-emerald-200">
                  <%= t("pricing.annual_savings") %>
                </span>
              </div>
            </div>
          </div>

          <div class="relative mt-auto">
            <% if @subscription_state == :premium %>
              <span class="flex items-center justify-center w-full h-[52px] px-6 rounded-xl bg-white/20 text-white font-semibold text-sm cursor-default">
                <%= t("pricing.cta.already_premium") %> ✓
              </span>
            <% elsif @subscription_state == :guest %>
              <%= link_to t("pricing.cta.start_trial"), new_user_path(upgrade: 1),
                  class: "flex items-center justify-center w-full h-[52px] px-6 rounded-xl bg-white text-indigo-600 font-bold text-sm hover:bg-indigo-50 transition-colors" %>
            <% else %>
              <%= link_to t("pricing.cta.upgrade"), subscription_path,
                  class: "flex items-center justify-center w-full h-[52px] px-6 rounded-xl bg-white text-indigo-600 font-bold text-sm hover:bg-indigo-50 transition-colors" %>
            <% end %>
            <p class="text-xs text-indigo-300 text-center mt-3"><%= t("pricing.no_commitment") %></p>
          </div>
        </div>
      </div><!-- /plan cards -->

    </div><!-- /pricing-toggle controller -->

    <!-- Feature Comparison Table -->
    <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl overflow-hidden mb-12">
      <div class="grid grid-cols-3 border-b border-slate-200 dark:border-slate-700">
        <div class="px-6 py-4 col-span-1">
          <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide"><%= t("pricing.table.feature") %></p>
        </div>
        <div class="px-6 py-4 text-center border-l border-slate-200 dark:border-slate-700">
          <p class="text-sm font-semibold text-slate-700 dark:text-slate-300"><%= t("pricing.free.name") %></p>
        </div>
        <div class="px-6 py-4 text-center border-l border-indigo-200 dark:border-indigo-700 bg-indigo-50 dark:bg-indigo-900/20">
          <p class="text-sm font-bold text-indigo-700 dark:text-indigo-300">Premium</p>
        </div>
      </div>

      <% [
        { key: :manual_transactions,   free: true,  premium: true  },
        { key: :bank_accounts,         free: true,  premium: true  },
        { key: :dashboard,             free: true,  premium: true  },
        { key: :goals,                 free: true,  premium: true  },
        { key: :statement_import,      free: false, premium: true  },
        { key: :voice_input,           free: false, premium: true  },
        { key: :receipt_scan,          free: false, premium: true  },
        { key: :recurring_suggestions, free: false, premium: true  },
        { key: :ai_assistant,          free: false, premium: :soon },
      ].each_with_index do |feature, i| %>
        <div class="grid grid-cols-3 <%= i < 8 ? 'border-b border-slate-100 dark:border-slate-700/50' : '' %> hover:bg-slate-50/50 dark:hover:bg-slate-700/20 transition-colors">
          <div class="px-6 py-4 flex items-center">
            <span class="text-sm text-slate-700 dark:text-slate-300 font-medium"><%= t("pricing.features.#{feature[:key]}") %></span>
          </div>
          <div class="px-6 py-4 flex items-center justify-center border-l border-slate-100 dark:border-slate-700/50">
            <% if feature[:free] %>
              <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <% else %>
              <svg class="w-5 h-5 text-slate-300 dark:text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            <% end %>
          </div>
          <div class="px-6 py-4 flex items-center justify-center border-l border-indigo-100 dark:border-indigo-700/50 bg-indigo-50/50 dark:bg-indigo-900/10">
            <% if feature[:premium] == :soon %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-indigo-100 dark:bg-indigo-900/40 text-indigo-600 dark:text-indigo-300"><%= t("pricing.coming_soon") %></span>
            <% else %>
              <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Bottom CTA block -->
    <div class="text-center mb-12">
      <% if @subscription_state == :premium %>
        <div class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-700">
          <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span class="text-sm font-semibold text-emerald-700 dark:text-emerald-300"><%= t("pricing.cta.already_premium") %> ✓</span>
        </div>
        <div class="mt-4">
          <%= link_to t("pricing.cta.manage_subscription"), portal_subscription_path,
              class: "text-sm text-indigo-600 dark:text-indigo-400 hover:underline font-medium" %>
        </div>
      <% elsif @subscription_state == :guest %>
        <h3 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2"><%= t("pricing.cta.guest_headline") %></h3>
        <p class="text-slate-500 dark:text-slate-400 mb-6"><%= t("pricing.cta.guest_subtext") %></p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <%= link_to t("pricing.cta.start_free"), new_user_path,
              class: "flex items-center justify-center h-11 px-8 rounded-xl border-2 border-slate-200 dark:border-slate-600 text-slate-700 dark:text-slate-300 font-semibold hover:bg-white dark:hover:bg-slate-800 transition-colors" %>
          <%= link_to t("pricing.cta.subscribe_premium"), new_user_path(upgrade: 1),
              class: "flex items-center justify-center h-[52px] px-8 rounded-xl bg-indigo-600 text-white font-bold hover:bg-indigo-700 transition-colors" %>
        </div>
      <% else %>
        <h3 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2"><%= t("pricing.cta.upgrade_headline") %></h3>
        <p class="text-slate-500 dark:text-slate-400 mb-6">
          <% if @subscription_state == :on_trial %>
            <%= t("pricing.trial_banner", count: @trial_days_remaining) %>
          <% else %>
            <%= t("pricing.cta.upgrade_subtext") %>
          <% end %>
        </p>
        <%= link_to t("pricing.cta.upgrade"), subscription_path,
            class: "inline-flex items-center justify-center h-[52px] px-10 rounded-xl bg-indigo-600 text-white font-bold hover:bg-indigo-700 transition-colors text-base" %>
      <% end %>
    </div>

    <!-- Footer notes -->
    <div class="border-t border-slate-200 dark:border-slate-700 pt-8 text-center space-y-2">
      <p class="text-xs text-slate-400 dark:text-slate-500"><%= t("pricing.iva_note") %></p>
      <p class="text-xs text-slate-400 dark:text-slate-500"><%= t("pricing.cancel_anytime") %></p>
      <div class="flex items-center justify-center gap-4 mt-3">
        <%= link_to t("pricing.footer.privacy"), legal_privacy_path, class: "text-xs text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" %>
        <span class="text-slate-300 dark:text-slate-600">&middot;</span>
        <%= link_to t("pricing.footer.terms"), legal_terms_path, class: "text-xs text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" %>
      </div>
    </div>

  </div>
</div>
