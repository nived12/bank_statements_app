<%# locals: (statement_file:) %>
<% status = statement_file.status %>
<div class="sf-statement-card sf-accent-<%= status %>">
  <!-- Icon + filename row -->
  <div class="flex items-start gap-3">
    <div class="sf-card-icon sf-card-icon-<%= status %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
      </svg>
    </div>
    <div class="flex-1 min-w-0">
      <h4 class="text-sm font-medium text-gray-900 leading-snug" style="overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
        <%= statement_file.file.attached? ? statement_file.file.filename.to_s : t("statement_files.no_file") %>
      </h4>
    </div>
  </div>

  <!-- Metadata -->
  <div class="flex flex-col gap-1">
    <span class="sf-meta-label">
      <%= statement_file.cutoff_date ? format_local_time(statement_file.cutoff_date, format: "date") : t("statement_files.no_cutoff_date") %>
      &nbsp;·&nbsp;
      <%= statement_file.transactions.count %> <%= t("table_headers.transactions") %>
    </span>
    <span class="text-xs font-medium <%= status == 'completed' || status == 'processed' ? 'text-green-600' : status == 'error' ? 'text-red-600' : 'text-amber-600' %>">
      <%= t("mobile.statement_files.#{status}") %>
    </span>
  </div>

  <!-- Hover actions -->
  <div class="sf-card-actions">
    <%= link_to statement_file_path(statement_file), data: { turbo_frame: "_top" }, class: "inline-flex items-center justify-center w-8 h-8 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-colors", title: t("dashboard.view_statement") do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
      </svg>
    <% end %>

    <% if status == "error" %>
      <button class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-gray-400 hover:text-amber-600 hover:bg-amber-50 transition-colors"
              data-controller="statement-retry"
              data-statement-id="<%= statement_file.id %>"
              title="<%= t("statement_file_status.retry_processing") %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
        </svg>
      </button>
    <% end %>

    <%= button_to statement_file_path(statement_file),
                  method: :delete,
                  class: "inline-flex items-center justify-center w-8 h-8 rounded-lg text-gray-400 hover:text-red-600 hover:bg-red-50 transition-colors",
                  data: { confirm: t("confirm_delete_statement", count: statement_file.transactions.count) },
                  title: t("dashboard.delete_statement") do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
      </svg>
    <% end %>
  </div>
</div>
