<header>
  <div class="dashboard-header-container">
    <div class="dashboard-header-content">

      <!-- HEADER LEFT: Brand and Title -->
      <div class="dashboard-header-left">
        <div class="dashboard-header-brand">
          <div>
            <!-- WEB: Full title for desktop -->
            <h1 class="dashboard-header-title hidden md:block"><%= t('dashboard.title') %></h1>
            <!-- MOBILE: Shortened title for mobile -->
            <h1 class="dashboard-header-title block md:hidden"><%= t('mobile.dashboard.title') %></h1>
          </div>
        </div>
      </div>

      <!-- HEADER RIGHT: Month Picker and Upload Button -->
      <div class="dashboard-header-right">
        <!-- MOBILE: Clean header with simplified controls -->
        <div class="mobile-header-controls flex items-center space-x-3 md:hidden">
          <!-- Mobile Month Picker -->
          <select id="month-selector-mobile" class="mobile-month-selector text-sm px-5 py-2 bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" onchange="changeMonth(this.value)">
            <% if @available_months && @available_months.any? %>
              <% @available_months.each do |month| %>
                <option value="<%= month.strftime('%Y-%m') %>"
                        <%= 'selected' if month.strftime('%Y-%m') == @selected_month.strftime('%Y-%m') %>>
                  <%= l(month, format: :month_year) %>
                </option>
              <% end %>
            <% else %>
              <%= current_month_option %>
            <% end %>
          </select>
        </div>

        <!-- DESKTOP: Full header controls -->
        <%= yield %>
    </div>
  </div>
</header>