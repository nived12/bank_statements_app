// Inline filter functionality
if (typeof window.applyFilters === 'undefined') {
window.applyFilters = function() {

  // Safely get filter values, handling cases where elements might not exist (mobile vs desktop)
  const bankAccountElement = document.getElementById('bank_account_id');
  const statementFileElement = document.getElementById('statement_file_id');
  const transactionTypeElement = document.getElementById('transaction_type');
  const fromDateElement = document.getElementById('from_date');
  const toDateElement = document.getElementById('to_date');
  const mobileFromDateElement = document.getElementById('mobile_from_date');
  const mobileToDateElement = document.getElementById('mobile_to_date');

  const bankAccountId = bankAccountElement ? bankAccountElement.value : '';
  const statementFileId = statementFileElement ? statementFileElement.value : '';
  const transactionType = transactionTypeElement ? transactionTypeElement.value : '';

  // Use mobile date values if available, otherwise use desktop values
  const fromDate = (mobileFromDateElement && mobileFromDateElement.value) ? mobileFromDateElement.value : (fromDateElement ? fromDateElement.value : '');
  const toDate = (mobileToDateElement && mobileToDateElement.value) ? mobileToDateElement.value : (toDateElement ? toDateElement.value : '');

  // Get search value from either desktop or mobile search input
  const desktopSearch = document.getElementById('search');
  const mobileSearch = document.getElementById('mobile-search');
  
  // Get the current search value - use whichever input has content, prioritizing mobile
  let search = '';
  if (mobileSearch && mobileSearch.value) {
    search = mobileSearch.value.trim();
  } else if (desktopSearch && desktopSearch.value) {
    search = desktopSearch.value.trim();
  }
  
  // Build URL with current filters
  const url = new URL(window.location);

  // Set or clear parameters - only update if the element exists
  if (bankAccountElement) {
    if (bankAccountId) {
      url.searchParams.set('bank_account_id', bankAccountId);
    } else {
      url.searchParams.delete('bank_account_id');
    }
  }

  if (statementFileElement) {
    if (statementFileId) {
      url.searchParams.set('statement_file_id', statementFileId);
    } else {
      url.searchParams.delete('statement_file_id');
    }
  }

  if (transactionTypeElement) {
    if (transactionType) {
      url.searchParams.set('transaction_type', transactionType);
    } else {
      url.searchParams.delete('transaction_type');
    }
  }

  if (fromDateElement) {
    if (fromDate) {
      url.searchParams.set('from_date', fromDate);
    } else {
      url.searchParams.delete('from_date');
    }
  }

  if (toDateElement) {
    if (toDate) {
      url.searchParams.set('to_date', toDate);
    } else {
      url.searchParams.delete('to_date');
    }
  }

  // Always handle search since it exists in both mobile and desktop
  if (search) {
    url.searchParams.set('search', search);
  } else {
    url.searchParams.delete('search');
  }

  // Preserve sorting parameters
  const currentParams = new URLSearchParams(window.location.search);
  ['sort', 'direction'].forEach(param => {
    if (currentParams.has(param)) {
      url.searchParams.set(param, currentParams.get(param));
    }
  });


  // Navigate to the new URL - use Turbo for Hotwire Native compatibility
  // Use _top to break out of turbo-frame and navigate the whole page
  Turbo.visit(url.toString(), { frame: "_top" });
};
}

