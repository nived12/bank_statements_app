<!-- BANK ACCOUNTS INDEX: List of User's Bank Accounts -->
<div class="bank-accounts-container">
  <!-- HEADER SECTION: Title and Add Account Button -->
  <div class="bank-accounts-header">
    <div class="bank-accounts-header-content">
      <h1 class="bank-accounts-header-title"><%= t('bank_accounts') %></h1>
      <p class="bank-accounts-header-subtitle"><%= t('bank_accounts_subtitle') %></p>
    </div>
    <div class="bank-accounts-header-actions">
      <a href="/bank_accounts/new" class="bank-accounts-add-button">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
        </svg>
        <%= t('add_bank_account') %>
      </a>
    </div>
  </div>

  <!-- ACCOUNTS LIST: Display All Bank Accounts -->
  <% if @bank_accounts.any? %>
    <div class="bank-accounts-grid">
      <% @bank_accounts.each do |bank_account| %>
        <div class="bank-account-card">
          <!-- BANK ACCOUNT HEADER: Bank Name and Account Number -->
          <div class="bank-account-card-header">
            <div class="bank-account-icon">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 003 3v8a3 3 0 003 3z"></path>
              </svg>
            </div>
            <div class="bank-account-info">
              <h3 class="bank-account-name"><%= bank_account.display_name %></h3>
              <p class="bank-account-bank"><%= bank_account.bank_display_name %></p>
            </div>
            <div class="bank-account-actions">
              <a href="/bank_accounts/<%= bank_account.id %>" class="bank-account-action-button">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
              </a>
              <a href="/bank_accounts/<%= bank_account.id %>/edit" class="bank-account-action-button">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
              </a>
            </div>
          </div>

          <!-- BANK ACCOUNT DETAILS: Currency and Balance -->
          <div class="bank-account-card-details">
            <div class="bank-account-detail">
              <span class="bank-account-detail-label"><%= t('currency') %>:</span>
              <span class="bank-account-detail-value"><%= bank_account.currency %></span>
            </div>
            <% if bank_account.opening_balance.present? %>
              <div class="bank-account-detail">
                <span class="bank-account-detail-label"><%= t('opening_balance') %>:</span>
                <span class="bank-account-detail-value"><%= number_to_currency(bank_account.opening_balance, unit: bank_account.currency) %></span>
              </div>
            <% end %>
            <div class="bank-account-detail">
              <span class="bank-account-detail-label"><%= t('parsing_support') %>:</span>
              <span class="bank-account-detail-value <%= bank_account.supported_for_parsing? ? 'text-green-600' : 'text-gray-500' %>">
                <%= bank_account.supported_for_parsing? ? t('supported') : t('generic_parsing') %>
              </span>
            </div>
          </div>

          <!-- BANK ACCOUNT FOOTER: Statement Files Count -->
          <div class="bank-account-card-footer">
            <span class="bank-account-statements">
              <%= bank_account.statement_files.count %> <%= t('statement_files') %>
            </span>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- EMPTY STATE: No Bank Accounts Yet -->
    <div class="bank-accounts-empty">
      <div class="bank-accounts-empty-icon">
        <svg class="w-16 h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 003 3v8a3 3 0 003 3z"></path>
        </svg>
      </div>
      <h3 class="bank-accounts-empty-title"><%= t('no_bank_accounts') %></h3>
      <p class="bank-accounts-empty-description"><%= t('no_bank_accounts_description') %></p>
      <a href="/bank_accounts/new" class="bank-accounts-empty-button">
        <%= t('add_first_bank_account') %>
      </a>
    </div>
  <% end %>
</div>
