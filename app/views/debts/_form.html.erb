<%= form_with(
      model: debt,
      local: true,
      class: "grid grid-cols-1 md:grid-cols-2 gap-4",
      data: { debt_form_target: "form", controller: "payment-mode" }
    ) do |f| %>

  <!-- Icon and Debt Name -->
  <div data-controller="icon-picker"
       data-icon-picker-selected-value="<%= debt.icon || 'credit-card' %>"
       data-action="icon-picker:changed->debt-form#iconChanged">
    <%= f.hidden_field :icon,
        data: {
          icon_picker_target: "input",
          debt_form_target: "iconInput"
        },
        value: debt.icon || 'credit-card' %>

    <div class="flex space-x-2 col-span-2 items-end">
      <%= render 'common/planning/icon_picker', icon: debt.icon || 'credit-card' %>

      <!-- Name Field -->
      <div class="flex-1">
        <%= required_field_label(f, :name, t('debts.name')) %>
        <%= f.text_field :name,
            placeholder: t('debts.name_placeholder'),
            class: "w-full px-4 py-2 border #{debt.errors[:name].any? ? 'border-red-500' : 'border-slate-300'} rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500",
            required: true,
            data: { action: "input->debt-form#checkChanges" } %>
        <% if debt.errors[:name].any? %>
          <p class="mt-1 text-sm text-red-600"><%= debt.errors[:name].first %></p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Color Picker -->
  <div data-controller="color-picker">
    <%= optional_field_label(f, :color, t('debts.color')) %>
    <%= f.hidden_field :color, value: debt.color || '#EF4444', data: { color_picker_target: "input", action: "change->debt-form#checkChanges" } %>

    <div class="flex gap-3 flex-wrap">
      <% [
        ['#EF4444', 'Red'],
        ['#F97316', 'Orange'],
        ['#F59E0B', 'Amber'],
        ['#10B981', 'Green'],
        ['#3B82F6', 'Blue'],
        ['#6366F1', 'Indigo'],
        ['#8B5CF6', 'Purple'],
        ['#EC4899', 'Pink'],
        ['#64748B', 'Slate'],
        ['#0EA5E9', 'Sky']
      ].each do |color, name| %>
        <button type="button"
                data-action="click->color-picker#select"
                data-color="<%= color %>"
                data-color-picker-target="button"
                class="w-10 h-10 rounded-full transition-all hover:scale-110 <%= (debt.color || '#EF4444') == color ? 'ring-4 ring-offset-2' : '' %>"
                style="background-color: <%= color %>;"
                title="<%= name %>">
        </button>
      <% end %>
    </div>
  </div>

  <!-- Original Amount and Current Balance -->
  <div>
    <%= required_field_label(f, :original_amount, t('debts.original_amount')) %>
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <span class="text-slate-500 sm:text-sm">$</span>
      </div>
      <%= f.text_field :original_amount,
          inputmode: "decimal",
          placeholder: "0.00",
          data: {
            controller: "currency-input",
            action: "input->debt-form#checkChanges change->debt-form#checkChanges"
          },
          class: "w-full pl-7 pr-3 py-2 border #{debt.errors[:original_amount].any? ? 'border-red-500' : 'border-slate-300'} rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500",
          required: true %>
    </div>
    <% if debt.errors[:original_amount].any? %>
      <p class="mt-1 text-sm text-red-600"><%= debt.errors[:original_amount].first %></p>
    <% else %>
      <p class="mt-1 text-sm text-slate-500"><%= t('debts.original_amount_help') %></p>
    <% end %>
  </div>

  <div>
    <%= required_field_label(f, :current_balance, t('debts.current_balance')) %>
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <span class="text-slate-500 sm:text-sm">$</span>
      </div>
      <%= f.text_field :current_balance,
          inputmode: "decimal",
          placeholder: "0.00",
          data: {
            controller: "currency-input",
            action: "input->debt-form#checkChanges change->debt-form#checkChanges input->payment-mode#updateSuggestedDate change->payment-mode#updateCalculatedAmount"
          },
          class: "w-full pl-7 pr-3 py-2 border #{debt.errors[:current_balance].any? ? 'border-red-500' : 'border-slate-300'} rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500" %>
    </div>
    <% if debt.errors[:current_balance].any? %>
      <p class="mt-1 text-sm text-red-600"><%= debt.errors[:current_balance].first %></p>
    <% else %>
      <p class="mt-1 text-sm text-slate-500"><%= t('debts.current_balance_help') %></p>
    <% end %>
  </div>

  <!-- Interest Rate and Minimum Payment -->
  <div>
    <%= optional_field_label(f, :interest_rate, t('debts.interest_rate_annual')) %>
    <%= f.text_field :interest_rate,
        inputmode: "decimal",
        placeholder: t('debts.interest_rate_placeholder'),
        data: { action: "input->debt-form#checkChanges" },
        class: "w-full px-4 py-2 border #{debt.errors[:interest_rate].any? ? 'border-red-500' : 'border-slate-300'} rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500" %>
    <% if debt.errors[:interest_rate].any? %>
      <p class="mt-1 text-sm text-red-600"><%= debt.errors[:interest_rate].first %></p>
    <% else %>
      <p class="mt-1 text-sm text-slate-500"><%= t('debts.interest_rate_help') %></p>
    <% end %>
  </div>

  <div>
    <%= optional_field_label(f, :minimum_payment, t('debts.minimum_payment')) %>
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <span class="text-slate-500 sm:text-sm">$</span>
      </div>
      <%= f.text_field :minimum_payment,
          inputmode: "decimal",
          placeholder: "0.00",
          data: {
            controller: "currency-input",
            action: "input->debt-form#checkChanges change->debt-form#checkChanges"
          },
          class: "w-full pl-7 pr-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500" %>
    </div>
    <p class="mt-1 text-sm text-slate-500"><%= t('debts.minimum_payment_help') %></p>
  </div>

  <!-- Due Day of Month -->
  <div>
    <%= optional_field_label(f, :due_day_of_month, t('debts.due_day_of_month')) %>
    <%= f.number_field :due_day_of_month,
        min: 1,
        max: 31,
        placeholder: "15",
        data: { action: "input->debt-form#checkChanges" },
        class: "w-full px-4 py-2 border #{debt.errors[:due_day_of_month].any? ? 'border-red-500' : 'border-slate-300'} rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500" %>
    <% if debt.errors[:due_day_of_month].any? %>
      <p class="mt-1 text-sm text-red-600"><%= debt.errors[:due_day_of_month].first %></p>
    <% else %>
      <p class="mt-1 text-sm text-slate-500"><%= t('debts.due_day_of_month_help') %></p>
    <% end %>
  </div>

  <!-- Target Payoff Date -->
  <div>
    <div data-payment-mode-target="targetDateLabelContainer">
      <% if debt.payment_mode == 'calculated' %>
        <%= required_field_label(f, :target_payoff_date, t('debts.target_payoff_date')) %>
      <% else %>
        <%= optional_field_label(f, :target_payoff_date, t('debts.target_payoff_date')) %>
      <% end %>
    </div>
    <%= f.date_field :target_payoff_date,
        class: "w-full px-4 py-2 border #{debt.errors[:target_payoff_date].any? ? 'border-red-500' : 'border-slate-300'} rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500",
        data: {
          payment_mode_target: "targetDateField",
          action: "change->payment-mode#checkTargetDate change->payment-mode#updateCalculatedAmount change->debt-form#checkChanges"
        } %>
    <% if debt.errors[:target_payoff_date].any? %>
      <p class="mt-1 text-sm text-red-600"><%= debt.errors[:target_payoff_date].first %></p>
    <% else %>
      <p class="mt-1 text-sm text-slate-500"><%= t('debts.target_payoff_date_help') %></p>
    <% end %>
  </div>

  <!-- Category & Bank Account Selection -->
  <div data-controller="auto-link-toggle multi-select" class="col-span-2">
    <%= f.label :category_ids, class: "block text-sm font-medium text-slate-700 mb-2", data: { auto_link_toggle_target: "categoryLabel" } do %>
      <%= t('debts.categories') %>
      <span class="text-slate-400 text-xs optional-indicator">(<%= t('form_actions.optional') %>)</span>
      <span class="text-red-500 required-indicator hidden">*</span>
    <% end %>

    <!-- Collapsed button -->
    <button type="button"
            data-multi-select-target="button"
            data-action="click->multi-select#toggle"
            class="w-full px-4 py-3 bg-white border border-slate-300 rounded-lg text-left flex items-center justify-between hover:bg-slate-50 transition-colors">
      <span data-multi-select-target="summary"
            data-placeholder="<%= t('debts.select_categories') %>"
            class="text-sm text-slate-400">
        <%= debt.categories.any? ? "#{debt.categories.count} selected" : t('debts.select_categories') %>
      </span>
      <svg class="w-5 h-5 text-slate-400 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
      </svg>
    </button>

    <!-- Expandable checkbox list -->
    <div data-multi-select-target="container" class="hidden mt-2 border border-slate-300 rounded-lg bg-white">
      <!-- Select all header -->
      <div class="flex items-center justify-between p-3 border-b border-slate-200 bg-slate-50">
        <span class="text-sm font-medium text-slate-700"><%= t('debts.categories') %></span>
        <button type="button"
                data-multi-select-target="selectAllButton"
                data-action="click->multi-select#toggleAll"
                data-select-text="<%= t('debts.select_all') %>"
                data-unselect-text="<%= t('debts.unselect_all') %>"
                class="text-sm font-medium text-red-600 hover:text-red-800">
          <%= t('debts.select_all') %>
        </button>
      </div>

      <!-- Checkbox list -->
      <div class="max-h-60 overflow-y-auto p-2">
        <% @categories.each do |category| %>
          <label class="flex items-center p-3 hover:bg-slate-50 rounded cursor-pointer <%= 'pl-10' if category.parent_id.present? %>">
            <%= check_box_tag 'debt[category_ids][]', category.id, debt.category_ids.include?(category.id),
                class: "w-5 h-5 text-red-600 border-slate-300 rounded focus:ring-red-500",
                data: {
                  multi_select_target: "checkbox",
                  action: "change->multi-select#updateCount change->debt-form#checkChanges"
                },
                id: "debt_category_#{category.id}" %>
            <div class="ml-3 flex items-center">
              <% if category.icon.present? %>
                <div class="w-8 h-8 rounded-full bg-red-50 flex items-center justify-center mr-2">
                  <%= icon_svg(category.icon, css_classes: "w-4 h-4 text-red-600") %>
                </div>
              <% end %>
              <span class="text-sm text-slate-900"><%= category.name %></span>
            </div>
          </label>
        <% end %>
      </div>
    </div>

    <% if debt.errors[:base].any? { |e| e.include?('category') || e.include?('categor') } %>
      <p class="mt-1 text-sm text-red-600"><%= debt.errors[:base].select { |e| e.include?('category') || e.include?('categor') }.first %></p>
    <% end %>
  </div>

  <!-- Bank Accounts (Multi-select with collapse) -->
  <div data-controller="multi-select" class="col-span-2">
    <%= f.label :bank_account_ids, class: "block text-sm font-medium text-slate-700 mb-2", data: { auto_link_toggle_target: "bankAccountLabel" } do %>
      <%= t('debts.bank_accounts') %>
      <span class="text-slate-400 text-xs optional-indicator">(<%= t('form_actions.optional') %>)</span>
      <span class="text-red-500 required-indicator hidden">*</span>
    <% end %>

    <!-- Collapsed button -->
    <button type="button"
            data-multi-select-target="button"
            data-action="click->multi-select#toggle"
            class="w-full px-4 py-3 bg-white border border-slate-300 rounded-lg text-left flex items-center justify-between hover:bg-slate-50 transition-colors">
      <span data-multi-select-target="summary"
            data-placeholder="<%= t('debts.select_bank_accounts') %>"
            class="text-sm text-slate-400">
        <%= debt.bank_accounts.any? ? "#{debt.bank_accounts.count} selected" : t('debts.select_bank_accounts') %>
      </span>
      <svg class="w-5 h-5 text-slate-400 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
      </svg>
    </button>

    <!-- Expandable checkbox list -->
    <div data-multi-select-target="container" class="hidden mt-2 border border-slate-300 rounded-lg bg-white">
      <!-- Select all header -->
      <div class="flex items-center justify-between p-3 border-b border-slate-200 bg-slate-50">
        <span class="text-sm font-medium text-slate-700"><%= t('debts.bank_accounts') %></span>
        <button type="button"
                data-multi-select-target="selectAllButton"
                data-action="click->multi-select#toggleAll"
                data-select-text="<%= t('debts.select_all') %>"
                data-unselect-text="<%= t('debts.unselect_all') %>"
                class="text-sm font-medium text-red-600 hover:text-red-800">
          <%= t('debts.select_all') %>
        </button>
      </div>

      <!-- Checkbox list -->
      <div class="max-h-60 overflow-y-auto p-2">
        <% @bank_accounts.each do |bank_account| %>
          <label class="flex items-center p-3 hover:bg-slate-50 rounded cursor-pointer">
            <%= check_box_tag 'debt[bank_account_ids][]', bank_account.id, debt.bank_account_ids.include?(bank_account.id),
                class: "w-5 h-5 text-red-600 border-slate-300 rounded focus:ring-red-500",
                data: {
                  multi_select_target: "checkbox",
                  action: "change->multi-select#updateCount change->debt-form#checkChanges"
                },
                id: "debt_bank_account_#{bank_account.id}" %>
            <span class="ml-3 text-sm text-slate-900"><%= bank_account.custom_name %></span>
          </label>
        <% end %>
      </div>
    </div>

    <% if debt.errors[:base].any? { |e| e.include?('bank') } %>
      <p class="mt-1 text-sm text-red-600"><%= debt.errors[:base].select { |e| e.include?('bank') }.first %></p>
    <% end %>
  </div>

  <!-- Notes -->
  <div class="col-span-2">
    <%= optional_field_label(f, :notes, t('debts.notes')) %>
    <%= f.text_area :notes,
        placeholder: t('debts.notes_placeholder'),
        rows: 3,
        data: { action: "input->debt-form#checkChanges" },
        class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500" %>
    <p class="mt-1 text-sm text-slate-500"><%= t('debts.notes_help') %></p>
  </div>

  <!-- Auto-Sync Configuration -->
  <div class="py-6 col-span-2">
    <div class="flex items-center justify-between">
      <div>
        <%= f.label :auto_sync_transactions, t('debts.auto_sync_enable'),
            class: "text-sm font-medium text-slate-700" %>
        <p class="text-xs text-slate-500 mt-1"><%= t('debts.auto_sync_description') %></p>
      </div>
      <label class="relative inline-flex items-center cursor-pointer">
        <%= f.check_box :auto_sync_transactions,
            class: "sr-only peer",
            data: {
              auto_link_toggle_target: "checkbox",
              action: "change->auto-link-toggle#toggle change->debt-form#checkChanges"
            } %>
        <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-red-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-red-600"></div>
      </label>
    </div>
  </div>

    <!-- Advanced Settings -->
  <div data-controller="debt-calculation-settings"
       data-debt-calculation-settings-hide-text-value="<%= t('debts.hide_advanced_settings') %>"
       data-debt-calculation-settings-show-text-value="<%= t('debts.show_advanced_settings') %>"
       class="flex flex-col col-span-2 border-slate-200 border-b">
    <!-- Toggle Button -->
    <button type="button"
            data-action="click->debt-calculation-settings#toggle"
            class="flex w-full items-center justify-between text-sm px-4 py-8 hover:bg-slate-50 transition-colors">
      <div class="flex items-center space-x-2 font-medium text-slate-700 text-xl">
        <label>
          <%= t('debts.advanced_settings') %>
        </label>
        <span class="text-slate-400 text-xs">(<%= t('form_actions.optional') %>)</span>
      </div>

      <div class="flex items-center space-x-2 text-blue-600 hover:text-blue-700 font-medium transition-colors">
        <div data-debt-calculation-settings-target="advancedSettingsToggleText"
              data-show-text="<%= t('debts.show_advanced_settings', default: 'Show Advanced Settings') %>"
              data-hide-text="<%= t('debts.hide_advanced_settings', default: 'Hide Advanced Settings') %>">
          <%= t('debts.show_advanced_settings', default: 'Show Advanced Settings') %>
        </div>
        <svg data-debt-calculation-settings-target="advancedSettingsToggleIcon"
            class="w-4 h-4 transform transition-transform"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </div>
    </button>

    <!-- Advanced Settings Content (hidden by default) -->
    <div data-debt-calculation-settings-target="content" class="mt-2 space-y-2 border border-slate-200 rounded-lg p-3 hidden">

      <!-- Payment Tracking Section -->
      <div class="pb-6 border-b border-slate-200">
        <h4 class="text-sm font-semibold text-slate-900 mb-3"><%= t('debts.payment_tracking') %></h4>
        <p class="text-xs text-slate-500 mb-4"><%= t('debts.payment_tracking_help') %></p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <!-- Payment Mode Dropdown -->
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-2">
              <%= t('debts.payment_mode') %>
            </label>
            <div class="relative">
              <!-- Collapsed button -->
              <button type="button"
                      data-payment-mode-target="modeButton"
                      data-action="click->payment-mode#toggleDropdown"
                      class="w-full px-4 py-3 bg-white border border-slate-300 rounded-lg text-left flex items-center justify-between hover:bg-slate-50 transition-colors">
                <span data-payment-mode-target="modeSummary"
                      class="text-sm <%= debt.payment_mode.present? ? 'text-slate-900' : 'text-slate-400' %> truncate overflow-hidden whitespace-nowrap">
                  <%= debt.payment_mode.present? ? t("payment_modes.#{debt.payment_mode}") : t('debts.no_tracking') %>
                </span>
                <svg class="w-5 h-5 text-slate-400 transition-transform flex-shrink-0 ml-2" data-payment-mode-target="modeArrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>

              <!-- Expandable mode list -->
              <div data-payment-mode-target="modeContainer" class="hidden absolute top-full left-0 right-0 mt-2 border border-slate-300 rounded-lg bg-white shadow-lg z-10">
                <div class="py-1">
                  <button type="button"
                          data-action="click->payment-mode#selectMode"
                          data-mode=""
                          class="w-full text-left px-4 py-2 text-sm text-slate-900 hover:bg-slate-50 transition-colors">
                    <%= t('debts.no_tracking') %>
                  </button>
                  <button type="button"
                          data-action="click->payment-mode#selectMode"
                          data-mode="fixed"
                          class="w-full text-left px-4 py-2 text-sm text-slate-900 hover:bg-slate-50 transition-colors">
                    <%= t('payment_modes.fixed') %>
                  </button>
                  <button type="button"
                          data-action="click->payment-mode#selectMode"
                          data-mode="calculated"
                          class="w-full text-left px-4 py-2 text-sm text-slate-900 hover:bg-slate-50 transition-colors">
                    <%= t('payment_modes.calculated') %>
                  </button>
                </div>
              </div>

              <%= f.hidden_field :payment_mode,
                  data: {
                    payment_mode_target: "modeInput",
                    action: "change->debt-form#checkChanges"
                  } %>
            </div>
          </div>

          <!-- Payment Frequency -->
          <div data-payment-mode-target="frequencyField"
                class="<%= debt.payment_mode.nil? ? 'hidden' : '' %>">
            <div data-payment-mode-target="frequencyLabelContainer">
              <%= required_field_label(f, :payment_frequency, t('debts.payment_frequency')) %>
            </div>
            <%= f.select :payment_frequency,
                options_for_select([
                  [t('payment_frequencies.weekly'), 'weekly'],
                  [t('payment_frequencies.biweekly'), 'biweekly'],
                  [t('payment_frequencies.semimonthly'), 'semimonthly'],
                  [t('payment_frequencies.monthly'), 'monthly']
                ], debt.payment_frequency || 'monthly'),
                {},
                data: { action: "change->debt-form#checkChanges change->payment-mode#updateSuggestedDate change->payment-mode#updateCalculatedAmount" },
                class: "w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm" %>
          </div>

          <!-- Payment Amount Field (changes based on mode) -->
          <div data-payment-mode-target="amountField"
                class="<%= debt.payment_mode.blank? ? 'hidden' : '' %>">
            <div data-payment-mode-target="amountLabelContainer">
              <% if debt.payment_mode == 'fixed' %>
                <%= required_field_label(f, :target_payment_amount, t('debts.payment_amount')) %>
              <% else %>
                <label class="block text-sm font-medium text-slate-700 mb-2">
                  <%= t('debts.payment_amount') %>
                </label>
              <% end %>
            </div>

            <!-- Target Amount (shown when mode is nil or empty) -->
            <div data-payment-mode-target="targetAmountDisplay"
                  class="hidden">
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <span class="text-slate-500 text-sm">$</span>
                </div>
                <input type="text" class="w-full pl-7 pr-3 py-3 border border-slate-300 rounded-lg bg-slate-100 text-sm text-slate-400" disabled value="N/A">
              </div>
            </div>

            <!-- Fixed Amount Input (shown when mode is "fixed") -->
            <div data-payment-mode-target="fixedAmountInput"
                  class="<%= debt.payment_mode != 'fixed' ? 'hidden' : '' %>">
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <span class="text-slate-500 text-sm">$</span>
                </div>
                <%= f.text_field :target_payment_amount,
                    inputmode: "decimal",
                    placeholder: "0.00",
                    data: {
                      controller: "currency-input",
                      action: "input->debt-form#checkChanges change->debt-form#checkChanges input->payment-mode#updateSuggestedDate"
                    },
                    class: "w-full pl-7 pr-3 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm" %>
              </div>
              <p class="mt-1 text-xs text-slate-500"><%= t('debts.fixed_amount_help') %></p>
            </div>

            <!-- Calculated Amount Display (shown when mode is "calculated") -->
            <div data-payment-mode-target="calculatedAmountDisplay"
                  class="<%= debt.payment_mode != 'calculated' ? 'hidden' : '' %>">

              <!-- Warning if target_payoff_date is blank -->
              <div data-payment-mode-target="calculatedWarning"
                    class="<%= debt.target_payoff_date.present? ? 'hidden' : '' %> p-3 bg-red-50 border border-red-200 rounded-lg">
                <div class="flex items-start">
                  <svg class="w-5 h-5 text-red-600 mt-0.5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                  </svg>
                  <div class="text-sm text-red-800">
                    <p class="font-medium"><%= t('debts.set_target_date_to_calculate') %></p>
                  </div>
                </div>
              </div>

              <!-- Calculated amount (shown when target_payoff_date is present) -->
              <div data-payment-mode-target="calculatedAmountContent"
                    class="<%= debt.target_payoff_date.blank? ? 'hidden' : '' %>">
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <span class="text-slate-500 text-sm">$</span>
                  </div>
                  <div class="w-full pl-7 pr-3 py-3 border border-slate-300 rounded-lg bg-slate-50 text-sm text-slate-500"
                        data-payment-mode-target="calculatedAmountValue">
                    <%= number_to_currency(debt.calculated_monthly_payment || 0, precision: 2, strip_insignificant_zeros: false) %>
                  </div>
                </div>
                <p class="mt-1 text-xs text-slate-500"><%= t('debts.calculated_amount_help') %></p>
              </div>
            </div>
          </div>

          <!-- Suggested Payoff Date Section (spans 2 columns on the right) -->
          <div data-payment-mode-target="suggestedDateSection"
                class="md:col-span-2 md:col-start-2">
            <div class="p-4 bg-red-50 border border-red-200 rounded-lg">
              <label class="block text-sm font-medium text-slate-700 mb-3">
                <%= t('debts.suggested_payoff_date') %>
              </label>
              <div class="flex items-center gap-3">
                <div class="flex-1">
                  <input type="text"
                          data-payment-mode-target="suggestedDateDisplay"
                          data-enter-amount-text="<%= t('debts.enter_amount_to_calculate') %>"
                          data-debt-paid-off-text="<%= t('debts.debt_paid_off') %>"
                          readonly
                          value="<%= debt.suggested_payoff_date&.strftime("%B %d, %Y") || t('debts.enter_amount_to_calculate') %>"
                          class="w-full px-4 py-3 border border-red-200 bg-white rounded-lg text-base text-slate-900 font-medium focus:outline-none">
                </div>
                <button type="button"
                        data-payment-mode-target="replaceButton"
                        data-action="click->payment-mode#replaceDateWithSuggested"
                        data-suggested-date="<%= debt.suggested_payoff_date&.iso8601 %>"
                        title="<%= t('debts.replace_payoff_date_tooltip') %>"
                        class="flex-shrink-0 p-3 text-red-600 hover:text-red-800 hover:bg-red-100 rounded-lg transition-colors group relative">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
                  </svg>
                  <!-- Tooltip -->
                  <span class="invisible group-hover:visible absolute bottom-full right-0 mb-2 w-48 px-3 py-2 text-xs text-white bg-slate-800 rounded-lg shadow-lg z-10 whitespace-normal">
                    <%= t('debts.replace_payoff_date_tooltip') %>
                  </span>
                </button>
              </div>
              <p class="mt-2 text-sm text-slate-600"><%= t('debts.suggested_payoff_date_help') %></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Calculation Settings Section -->
      <div>
        <h4 class="text-sm font-semibold text-slate-900 mb-3"><%= t('debts.calculation_settings_label') %></h4>
        <p class="text-xs text-slate-500 mb-4"><%= t('debts.calculation_settings_help') %></p>

        <div class="space-y-4">
          <% %w[income expense transfer_in transfer_out].each do |type| %>
            <div class="border-b border-slate-200 pb-4 last:border-b-0 last:pb-0">
              <h5 class="text-xs font-medium text-slate-700 mb-2">
                <%= t("debts.calculation_settings.#{type}") %>
              </h5>
              <div class="flex space-x-4">
                <% %w[positive negative ignore].each do |option| %>
                  <label class="flex items-center">
                    <%= f.radio_button "calculation_settings_#{type}", option,
                        checked: debt.calculation_settings&.dig(type) == option,
                        class: "w-4 h-4 text-red-600 border-slate-300 focus:ring-red-500",
                        data: { action: "change->debt-form#checkChanges" } %>
                    <span class="ml-2 text-xs text-slate-700">
                      <%= t("debts.calculation_settings.#{option}") %>
                    </span>
                  </label>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Submit Button -->
  <div class="flex pt-4 col-span-2 mt-8 justify-end space-x-4">
    <%= link_to t('form_actions.cancel'), transactions_path, class: "btn-outline" %>
    <%= f.submit t('form_actions.save'), class: "btn-primary" %>
  </div>
<% end %>
