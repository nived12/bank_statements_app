<% transactions.each.with_index(1) do |transaction, index| %>
  <%= render partial: "transactions/transaction_row",
             locals: { transaction: transaction, index: (page_offset || 0) + index, filter_params: {} } %>
<% end %>

<!-- Mobile date groups (hidden on desktop) -->
<div class="block md:hidden" data-mobile-transactions-list>
  <%= render partial: "transactions/mobile_transaction_groups", locals: { transactions: transactions } %>
</div>

