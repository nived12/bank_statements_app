<%# Tab strip nesting "Recurrentes" inside the Transactions section.
    Mirrors the Categorías ⇄ Reglas pattern. Pass `active: :transactions` or `:recurring`. %>
<div class="hidden md:block bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 px-4 md:px-8">
  <div class="max-w-7xl mx-auto flex">
    <%= link_to t("transactions.tabs.transactions"), transactions_path,
        class: "px-4 py-3 text-sm font-medium border-b-2 #{active == :transactions ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200'}" %>
    <%= link_to recurring_tab_label, recurring_series_index_path,
        class: "px-4 py-3 text-sm font-medium border-b-2 inline-flex items-center #{active == :recurring ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200'}" %>
  </div>
</div>
