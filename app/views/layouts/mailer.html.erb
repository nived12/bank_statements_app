<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= message.subject %></title>
  <style>
    /* Shared Vittio email chrome. Inline-safe CSS only — no external assets.
       Views supply body content; this layout owns the header, footer and tokens. */
    body {
      margin: 0;
      /* Breathing room so the card reads as a card and not as the page. */
      padding: 24px 12px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto", "Helvetica", "Arial", sans-serif;
      line-height: 1.6;
      background-color: #f8fafc;
    }
    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      border: 1px solid #e2e8f0;
      /* Outlook ignores border-radius and squares the corners. Harmless. */
      border-radius: 16px;
      overflow: hidden;
    }
    /* The banner image carries its own slate background, so this colour only
       shows if a client blocks images. Do not move the band into CSS: Gmail's
       dark mode remaps background colours in both directions and stranded the
       wordmark on both a white and a slate header. */
    .email-header {
      background: #0f172a;
      font-size: 0;
      line-height: 0;
    }
    .email-header-image {
      display: block;
      width: 100%;
      max-width: 600px;
      height: auto;
      border: 0;
    }
    .email-body {
      padding: 40px 30px;
      color: #334155;
    }
    .email-title {
      font-size: 24px;
      font-weight: 700;
      color: #1e293b;
      margin: 0 0 20px 0;
    }
    .email-text {
      font-size: 16px;
      color: #475569;
      margin: 0 0 20px 0;
      line-height: 1.6;
    }
    .email-button-container {
      text-align: center;
      margin: 35px 0;
    }
    .email-button {
      display: inline-block;
      padding: 16px 40px;
      background-color: #2563eb;
      color: #ffffff !important;
      text-decoration: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 16px;
      transition: background-color 0.3s ease;
    }
    .email-button:hover {
      background-color: #1d4ed8;
    }
    .email-notice {
      background-color: #f1f5f9;
      border-left: 4px solid #38bdf8;
      padding: 15px 20px;
      margin: 25px 0;
      border-radius: 4px;
    }
    .email-notice-title {
      font-weight: 600;
      color: #1e293b;
      margin: 0 0 8px 0;
      font-size: 14px;
    }
    .email-notice-text {
      margin: 0;
      font-size: 14px;
      color: #64748b;
      line-height: 1.5;
    }
    .email-highlight {
      background-color: #eef2ff;
      border-left: 4px solid #4f46e5;
      padding: 15px 20px;
      margin: 25px 0;
      border-radius: 4px;
      font-size: 16px;
      color: #1e293b;
    }
    .alternative-link {
      margin-top: 30px;
      padding-top: 20px;
      border-top: 1px solid #e2e8f0;
    }
    .alternative-link-text {
      font-size: 13px;
      color: #64748b;
      margin: 0 0 10px 0;
    }
    .link-url {
      font-size: 12px;
      color: #2563eb;
      word-break: break-all;
      background-color: #f8fafc;
      padding: 10px;
      border-radius: 4px;
      border: 1px solid #e2e8f0;
    }
    .email-footer {
      background-color: #f8fafc;
      padding: 30px;
      text-align: center;
      border-top: 1px solid #e2e8f0;
    }
    .footer-text {
      font-size: 13px;
      color: #64748b;
      margin: 5px 0;
      line-height: 1.5;
    }
    .footer-link {
      color: #2563eb;
      text-decoration: none;
    }
    .footer-link:hover {
      text-decoration: underline;
    }
    /* Announcement bodies come from Markdown, so they arrive as bare tags.
       Scoped to this wrapper so the hand-written emails above are untouched. */
    .email-body-markdown {
      font-size: 16px;
      color: #475569;
      line-height: 1.6;
    }
    .email-body-markdown p {
      margin: 0 0 20px 0;
    }
    .email-body-markdown h1,
    .email-body-markdown h2 {
      font-size: 22px;
      font-weight: 700;
      color: #1e293b;
      margin: 32px 0 14px 0;
    }
    .email-body-markdown h3 {
      font-size: 17px;
      font-weight: 600;
      color: #1e293b;
      margin: 26px 0 10px 0;
    }
    .email-body-markdown ul,
    .email-body-markdown ol {
      margin: 0 0 20px 0;
      padding-left: 22px;
    }
    .email-body-markdown li {
      margin: 0 0 8px 0;
    }
    .email-body-markdown strong {
      color: #1e293b;
    }
    .email-body-markdown a {
      color: #2563eb;
    }
    .email-body-markdown blockquote {
      margin: 0 0 20px 0;
      padding: 12px 18px;
      background-color: #f1f5f9;
      border-left: 4px solid #38bdf8;
      border-radius: 4px;
    }
    @media only screen and (max-width: 600px) {
      .email-body {
        padding: 30px 20px;
      }
      .email-title {
        font-size: 20px;
      }
      .email-button {
        padding: 14px 30px;
        font-size: 15px;
      }
    }
  </style>
</head>
<body>
  <div class="email-container">
    <div class="email-header">
      <img src="<%= header_image_url %>" alt="Vittio" class="email-header-image">
    </div>

    <div class="email-body">
      <%= yield %>
    </div>

    <div class="email-footer">
      <p class="footer-text">
        <strong>Vittio</strong><br>
        <%= t("mailer.footer.tagline") %>
      </p>
      <p class="footer-text">
        <%= t("mailer.footer.help") %>
      </p>
    </div>
  </div>
</body>
</html>
