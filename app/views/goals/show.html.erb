<div class="goal-show-page">
  <div class="goal-main">
    <!-- Mobile View -->
    <div class="block md:hidden min-h-screen bg-slate-50 pb-24">
      <!-- Mobile Header -->
      <header class="bg-white border-b border-slate-200 px-4 py-4 sticky top-0 z-10">
        <div class="flex items-center justify-between mb-3">
          <%= link_to goals_path, class: "text-slate-600 hover:text-slate-900" do %>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
          <% end %>
          <h1 class="text-xl font-bold text-slate-900 flex-1 text-center"><%= @goal.name %></h1>
          <%= link_to edit_goal_path(@goal), class: "text-blue-600 hover:text-blue-700" do %>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
          <% end %>
        </div>
        <div class="flex items-center justify-center space-x-2">
          <span class="text-xs px-2 py-1 rounded-full <%= @goal.type_savings_goal? ? 'bg-green-100 text-green-800' : 'bg-orange-100 text-orange-800' %>">
            <%= t("goals.types.#{@goal.goal_type}") %>
          </span>
          <span class="text-xs px-2 py-1 rounded-full <%=
            case @goal.status
            when 'active' then 'bg-blue-100 text-blue-800'
            when 'completed' then 'bg-green-100 text-green-800'
            when 'paused' then 'bg-gray-100 text-gray-800'
            when 'archived' then 'bg-slate-100 text-slate-800'
            end
          %>">
            <%= t("goals.statuses.#{@goal.status}") %>
          </span>
        </div>
      </header>

      <!-- Mobile Content -->
      <div class="px-4 py-4 space-y-4">
        <!-- Icon & Progress -->
        <div class="bg-white rounded-xl border border-slate-200 p-4">
          <div class="flex justify-center mb-4">
            <div class="w-20 h-20 rounded-xl flex items-center justify-center"
                 style="background-color: <%= @goal.color %>20">
              <%= category_icon_svg(@goal.icon, css_classes: "w-12 h-12") %>
            </div>
          </div>

          <!-- Progress Bar -->
          <div class="mb-4">
            <div class="flex justify-between text-sm text-slate-600 mb-2">
              <span><%= number_to_currency(@goal.current_amount) %></span>
              <span><%= number_to_currency(@goal.target_amount) %></span>
            </div>
            <div class="w-full bg-slate-200 rounded-full h-3 overflow-hidden">
              <div class="h-full rounded-full transition-all duration-500"
                   style="width: <%= [@goal.progress_percentage, 100].min %>%; background-color: <%= @goal.color %>">
              </div>
            </div>
            <div class="mt-2 text-center text-2xl font-bold" style="color: <%= @goal.color %>">
              <%= @goal.progress_percentage %>%
            </div>
          </div>

          <!-- Stats Grid -->
          <% if @progress.present? %>
            <div class="grid grid-cols-2 gap-3">
              <div class="text-center p-3 bg-slate-50 rounded-lg">
                <div class="text-xl font-bold text-slate-900"><%= @progress[:days_since_start] %></div>
                <div class="text-xs text-slate-600"><%= t('goals.progress.days_elapsed') %></div>
              </div>
              <div class="text-center p-3 bg-slate-50 rounded-lg">
                <div class="text-xl font-bold <%= @progress[:days_remaining] < 0 ? 'text-red-600' : 'text-slate-900' %>">
                  <%= @progress[:days_remaining] %>
                </div>
                <div class="text-xs text-slate-600"><%= t('goals.progress.days_remaining') %></div>
              </div>
              <div class="text-center p-3 bg-slate-50 rounded-lg">
                <div class="text-lg font-bold text-slate-900">
                  <%= number_to_currency(@progress[:amount_remaining]) %>
                </div>
                <div class="text-xs text-slate-600"><%= t('goals.progress.amount_remaining') %></div>
              </div>
              <div class="text-center p-3 bg-slate-50 rounded-lg">
                <div class="text-lg font-bold text-slate-900">
                  <%= number_to_currency(@progress[:monthly_contribution_needed]) %>
                </div>
                <div class="text-xs text-slate-600"><%= t('goals.progress.monthly_contribution_needed') %></div>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Quick Actions -->
        <% unless @goal.status_completed? %>
          <div class="flex gap-2">
            <%= button_to goal_path(@goal), method: :patch, params: { status_action: "complete" }, class: "flex-1 inline-flex items-center justify-center px-4 py-3 bg-green-600 text-white rounded-lg font-medium hover:bg-green-700 transition-colors" do %>
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <%= t('goals.actions.complete') %>
            <% end %>
            <%= button_to goal_path(@goal), method: :delete,
                data: { turbo_confirm: t('goals.delete_confirm', name: @goal.name) },
                class: "inline-flex items-center justify-center px-4 py-3 bg-red-600 text-white rounded-lg font-medium hover:bg-red-700 transition-colors" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
            <% end %>
          </div>
        <% end %>

        <!-- Details -->
        <div class="bg-white rounded-xl border border-slate-200 p-4">
          <h3 class="text-lg font-semibold text-slate-900 mb-3"><%= t('goals.actions.view_details') %></h3>
          <dl class="space-y-3">
            <div>
              <dt class="text-sm text-slate-600"><%= t('goals.start_date') %></dt>
              <dd class="text-base font-medium text-slate-900"><%= l(@goal.start_date, format: :long) %></dd>
            </div>
            <div>
              <dt class="text-sm text-slate-600"><%= t('goals.deadline') %></dt>
              <dd class="text-base font-medium text-slate-900"><%= l(@goal.deadline, format: :long) %></dd>
            </div>
            <% if @goal.category.present? %>
              <div>
                <dt class="text-sm text-slate-600"><%= t('goals.category') %></dt>
                <dd class="text-base font-medium text-slate-900"><%= @goal.category.name %></dd>
              </div>
            <% end %>
            <div>
              <dt class="text-sm text-slate-600"><%= t('goals.auto_sync') %></dt>
              <dd class="text-base font-medium <%= @goal.auto_link_category? ? 'text-green-600' : 'text-slate-900' %>">
                <%= @goal.auto_link_category? ? t('goals.auto_sync_on') : t('goals.auto_sync_off') %>
              </dd>
            </div>
            <% if @goal.goal_calculation_settings.present? %>
              <div>
                <dt class="text-sm text-slate-600"><%= t('goals.calculation_settings_label') %></dt>
                <dd class="text-sm text-slate-900 space-y-1 mt-1">
                  <% @goal.goal_calculation_settings.each do |transaction_type, setting| %>
                    <div class="flex justify-between items-center py-1 px-2 bg-slate-50 rounded">
                      <span class="text-slate-600"><%= t("goals.calculation_settings.#{transaction_type}") %></span>
                      <span class="font-medium <%=
                        case setting
                        when 'positive' then 'text-green-600'
                        when 'negative' then 'text-orange-600'
                        else 'text-slate-500'
                        end
                      %>">
                        <%= t("goals.calculation_settings.#{setting}") %>
                      </span>
                    </div>
                  <% end %>
                </dd>
              </div>
            <% end %>
            <% if @goal.type_debt_payoff? %>
              <div>
                <dt class="text-sm text-slate-600"><%= t('goals.debt_strategy') %></dt>
                <dd class="text-base font-medium text-slate-900">
                  <%= t("goals.strategies.#{@goal.debt_strategy}") %>
                </dd>
              </div>
              <div>
                <dt class="text-sm text-slate-600"><%= t('goals.starting_debt_amount') %></dt>
                <dd class="text-base font-medium text-slate-900">
                  <%= number_to_currency(@goal.starting_debt_amount) %>
                </dd>
              </div>
            <% end %>
            <% if @goal.notes.present? %>
              <div>
                <dt class="text-sm text-slate-600"><%= t('goals.notes') %></dt>
                <dd class="text-base text-slate-900"><%= @goal.notes %></dd>
              </div>
            <% end %>
          </dl>
        </div>

        <!-- Linked Transactions -->
        <div class="bg-white rounded-xl border border-slate-200 p-4">
          <h3 class="text-lg font-semibold text-slate-900 mb-3"><%= t('goals.linked_transactions.title') %></h3>
          <div id="goal-<%= @goal.id %>-transactions-mobile" class="space-y-2">
            <% if @goal_transactions.any? %>
              <% @goal_transactions.each do |goal_transaction| %>
                <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg">
                  <div class="flex-1">
                    <div class="font-medium text-slate-900"><%= goal_transaction.txn.description %></div>
                    <div class="text-xs text-slate-500"><%= l(goal_transaction.txn.date, format: :short) %></div>
                  </div>
                  <div class="text-right">
                    <div class="font-semibold text-green-600"><%= number_to_currency(goal_transaction.amount_applied) %></div>
                  </div>
                </div>
              <% end %>
            <% else %>
              <div class="text-center py-6 text-slate-500">
                <svg class="w-10 h-10 mx-auto mb-2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                </svg>
                <p class="text-sm"><%= t('goals.linked_transactions.no_transactions') %></p>
              </div>
            <% end %>
          </div>
        </div>

        <!-- More Actions -->
        <div class="bg-white rounded-xl border border-slate-200 p-4">
          <h3 class="text-lg font-semibold text-slate-900 mb-3"><%= t('goals.actions.title') %></h3>
          <div class="space-y-2">
            <% if @goal.status_archived? %>
              <%= button_to goal_path(@goal), method: :patch, params: { status_action: "unarchive" },
                  class: "w-full inline-flex items-center justify-center px-4 py-2 bg-green-600 text-white rounded-lg font-medium hover:bg-green-700 transition-colors" do %>
                <%= t('goals.actions.unarchive') %>
              <% end %>
            <% else %>
              <% if @goal.status_active? %>
                <%= button_to goal_path(@goal), method: :patch, params: { status_action: "pause" },
                    class: "w-full inline-flex items-center justify-center px-4 py-2 bg-gray-500 text-white rounded-lg font-medium hover:bg-gray-700 transition-colors" do %>
                  <%= t('goals.actions.pause') %>
                <% end %>
              <% elsif @goal.status_paused? %>
                <%= button_to goal_path(@goal), method: :patch, params: { status_action: "resume" },
                    class: "w-full inline-flex items-center justify-center px-4 py-2 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition-colors" do %>
                  <%= t('goals.actions.resume') %>
                <% end %>
              <% end %>

              <%= button_to goal_path(@goal), method: :patch, params: { status_action: "archive" },
                  data: { turbo_confirm: t('goals.archive_confirm', name: @goal.name) },
                  class: "w-full inline-flex items-center justify-center px-4 py-2 bg-slate-600 text-white rounded-lg font-medium hover:bg-slate-700 transition-colors" do %>
                <%= t('goals.actions.archive') %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Desktop View -->
    <div class="hidden md:block min-h-screen bg-slate-50">
      <!-- Header -->
      <header class="bg-white border-b border-slate-200 px-8 py-6">
        <div class="max-w-7xl mx-auto">
          <div class="flex items-center justify-between mb-4">
            <%= link_to goals_path, class: "text-slate-600 hover:text-slate-900 flex items-center" do %>
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
              <%= t('goals.back_to_goals') %>
            <% end %>
          </div>
          <div class="flex items-start justify-between">
            <div class="flex items-center space-x-4">
              <div class="w-16 h-16 rounded-xl flex items-center justify-center"
                   style="background-color: <%= @goal.color %>20">
                <%= category_icon_svg(@goal.icon, css_classes: "w-10 h-10") %>
              </div>
              <div>
                <h1 class="text-3xl font-bold text-slate-900"><%= @goal.name %></h1>
                <div class="flex items-center space-x-2 mt-2">
                  <span class="text-sm px-3 py-1 rounded-full <%= @goal.type_savings_goal? ? 'bg-green-100 text-green-800' : 'bg-orange-100 text-orange-800' %>">
                    <%= t("goals.types.#{@goal.goal_type}") %>
                  </span>
                  <span class="text-sm px-3 py-1 rounded-full <%=
                    case @goal.status
                    when 'active' then 'bg-blue-100 text-blue-800'
                    when 'completed' then 'bg-green-100 text-green-800'
                    when 'paused' then 'bg-gray-100 text-gray-800'
                    when 'archived' then 'bg-slate-100 text-slate-800'
                    end
                  %>">
                    <%= t("goals.statuses.#{@goal.status}") %>
                  </span>
                </div>
              </div>
            </div>
            <div class="flex space-x-2">
              <%= link_to edit_goal_path(@goal), class: "inline-flex items-center px-4 py-2 bg-white border border-slate-300 rounded-lg font-medium text-slate-700 hover:bg-slate-50 transition-colors", data: { turbo_prefetch: false } do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
                <%= t('goals.edit') %>
              <% end %>
              <% unless @goal.status_completed? %>
                <%= button_to goal_path(@goal), method: :patch, params: { status_action: "complete" }, class: "inline-flex items-center px-4 py-2 bg-green-600 text-white rounded-lg font-medium hover:bg-green-700 transition-colors" do %>
                  <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                  </svg>
                  <%= t('goals.actions.complete') %>
                <% end %>
              <% end %>
              <%= button_to goal_path(@goal), method: :delete,
                  data: { turbo_confirm: t('goals.delete_confirm', name: @goal.name) },
                  class: "inline-flex items-center px-4 py-3 bg-red-600 text-white rounded-lg font-medium hover:bg-red-700 transition-colors" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              <% end %>
            </div>
          </div>
        </div>
      </header>

      <!-- Content -->
      <div class="max-w-7xl mx-auto px-8 py-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Left Column - Progress -->
          <div class="lg:col-span-2 space-y-6">
            <!-- Progress Card -->
            <div id="goal-<%= @goal.id %>-progress" class="bg-white rounded-xl border border-slate-200 p-6">
              <h2 class="text-xl font-semibold text-slate-900 mb-4"><%= t('goals.progress.title') %></h2>

              <!-- Progress Bar -->
              <div class="mb-6">
                <div class="flex justify-between text-sm text-slate-600 mb-2">
                  <span><%= number_to_currency(@goal.current_amount) %></span>
                  <span><%= number_to_currency(@goal.target_amount) %></span>
                </div>
                <div class="w-full bg-slate-200 rounded-full h-4 overflow-hidden">
                  <div class="h-full rounded-full transition-all duration-500"
                       style="width: <%= [@goal.progress_percentage, 100].min %>%; background-color: <%= @goal.color %>"
                       title="<%= @goal.progress_percentage %>%">
                  </div>
                </div>
                <div class="mt-2 text-center text-lg font-semibold" style="color: <%= @goal.color %>">
                  <%= @goal.progress_percentage %>%
                </div>
              </div>

              <!-- Stats Grid -->
              <% if @progress.present? %>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                  <div class="text-center p-4 bg-slate-50 rounded-lg">
                    <div class="text-2xl font-bold text-slate-900"><%= @progress[:days_since_start] %></div>
                    <div class="text-sm text-slate-600"><%= t('goals.progress.days_elapsed') %></div>
                  </div>
                  <div class="text-center p-4 bg-slate-50 rounded-lg">
                    <div class="text-2xl font-bold <%= @progress[:days_remaining] < 0 ? 'text-red-600' : 'text-slate-900' %>">
                      <%= @progress[:days_remaining] %>
                    </div>
                    <div class="text-sm text-slate-600"><%= t('goals.progress.days_remaining') %></div>
                  </div>
                  <div class="text-center p-4 bg-slate-50 rounded-lg">
                    <div class="text-2xl font-bold text-slate-900">
                      <%= number_to_currency(@progress[:amount_remaining]) %>
                    </div>
                    <div class="text-sm text-slate-600"><%= t('goals.progress.amount_remaining') %></div>
                  </div>
                  <div class="text-center p-4 bg-slate-50 rounded-lg">
                    <div class="text-2xl font-bold text-slate-900">
                      <%= number_to_currency(@progress[:monthly_contribution_needed]) %>
                    </div>
                    <div class="text-sm text-slate-600"><%= t('goals.progress.monthly_contribution_needed') %></div>
                  </div>
                </div>
              <% end %>
            </div>

            <!-- Linked Transactions -->
            <div class="bg-white rounded-xl border border-slate-200 p-6">
              <h2 class="text-xl font-semibold text-slate-900 mb-4"><%= t('goals.linked_transactions.title') %></h2>

              <div id="goal-<%= @goal.id %>-transactions" class="space-y-3">
                <% if @goal_transactions.any? %>
                  <% @goal_transactions.each do |goal_transaction| %>
                    <%= render 'goal_transaction', goal_transaction: goal_transaction, goal: @goal %>
                  <% end %>
                <% else %>
                  <div class="text-center py-8 text-slate-500">
                    <svg class="w-12 h-12 mx-auto mb-2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                    </svg>
                    <p><%= t('goals.linked_transactions.no_transactions') %></p>
                    <p class="text-sm"><%= t('goals.linked_transactions.link_first') %></p>
                  </div>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Right Column - Details & Actions -->
          <div class="space-y-6">
            <!-- Details Card -->
            <div class="bg-white rounded-xl border border-slate-200 p-6">
              <h3 class="text-lg font-semibold text-slate-900 mb-4"><%= t('goals.actions.view_details') %></h3>
              <dl class="space-y-3">
                <div>
                  <dt class="text-sm text-slate-600"><%= t('goals.start_date') %></dt>
                  <dd class="text-base font-medium text-slate-900"><%= l(@goal.start_date, format: :long) %></dd>
                </div>
                <div>
                  <dt class="text-sm text-slate-600"><%= t('goals.deadline') %></dt>
                  <dd class="text-base font-medium text-slate-900"><%= l(@goal.deadline, format: :long) %></dd>
                </div>
                <% if @goal.category.present? %>
                  <div>
                    <dt class="text-sm text-slate-600"><%= t('goals.category') %></dt>
                    <dd class="text-base font-medium text-slate-900"><%= @goal.category.name %></dd>
                  </div>
                <% end %>
                <div>
                  <dt class="text-sm text-slate-600"><%= t('goals.auto_sync') %></dt>
                  <dd class="text-base font-medium <%= @goal.auto_link_category? ? 'text-green-600' : 'text-slate-900' %>">
                    <%= @goal.auto_link_category? ? t('goals.auto_sync_on') : t('goals.auto_sync_off') %>
                  </dd>
                </div>
                <% if @goal.goal_calculation_settings.present? %>
                  <div>
                    <dt class="text-sm text-slate-600"><%= t('goals.calculation_settings_label') %></dt>
                    <dd class="text-sm text-slate-900 space-y-1 mt-1">
                      <% @goal.goal_calculation_settings.each do |transaction_type, setting| %>
                        <div class="flex justify-between items-center py-1 px-2 bg-slate-50 rounded">
                          <span class="text-slate-600"><%= t("goals.calculation_settings.#{transaction_type}") %></span>
                          <span class="font-medium <%=
                            case setting
                            when 'positive' then 'text-green-600'
                            when 'negative' then 'text-orange-600'
                            else 'text-slate-500'
                            end
                          %>">
                            <%= t("goals.calculation_settings.#{setting}") %>
                          </span>
                        </div>
                      <% end %>
                    </dd>
                  </div>
                <% end %>
                <% if @goal.type_debt_payoff? %>
                  <div>
                    <dt class="text-sm text-slate-600"><%= t('goals.debt_strategy') %></dt>
                    <dd class="text-base font-medium text-slate-900">
                      <%= t("goals.strategies.#{@goal.debt_strategy}") %>
                    </dd>
                  </div>
                  <div>
                    <dt class="text-sm text-slate-600"><%= t('goals.starting_debt_amount') %></dt>
                    <dd class="text-base font-medium text-slate-900">
                      <%= number_to_currency(@goal.starting_debt_amount) %>
                    </dd>
                  </div>
                <% end %>
                <% if @goal.notes.present? %>
                  <div>
                    <dt class="text-sm text-slate-600"><%= t('goals.notes') %></dt>
                    <dd class="text-base text-slate-900"><%= @goal.notes %></dd>
                  </div>
                <% end %>
              </dl>
            </div>

            <!-- Actions Card -->
            <div class="bg-white rounded-xl border border-slate-200 p-6">
              <h3 class="text-lg font-semibold text-slate-900 mb-4">Actions</h3>
              <div class="space-y-2">
                <% if @goal.status_archived? %>
                  <%= button_to goal_path(@goal), method: :patch, params: { status_action: "unarchive" },
                      class: "w-full inline-flex items-center justify-center px-4 py-2 bg-green-600 text-white rounded-lg font-medium hover:bg-green-700 transition-colors" do %>
                    <%= t('goals.actions.unarchive') %>
                  <% end %>
                <% else %>
                  <% if @goal.status_active? %>
                    <%= button_to goal_path(@goal), method: :patch, params: { status_action: "pause" },
                        class: "w-full inline-flex items-center justify-center px-4 py-2 bg-gray-500 text-white rounded-lg font-medium hover:bg-gray-700 transition-colors" do %>
                      <%= t('goals.actions.pause') %>
                    <% end %>
                  <% elsif @goal.status_paused? %>
                    <%= button_to goal_path(@goal), method: :patch, params: { status_action: "resume" },
                        class: "w-full inline-flex items-center justify-center px-4 py-2 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition-colors" do %>
                      <%= t('goals.actions.resume') %>
                    <% end %>
                  <% end %>

                  <%= button_to goal_path(@goal), method: :patch, params: { status_action: "archive" },
                      data: { turbo_confirm: t('goals.archive_confirm', name: @goal.name) },
                      class: "w-full inline-flex items-center justify-center px-4 py-2 bg-slate-600 text-white rounded-lg font-medium hover:bg-slate-700 transition-colors" do %>
                    <%= t('goals.actions.archive') %>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
