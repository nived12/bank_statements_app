<!-- NEW CATEGORY PAGE: Create New Category -->
<main class="new-category-page">
  
  <!-- HEADER SECTION: Page Header -->
  <header class="new-category-header">
    <div class="new-category-header-container">
      <div class="new-category-header-content">
        
        <!-- HEADER LEFT: Title and Description -->
        <div class="new-category-header-left">
          <h1 class="new-category-header-title"><%= t('new_category') %></h1>
          <p class="new-category-header-subtitle"><%= t('add_new_category_description') %></p>
        </div>
        
        <!-- HEADER RIGHT: Back Button -->
        <div class="new-category-header-right">
          <a href="/categories" class="new-category-back-button">
            <svg class="new-category-back-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <%= t('back_to_categories') %>
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- NEW CATEGORY CONTENT: Form -->
  <div class="new-category-content">
    <div class="new-category-container">
      
      <!-- NEW CATEGORY FORM: Create Category Form -->
      <div class="new-category-form-container">
        <div class="new-category-form-card">
          
          <form action="/categories" method="POST" class="new-category-form">
            <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
            
            <!-- CATEGORY NAME -->
            <div class="form-group">
              <label for="category_name" class="form-label"><%= t('category_name') %> *</label>
              <input type="text" 
                     id="category_name" 
                     name="category[name]" 
                     class="form-input" 
                     placeholder="<%= t('category_name_placeholder') %>"
                     required>
              <p class="form-help"><%= t('category_name_help') %></p>
            </div>
            
            <!-- PARENT CATEGORY -->
            <div class="form-group">
              <label for="category_parent_id" class="form-label"><%= t('parent_category') %></label>
              <select id="category_parent_id" name="category[parent_id]" class="form-select">
                <option value=""><%= t('no_parent_top_level') %></option>
                <% current_user.categories.where(parent_id: nil).order(:name).each do |parent| %>
                  <option value="<%= parent.id %>"><%= parent.name %></option>
                <% end %>
              </select>
              <p class="form-help"><%= t('parent_category_help') %></p>
            </div>
            
            <!-- FORM ACTIONS -->
            <div class="form-actions">
              <a href="/categories" class="btn-secondary"><%= t('cancel') %></a>
              <button type="submit" class="btn-primary"><%= t('create_category') %></button>
            </div>
          </form>
          
        </div>
      </div>
      
      <!-- INFO PANEL: Category Creation Tips -->
      <div class="new-category-info-panel">
        <div class="new-category-info-header">
          <h3 class="new-category-info-title"><%= t('category_creation_tips') %></h3>
        </div>
        <div class="new-category-info-content">
          
          <div class="new-category-info-item">
            <div class="new-category-info-icon">
              <svg class="new-category-info-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div class="new-category-info-text">
              <h4 class="new-category-info-subtitle"><%= t('naming_convention') %></h4>
              <p class="new-category-info-description"><%= t('naming_convention_description') %></p>
            </div>
          </div>
          
          <div class="new-category-info-item">
            <div class="new-category-info-icon">
              <svg class="new-category-info-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
              </svg>
            </div>
            <div class="new-category-info-text">
              <h4 class="new-category-info-subtitle"><%= t('hierarchical_structure') %></h4>
              <p class="new-category-info-description"><%= t('hierarchical_structure_example') %></p>
            </div>
          </div>
          
          <div class="new-category-info-item">
            <div class="new-category-info-icon">
              <svg class="new-category-info-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div class="new-category-info-text">
              <h4 class="new-category-info-subtitle"><%= t('best_practices') %></h4>
              <p class="new-category-info-description"><%= t('best_practices_description') %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
