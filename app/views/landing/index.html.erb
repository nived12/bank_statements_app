            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span data-lang-es>Cancela cuando quieras</span><span data-lang-en>Cancel anytime</span>
          </span>
        </div>
      </div>

      <div class="hero-visual">
        <div class="hero-screen hero-screen-desktop">
          <div class="hero-screen-chrome">
            <div class="dots"><span></span><span></span><span></span></div>
            <div class="url-bar">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              app.vitt.io
            </div>
          </div>
          <%= image_tag "landing/dashboard.png", alt: "Vittio dashboard", fetchpriority: "high", loading: "eager", width: 1400, height: 1062 %>
