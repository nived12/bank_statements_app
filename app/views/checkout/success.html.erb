    <div class="w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-6">
      <%= icon("check", library: "lucide", variant: "outline", class: "w-8 h-8 text-emerald-600") %>
    </div>
    <h1 class="text-xl font-bold text-slate-900 mb-2"><%= t("checkout.success.title") %></h1>
