<% content_for :title, @series.name %>

<div class="max-w-3xl mx-auto p-4 md:p-8">
  <%= link_to "← #{t("recurring.title")}", recurring_series_index_path, class: "text-sm text-indigo-600 hover:underline" %>

  <header class="mt-4 mb-6 flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100"><%= @series.name %></h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
        <%= t("recurring.frequencies.#{@series.frequency}") %> ·
        <%= number_to_currency(@series.expected_amount, unit: "$") %> ·
        <%= t("recurring.#{@series.status}") %>
      </p>
    </div>
    <div class="flex gap-2">
      <%= link_to t("recurring.edit"), edit_recurring_series_path(@series),
                  class: "px-3 py-1.5 text-sm rounded-lg border border-slate-300 dark:border-slate-600" %>
      <% if @series.status == "active" %>
        <%= button_to t("recurring.actions.pause"), recurring_series_path(@series), method: :patch,
                      params: { recurring_series: { status: "paused" } },
                      class: "px-3 py-1.5 text-sm rounded-lg border border-slate-300 dark:border-slate-600" %>
      <% elsif @series.status == "paused" %>
        <%= button_to t("recurring.actions.resume"), recurring_series_path(@series), method: :patch,
                      params: { recurring_series: { status: "active" } },
                      class: "px-3 py-1.5 text-sm rounded-lg bg-indigo-600 text-white" %>
      <% end %>
      <% unless @series.status == "cancelled" %>
        <%= button_to t("recurring.actions.cancel"), recurring_series_path(@series), method: :patch,
                      params: { recurring_series: { status: "cancelled" } },
                      class: "px-3 py-1.5 text-sm rounded-lg border border-rose-300 text-rose-700" %>
      <% end %>
    </div>
  </header>

  <div class="grid grid-cols-2 gap-3 mb-6">
    <div class="bg-white dark:bg-slate-800 rounded-xl p-4 border border-slate-200 dark:border-slate-700">
      <p class="text-xs text-slate-500"><%= t("recurring.monthly_total") %></p>
      <p class="text-xl font-bold text-slate-900 dark:text-slate-100"><%= number_to_currency(@series.monthly_estimate, unit: "$") %></p>
    </div>
    <div class="bg-white dark:bg-slate-800 rounded-xl p-4 border border-slate-200 dark:border-slate-700">
      <p class="text-xs text-slate-500"><%= t("recurring.annual_total") %></p>
      <p class="text-xl font-bold text-slate-900 dark:text-slate-100"><%= number_to_currency(@series.annual_estimate, unit: "$") %></p>
    </div>
  </div>

  <% if @transactions.any? %>
    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-3">
      <%= t("recurring.linked_transactions", default: "Linked transactions") %> (<%= @transactions.size %>)
    </h2>
    <div class="space-y-1">
      <% @transactions.each do |tx| %>
        <div class="flex items-center justify-between bg-white dark:bg-slate-800 rounded-lg p-3 border border-slate-200 dark:border-slate-700">
          <div class="min-w-0">
            <p class="text-sm font-medium text-slate-900 dark:text-slate-100 truncate"><%= tx.description %></p>
            <p class="text-xs text-slate-500"><%= l(tx.date, format: :short) %></p>
          </div>
          <p class="font-semibold <%= tx.amount.negative? ? 'text-rose-600' : 'text-emerald-600' %>">
            <%= number_to_currency(tx.amount, unit: "$") %>
          </p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
