<%= link_to category_path(category), id: "category-#{category.id}", class: "block bg-white rounded-xl border border-slate-200 hover:border-blue-300 hover:shadow-md transition-all" do %>
  <div class="p-4 flex items-center justify-between">
    <div class="flex items-center space-x-3 flex-1">
      <!-- Icon -->
      <div class="w-10 h-10 bg-blue-50 rounded-lg flex items-center justify-center flex-shrink-0">
        <%= category_icon_svg(category.icon, css_classes: "w-5 h-5 text-blue-600") %>
      </div>

      <!-- Category Info -->
      <div class="flex-1 min-w-0">
        <h3 class="font-semibold text-slate-900 truncate"><%= category.name %></h3>
        <p class="text-sm text-slate-500">
          <%= category.transactions.count == 1 ? "#{category.transactions.count} #{t('mobile.transactions.transaction').downcase}" : "#{category.transactions.count} #{t('mobile.transactions.transactions').downcase}" %>
        </p>
        <p class="text-sm text-slate-500">
            <%= category.children.count == 1 ? "#{category.children.count} #{t('mobile.categories.subcategory').downcase}" : "#{category.children.count} #{t('mobile.categories.subcategories').downcase}" %>
        </p>
      </div>
    </div>

    <!-- Arrow -->
    <svg class="w-5 h-5 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
    </svg>
  </div>
<% end %>
