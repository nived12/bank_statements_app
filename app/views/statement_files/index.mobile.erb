<!-- MOBILE STATEMENT FILES PAGE: Mobile-Optimized Statement File Management -->
<main class="mobile-statement-files-page">
  <div class="mobile-statement-files-container">
    
    <!-- MOBILE HEADER: Page Title and Quick Actions -->
    <header class="mobile-statement-files-header">
      <div class="mobile-statement-files-header-content">
        <div class="mobile-statement-files-header-left">
          <h1 class="mobile-statement-files-title"><%= t('statement_files.overview') %></h1>
          <p class="mobile-statement-files-subtitle"><%= t('dashboard.manage_your_bank_statements') %></p>
        </div>
        <div class="mobile-statement-files-header-actions">
          <a href="/statement_files/new" class="mobile-statement-files-upload-btn">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
            </svg>
          </a>
        </div>
      </div>
    </header>

    <!-- MOBILE STATS: Quick Overview Cards -->
    <section class="mobile-statement-files-stats">
      <div class="mobile-stats-grid">
        <!-- Total Files -->
        <div class="mobile-stat-card">
          <div class="mobile-stat-icon mobile-stat-icon-files">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <div class="mobile-stat-content">
            <p class="mobile-stat-label"><%= t('statement_files.total_files') %></p>
            <p class="mobile-stat-value"><%= @mobile_statement_files_data[:total_files] %></p>
          </div>
        </div>

        <!-- Processed Files -->
        <div class="mobile-stat-card">
          <div class="mobile-stat-icon mobile-stat-icon-processed">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="mobile-stat-content">
            <p class="mobile-stat-label"><%= t('statement_files.processed') %></p>
            <p class="mobile-stat-value text-green-600"><%= @mobile_statement_files_data[:processed_files] %></p>
          </div>
        </div>

        <!-- Pending Files -->
        <div class="mobile-stat-card">
          <div class="mobile-stat-icon mobile-stat-icon-pending">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="mobile-stat-content">
            <p class="mobile-stat-label"><%= t('statement_files.pending') %></p>
            <p class="mobile-stat-value text-yellow-600"><%= @mobile_statement_files_data[:pending_files] %></p>
          </div>
        </div>

        <!-- Error Files -->
        <div class="mobile-stat-card">
          <div class="mobile-stat-icon mobile-stat-icon-error">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="mobile-stat-content">
            <p class="mobile-stat-label"><%= t('statement_files.errors') %></p>
            <p class="mobile-stat-value text-red-600"><%= @mobile_statement_files_data[:error_files] %></p>
          </div>
        </div>

        <!-- Total Transactions -->
        <div class="mobile-stat-card mobile-stat-card-primary">
          <div class="mobile-stat-icon mobile-stat-icon-transactions">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
          <div class="mobile-stat-content">
            <p class="mobile-stat-label"><%= t('statement_files.total_transactions') %></p>
            <p class="mobile-stat-value mobile-stat-value-large"><%= @mobile_statement_files_data[:total_transactions] %></p>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="mobile-stat-card mobile-stat-card-action">
          <div class="mobile-stat-icon mobile-stat-icon-action">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
          </div>
          <div class="mobile-stat-content">
            <p class="mobile-stat-label"><%= t('statement_files.quick_actions') %></p>
            <a href="/statement_files/new" class="mobile-stat-action-btn">
              <%= t('quick_actions.upload_statement') %>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- MOBILE STATEMENT FILES LIST: Card-based File Display -->
    <% if @mobile_statement_files_data[:statement_files].any? %>
      <section class="mobile-statement-files-list">
        <div class="mobile-statement-files-header-bar">
          <h3 class="mobile-statement-files-list-title">
            <%= t('statement_files.your_files') %>
            <span class="mobile-statement-files-count">(<%= @mobile_statement_files_data[:total_files] %>)</span>
          </h3>
        </div>

        <div class="mobile-statement-files-cards">
          <% @mobile_statement_files_data[:statement_files].each do |statement_file| %>
            <div class="mobile-statement-file-card" data-file-id="<%= statement_file[:id] %>">
              <div class="mobile-statement-file-main">
                <div class="mobile-statement-file-info">
                  <div class="mobile-statement-file-icon">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                  </div>
                  <div class="mobile-statement-file-details">
                    <h4 class="mobile-statement-file-name"><%= statement_file[:filename] %></h4>
                    <p class="mobile-statement-file-bank">
                      <%= statement_file[:bank_name] %> • ••••<%= statement_file[:account_number].last(4) %>
                    </p>
                    <p class="mobile-statement-file-date">
                      <%= format_local_time(statement_file[:created_at], format: 'date') %>
                    </p>
                  </div>
                </div>
                
                <div class="mobile-statement-file-status">
                  <span class="mobile-statement-file-status-badge mobile-statement-file-status-<%= statement_file[:status] %>">
                    <%= statement_file[:status].humanize %>
                  </span>
                </div>
              </div>

              <!-- File Details -->
              <div class="mobile-statement-file-details-section">
                <div class="mobile-statement-file-detail-row">
                  <span class="mobile-statement-file-detail-label"><%= t('table_headers.transactions') %>:</span>
                  <span class="mobile-statement-file-detail-value"><%= statement_file[:transactions_count] %></span>
                </div>
                
                <% if statement_file[:ai_enabled] %>
                  <div class="mobile-statement-file-detail-row">
                    <span class="mobile-statement-file-detail-label"><%= t('statement_files.ai_enabled') %>:</span>
                    <span class="mobile-statement-file-detail-value text-green-600">
                      <svg class="w-3 h-3 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      <%= t('statement_files.yes') %>
                    </span>
                  </div>
                <% end %>

                <% if statement_file[:processed_at].present? %>
                  <div class="mobile-statement-file-detail-row">
                    <span class="mobile-statement-file-detail-label"><%= t('statement_files.processed_at') %>:</span>
                    <span class="mobile-statement-file-detail-value">
                      <%= format_local_time(statement_file[:processed_at], format: 'datetime') %>
                    </span>
                  </div>
                <% end %>

                <% if statement_file[:error_message].present? %>
                  <div class="mobile-statement-file-detail-row">
                    <span class="mobile-statement-file-detail-label"><%= t('statement_files.error') %>:</span>
                    <span class="mobile-statement-file-detail-value text-red-600 text-xs">
                      <%= statement_file[:error_message] %>
                    </span>
                  </div>
                <% end %>
              </div>

              <!-- File Actions -->
              <div class="mobile-statement-file-actions">
                <a href="/statement_files/<%= statement_file[:id] %>" class="mobile-statement-file-action-btn mobile-statement-file-view-btn">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                  <%= t('statement_files.view') %>
                </a>
                
                <% if statement_file[:status] == 'error' %>
                  <button class="mobile-statement-file-action-btn mobile-statement-file-retry-btn"
                          data-controller="statement-retry"
                          data-statement-id="<%= statement_file[:id] %>">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                    <%= t('statement_files.retry') %>
                  </button>
                <% end %>
                
                <%= button_to statement_file_path(statement_file[:id]), 
                            method: :delete,
                            class: "mobile-statement-file-action-btn mobile-statement-file-delete-btn",
                            data: { 
                              confirm: t('confirm_delete_statement', count: statement_file[:transactions_count])
                            } do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                  <%= t('statement_files.delete') %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% else %>
      <!-- EMPTY STATE: No Statement Files -->
      <section class="mobile-statement-files-empty">
        <div class="mobile-empty-icon">
          <svg class="w-16 h-16 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
        <h3 class="mobile-empty-title"><%= t('dashboard.no_statement_files_yet') %></h3>
        <p class="mobile-empty-description"><%= t('dashboard.upload_your_first_statement') %></p>
        <div class="mobile-empty-actions">
          <a href="/statement_files/new" class="mobile-empty-action-btn">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
            </svg>
            <%= t('quick_actions.upload_statement') %>
          </a>
        </div>
      </section>
    <% end %>
  </div>
</main>
