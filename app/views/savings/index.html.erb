<div class="savings-page">
  <div class="savings-main">
    <!-- Mobile View -->
    <div class="block md:hidden min-h-screen bg-slate-50 dark:bg-slate-900 pb-24">
      <!-- Mobile Header -->
      <header class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 px-4 py-4 sticky top-0 z-10">
        <div class="flex items-center justify-between mb-3">
          <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100"><%= t('savings.title') %></h1>
          <%= link_to new_saving_path, class: "flex items-center justify-center w-10 h-10 bg-indigo-600 text-white rounded-full hover:bg-indigo-700 transition-colors" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path>
            </svg>
          <% end %>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-400"><%= t('savings.description') %></p>
      </header>

      <!-- Status Filter Tabs -->
      <div class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 px-4 sticky top-[73px] z-10">
        <div class="flex space-x-1 overflow-x-auto">
          <%= link_to savings_path(status: "all"),
                      class: "px-4 py-3 text-sm font-medium whitespace-nowrap #{@selected_status == 'all' ? 'text-blue-600 border-b-2 border-blue-600' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900'}" do %>
            <%= t('savings.all_savings') %> <%= content_tag(:span, "(#{@status_counts.values.sum - (@status_counts['archived'] || 0)})", class: "text-xs") %>
          <% end %>
          <%= link_to savings_path(status: "active"),
                      class: "px-4 py-3 text-sm font-medium whitespace-nowrap #{@selected_status == 'active' ? 'text-blue-600 border-b-2 border-blue-600' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900'}" do %>
            <%= t('savings.active_savings') %> <%= content_tag(:span, "(#{@status_counts['active'] || 0})", class: "text-xs") %>
          <% end %>
          <%= link_to savings_path(status: "completed"),
                      class: "px-4 py-3 text-sm font-medium whitespace-nowrap #{@selected_status == 'completed' ? 'text-blue-600 border-b-2 border-blue-600' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900'}" do %>
            <%= t('savings.completed_savings') %> <%= content_tag(:span, "(#{@status_counts['completed'] || 0})", class: "text-xs") %>
          <% end %>
          <%= link_to savings_path(status: "paused"),
                      class: "px-4 py-3 text-sm font-medium whitespace-nowrap #{@selected_status == 'paused' ? 'text-blue-600 border-b-2 border-blue-600' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900'}" do %>
            <%= t('savings.paused_savings') %> <%= content_tag(:span, "(#{@status_counts['paused'] || 0})", class: "text-xs") %>
          <% end %>
          <%= link_to savings_path(status: "archived"),
                      class: "px-4 py-3 text-sm font-medium whitespace-nowrap #{@selected_status == 'archived' ? 'text-blue-600 border-b-2 border-blue-600' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900'}" do %>
            <%= t('savings.archived_savings') %> <%= content_tag(:span, "(#{@status_counts['archived'] || 0})", class: "text-xs") %>
          <% end %>
        </div>
      </div>

      <!-- Mobile Content -->
      <div class="px-4 py-4 space-y-3">
        <% if @savings.any? %>
          <% @savings.each do |saving| %>
            <%= link_to saving_path(saving), class: "block bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-4 hover:border-blue-300 transition-colors", data: { turbo_prefetch: false } do %>
              <div class="flex items-start justify-between mb-3">
                <div class="flex items-center space-x-3">
                  <div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background-color: <%= saving.color %>20">
                    <%= icon_svg(saving.icon, css_classes: "w-6 h-6") %>
                  </div>
                  <div>
                    <h3 class="font-semibold text-slate-900 dark:text-slate-100"><%= saving.name %></h3>
                    <% if saving.categories.any? %>
                      <p class="text-xs text-slate-500 dark:text-slate-400"><%= saving.categories.first(2).map(&:name).join(", ") %><%= " +#{saving.categories.count - 2}" if saving.categories.count > 2 %></p>
                    <% else %>
                      <p class="text-xs text-slate-500 dark:text-slate-400"><%= t('savings.no_category') %></p>
                    <% end %>
                  </div>
                </div>
              </div>

              <!-- Progress Bar -->
              <div class="mb-2">
                <div class="flex justify-between text-xs text-slate-600 dark:text-slate-400 mb-1">
                  <span><%= number_to_currency(saving.current_amount) %></span>
                  <span><%= number_to_currency(saving.target_amount) %></span>
                </div>
                <div class="w-full bg-slate-200 rounded-full h-2">
                  <div class="h-full rounded-full transition-all" style="width: <%= [saving.progress_percentage, 100].min %>%; background-color: <%= saving.color %>"></div>
                </div>
              </div>

              <div class="flex items-center justify-between text-xs text-slate-600 dark:text-slate-400">
                <span><%= saving.progress_percentage.round %>% complete</span>
                <span><%= saving.status.humanize %></span>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <!-- Empty State -->
          <div class="text-center py-12">
            <div class="w-20 h-20 bg-blue-50 dark:bg-blue-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-10 h-10 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-2"><%= t('savings.no_savings_yet') %></h3>
            <p class="text-slate-600 dark:text-slate-400 mb-6 px-4"><%= t('savings.create_first_description') %></p>
            <%= link_to new_saving_path, class: "inline-flex items-center px-6 py-3 bg-indigo-600 text-white rounded-lg font-medium hover:bg-indigo-700 transition-colors" do %>
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              <%= t('savings.create_saving') %>
            <% end %>
            <%= render "shared/template_picker", type: "saving" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Desktop View -->
    <div class="hidden md:block min-h-screen bg-slate-50 dark:bg-slate-900">
      <!-- Header -->
      <header class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 px-8 py-6">
        <div class="max-w-7xl mx-auto flex items-start justify-between">
          <div class="flex-1">
            <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100"><%= t('savings.manage_savings') %></h1>
            <p class="text-slate-600 dark:text-slate-400 mt-2"><%= t('savings.description') %></p>
          </div>
          <%= link_to new_saving_path,
                      class: "inline-flex items-center px-5 py-2.5 bg-indigo-600 text-white rounded-lg font-medium hover:bg-indigo-700 transition-colors shadow-sm" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            <%= t('savings.add_saving') %>
          <% end %>
        </div>
      </header>

      <!-- Status Filter Tabs -->
      <div class="bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 px-8">
        <div class="max-w-7xl mx-auto">
          <div class="flex space-x-6">
            <%= link_to savings_path(status: "all"),
                        class: "px-1 py-4 text-sm font-medium border-b-2 #{@selected_status == 'all' ? 'text-blue-600 border-blue-600' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:text-slate-100 border-transparent'}" do %>
              <%= t('savings.all_savings') %> <span class="text-xs ml-1">(<%= @status_counts.values.sum - (@status_counts['archived'] || 0) %>)</span>
            <% end %>
            <%= link_to savings_path(status: "active"),
                        class: "px-1 py-4 text-sm font-medium border-b-2 #{@selected_status == 'active' ? 'text-blue-600 border-blue-600' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:text-slate-100 border-transparent'}" do %>
              <%= t('savings.active_savings') %> <span class="text-xs ml-1">(<%= @status_counts['active'] || 0 %>)</span>
            <% end %>
            <%= link_to savings_path(status: "completed"),
                        class: "px-1 py-4 text-sm font-medium border-b-2 #{@selected_status == 'completed' ? 'text-blue-600 border-blue-600' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:text-slate-100 border-transparent'}" do %>
              <%= t('savings.completed_savings') %> <span class="text-xs ml-1">(<%= @status_counts['completed'] || 0 %>)</span>
            <% end %>
            <%= link_to savings_path(status: "paused"),
                        class: "px-1 py-4 text-sm font-medium border-b-2 #{@selected_status == 'paused' ? 'text-blue-600 border-blue-600' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:text-slate-100 border-transparent'}" do %>
              <%= t('savings.paused_savings') %> <span class="text-xs ml-1">(<%= @status_counts['paused'] || 0 %>)</span>
            <% end %>
            <%= link_to savings_path(status: "archived"),
                        class: "px-1 py-4 text-sm font-medium border-b-2 #{@selected_status == 'archived' ? 'text-blue-600 border-blue-600' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:text-slate-100 border-transparent'}" do %>
              <%= t('savings.archived_savings') %> <span class="text-xs ml-1">(<%= @status_counts['archived'] || 0 %>)</span>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Savings Grid -->
      <div class="max-w-7xl mx-auto px-8 py-8">
        <% if @savings.any? %>
          <div id="savings-list" class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6">
            <% @savings.each do |saving| %>
              <%= render 'saving_card', saving: saving %>
            <% end %>
          </div>
        <% else %>
          <!-- Empty State -->
          <div class="text-center py-16">
            <div class="mx-auto w-24 h-24 bg-slate-100 dark:bg-slate-700 rounded-full flex items-center justify-center mb-4">
              <svg class="w-12 h-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
              </svg>
            </div>
            <h3 class="text-lg font-medium text-slate-900 dark:text-slate-100 mb-2"><%= t('savings.no_savings_yet') %></h3>
            <p class="text-slate-600 dark:text-slate-400 mb-6"><%= t('savings.create_first_description') %></p>
            <%= link_to t('savings.create_first'), new_saving_path,
                        class: "inline-flex items-center px-5 py-2.5 bg-indigo-600 text-white rounded-lg font-medium hover:bg-indigo-700 transition-colors shadow-sm" %>
            <div class="max-w-2xl mx-auto">
              <%= render "shared/template_picker", type: "saving" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
