<section>
  <div class="container w-full flex flex-col mb-8">

    <!-- Active filters section -->
    <% total_filters_count = [params[:bank_account_id], params[:statement_file_id], params[:transaction_type], params[:from_date], params[:to_date], params[:search]].compact.length %>
    <% if total_filters_count > 0 %>
      <div class="flex space-x-4">
        <span class="text-sm font-medium text-slate-700"><%= t('transactions.active_filters') %></span>

        <!-- Bank account filter -->
        <% if params[:bank_account_id].present? %>
          <% bank_account = @bank_accounts.find { |ba| ba.id.to_s == params[:bank_account_id] } %>
          <div class="inline-flex items-center bg-blue-100 text-blue-800 text-sm px-3 py-1 rounded-full">
            <span><%= bank_account&.custom_name || "#{bank_account&.bank_display_name} - ••••#{bank_account&.account_number&.last(4)}" %></span>
            <button onclick="clearFilter('bank_account_id')" class="ml-2 text-blue-600 hover:text-blue-800">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        <% end %>

        <!-- Statement file filter -->
        <% if params[:statement_file_id].present? %>
          <div class="inline-flex items-center bg-green-100 text-green-800 text-sm px-3 py-1 rounded-full">
            <span><%= @statement_file&.safe_filename %></span>
            <button onclick="clearFilter('statement_file_id')" class="ml-2 text-green-600 hover:text-green-800">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        <% end %>

        <!-- Transaction type filter -->
        <% if params[:transaction_type].present? %>
          <div class="inline-flex items-center bg-purple-100 text-purple-800 text-sm px-3 py-1 rounded-full">
            <span><%= t("transaction_types.#{params[:transaction_type]}") %></span>
            <button onclick="clearFilter('transaction_type')" class="ml-2 text-purple-600 hover:text-purple-800">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        <% end %>

        <!-- Date range filter -->
        <% if params[:from_date].present? || params[:to_date].present? %>
          <div class="inline-flex items-center bg-orange-100 text-orange-800 text-sm px-3 py-1 rounded-full">
            <span>
              <% if params[:from_date].present? && params[:to_date].present? %>
                <%= params[:from_date] %> - <%= params[:to_date] %>
              <% elsif params[:from_date].present? %>
                Desde <%= params[:from_date] %>
              <% else %>
                Hasta <%= params[:to_date] %>
              <% end %>
            </span>
            <button onclick="clearDateFilter()" class="ml-2 text-orange-600 hover:text-orange-800">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        <% end %>

        <!-- Search filter -->
        <% if params[:search].present? %>
          <div class="inline-flex items-center bg-indigo-100 text-indigo-800 text-sm px-3 py-1 rounded-full">
            <span><%= t('transactions.search_filter', query: params[:search]) %></span>
            <button onclick="window.clearSearch()" class="ml-2 text-indigo-600 hover:text-indigo-800">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        <% end %>

        <!-- Clear all filters button -->
        <% if total_filters_count > 0 %>
          <button onclick="clearAllFilters()" class="text-sm text-red-600 hover:text-red-800 font-medium">
            <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
            <%= t('transactions.clear_all_filters') %>
          </button>
        <% end %>
      </div>
    <% end %>

    <!-- Filters form -->
    <form class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Hidden inputs to preserve other filter parameters -->
      <input type="hidden" name="bank_account_id" value="<%= params[:bank_account_id] %>">
      <input type="hidden" name="statement_file_id" value="<%= params[:statement_file_id] %>">
      <input type="hidden" name="transaction_type" value="<%= params[:transaction_type] %>">
      <input type="hidden" name="from_date" value="<%= params[:from_date] %>">
      <input type="hidden" name="to_date" value="<%= params[:to_date] %>">
      <input type="hidden" name="sort" value="<%= params[:sort] %>">
      <input type="hidden" name="direction" value="<%= params[:direction] %>">

      <%# TODO: Fix search bar to use the filter controller to handle the search and clear search buttons. %>
      <div class="flex flex-col">
        <label for="search" class="block text-xs font-medium text-slate-600 mb-1"><%= t('transactions.search_description') %></label>
        <div class="relative">
          <input type="text"
                  id="search"
                  name="search"
                  value="<%= params[:search] %>"
                  placeholder="<%= t('transactions.search_placeholder') %>"
                  class="w-full px-3 py-2 pl-10 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  oninput="clearTimeout(this.searchTimeout); this.searchTimeout = setTimeout(() => this.form.requestSubmit(), 300)"
                  onkeydown="if(event.key === 'Enter') { event.preventDefault(); this.form.requestSubmit(); }">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <% if params[:search].present? %>
            <button onclick="window.clearSearch()" class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          <% end %>
        </div>
      </div>

      <!-- Date range picker -->
      <%# TODO: Fix date range picker. %>
      <div class="flex flex-col">
        <label for="date_range" class="block text-xs font-medium text-slate-600 mb-1"><%= t('transactions.date_range_filter') %></label>
        <input type="text"
                id="date_range"
                name="date_range"
                placeholder="<%= t('transactions.click_to_select_range') %>"
                class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                readonly>
        <input type="hidden" name="from_date" id="from_date">
        <input type="hidden" name="to_date" id="to_date">
      </div>

      <!-- Bank account filter -->
      <div class="flex flex-col">
        <label for="bank_account_id" class="block text-xs font-medium text-slate-600 mb-1"><%= t('transactions.bank_account_filter') %></label>
        <select name="bank_account_id" id="bank_account_id" class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" onchange="this.form.requestSubmit()">
          <option value=""><%= t('transactions.all_accounts') %></option>
        </select>
      </div>

      <!-- Transaction type filter -->
      <div class="flex flex-col">
        <label for="transaction_type" class="block text-xs font-medium text-slate-600 mb-1"><%= t('transactions.transaction_type_filter') %></label>
        <select name="transaction_type" id="transaction_type" class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" onchange="this.form.requestSubmit()">
          <option value=""><%= t('transactions.all_transaction_types') %></option>
          <option value="income" <%= "selected" if params[:transaction_type] == "income" %>><%= t('transaction_types.income') %></option>
          <option value="fixed_expense" <%= "selected" if params[:transaction_type] == "fixed_expense" %>><%= t('transaction_types.fixed_expense') %></option>
          <option value="variable_expense" <%= "selected" if params[:transaction_type] == "variable_expense" %>><%= t('transaction_types.variable_expense') %></option>
          <option value="transfer" <%= "selected" if params[:transaction_type] == "transfer" || params[:transaction_type] == "transfer_out" || params[:transaction_type] == "transfer_in" %>><%= t('transaction_types.transfer_out') %></option>
        </select>
      </div>
    </form>
  </div>
</section>
