<%#
  Titled section wrapper for the savings / debts / goals forms.
  Render with `render layout: "shared/form_section", locals: { title: ... } do`.

  Locals: title, description (optional), first (optional — omits the top divider)
%>
<section class="<%= local_assigns[:first] ? "" : "pt-8 border-t border-slate-200 dark:border-slate-700" %>">
  <h3 class="text-base font-semibold text-slate-900 dark:text-slate-100"><%= title %></h3>
  <% if local_assigns[:description].present? %>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= description %></p>
  <% end %>
  <div class="mt-5 space-y-5">
    <%= yield %>
  </div>
</section>
