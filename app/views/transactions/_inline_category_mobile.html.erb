<div id="transaction-category-mobile-<%= transaction.id %>"
     data-controller="inline-category"
     data-inline-category-url-value="<%= transaction_category_path(transaction) %>"
     data-inline-category-current-category-id-value="<%= transaction.category_id %>"
     class="relative inline-flex">
  <button type="button"
          data-action="click->inline-category#toggle"
          data-inline-category-target="trigger"
          class="inline-flex items-center space-x-1"
          title="<%= t('transactions.inline_edit.change_category') %>">
    <% if transaction.category %>
      <span class="mobile-transaction-category">
        <%= transaction.category.name %>
      </span>
    <% else %>
      <span class="mobile-transaction-category mobile-category-empty">
        <%= t('transactions.no_category') %>
      </span>
    <% end %>
    <svg class="w-3 h-3 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
    </svg>
  </button>
</div>
