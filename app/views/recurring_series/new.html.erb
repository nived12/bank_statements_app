<% content_for :title, t("recurring.new") %>
<% content_for :hide_fab, true %>
<% content_for :hide_mobile_header, true %>

<div class="block md:hidden mobile-form-page" data-controller="recurring-series-form">
  <%= render "shared/mobile_form_header",
      title: t("recurring.new"),
      back_url: recurring_series_index_path %>

  <div class="mobile-form-body mobile-form-fields">
    <%= render "recurring_form_mobile", form_id: "mobile_recurring_form" %>
  </div>

  <%= render "shared/mobile_form_footer",
      form_id: "mobile_recurring_form",
      controller_name: "recurring-series-form",
      label: t("form_actions.create", default: "Crear") %>
</div>

<div class="hidden md:block min-h-screen bg-slate-50 dark:bg-slate-900" data-controller="recurring-series-form">
  <header class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 px-8 py-6">
    <div class="max-w-3xl mx-auto">
      <div class="flex items-center justify-between mb-4">
        <%= link_to recurring_series_index_path, class: "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:text-slate-100 flex items-center" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          <%= t("recurring.back_to_recurring") %>
        <% end %>
      </div>
      <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100"><%= t("recurring.new") %></h1>
      <p class="text-slate-600 dark:text-slate-400 mt-2"><%= t("recurring.new_description") %></p>
    </div>
  </header>

  <div class="max-w-3xl mx-auto px-8 py-8">
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6">
      <%= render "form" %>
    </div>
  </div>
</div>
