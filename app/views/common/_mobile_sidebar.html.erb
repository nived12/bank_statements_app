<div data-mobile-menu-target="overlay"
    class="fixed inset-0 z-[9999] hidden mobile-menu-overlay lg:hidden"
    style="pointer-events: auto;">
  <!-- Backdrop -->
  <div class="fixed inset-0 bg-black bg-opacity-60"
        data-action="click->mobile-menu#close"></div>

  <!-- Menu Panel -->
  <div data-mobile-menu-target="panel"
        class="fixed top-0 left-0 h-full w-80 bg-white shadow-2xl mobile-menu-panel transform -translate-x-full transition-transform duration-300 ease-in-out z-[10000] flex flex-col overflow-hidden">

    <!-- Menu Header -->
    <div class="mobile-menu-header flex items-center justify-between bg-white border-b border-slate-200 p-6">
      <div class="flex items-center">
        <img src="/vittio1.png" alt="Vittio" class="h-8 w-auto">
      </div>
      <button type="button"
              data-action="click->mobile-menu#close"
              class="mobile-menu-close-btn p-2 rounded-lg hover:bg-slate-100 transition-colors">
        <svg class="w-6 h-6 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Menu Items -->
    <nav class="mobile-menu-nav p-4 space-y-2 flex-1 overflow-y-auto">
      <a href="<%= dashboard_path %>"
          class="mobile-menu-item flex items-center px-4 py-4 rounded-xl text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200">
        <%= icon("layout-dashboard", library: "lucide", variant: "outline", class: "w-5 h-5 mr-3") %>
        <span><%= t('navigation.dashboard') %></span>
      </a>

      <a href="<%= bank_accounts_path %>"
          class="mobile-menu-item flex items-center px-4 py-4 rounded-xl text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200">
        <%= icon("credit-card", library: "lucide", variant: "outline", class: "w-5 h-5 mr-3") %>
        <span><%= t('navigation.bank_accounts') %></span>
      </a>

      <a href="<%= categories_path %>"
          class="mobile-menu-item flex items-center px-4 py-4 rounded-xl text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200">
        <%= icon("folder", library: "lucide", variant: "outline", class: "w-5 h-5 mr-3") %>
        <span><%= t('navigation.categories') %></span>
      </a>

      <a href="<%= transactions_path %>"
          class="mobile-menu-item flex items-center px-4 py-4 rounded-xl text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200">
        <%= icon("receipt", library: "lucide", variant: "outline", class: "w-5 h-5 mr-3") %>
        <span><%= t('navigation.transactions') %></span>
      </a>

      <a href="<%= statement_files_path %>"
          class="mobile-menu-item flex items-center px-4 py-4 rounded-xl text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200">
        <%= icon("file-text", library: "lucide", variant: "outline", class: "w-5 h-5 mr-3") %>
        <span><%= t('navigation.statement_files') %></span>
      </a>

      <a href="<%= goals_path %>"
          class="mobile-menu-item flex items-center px-4 py-4 rounded-xl text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200">
        <%= icon("target", library: "lucide", variant: "outline", class: "w-5 h-5 mr-3") %>
        <span><%= t('navigation.goals') %></span>
      </a>

      <a href="<%= savings_path %>"
          class="mobile-menu-item flex items-center px-4 py-4 rounded-xl text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200">
        <%= icon("piggy-bank", library: "lucide", variant: "outline", class: "w-5 h-5 mr-3") %>
        <span><%= t('navigation.savings') %></span>
      </a>

      <a href="<%= debts_path %>"
          class="mobile-menu-item flex items-center px-4 py-4 rounded-xl text-slate-700 hover:text-red-600 hover:bg-red-50 transition-all duration-200">
        <%= icon("wallet", library: "lucide", variant: "outline", class: "w-5 h-5 mr-3") %>
        <span><%= t('navigation.debts') %></span>
      </a>
    </nav>

    <!-- Mobile User Section -->
    <% if current_user %>
      <div class="flex-shrink-0 flex border-t border-slate-200 p-3">
        <div class="flex items-center w-full">
          <img src="<%= current_user.avatar_url %>?t=<%= Time.current.to_i %>"
                alt="<%= current_user.full_name %>"
                class="w-8 h-8 rounded-full object-cover">
          <div class="ml-3 flex-1">
            <p class="text-sm font-medium text-slate-900 truncate"><%= current_user.full_name %></p>
            <div class="flex items-center space-x-2">
              <%= render 'shared/language_switcher' %>
              <form action="/session" method="post" class="inline">
                <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                <input type="hidden" name="_method" value="delete" />
                <button type="submit" class="p-1 text-slate-500 hover:text-slate-700 transition-colors" title="<%= t('session.sign_out') %>">
                  <%= icon("log-out", library: "lucide", variant: "outline", class: "w-4 h-4") %>
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>