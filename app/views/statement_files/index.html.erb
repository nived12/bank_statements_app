<!-- STATEMENT FILES INDEX PAGE: All Statement Files -->
<div class="statement-files-page" data-controller="delete-confirm">
  <!-- DESKTOP HEADER -->
  <div class="hidden md:block">
    <header class="bg-white border-b border-slate-200 px-8 py-6">
      <div class="max-w-7xl mx-auto flex items-start justify-between">
        <div class="flex-1">
          <h1 class="text-3xl font-bold text-slate-900"><%= t('statement_files.overview') %></h1>
          <p class="text-slate-600 mt-2"><%= t('dashboard.manage_your_bank_statements') %></p>
        </div>
        <div class="flex items-center space-x-3">
          <% if @subscription_allows_upload %>
            <%= link_to new_statement_file_path, class: "inline-flex items-center px-5 py-2.5 bg-indigo-600 text-white rounded-lg font-medium hover:bg-indigo-700 transition-colors shadow-sm" do %>
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
              </svg>
              <%= t('quick_actions.upload_statement') %>
            <% end %>
          <% else %>
            <div class="relative inline-block">
              <span class="inline-flex items-center px-5 py-2.5 bg-slate-300 text-slate-500 rounded-lg font-medium cursor-pointer" onclick="const t=this.nextElementSibling; t.classList.remove('hidden'); setTimeout(() => t.classList.add('hidden'), 3000)">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                </svg>
                <%= t('quick_actions.upload_statement') %>
                <svg class="w-4 h-4 ml-2 text-amber-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 16L3 6l4 3 5-4 5 4 4-3-2 10H5z"/>
                </svg>
              </span>
              <div class="hidden absolute top-full left-1/2 -translate-x-1/2 mt-2 px-3 py-2 bg-gray-900 text-white text-sm rounded-lg shadow-lg whitespace-nowrap z-50">
                <div class="absolute -top-1 left-1/2 -translate-x-1/2 w-2 h-2 bg-gray-900 rotate-45"></div>
                <%= t('statement_files.upload_pro_only') %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </header>
  </div>

  <!-- MOBILE HEADER -->
  <header class="block md:hidden bg-white border-b border-slate-200 px-4 py-4 sticky top-0 z-10">
    <div class="flex items-center justify-between mb-3">
      <h1 class="text-2xl font-bold text-slate-900"><%= t('mobile.statement_files.statement_file') %></h1>
      <% if @subscription_allows_upload %>
        <%= link_to new_statement_file_path, class: "flex items-center justify-center w-10 h-10 bg-indigo-600 text-white rounded-full hover:bg-indigo-700 transition-colors" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path>
          </svg>
        <% end %>
      <% else %>
        <div class="relative">
          <span class="flex items-center justify-center w-10 h-10 bg-slate-300 text-slate-500 rounded-full cursor-pointer" onclick="const t=this.nextElementSibling; t.classList.remove('hidden'); setTimeout(() => t.classList.add('hidden'), 3000)">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path>
            </svg>
            <svg class="w-3.5 h-3.5 text-amber-400 absolute -top-0.5 -right-0.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 16L3 6l4 3 5-4 5 4 4-3-2 10H5z"/>
            </svg>
          </span>
          <div class="hidden absolute top-full right-0 mt-2 px-3 py-2 bg-gray-900 text-white text-sm rounded-lg shadow-lg whitespace-nowrap z-50">
            <div class="absolute -top-1 right-4 w-2 h-2 bg-gray-900 rotate-45"></div>
            <%= t('statement_files.upload_pro_only') %>
          </div>
        </div>
      <% end %>
    </div>
    <p class="text-sm text-slate-600"><%= t('mobile.statement_files.description') %></p>
  </header>

  <div class="statement-files-container">
    <!-- MOBILE STATS: Quick Overview Cards (visible only on mobile) -->
    <turbo-frame id="statement-files-stats" class="statement-files-stats-frame">
      <section class="mobile-statement-files-stats block md:hidden" data-controller="mobile-carousel">
        <div class="mobile-stats-carousel-wrapper">
          <div class="mobile-stats-carousel" data-mobile-carousel-target="container">
            <!-- Total Files Slide -->
            <div class="mobile-stat-slide" data-mobile-carousel-target="slide">
              <div class="mobile-stat-card mobile-stat-card-files">
                <div class="mobile-stat-icon">
                  <svg class="w-8 h-8 mx-auto text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                </div>
                <div class="mobile-stat-content">
                  <span class="mobile-stat-label"><%= t('mobile.statement_files.total_files') %></span>
                  <span class="mobile-stat-value mobile-stat-value-files">
                    <%= @statement_files.count %>
                  </span>
                  <span class="mobile-stat-subtitle">
                    <%= t('mobile.statement_files.in_total') %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Processed Files Slide -->
            <div class="mobile-stat-slide" data-mobile-carousel-target="slide">
              <div class="mobile-stat-card mobile-stat-card-processed">
                <div class="mobile-stat-icon">
                  <svg class="w-8 h-8 mx-auto text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div class="mobile-stat-content">
                  <span class="mobile-stat-label"><%= t('mobile.statement_files.processed') %></span>
                  <span class="mobile-stat-value mobile-stat-value-processed">
                    <%
                      processed_count = @statement_files.select { |f| f.status == 'completed' }.count
                    %>
                    <%= processed_count %>
                  </span>
                  <span class="mobile-stat-subtitle">
                    <%= t('mobile.statement_files.in_total') %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Total Transactions Slide -->
            <div class="mobile-stat-slide" data-mobile-carousel-target="slide">
              <div class="mobile-stat-card mobile-stat-card-transactions">
                <div class="mobile-stat-icon">
                  <svg class="w-8 h-8 mx-auto text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                  </svg>
                </div>
                <div class="mobile-stat-content">
                  <span class="mobile-stat-label"><%= t('table_headers.transactions') %></span>
                  <span class="mobile-stat-value mobile-stat-value-transactions">
                    <%
                      total_transactions = @statement_files.sum { |f| f.transactions.count }
                    %>
                    <%= total_transactions %>
                  </span>
                  <span class="mobile-stat-subtitle">
                    <%= t('mobile.statement_files.in_total') %>
                  </span>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Carousel Indicators -->
          <div class="mobile-carousel-indicators">
            <button class="mobile-carousel-indicator active" data-mobile-carousel-target="indicator" data-index="0" data-action="click->mobile-carousel#goToSlideAction"></button>
            <button class="mobile-carousel-indicator" data-mobile-carousel-target="indicator" data-index="1" data-action="click->mobile-carousel#goToSlideAction"></button>
            <button class="mobile-carousel-indicator" data-mobile-carousel-target="indicator" data-index="2" data-action="click->mobile-carousel#goToSlideAction"></button>
          </div>
        </div>
      </section>
    </turbo-frame>

    <!-- STATEMENT FILES LIST: Grouped by Bank Account -->
    <% if @grouped_by_account.any? %>
      <turbo-frame id="statement-files-list" class="statement-files-list-frame">
        <% @grouped_by_account.each do |(bank_account, files)| %>
          <%= render "account_group", bank_account: bank_account, files: files %>
        <% end %>
      </turbo-frame>
    <% else %>
      <!-- EMPTY STATE: No Statement Files -->
      <div class="statement-files-empty">
        <svg class="statement-files-empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <h3 class="statement-files-empty-title"><%= t('dashboard.no_statement_files_yet') %></h3>
        <p class="statement-files-empty-description"><%= t('dashboard.upload_your_first_statement') %></p>
      </div>
    <% end %>
  </div>

  <%= render "delete_confirm_modal" %>
</div>
