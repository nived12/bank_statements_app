<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <!-- Header -->
  <div class="mb-8 text-center">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100 mb-2">
      <%= t("subscription.upgrade.title") %>
    </h1>
    <p class="text-slate-500 dark:text-slate-400">
      <%= t("subscription.upgrade.iva_note") %>
    </p>
  </div>

  <!-- Current plan status -->
  <div class="mb-8">
    <% if @active_subscription %>
      <div class="rounded-xl bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-700 px-5 py-4 flex items-center gap-3">
        <svg class="w-5 h-5 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <div>
          <p class="text-sm font-semibold text-emerald-800 dark:text-emerald-300">Premium activo</p>
          <% if @active_subscription.ends_at.present? %>
            <p class="text-xs text-emerald-600 dark:text-emerald-400 mt-0.5">
              <%= t("subscription.upgrade.renews_on", date: l(@active_subscription.ends_at, format: :long)) %>
            </p>
          <% end %>
        </div>
      </div>
    <% elsif @trial_ends_at.present? && @trial_ends_at > Time.current %>
      <div class="rounded-xl bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700 px-5 py-4 flex items-center gap-3">
        <svg class="w-5 h-5 text-amber-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <p class="text-sm font-medium text-amber-800 dark:text-amber-300">
          <%= t("subscription.upgrade.trial_ends", date: l(@trial_ends_at, format: :long)) %>
        </p>
      </div>
    <% else %>
      <div class="rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-5 py-4">
        <p class="text-sm text-slate-600 dark:text-slate-400"><%= t("subscription.upgrade.trial_expired") %></p>
      </div>
    <% end %>
  </div>

  <% unless @active_subscription %>
    <!-- Plan selection cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
      <!-- Monthly -->
      <%= form_with url: checkout_subscription_path, method: :post, local: true, data: { turbo: false } do |f| %>
        <%= f.hidden_field :interval, value: "month" %>
        <button type="submit"
                class="w-full text-left p-6 rounded-2xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:border-indigo-400 dark:hover:border-indigo-500 hover:shadow-md transition-all group">
          <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-2">Mensual</p>
          <div class="flex items-end gap-1 mb-1">
            <span class="text-3xl font-bold text-slate-900 dark:text-slate-100">$149</span>
            <span class="text-slate-500 dark:text-slate-400 mb-0.5 text-sm">MXN/mes</span>
          </div>
          <p class="text-xs text-slate-400 dark:text-slate-500"><%= t("subscription.upgrade.iva_note") %></p>
          <div class="mt-4 flex items-center justify-between">
            <span class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 group-hover:underline">
              <%= t("subscription.upgrade.subscribe_monthly") %> →
            </span>
          </div>
        </button>
      <% end %>

      <!-- Annual -->
      <%= form_with url: checkout_subscription_path, method: :post, local: true, data: { turbo: false } do |f| %>
        <%= f.hidden_field :interval, value: "year" %>
        <button type="submit"
                class="w-full text-left p-6 rounded-2xl border-2 border-indigo-600 bg-indigo-600 text-white hover:bg-indigo-700 hover:border-indigo-700 hover:shadow-md transition-all relative overflow-hidden group">
          <span class="absolute top-3 right-3 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-400/20 text-emerald-200">-33%</span>
          <p class="text-xs font-semibold text-indigo-200 uppercase tracking-wide mb-2">Anual</p>
          <div class="flex items-end gap-1 mb-0.5">
            <span class="text-3xl font-bold text-white">$99</span>
            <span class="text-indigo-200 mb-0.5 text-sm">MXN/mes</span>
          </div>
          <p class="text-xs text-indigo-300">$1,188 MXN/año · <%= t("subscription.upgrade.iva_note") %></p>
          <div class="mt-4 flex items-center justify-between">
            <span class="text-sm font-semibold text-white group-hover:underline">
              Ahorra $600 MXN al año →
            </span>
          </div>
        </button>
      <% end %>
    </div>

    <p class="text-center text-xs text-slate-400 dark:text-slate-500 mb-8">Cancela cuando quieras. Sin compromisos.</p>
  <% else %>
    <!-- Active subscriber — manage link -->
    <div class="text-center mb-8">
      <%= link_to t("subscription.upgrade.manage"), portal_subscription_path,
          class: "inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 font-medium text-sm hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors" %>
    </div>
  <% end %>

  <%= link_to "← #{t('navigation.back')}", :back,
      class: "block text-center text-sm text-indigo-600 dark:text-indigo-400 hover:underline" %>
</div>
