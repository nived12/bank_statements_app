<%= turbo_stream.replace "waitlist-form" do %>
  <div id="waitlist-form" class="flex items-center gap-3 p-4 rounded-xl bg-emerald-50 border border-emerald-200">
    <svg class="w-6 h-6 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
    </svg>
    <p class="text-emerald-800 font-medium text-sm"><%= t("landing.waitlist.success") %></p>
  </div>
<% end %>

<%= turbo_stream.replace "waitlist-form-bottom" do %>
  <div id="waitlist-form-bottom" class="flex items-center justify-center gap-3 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20">
    <svg class="w-6 h-6 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
    </svg>
    <p class="text-emerald-300 font-medium text-sm"><%= t("landing.waitlist.success") %></p>
  </div>
<% end %>
