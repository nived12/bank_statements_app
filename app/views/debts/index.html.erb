<div class="debts-page">
  <div class="debts-main">
    <!-- Mobile View -->
    <div class="block md:hidden min-h-screen bg-slate-50 pb-24">
      <!-- Mobile Header -->
      <header class="bg-white border-b border-slate-200 px-4 py-4 sticky top-0 z-10">
        <div class="flex items-center justify-between mb-3">
          <h1 class="text-2xl font-bold text-slate-900"><%= t('debts.title') %></h1>
          <%= link_to new_debt_path, class: "flex items-center justify-center w-10 h-10 bg-red-600 text-white rounded-full hover:bg-red-700 transition-colors" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path>
            </svg>
          <% end %>
        </div>
        <p class="text-sm text-slate-600"><%= t('debts.description') %></p>
      </header>

      <!-- Status Filter Tabs -->
      <div class="bg-white border-b border-slate-200 px-4 sticky top-[73px] z-10">
        <div class="flex space-x-1 overflow-x-auto">
          <%= link_to debts_path(status: "all"),
                      class: "px-4 py-3 text-sm font-medium whitespace-nowrap #{@selected_status == 'all' ? 'text-red-600 border-b-2 border-red-600' : 'text-slate-600 hover:text-slate-900'}" do %>
            <%= t('debts.all_debts') %> <%= content_tag(:span, "(#{@status_counts.values.sum - (@status_counts['archived'] || 0)})", class: "text-xs") %>
          <% end %>
          <%= link_to debts_path(status: "active"),
                      class: "px-4 py-3 text-sm font-medium whitespace-nowrap #{@selected_status == 'active' ? 'text-red-600 border-b-2 border-red-600' : 'text-slate-600 hover:text-slate-900'}" do %>
            <%= t('debts.active_debts') %> <%= content_tag(:span, "(#{@status_counts['active'] || 0})", class: "text-xs") %>
          <% end %>
          <%= link_to debts_path(status: "paid_off"),
                      class: "px-4 py-3 text-sm font-medium whitespace-nowrap #{@selected_status == 'paid_off' ? 'text-red-600 border-b-2 border-red-600' : 'text-slate-600 hover:text-slate-900'}" do %>
            <%= t('debts.paid_off_debts') %> <%= content_tag(:span, "(#{@status_counts['paid_off'] || 0})", class: "text-xs") %>
          <% end %>
          <%= link_to debts_path(status: "paused"),
                      class: "px-4 py-3 text-sm font-medium whitespace-nowrap #{@selected_status == 'paused' ? 'text-red-600 border-b-2 border-red-600' : 'text-slate-600 hover:text-slate-900'}" do %>
            <%= t('debts.paused_debts') %> <%= content_tag(:span, "(#{@status_counts['paused'] || 0})", class: "text-xs") %>
          <% end %>
          <%= link_to debts_path(status: "archived"),
                      class: "px-4 py-3 text-sm font-medium whitespace-nowrap #{@selected_status == 'archived' ? 'text-red-600 border-b-2 border-red-600' : 'text-slate-600 hover:text-slate-900'}" do %>
            <%= t('debts.archived_debts') %> <%= content_tag(:span, "(#{@status_counts['archived'] || 0})", class: "text-xs") %>
          <% end %>
        </div>
      </div>

      <!-- Mobile Content -->
      <div class="px-4 py-4 space-y-3">
        <% if @debts.any? %>
          <% @debts.each do |debt| %>
            <%= link_to debt_path(debt), class: "block bg-white rounded-xl border border-slate-200 p-4 hover:border-red-300 transition-colors", data: { turbo_prefetch: false } do %>
              <div class="flex items-start justify-between mb-3">
                <div class="flex items-center space-x-3">
                  <div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background-color: <%= debt.color %>20">
                    <%= icon_svg(debt.icon, css_classes: "w-6 h-6") %>
                  </div>
                  <div>
                    <h3 class="font-semibold text-slate-900"><%= debt.name %></h3>
                    <p class="text-xs text-slate-500"><%= debt.category&.name || t('debts.no_category') %></p>
                  </div>
                </div>
              </div>

              <!-- Progress Bar -->
              <div class="mb-2">
                <div class="flex justify-between text-xs text-slate-600 mb-1">
                  <span><%= number_to_currency(debt.current_balance) %></span>
                  <span><%= number_to_currency(debt.original_amount) %></span>
                </div>
                <div class="w-full bg-slate-200 rounded-full h-2">
                  <div class="h-full rounded-full transition-all" style="width: <%= [debt.progress_percentage, 100].min %>%; background-color: <%= debt.color %>"></div>
                </div>
              </div>

              <div class="flex items-center justify-between text-xs text-slate-600">
                <span><%= debt.progress_percentage.round %>% paid off</span>
                <span><%= debt.status.humanize %></span>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <!-- Empty State -->
          <div class="text-center py-12">
            <div class="w-20 h-20 bg-red-50 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-10 h-10 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-slate-900 mb-2"><%= t('debts.no_debts_yet') %></h3>
            <p class="text-slate-600 mb-6 px-4"><%= t('debts.create_first_description') %></p>
            <%= link_to new_debt_path, class: "inline-flex items-center px-6 py-3 bg-red-600 text-white rounded-lg font-medium hover:bg-red-700 transition-colors" do %>
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              <%= t('debts.create_debt') %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Desktop View -->
    <div class="hidden md:block min-h-screen bg-slate-50">
      <!-- Header -->
      <header class="bg-white border-b border-slate-200 px-8 py-6">
        <div class="max-w-7xl mx-auto flex items-start justify-between">
          <div class="flex-1">
            <h1 class="text-3xl font-bold text-slate-900"><%= t('debts.manage_debts') %></h1>
            <p class="text-slate-600 mt-2"><%= t('debts.description') %></p>
          </div>
          <%= link_to new_debt_path,
                      class: "inline-flex items-center px-5 py-2.5 bg-red-600 text-white rounded-lg font-medium hover:bg-red-700 transition-colors shadow-sm" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            <%= t('debts.add_debt') %>
          <% end %>
        </div>
      </header>

      <!-- Status Filter Tabs -->
      <div class="bg-white border-b border-slate-200 px-8">
        <div class="max-w-7xl mx-auto">
          <div class="flex space-x-6">
            <%= link_to debts_path(status: "all"),
                        class: "px-1 py-4 text-sm font-medium border-b-2 #{@selected_status == 'all' ? 'text-red-600 border-red-600' : 'text-slate-600 hover:text-slate-900 border-transparent'}" do %>
              <%= t('debts.all_debts') %> <span class="text-xs ml-1">(<%= @status_counts.values.sum - (@status_counts['archived'] || 0) %>)</span>
            <% end %>
            <%= link_to debts_path(status: "active"),
                        class: "px-1 py-4 text-sm font-medium border-b-2 #{@selected_status == 'active' ? 'text-red-600 border-red-600' : 'text-slate-600 hover:text-slate-900 border-transparent'}" do %>
              <%= t('debts.active_debts') %> <span class="text-xs ml-1">(<%= @status_counts['active'] || 0 %>)</span>
            <% end %>
            <%= link_to debts_path(status: "paid_off"),
                        class: "px-1 py-4 text-sm font-medium border-b-2 #{@selected_status == 'paid_off' ? 'text-red-600 border-red-600' : 'text-slate-600 hover:text-slate-900 border-transparent'}" do %>
              <%= t('debts.paid_off_debts') %> <span class="text-xs ml-1">(<%= @status_counts['paid_off'] || 0 %>)</span>
            <% end %>
            <%= link_to debts_path(status: "paused"),
                        class: "px-1 py-4 text-sm font-medium border-b-2 #{@selected_status == 'paused' ? 'text-red-600 border-red-600' : 'text-slate-600 hover:text-slate-900 border-transparent'}" do %>
              <%= t('debts.paused_debts') %> <span class="text-xs ml-1">(<%= @status_counts['paused'] || 0 %>)</span>
            <% end %>
            <%= link_to debts_path(status: "archived"),
                        class: "px-1 py-4 text-sm font-medium border-b-2 #{@selected_status == 'archived' ? 'text-red-600 border-red-600' : 'text-slate-600 hover:text-slate-900 border-transparent'}" do %>
              <%= t('debts.archived_debts') %> <span class="text-xs ml-1">(<%= @status_counts['archived'] || 0 %>)</span>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Debts Grid -->
      <div class="max-w-7xl mx-auto px-8 py-8">
        <% if @debts.any? %>
          <div id="debts-list" class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6">
            <% @debts.each do |debt| %>
              <%= render 'debt_card', debt: debt %>
            <% end %>
          </div>
        <% else %>
          <!-- Empty State -->
          <div class="text-center py-16">
            <div class="mx-auto w-24 h-24 bg-slate-100 rounded-full flex items-center justify-center mb-4">
              <svg class="w-12 h-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
              </svg>
            </div>
            <h3 class="text-lg font-medium text-slate-900 mb-2"><%= t('debts.no_debts_yet') %></h3>
            <p class="text-slate-600 mb-6"><%= t('debts.create_first_description') %></p>
            <%= link_to t('debts.create_first'), new_debt_path,
                        class: "inline-flex items-center px-5 py-2.5 bg-red-600 text-white rounded-lg font-medium hover:bg-red-700 transition-colors shadow-sm" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
