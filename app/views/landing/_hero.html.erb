<section class="relative overflow-hidden pt-24 pb-16 md:pt-32 md:pb-24" id="hero">
  <!-- Background gradient -->
  <div class="absolute inset-0 bg-gradient-to-br from-sky-50 via-indigo-50/50 to-white -z-10"></div>
  <div class="absolute top-0 right-0 w-1/2 h-1/2 bg-gradient-to-bl from-indigo-100/40 to-transparent rounded-full blur-3xl -z-10"></div>
  <div class="absolute bottom-0 left-0 w-1/3 h-1/3 bg-gradient-to-tr from-sky-100/40 to-transparent rounded-full blur-3xl -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left: Copy + CTA -->
      <div class="max-w-xl" data-landing-scroll-target="section">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-100/80 text-indigo-700 text-xs font-semibold mb-6 tracking-wide">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-pulse"></span>
          <%= t("landing.hero.badge") %>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight leading-[1.1]">
          <%= t("landing.hero.title") %>
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-slate-600 dark:text-slate-400 leading-relaxed">
          <%= t("landing.hero.subtitle") %>
        </p>

        <!-- Waitlist form -->
        <div class="mt-8" id="waitlist-form">
          <%= render "landing/waitlist_form", waitlist: @waitlist %>
        </div>

        <p class="mt-4 text-sm text-slate-500">
          <%= t("landing.hero.disclaimer") %>
        </p>
      </div>

      <!-- Right: App screenshot -->
      <div class="relative" data-landing-scroll-target="section">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl shadow-slate-900/10 border border-slate-200/50 bg-white">
          <%= image_tag "landing/dashboard.png",
                alt: t("landing.hero.screenshot_alt"),
                class: "w-full h-auto",
                loading: "eager" %>
        </div>
        <!-- Decorative elements -->
        <div class="absolute -bottom-4 -right-4 w-24 h-24 bg-indigo-500/10 rounded-2xl -z-10"></div>
        <div class="absolute -top-4 -left-4 w-16 h-16 bg-sky-500/10 rounded-2xl -z-10"></div>
      </div>
    </div>
  </div>
</section>
