<!-- TRANSACTIONS PAGE: Transaction Management -->
<main class="transactions-page">
  <div class="transactions-main">
    
    <!-- HEADER SECTION: Page Title and Actions -->
    <header class="transactions-header">
      <div class="transactions-header-actions">
        <div class="transactions-header-left">
          <h1 class="transactions-header-title"><%= t('transactions_title') %></h1>
          <p class="transactions-header-subtitle"><%= t('transactions_description') %></p>
        </div>
        <div class="transactions-header-right">
          <%= link_to new_statement_file_path, class: "transactions-button transactions-button-primary" do %>
            <svg class="transactions-button-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
            </svg>
            <%= t('upload_statement') %>
          <% end %>
        </div>
      </div>
    </header>

    <!-- FILTER SECTION: Search and Filter Options -->
    <section class="transactions-filters">
      <h3 class="transactions-filters-title"><%= t('filter_transactions') %></h3>
      <%= form_with url: transactions_path, method: :get, local: true, class: "transactions-filters-form" do %>
        <div class="transactions-filter-group">
          <label for="bank_account_id" class="transactions-filter-label"><%= t('bank_account_filter') %></label>
          <div class="flex flex-wrap gap-3">
            <select name="bank_account_id" id="bank_account_id" class="transactions-filter-select w-auto max-w-md" onchange="this.form.submit()">
              <option value=""><%= t('all_accounts') %></option>
              <% @bank_accounts.each do |ba| %>
                <option value="<%= ba.id %>" <%= "selected" if params[:bank_account_id].to_s == ba.id.to_s %>>
                  <%= ba.bank_display_name %> - ••••<%= ba.account_number.last(4) %>
                </option>
              <% end %>
            </select>
            
            <% if params[:bank_account_id].present? %>
              <%= link_to transactions_path, class: "transactions-filter-button" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
                <%= t('clear_filter') %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </section>

    <!-- STATS OVERVIEW: Transaction Statistics -->
    <section class="transactions-stats">
      
      <!-- TOTAL TRANSACTIONS STAT -->
      <div class="transactions-stat-card">
        <div class="transactions-stat-content">
          <div class="transactions-stat-icon transactions-stat-icon-total">
            <svg class="transactions-stat-icon-svg transactions-stat-icon-svg-total" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
          <div>
            <p class="transactions-stat-label"><%= t('transactions') %></p>
            <p class="transactions-stat-value transactions-stat-value-total"><%= @pagy.count %></p>
          </div>
        </div>
      </div>

      <!-- INCOME STAT -->
      <div class="transactions-stat-card">
        <div class="transactions-stat-content">
          <div class="transactions-stat-icon transactions-stat-icon-income">
            <svg class="transactions-stat-icon-svg transactions-stat-icon-svg-income" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
            </svg>
          </div>
          <div>
            <p class="transactions-stat-label"><%= t('income') %></p>
            <p class="transactions-stat-value transactions-stat-value-income">
              <%= number_to_currency(current_user.transactions.where(transaction_type: 'income').sum(:amount), unit: "$") %>
            </p>
          </div>
        </div>
      </div>

      <!-- EXPENSES STAT -->
      <div class="transactions-stat-card">
        <div class="transactions-stat-content">
          <div class="transactions-stat-icon transactions-stat-icon-expenses">
            <svg class="transactions-stat-icon-svg transactions-stat-icon-svg-expenses" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <div>
            <p class="transactions-stat-label"><%= t('expenses') %></p>
            <p class="transactions-stat-value transactions-stat-value-expenses">
              <%= number_to_currency(current_user.transactions.where(transaction_type: ['fixed_expense', 'variable_expense']).sum(:amount), unit: "$") %>
            </p>
          </div>
        </div>
      </div>

      <!-- CATEGORIES STAT -->
      <div class="transactions-stat-card">
        <div class="transactions-stat-content">
          <div class="transactions-stat-icon transactions-stat-icon-total">
            <svg class="transactions-stat-icon-svg transactions-stat-icon-svg-total" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
            </svg>
          </div>
          <div>
            <p class="transactions-stat-label"><%= t('categories') %></p>
            <p class="transactions-stat-value transactions-stat-value-total">
              <%= current_user.categories.count %>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- TRANSACTIONS TABLE: Transaction List -->
    <% if @transactions.any? %>
      <section class="transactions-table-container">
        <div class="overflow-x-auto">
          <table class="transactions-table">
            <thead class="transactions-table-header">
              <tr>
                <th class="transactions-table-header-row">
                  <span class="text-slate-700 font-medium">#</span>
                </th>
                <th class="transactions-table-header-row">
                  <%= link_to transactions_path(sort: 'date', direction: @current_sort == 'date' && @current_direction == 'desc' ? 'asc' : 'desc', bank_account_id: params[:bank_account_id]), class: "transactions-table-header-sortable" do %>
                    <%= t('table_headers.date') %>
                    <%= render_sort_indicator('date') %>
                  <% end %>
                </th>
                <th class="transactions-table-header-row">
                  <%= link_to transactions_path(sort: 'description', direction: @current_sort == 'description' && @current_direction == 'desc' ? 'asc' : 'desc', bank_account_id: params[:bank_account_id]), class: "transactions-table-header-sortable" do %>
                    <%= t('table_headers.description') %>
                    <%= render_sort_indicator('description') %>
                  <% end %>
                </th>
                <th class="transactions-table-header-row transactions-table-header-row-right">
                  <%= link_to transactions_path(sort: 'amount', direction: @current_sort == 'amount' && @current_direction == 'desc' ? 'asc' : 'desc', bank_account_id: params[:bank_account_id]), class: "transactions-table-header-sortable" do %>
                    <%= t('amount') %>
                    <%= render_sort_indicator('amount') %>
                  <% end %>
                </th>
                <th class="transactions-table-header-row">
                  <%= link_to transactions_path(sort: 'transaction_type', direction: @current_sort == 'transaction_type' && @current_direction == 'desc' ? 'asc' : 'desc', bank_account_id: params[:bank_account_id]), class: "transactions-table-header-sortable" do %>
                    <%= t('transaction_type') %>
                    <%= render_sort_indicator('transaction_type') %>
                  <% end %>
                </th>
                <th class="transactions-table-header-row">
                  <%= link_to transactions_path(sort: 'category', direction: @current_sort == 'category' && @current_direction == 'desc' ? 'asc' : 'desc', bank_account_id: params[:bank_account_id]), class: "transactions-table-header-sortable" do %>
                    <%= t('category') %>
                    <%= render_sort_indicator('category') %>
                  <% end %>
                </th>
                <th class="transactions-table-header-row"><%= t('actions') %></th>
              </tr>
            </thead>
            <tbody class="transactions-table-body" id="transactions-tbody">
              <% @transactions.each.with_index(1) do |transaction, index| %>
                <tr class="transactions-table-row">
                  <td class="transactions-table-cell">
                    <span class="transactions-table-cell-text text-slate-500 font-medium">
                      <%= index %>
                    </span>
                  </td>
                  <td class="transactions-table-cell">
                    <span class="transactions-table-cell-text">
                      <%= l(transaction.date, format: :transaction) %>
                    </span>
                  </td>
                  <td class="transactions-table-cell">
                    <div>
                      <div class="transactions-table-cell-text"><%= transaction.description %></div>
                      <% if transaction.bank_account %>
                        <div class="transactions-table-cell-account">
                          <%= transaction.bank_account.bank_display_name %> - ••••<%= transaction.bank_account.account_number.last(4) %>
                        </div>
                      <% end %>
                    </div>
                  </td>
                  <td class="transactions-table-cell transactions-table-cell-amount">
                    <span class="<%= transaction.transaction_type == 'income' ? 'transactions-table-cell-amount-credit' : 'transactions-table-cell-amount-debit' %>">
                      <%= format_currency(transaction.amount) %>
                    </span>
                  </td>
                  <td class="transactions-table-cell">
                    <span class="transactions-category">
                      <%= transaction.transaction_type.humanize %>
                    </span>
                  </td>
                  <td class="transactions-table-cell">
                    <% if transaction.category %>
                      <div class="flex flex-col">
                        <% if transaction.category.parent %>
                          <!-- Parent category -->
                          <span class="transactions-category transactions-category-parent">
                            <%= transaction.category.parent.name %>
                          </span>
                          <!-- Child category -->
                          <span class="transactions-category transactions-category-child">
                            <%= transaction.category.name %>
                          </span>
                        <% else %>
                          <!-- Parent category only (no subcategory) -->
                          <span class="transactions-category transactions-category-parent">
                            <%= transaction.category.name %>
                          </span>
                        <% end %>
                      </div>
                    <% else %>
                      <span class="transactions-category-empty"><%= t('no_category') %></span>
                    <% end %>
                  </td>
                  <td class="transactions-table-cell">
                    <div class="transactions-actions">
                      <button onclick="openEditModal('<%= transaction.id %>')" class="transactions-action-btn transactions-action-btn-edit" title="<%= t('edit_transaction') %>">
                        <svg class="transactions-action-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                        </svg>
                      </button>
                      <% if transaction.statement_file %>
                        <div class="relative group">
                          <%= link_to statement_file_path(transaction.statement_file), class: "block" do %>
                            <div class="w-6 h-6 bg-blue-100 rounded-full flex items-center justify-center cursor-pointer hover:bg-blue-200 transition-colors duration-200">
                              <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                              </svg>
                            </div>
                          <% end %>
                          <!-- Tooltip -->
                          <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-2 bg-slate-900 text-white text-xs rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none whitespace-nowrap z-10">
                            <div class="text-center">
                              <div class="font-medium mb-1"><%= t('statement_file') %></div>
                              <div class="text-slate-200"><%= transaction.statement_file.file.filename.to_s %></div>
                              <div class="text-slate-300 text-xs mt-1"><%= t('click_to_view_details') %></div>
                            </div>
                            <!-- Tooltip arrow -->
                            <div class="absolute top-full left-1/2 transform -translate-x-1/2 w-0 h-0 border-l-4 border-r-4 border-t-4 border-transparent border-t-slate-900"></div>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
          
          <!-- Visible element for intersection observer -->
          <div id="scroll-trigger" class="h-4 w-full bg-transparent"></div>
          
          <!-- Pagination Indicator -->
          <div class="mt-6 text-center" 
               id="infinite-scroll-container"
               data-next-page="<%= @pagy.next || (@pagy.page < @pagy.pages ? @pagy.page + 1 : '') %>"
               data-current-page="<%= @pagy.page %>"
               data-total-pages="<%= @pagy.pages %>"
               data-total-count="<%= @pagy.count %>">
            <div class="text-sm text-slate-600 mb-2" id="pagination-info">
              <%= t('showing_page') %> <%= @pagy.page %> <%= t('of') %> <%= @pagy.pages %> 
              (<%= t('transactions_loaded') %>: <span id="transactions-loaded-count"><%= @transactions.count %></span> / <%= t('total_transactions') %>: <%= @pagy.count %>)
            </div>
            
            <!-- Loading indicator for infinite scroll -->
            <div id="infinite-scroll-indicator" class="hidden">
              <div class="inline-flex items-center px-4 py-2 text-sm text-slate-600">
                <svg class="animate-spin h-4 w-4 mr-2" xmlns="http://www/w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <%= t('loading') %>
              </div>
            </div>
          </div>
        </div>
      </section>
    <% else %>
      
      <!-- EMPTY STATE: No Transactions Yet -->
      <section class="transactions-empty">
        <div class="w-24 h-24 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-12 h-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
        </div>
        <h3 class="transactions-empty-title"><%= t('no_transactions_yet') %></h3>
        <p class="transactions-empty-description"><%= t('upload_statement_help') %></p>
        <%= link_to new_statement_file_path, class: "transactions-empty-action" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
          </svg>
          <%= t('upload_statement') %>
        <% end %>
      </section>
    <% end %>
  </div>
</main>

<!-- EDIT TRANSACTION MODAL: Transaction Edit Form -->
<div id="editModal" class="fixed inset-0 bg-slate-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-50">
  <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
    <div class="mt-3">
      <h3 class="text-lg font-medium text-slate-900 mb-4"><%= t('edit_transaction') %></h3>
      <form id="editForm" method="post" class="space-y-4">
        <input type="hidden" name="_method" value="patch">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2"><%= t('merchant') %></label>
          <input type="text" name="transaction[merchant]" id="edit_merchant" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
        </div>
        
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2"><%= t('reference') %></label>
          <input type="text" name="transaction[reference]" id="edit_reference" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
        </div>
        
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2"><%= t('transaction_type') %></label>
          <select name="transaction[transaction_type]" id="edit_transaction_type" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
            <% Transaction.transaction_types.keys.each do |opt| %>
              <option value="<%= opt %>"><%= opt.humanize %></option>
            <% end %>
          </select>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2"><%= t('category') %></label>
          <select name="transaction[category_id]" id="edit_category_id" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
            <option value=""><%= t('no_category') %></option>
            <% current_user.categories.order(:name).each do |cat| %>
              <option value="<%= cat.id %>"><%= cat.name %></option>
            <% end %>
          </select>
        </div>
        
        <div class="flex justify-end space-x-3 pt-4">
          <button type="button" onclick="closeEditModal()" class="px-4 py-2 border border-slate-300 text-sm font-medium rounded-lg text-slate-700 bg-white hover:bg-slate-50 transition-colors duration-200">
            <%= t('cancel') %>
          </button>
          <button type="submit" class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors duration-200">
            <%= t('save_changes') %>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function openEditModal(transactionId) {
  // Set the form action
  document.getElementById('editForm').action = `<%= root_path %>transactions/${transactionId}`;
  
  // Show the modal
  document.getElementById('editModal').classList.remove('hidden');
}

function closeEditModal() {
  document.getElementById('editModal').classList.add('hidden');
}

// Close modal when clicking outside
document.getElementById('editModal').addEventListener('click', function(e) {
  if (e.target === this) {
    closeEditModal();
  }
});

// Infinite Scrolling for Transactions
let isLoading = false;
let currentObserver = null;

function setupInfiniteScroll() {
  console.log("Setting up infinite scroll...");
  
  const container = document.getElementById('infinite-scroll-container');
  if (!container) {
    console.log("No infinite scroll container found");
    return;
  }
  
  const nextPage = parseInt(container.dataset.nextPage);
  const totalPages = parseInt(container.dataset.totalPages);
  
  if (!nextPage || nextPage > totalPages) {
    console.log("No next page available");
    return;
  }
  
  console.log(`Setting up infinite scroll for page ${nextPage} of ${totalPages}`);
  
  // Clean up existing observer if any
  if (currentObserver) {
    currentObserver.disconnect();
  }
  
  // Set up intersection observer for infinite scrolling
  currentObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !isLoading) {
        // Check if we still have more pages before triggering
        const container = document.getElementById('infinite-scroll-container');
        if (container) {
          const nextPage = parseInt(container.dataset.nextPage);
          const totalPages = parseInt(container.dataset.totalPages);
          
          if (nextPage && nextPage <= totalPages) {
            console.log("Scroll trigger visible, loading more transactions...");
            loadMoreTransactions();
          } else {
            console.log("No more pages available, not triggering load");
          }
        }
      }
    });
  }, {
    rootMargin: '100px' // Start loading 100px before reaching the trigger
  });

  // Observe the scroll trigger element
  const scrollTrigger = document.getElementById('scroll-trigger');
  if (scrollTrigger) {
    currentObserver.observe(scrollTrigger);
    console.log("Observer set up for scroll trigger");
  } else {
    console.log("No scroll trigger found");
  }
}

function loadMoreTransactions() {
  if (isLoading) {
    console.log("Already loading, skipping request");
    return;
  }
  
  const container = document.getElementById('infinite-scroll-container');
  if (!container) return;
  
  const nextPage = parseInt(container.dataset.nextPage);
  const totalPages = parseInt(container.dataset.totalPages);
  
  if (!nextPage || nextPage > totalPages) {
    console.log("No next page available, stopping infinite scroll");
    // Hide the scroll trigger when no more pages
    const scrollTrigger = document.getElementById('scroll-trigger');
    if (scrollTrigger) {
      scrollTrigger.style.display = 'none';
    }
    return;
  }
  
  console.log(`Loading page ${nextPage}`);
  isLoading = true;
  
  // Show loading state
  const indicator = document.getElementById('infinite-scroll-indicator');
  if (indicator) {
    indicator.classList.remove('hidden');
  }

  // Build URL with current filters and sorting
  const url = new URL(window.location);
  url.searchParams.set('page', nextPage);
  
  fetch(url, {
    headers: {
      'X-Requested-With': 'XMLHttpRequest',
      'Accept': 'text/html'
    }
  })
  .then(response => {
    if (!response.ok) {
      throw new Error(`HTTP error! status: ${response.status}`);
    }
    return response.text();
  })
  .then(html => {
    console.log("Received response, length:", html.length);
    
    // Append new rows to the table
    const tbody = document.getElementById('transactions-tbody');
    if (tbody) {
      tbody.insertAdjacentHTML('beforeend', html);
    }
    
    // Update container state
    container.dataset.currentPage = nextPage.toString();
    
    // Check if there are more pages
    if (nextPage >= totalPages) {
      console.log("No more pages, hiding scroll trigger");
      // Hide the scroll trigger when no more pages
      const scrollTrigger = document.getElementById('scroll-trigger');
      if (scrollTrigger) {
        scrollTrigger.style.display = 'none';
      }
      // Also disconnect the observer
      if (currentObserver) {
        currentObserver.disconnect();
        currentObserver = null;
      }
    } else {
      // Update next page for next load
      const newNextPage = nextPage + 1;
      container.dataset.nextPage = newNextPage.toString();
      console.log(`Updated next page to ${newNextPage}`);
    }
    
    // Update pagination info
    updatePaginationInfo(nextPage);
  })
  .catch(error => {
    console.error('Error loading more transactions:', error);
  })
  .finally(() => {
    // Hide loading indicator
    if (indicator) {
      indicator.classList.add('hidden');
    }
    isLoading = false;
  });
}

function updatePaginationInfo(currentPage) {
  const container = document.getElementById('infinite-scroll-container');
  const totalPages = parseInt(container.dataset.totalPages);
  const totalCount = parseInt(container.dataset.totalCount);
  
  // Count actual loaded transactions
  const tbody = document.getElementById('transactions-tbody');
  const loadedCount = tbody ? tbody.querySelectorAll('tr').length : 0;
  
  console.log(`Updating pagination: currentPage=${currentPage}, totalPages=${totalPages}, loadedCount=${loadedCount}`);
  
  const paginationInfo = document.getElementById('pagination-info');
  if (paginationInfo) {
    paginationInfo.innerHTML = `
      Mostrando página ${currentPage} de ${totalPages} 
      (Transacciones cargadas: ${loadedCount} / Total de transacciones: ${totalCount})
    `;
  }
  
  // Also update the container's current page data attribute
  container.dataset.currentPage = currentPage.toString();
}

// Initialize infinite scrolling when the page loads
// This works for both direct navigation and Turbo Drive navigation
function initializeInfiniteScroll() {
  // Clean up any existing setup first
  if (currentObserver) {
    currentObserver.disconnect();
    currentObserver = null;
  }
  isLoading = false;
  
  // Set up the infinite scroll
  setupInfiniteScroll();
}

document.addEventListener('DOMContentLoaded', initializeInfiniteScroll);

// Also listen for Turbo Drive events to handle navigation
document.addEventListener('turbo:load', initializeInfiniteScroll);
document.addEventListener('turbo:render', initializeInfiniteScroll);

// Fallback: if none of the above events fire, try to set up after a short delay
setTimeout(initializeInfiniteScroll, 100);
</script>
