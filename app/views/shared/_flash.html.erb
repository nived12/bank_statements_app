<div id="flash-container" class="fixed top-4 right-4 z-50 space-y-2 max-w-sm">
  <% flash.each do |type, message| %>
    <% next if message.blank? %>
    <div data-controller="flash"
         data-flash-auto-dismiss-value="true"
         data-flash-dismiss-after-value="5000"
         class="<%= flash_class(type) %> rounded-lg shadow-lg p-4 flex items-start transition-all duration-300 ease-in-out transform">
      <div class="flex-shrink-0">
        <%= flash_icon(type) %>
      </div>
      <div class="ml-3 flex-1">
        <p class="<%= flash_text_class(type) %>">
          <%= message %>
        </p>
      </div>
      <div class="ml-4 flex-shrink-0 flex">
        <button type="button"
                data-action="click->flash#dismiss"
                class="inline-flex <%= flash_button_class(type) %> focus:outline-none focus:ring-2 focus:ring-offset-2 rounded-md">
          <span class="sr-only">Close</span>
          <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>
    </div>
  <% end %>
</div>
