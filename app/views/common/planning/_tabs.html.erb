<div class="border-b border-slate-200">
  <div class="flex space-x-1 overflow-x-auto">
    <%= link_to debts_path(status: "all"),
                class: "px-4 py-3 text-sm font-medium whitespace-nowrap #{@selected_status == 'all' ? 'text-blue-600 border-b-2 border-blue-600' : 'text-slate-600 hover:text-slate-900'}" do %>
      <%= t('debts.all_debts') %> <%= content_tag(:span, "(#{@status_counts.values.sum - (@status_counts['archived'] || 0)})", class: "text-xs") %>
    <% end %>
    <%= link_to debts_path(status: "active"),
                class: "px-4 py-3 text-sm font-medium whitespace-nowrap #{@selected_status == 'active' ? 'text-blue-600 border-b-2 border-blue-600' : 'text-slate-600 hover:text-slate-900'}" do %>
      <%= t('debts.active_debts') %> <%= content_tag(:span, "(#{@status_counts['active'] || 0})", class: "text-xs") %>
    <% end %>
    <%= link_to debts_path(status: "completed"),
                class: "px-4 py-3 text-sm font-medium whitespace-nowrap #{@selected_status == 'completed' ? 'text-blue-600 border-b-2 border-blue-600' : 'text-slate-600 hover:text-slate-900'}" do %>
      <%= t('debts.completed_debts') %> <%= content_tag(:span, "(#{@status_counts['completed'] || 0})", class: "text-xs") %>
    <% end %>
    <%= link_to debts_path(status: "archived"),
                class: "px-4 py-3 text-sm font-medium whitespace-nowrap #{@selected_status == 'archived' ? 'text-blue-600 border-b-2 border-blue-600' : 'text-slate-600 hover:text-slate-900'}" do %>
      <%= t('debts.archived_debts') %> <%= content_tag(:span, "(#{@status_counts['archived'] || 0})", class: "text-xs") %>
    <% end %>
  </div>
</div>