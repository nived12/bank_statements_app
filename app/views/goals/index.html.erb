<div class="goals-page">
  <main class="goals-main">
    <!-- Mobile View -->
    <div class="block md:hidden min-h-screen bg-slate-50 pb-24">
      <!-- Mobile Header -->
      <header class="bg-white border-b border-slate-200 px-4 py-4 sticky top-0 z-10">
        <div class="flex items-center justify-between mb-3">
          <h1 class="text-2xl font-bold text-slate-900"><%= t('goals.title') %></h1>
          <%= link_to new_goal_path, class: "flex items-center justify-center w-10 h-10 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition-colors" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path>
            </svg>
          <% end %>
        </div>
        <p class="text-sm text-slate-600"><%= t('goals.description') %></p>
      </header>

      <!-- Mobile Content -->
      <div class="px-4 py-4 space-y-6">
        <% if @goals.any? %>
          <!-- Active Goals -->
          <% if @active_goals.any? %>
            <div>
              <h2 class="text-lg font-semibold text-slate-900 mb-3"><%= t('goals.active_goals') %> (<%= @active_goals.count %>)</h2>
              <div class="space-y-3">
                <% @active_goals.each do |goal| %>
                  <%= link_to goal_path(goal), class: "block bg-white rounded-xl border border-slate-200 p-4 hover:border-blue-300 transition-colors", data: { turbo_prefetch: false } do %>
                    <div class="flex items-start justify-between mb-3">
                      <div class="flex items-center space-x-3">
                        <div class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl" style="background-color: <%= goal.color %>20;">
                          <%= goal.icon %>
                        </div>
                        <div>
                          <h3 class="font-semibold text-slate-900"><%= goal.name %></h3>
                          <p class="text-xs text-slate-500"><%= t("goals.types.#{goal.goal_type}") %></p>
                        </div>
                      </div>
                    </div>

                    <!-- Progress Bar -->
                    <div class="mb-2">
                      <div class="flex justify-between text-xs text-slate-600 mb-1">
                        <span><%= number_to_currency(goal.current_amount) %></span>
                        <span><%= number_to_currency(goal.target_amount) %></span>
                      </div>
                      <div class="w-full bg-slate-200 rounded-full h-2">
                        <div class="h-full rounded-full transition-all" style="width: <%= [goal.progress_percentage, 100].min %>%; background-color: <%= goal.color %>"></div>
                      </div>
                    </div>

                    <div class="flex items-center justify-between text-xs text-slate-600">
                      <span><%= goal.progress_percentage.round %>% complete</span>
                      <span><%= goal.days_remaining %> days left</span>
                    </div>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>

          <!-- Completed Goals -->
          <% if @completed_goals.any? %>
            <div>
              <h2 class="text-lg font-semibold text-slate-900 mb-3"><%= t('goals.completed_goals') %> (<%= @completed_goals.count %>)</h2>
              <div class="space-y-3">
                <% @completed_goals.each do |goal| %>
                  <%= link_to goal_path(goal), class: "block bg-white rounded-xl border border-slate-200 p-4 opacity-75", data: { turbo_prefetch: false } do %>
                    <div class="flex items-center space-x-3">
                      <div class="w-10 h-10 rounded-lg flex items-center justify-center text-xl" style="background-color: <%= goal.color %>20;">
                        <%= goal.icon %>
                      </div>
                      <div class="flex-1">
                        <h3 class="font-medium text-slate-900"><%= goal.name %></h3>
                        <p class="text-xs text-green-600"><%= t('goals.status.completed') %></p>
                      </div>
                    </div>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <!-- Empty State -->
          <div class="text-center py-12">
            <div class="w-20 h-20 bg-blue-50 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-10 h-10 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-slate-900 mb-2"><%= t('goals.no_goals_yet') %></h3>
            <p class="text-slate-600 mb-6 px-4"><%= t('goals.create_first_description') %></p>
            <%= link_to new_goal_path, class: "inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition-colors" do %>
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              <%= t('goals.create_goal') %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Desktop View -->
    <div class="hidden md:block min-h-screen bg-slate-50">
      <!-- Header -->
      <header class="bg-white border-b border-slate-200 px-8 py-6">
        <div class="max-w-7xl mx-auto flex items-start justify-between">
          <div class="flex-1">
            <h1 class="text-3xl font-bold text-slate-900"><%= t('goals.manage_goals') %></h1>
            <p class="text-slate-600 mt-2"><%= t('goals.description') %></p>
          </div>
          <%= link_to new_goal_path,
                      class: "inline-flex items-center px-5 py-2.5 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition-colors shadow-sm" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            <%= t('goals.add_goal') %>
          <% end %>
        </div>
      </header>

      <!-- Goals Grid -->
      <div class="max-w-7xl mx-auto px-8 py-8">
        <% if @goals.any? %>
          <!-- Active Goals -->
          <% if @active_goals.any? %>
            <div class="mb-8">
              <h2 class="text-xl font-semibold text-slate-900 mb-4"><%= t('goals.active_goals') %></h2>
              <div id="active-goals-list" class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6">
                <% @active_goals.each do |goal| %>
                  <%= render 'goal_card', goal: goal %>
                <% end %>
              </div>
            </div>
          <% end %>

          <!-- Completed Goals -->
          <% if @completed_goals.any? %>
            <div class="mb-8">
              <h2 class="text-xl font-semibold text-slate-900 mb-4"><%= t('goals.completed_goals') %></h2>
              <div id="completed-goals-list" class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6">
                <% @completed_goals.each do |goal| %>
                  <%= render 'goal_card', goal: goal %>
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <!-- Empty State -->
          <div class="text-center py-16">
            <div class="mx-auto w-24 h-24 bg-slate-100 rounded-full flex items-center justify-center mb-4">
              <svg class="w-12 h-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
              </svg>
            </div>
            <h3 class="text-lg font-medium text-slate-900 mb-2"><%= t('goals.no_goals_yet') %></h3>
            <p class="text-slate-600 mb-6"><%= t('goals.create_first_description') %></p>
            <%= link_to t('goals.create_first'), new_goal_path,
                        class: "inline-flex items-center px-5 py-2.5 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition-colors shadow-sm" %>
          </div>
        <% end %>
      </div>
    </div>
  </main>
</div>
