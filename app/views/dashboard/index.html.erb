<!-- DASHBOARD PAGE: Financial Overview -->
<div class="dashboard-page" data-controller="dashboard-charts recurring-suggestions">
  
  <!-- HIDDEN DATA: Chart Data for JavaScript -->
  <input type="hidden" id="spending-data" value="<%= (@chart_data[:spending_trends] || []).to_json %>">
  <input type="hidden" id="balance-data" value="<%= (@chart_data[:bank_summaries] || []).to_json %>">
  


  <!-- HIDDEN TRANSLATIONS: Chart Labels for JavaScript -->
  <input type="hidden" id="translations" value="<%= {
        account_balances: t('account_balances.title'),
        monthly_spending: t('spending_trends.title'),
        unknown: t('statement_files.unknown'),
        no_bank_accounts: t('account_balances.no_accounts'),
        spending: t('spending_trends.title'),
        spending_trends: t('spending_trends.title'),
        chart_render_error: t('dashboard.index.chart_render_error')
  }.to_json %>">

  <%# Compute month list once for both desktop and mobile selectors %>
  <%
    months_list = @available_months || []
    unless months_list.include?(@selected_month)
      months_list = [@selected_month] + months_list
      months_list = months_list.uniq.sort.reverse
    end
  %>

  <!-- DESKTOP HEADER -->
  <div class="hidden md:block">
    <header class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 px-8 py-6">
      <div class="max-w-7xl mx-auto flex items-start justify-between">
        <div class="flex-1">
          <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100"><%= t('dashboard.title') %></h1>
          <p class="text-slate-600 dark:text-slate-400 mt-2"><%= t('dashboard.subtitle') %></p>
        </div>
        <div class="flex items-center space-x-3">
          <%# Month picker controls %>
          <div class="flex flex-col items-center">
            <div class="flex items-center space-x-1">
              <button type="button" onclick="previousMonth()" class="p-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:bg-slate-700 dark:hover:bg-slate-700 rounded-lg transition-colors" title="<%= t('month_picker.previous_month') %>">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
              </button>
              <select id="month-selector" class="text-sm px-3 py-1.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" onchange="changeMonth(this.value)">
                <% if months_list.any? %>
                  <% months_list.each do |month| %>
                    <option value="<%= month.strftime('%Y-%m') %>"
                            <%= 'selected' if month.strftime('%Y-%m') == @selected_month.strftime('%Y-%m') %>>
                      <%= l(month, format: :month_year) %>
                    </option>
                  <% end %>
                <% else %>
                  <%= current_month_option %>
                <% end %>
              </select>
              <button type="button" onclick="nextMonth()" class="p-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:bg-slate-700 dark:hover:bg-slate-700 rounded-lg transition-colors" title="<%= t('month_picker.next_month') %>">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </button>
              <button type="button" onclick="jumpToCurrentMonth()" class="p-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:bg-slate-700 dark:hover:bg-slate-700 rounded-lg transition-colors" title="<%= t('month_picker.jump_to_current_month') %>">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                </svg>
              </button>
            </div>
          </div>
          <!-- PDF Report Download — uses the dashboard month picker, no secondary picker -->
          <button type="button"
                  data-controller="report-download"
                  data-action="click->report-download#downloadFromDashboard"
                  class="inline-flex items-center px-4 py-2.5 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-600 rounded-lg font-medium hover:bg-slate-50 dark:hover:bg-slate-700 dark:bg-slate-900 transition-colors shadow-sm text-sm">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <%= t("reports.download_pdf") %>
          </button>

          <% if @subscription_allows_upload %>
            <%= link_to new_statement_file_path, class: "inline-flex items-center px-5 py-2.5 bg-indigo-600 text-white rounded-lg font-medium hover:bg-indigo-700 transition-colors shadow-sm" do %>
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
              </svg>
              <%= t('quick_actions.upload_statement') %>
            <% end %>
          <% else %>
            <div class="relative inline-block">
              <span class="inline-flex items-center px-5 py-2.5 bg-slate-300 text-slate-500 dark:text-slate-400 rounded-lg font-medium cursor-pointer" onclick="const t=this.nextElementSibling; t.classList.remove('hidden'); setTimeout(() => t.classList.add('hidden'), 3000)">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                </svg>
                <%= t('quick_actions.upload_statement') %>
                <svg class="w-4 h-4 ml-2 text-amber-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 16L3 6l4 3 5-4 5 4 4-3-2 10H5z"/>
                </svg>
              </span>
              <div class="hidden absolute top-full left-1/2 -translate-x-1/2 mt-2 px-3 py-2 bg-gray-900 text-white text-sm rounded-lg shadow-lg whitespace-nowrap z-50">
                <div class="absolute -top-1 left-1/2 -translate-x-1/2 w-2 h-2 bg-gray-900 rotate-45"></div>
                <%= t('statement_files.upload_pro_only') %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </header>
  </div>

  <!-- MOBILE DASHBOARD (app parity) -->
  <%= render "dashboard/mobile_dashboard", months_list: months_list %>

  <!-- MAIN CONTENT: Dashboard Content Area -->
  <div class="dashboard-main hidden md:block">
    
    <!-- ERROR DISPLAY: Error Messages -->
    <% if @error %>
      <div class="dashboard-error">
        <div class="dashboard-error-content">
          <div class="dashboard-error-icon">
            <svg class="dashboard-error-icon-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
            </svg>
          </div>
          <div>
            <h3 class="dashboard-error-text"><%= t('flash.dashboard_error') %></h3>
            <p class="dashboard-error-description"><%= @error %></p>
          </div>
        </div>
      </div>
    <% end %>

    <!-- HERO CARD: Balance / Income / Expenses -->
    <section class="mb-8">
      <div class="dashboard-hero-card">
        <div class="dashboard-hero-grid">
          <%# Column 1 — Balance %>
          <div>
            <p class="dashboard-hero-label"><%= t('dashboard.total_portfolio_balance') %></p>
            <p class="dashboard-hero-amount"><%= format_currency(@total_balance) %></p>
            <p class="dashboard-hero-sub"><%= t('dashboard.across_accounts', count: @bank_accounts.count) %></p>

            <% if @monthly_summary[:has_data] && @monthly_summary[:income].to_f > 0 %>
              <% savings_rate = ((@monthly_summary[:net].to_f / @monthly_summary[:income].to_f) * 100).round(0) %>
              <div class="dashboard-hero-savings-bar-wrap">
                <div class="dashboard-hero-savings-bar" style="width: <%= [[savings_rate, 0].max, 100].min %>%"></div>
              </div>
              <p class="dashboard-hero-savings-label"><%= t('dashboard.savings_rate', rate: savings_rate) %></p>
            <% end %>
          </div>

          <div class="dashboard-hero-divider"></div>

          <%# Column 2 — Income %>
          <div class="dashboard-hero-stat">
            <p class="dashboard-hero-label"><%= t('monthly_summary.income') %></p>
            <p class="dashboard-hero-stat-value dashboard-hero-stat-income">
              <%= @monthly_summary[:has_data] ? format_currency(@monthly_summary[:income]) : t('dashboard.no_data') %>
            </p>
            <p class="dashboard-hero-stat-sub"><%= @monthly_summary[:income_count] %> <%= t('table_headers.transactions') %></p>
          </div>

          <div class="dashboard-hero-divider"></div>

          <%# Column 3 — Expenses %>
          <div class="dashboard-hero-stat">
            <p class="dashboard-hero-label"><%= t('monthly_summary.expenses') %></p>
            <p class="dashboard-hero-stat-value dashboard-hero-stat-expenses">
              <%= @monthly_summary[:has_data] ? format_currency(@monthly_summary[:expenses]) : t('dashboard.no_data') %>
            </p>
            <p class="dashboard-hero-stat-sub"><%= @monthly_summary[:expense_count] %> <%= t('table_headers.transactions') %></p>
          </div>
        </div>
      </div>
    </section>

    <!-- MONTHLY SUMMARY CARDS: Responsive Grid (Desktop) / Carousel (Mobile) -->
      <!-- MOBILE: Carousel Layout (visible only on mobile) -->
      <section class="block md:hidden" data-controller="mobile-carousel">
        <div class="mobile-stats-carousel-wrapper">
          <div class="mobile-stats-carousel" data-mobile-carousel-target="container">
            <!-- Total Transactions Slide -->
            <div class="mobile-stat-slide" data-mobile-carousel-target="slide">
              <div class="mobile-stat-card mobile-stat-card-total">
                <div class="mobile-stat-icon">
                  <svg class="w-8 h-8 mx-auto text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                  </svg>
                </div>
                <div class="mobile-stat-content">
                  <span class="mobile-stat-label"><%= t('monthly_summary.total_transactions') %></span>
                  <span class="mobile-stat-value mobile-stat-value-total">
                    <%= @monthly_summary[:count] || 0 %>
                  </span>
                  <span class="mobile-stat-subtitle">
                    <%= @monthly_summary[:has_data] ? t('mobile.dashboard.this_month') : t('mobile.dashboard.no_data_this_month') %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Income Slide -->
            <div class="mobile-stat-slide" data-mobile-carousel-target="slide">
              <div class="mobile-stat-card mobile-stat-card-income">
                <div class="mobile-stat-icon">
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11l5-5m0 0l5 5m-5-5v12"></path>
                  </svg>
                </div>
                <div class="mobile-stat-content">
                  <span class="mobile-stat-label"><%= t('monthly_summary.income') %></span>
                  <span class="mobile-stat-value mobile-stat-value-income">
                    <%= format_currency(@monthly_summary[:income] || 0) %>
                  </span>
                  <span class="mobile-stat-subtitle">
                    <%= @monthly_summary[:has_data] ? "#{@monthly_summary[:income_count]} transacciones" : "Sin datos este mes" %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Expenses Slide -->
            <div class="mobile-stat-slide" data-mobile-carousel-target="slide">
              <div class="mobile-stat-card mobile-stat-card-expenses">
                <div class="mobile-stat-icon">
                  <svg class="w-8 h-8 mx-auto text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 13l5 5m0 0l5-5m-5 5V6"></path>
                  </svg>
                </div>
                <div class="mobile-stat-content">
                  <span class="mobile-stat-label"><%= t('monthly_summary.expenses') %></span>
                  <span class="mobile-stat-value mobile-stat-value-expenses">
                    <%= format_currency(@monthly_summary[:expenses] || 0) %>
                  </span>
                  <span class="mobile-stat-subtitle">
                    <%= @monthly_summary[:has_data] ? "#{@monthly_summary[:expense_count]} transacciones" : "Sin datos este mes" %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Net Flow Slide -->
            <div class="mobile-stat-slide" data-mobile-carousel-target="slide">
              <div class="mobile-stat-card <%= (@monthly_summary[:net] || 0) >= 0 ? 'mobile-stat-card-positive' : 'mobile-stat-card-negative' %>">
                <div class="mobile-stat-icon">
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                  </svg>
                </div>
                <div class="mobile-stat-content">
                  <span class="mobile-stat-label"><%= t('monthly_summary.net_flow') %></span>
                  <span class="mobile-stat-value <%= (@monthly_summary[:net] || 0) >= 0 ? 'mobile-stat-value-positive' : 'mobile-stat-value-negative' %>">
                    <%= format_currency(@monthly_summary[:net] || 0) %>
                  </span>
                  <span class="mobile-stat-subtitle">
                    <%= @monthly_summary[:has_data] ? ((@monthly_summary[:net] || 0) >= 0 ? "Flujo positivo" : "Flujo negativo") : "Sin datos este mes" %>
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- Carousel Indicators -->
          <div class="mobile-carousel-indicators">
            <button class="mobile-carousel-indicator active" data-mobile-carousel-target="indicator" data-index="0" data-action="click->mobile-carousel#goToSlideAction"></button>
            <button class="mobile-carousel-indicator" data-mobile-carousel-target="indicator" data-index="1" data-action="click->mobile-carousel#goToSlideAction"></button>
            <button class="mobile-carousel-indicator" data-mobile-carousel-target="indicator" data-index="2" data-action="click->mobile-carousel#goToSlideAction"></button>
          </div>
        </div>
      </section>

    <!-- OVERALL STATS CARDS: Total Transactions, Statements, Accounts -->
    <section class="dashboard-metrics-grid hidden md:grid">
      <!-- TOTAL TRANSACTIONS CARD -->
      <a href="/transactions" class="dashboard-metric-card cursor-pointer">
        <div class="dashboard-metric-content">
          <div>
            <p class="dashboard-metric-label"><%= t('monthly_summary.total_transactions') %></p>
            <p class="dashboard-metric-value dashboard-metric-value-total">
              <%= @total_transactions %>
            </p>
            <p class="dashboard-metric-subtitle"><%= t('monthly_summary.across_all_accounts') %></p>
          </div>
          <div class="dashboard-metric-icon dashboard-metric-icon-total">
            <svg class="dashboard-metric-icon-svg dashboard-metric-icon-svg-total" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
        </div>
      </a>

      <!-- TOTAL STATEMENTS CARD -->
      <a href="/statement_files" class="dashboard-metric-card cursor-pointer">
        <div class="dashboard-metric-content">
          <div>
            <p class="dashboard-metric-label"><%= t('monthly_summary.total_statements') %></p>
            <p class="dashboard-metric-value dashboard-metric-value-statements">
              <%= @total_statements %>
            </p>
            <p class="dashboard-metric-subtitle"><%= t('monthly_summary.processed_files') %></p>
          </div>
          <div class="dashboard-metric-icon dashboard-metric-icon-statements">
            <svg class="dashboard-metric-icon-svg dashboard-metric-icon-svg-statements" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
        </div>
      </a>

      <!-- TOTAL ACCOUNTS CARD -->
      <a href="/bank_accounts" class="dashboard-metric-card cursor-pointer">
        <div class="dashboard-metric-content">
          <div>
            <p class="dashboard-metric-label"><%= t('monthly_summary.total_accounts') %></p>
            <p class="dashboard-metric-value dashboard-metric-value-accounts">
              <%= @bank_accounts.count %>
            </p>
            <p class="dashboard-metric-subtitle"><%= t('navigation.bank_accounts') %></p>
          </div>
          <div class="dashboard-metric-icon dashboard-metric-icon-accounts">
            <svg class="dashboard-metric-icon-svg dashboard-metric-icon-svg-accounts" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
            </svg>
          </div>
        </div>
      </a>
    </section>

    <!-- MONTHLY DETAILED STATS: Additional Insights for Selected Month -->
    <% if @monthly_stats && @monthly_stats[:has_data] %>
      <section class="dashboard-metrics-grid hidden md:grid">
        
        <!-- MONTHLY TRANSACTIONS COUNT -->
        <div class="dashboard-metric-card">
          <div class="dashboard-metric-content">
            <div>
              <p class="dashboard-metric-label"><%= t('dashboard.monthly_transactions') %></p>
              <p class="dashboard-metric-value dashboard-metric-value-monthly">
                <%= @monthly_stats&.dig(:total_transactions) || 0 %>
              </p>
              <p class="dashboard-metric-subtitle">
                                  <%= @monthly_stats&.dig(:income_transactions) || 0 %> <%= t('transaction_types.income') %> •
                  <%= @monthly_stats&.dig(:expense_transactions) || 0 %> <%= t('transaction_types.expenses') %>
              </p>
            </div>
            <div class="dashboard-metric-icon dashboard-metric-icon-monthly">
              <svg class="dashboard-metric-icon-svg dashboard-metric-icon-svg-monthly" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
            </div>
          </div>
        </div>

        <!-- AVERAGE INCOME -->
        <div class="dashboard-metric-card">
          <div class="dashboard-metric-content">
            <div>
              <p class="dashboard-metric-label"><%= t('dashboard.average_income') %></p>
              <p class="dashboard-metric-value dashboard-metric-value-average">
                <%= format_currency(@monthly_stats&.dig(:average_income) || 0) %>
              </p>
              <p class="dashboard-metric-subtitle">
                                  <%= t('dashboard.largest') %>: <%= format_currency(@monthly_stats&.dig(:largest_income) || 0) %>
              </p>
            </div>
            <div class="dashboard-metric-icon dashboard-metric-icon-average">
              <svg class="dashboard-metric-icon-svg dashboard-metric-icon-svg-average" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11l5-5m0 0l5 5m-5-5v12"></path>
              </svg>
            </div>
          </div>
        </div>

        <!-- AVERAGE EXPENSE -->
        <div class="dashboard-metric-card">
          <div class="dashboard-metric-content">
            <div>
              <p class="dashboard-metric-label"><%= t('dashboard.average_expense') %></p>
              <p class="dashboard-metric-value dashboard-metric-value-average-expense">
                <%= format_currency(@monthly_stats&.dig(:average_expense) || 0) %>
              </p>
            <p class="dashboard-metric-subtitle">
                                <%= t('dashboard.largest') %>: <%= format_currency(@monthly_stats&.dig(:largest_expense) || 0) %>
            </p>
          </div>
          <div class="dashboard-metric-icon dashboard-metric-icon-average-expense">
            <svg class="dashboard-metric-icon-svg dashboard-metric-icon-svg-average-expense" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 13l-5 5m0 0l-5-5m5 5V6"></path>
            </svg>
          </div>
        </div>
      </div>
    </section>
    <% end %>

    <!-- TOP CATEGORIES FOR SELECTED MONTH -->
    <% if @monthly_stats && @monthly_stats[:has_data] && @monthly_stats[:top_categories]&.any? %>
      <section class="dashboard-top-categories">
        <h3 class="dashboard-top-categories-title"><%= t('dashboard.top_categories_for_month', month: l(@selected_month, format: :month_year)) %></h3>
        <div class="dashboard-top-categories-grid">
          <% @monthly_stats[:top_categories].each_with_index do |category, index| %>
            <div class="dashboard-top-category-card">
              <div class="dashboard-top-category-rank">#<%= index + 1 %></div>
              <div class="dashboard-top-category-content">
                <h4 class="dashboard-top-category-name"><%= category[:name] %></h4>
                <p class="dashboard-top-category-amount"><%= format_currency(category[:amount]) %></p>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% elsif @monthly_stats && !@monthly_stats[:has_data] %>
      <section class="dashboard-top-categories">
