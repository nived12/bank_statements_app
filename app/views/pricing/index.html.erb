<% content_for :page_title, @locale == "en" ? "Pricing — Vittio" : "Precios — Vittio" %>
<% content_for :page_description, @locale == "en" ? "Start free. Upgrade to Premium anytime. $149 MXN/month or $99/month billed annually. 30 days Premium free at signup. No credit card." : "Empieza gratis. Mejora a Premium cuando quieras. $149 MXN/mes o $99/mes facturado anual. 30 días Premium gratis al registrarte. Sin tarjeta." %>

<% content_for :head do %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Vittio Premium",
  "description": "AI-powered personal finance for Mexico — Premium plan with PDF import, voice entry, receipt scanning and auto-categorization.",
  "brand": { "@type": "Brand", "name": "Vittio" },
  "offers": [
    { "@type": "Offer", "name": "Free", "price": "0", "priceCurrency": "MXN" },
    { "@type": "Offer", "name": "Premium Monthly", "price": "149", "priceCurrency": "MXN" },
    { "@type": "Offer", "name": "Premium Annual", "price": "1188", "priceCurrency": "MXN" }
  ]
}
</script>
<% end %>

<%# CTA helper — returns the right path + label given subscription state %>
<% free_cta_path  = current_user ? portal_subscription_path : new_user_path %>
<% free_cta_es    = current_user ? "Administrar cuenta" : "Empezar gratis" %>
<% free_cta_en    = current_user ? "Manage account" : "Start free" %>

<% prem_cta_path  = case @subscription_state
                    when :premium  then portal_subscription_path
                    when :on_trial, :expired then checkout_subscription_path
                    else new_user_path
                    end %>
<% prem_cta_es    = case @subscription_state
                    when :premium  then "Administrar suscripción"
                    when :on_trial then "Activar Premium"
                    when :expired  then "Reactivar Premium"
                    else "Empezar 30 días gratis"
                    end %>
<% prem_cta_en    = case @subscription_state
                    when :premium  then "Manage subscription"
                    when :on_trial then "Activate Premium"
                    when :expired  then "Reactivate Premium"
                    else "Start 30 days free"
                    end %>

