<%= t('.header', debt_name: @debt.name) %>

<%= t('.greeting', name: @user.email.split('@').first.capitalize) %>

<%= t('.message', debt_name: @debt.name, amount: number_to_currency(@amount, unit: "$"), due_date: l(@due_date, format: :long), days: @days_until_due) %>

<% if @recommendation.present? %>
---
<%= t('.recommendation_header') %>
<%= @recommendation[:reason] %>
<%= t('.strategy', strategy: @recommendation[:strategy].humanize) %>
---
<% end %>

<%= t('.footer') %>
