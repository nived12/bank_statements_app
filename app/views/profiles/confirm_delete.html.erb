<% content_for :title, t("profile.delete.title") %>

<div class="max-w-2xl mx-auto p-6">
  <%= link_to profile_path, class: "text-indigo-600 text-sm hover:underline mb-6 inline-block" do %>
    ← <%= t("common.cancel") %>
  <% end %>

  <div class="flex flex-col items-center mb-6">
    <div class="w-16 h-16 bg-red-100 rounded-2xl flex items-center justify-center mb-4">
      <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3"/>
      </svg>
    </div>
    <h1 class="text-xl font-bold text-slate-900 text-center"><%= t("profile.delete.title") %></h1>
    <p class="text-sm text-slate-500 text-center mt-2 max-w-md"><%= t("profile.delete.subtitle") %></p>
  </div>

  <div class="bg-white border border-slate-200 rounded-xl p-4 mb-4">
    <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-3">
      <%= t("profile.delete.will_be_archived") %>
    </h2>
    <ul class="space-y-2 text-sm text-slate-700">
      <% t("profile.delete.items").each do |item| %>
        <li class="flex items-start gap-2">
          <span class="text-red-500 mt-0.5">✗</span>
          <span><%= item %></span>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-6">
    <p class="text-sm text-amber-800 flex items-start gap-2">
      <span>⚠</span>
      <span><%= t("profile.delete.subscription_warning") %></span>
    </p>
  </div>

  <%= form_with url: profile_path, method: :delete, local: true, class: "space-y-4",
                data: { turbo_confirm: t("profile.delete.final_confirm") } do |f| %>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-2">
        <%= t("profile.delete.type_to_confirm_html", word: content_tag(:strong, I18n.locale == :es ? "ELIMINAR" : "DELETE")).html_safe %>
      </label>
      <%= text_field_tag :confirm, nil,
          class: "w-full px-4 py-3 border border-slate-300 rounded-xl text-center font-semibold text-lg tracking-wider uppercase focus:ring-2 focus:ring-red-500 focus:border-red-500",
          placeholder: (I18n.locale == :es ? "ELIMINAR" : "DELETE"),
          autocomplete: "off",
          autocapitalize: "characters",
          required: true %>
    </div>

    <%= f.submit t("profile.delete.confirm_button"),
        class: "w-full px-4 py-3 bg-red-500 text-white text-sm font-semibold rounded-xl hover:bg-red-600 transition-colors" %>
  <% end %>
</div>
