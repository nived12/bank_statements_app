<div id="goal-transaction-<%= goal_transaction.id %>" class="flex items-center justify-between p-4 bg-slate-50 rounded-lg hover:bg-slate-100 transition-colors">
  <div class="flex-1">
    <div class="flex items-center justify-between mb-1">
      <span class="font-medium text-slate-900"><%= goal_transaction.txn.description %></span>
      <span class="font-semibold text-slate-900"><%= number_to_currency(goal_transaction.amount_applied) %></span>
    </div>
    <div class="flex items-center space-x-3 text-sm text-slate-600">
      <span><%= l(goal_transaction.txn.date, format: :short) %></span>
      <% if goal_transaction.txn.bank_account %>
        <span>•</span>
        <span><%= goal_transaction.txn.bank_account.custom_name || goal_transaction.txn.bank_account.bank_display_name %></span>
      <% end %>
      <% if goal_transaction.txn.category %>
        <span>•</span>
        <span><%= goal_transaction.txn.category.name %></span>
      <% end %>
    </div>
    <% if goal_transaction.notes.present? %>
      <div class="mt-1 text-sm text-slate-500 italic">
        <%= goal_transaction.notes %>
      </div>
    <% end %>
  </div>
  <div class="ml-4">
    <%= button_to goal_goal_transaction_path(goal, goal_transaction),
        method: :delete,
        data: { turbo_confirm: t('goals.linked_transactions.unlink_confirm') },
        class: "p-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
      </svg>
    <% end %>
  </div>
</div>
