<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title>Bank Statements App</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="csrf-token" content="<%= form_authenticity_token %>">
    <meta name="view-transition" content="same-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/icon.svg">
    <% if ENV["VAPID_PUBLIC_KEY"].present? %>
      <meta name="vapid-public-key" content="<%= ENV["VAPID_PUBLIC_KEY"] %>">
    <% end %>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js" defer></script>
    <script>
      (function() {
        var theme = localStorage.getItem('vittio-theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>

  <body class="bg-slate-50 dark:bg-slate-900 font-sans antialiased" data-controller="mobile-menu sidebar web-push">
    <%= render "shared/flash" %>

    <div class="flex h-screen bg-slate-50 dark:bg-slate-900 w-full overflow-x-hidden">
      <!-- Desktop Sidebar -->
      <aside class="hidden md:flex md:w-56 md:flex-col md:fixed md:inset-y-0 z-50">
        <div class="flex flex-col flex-grow bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-700 pt-5 pb-4 overflow-y-auto">
          <!-- Logo -->
          <div class="flex items-center justify-center flex-shrink-0 px-4">
            <a href="<%= root_path %>" class="flex items-center hover:opacity-80 transition-opacity">
              <%= render "shared/logo", image_class: "h-8 w-auto" %>
            </a>
          </div>

          <!-- Navigation -->
          <nav class="mt-8 flex-1 px-2 space-y-1">
            <!-- Main Navigation -->
            <a href="<%= dashboard_path %>"
               class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200 <%= 'active' if controller_name == 'dashboard' %>">
              <%= icon("layout-dashboard", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
              <%= t('navigation.dashboard') %>
            </a>

            <a href="<%= bank_accounts_path %>"
               class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200 <%= 'active' if controller_name == 'bank_accounts' %>">
              <%= icon("credit-card", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
              <%= t('navigation.bank_accounts') %>
            </a>

            <a href="<%= categories_path %>"
               class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200 <%= 'active' if %w[categories category_rules].include?(controller_name) %>">
              <%= icon("folder", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
              <%= t('navigation.categories') %>
            </a>

            <a href="<%= transactions_path %>"
               class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200 <%= 'active' if controller_name == 'transactions' %>">
              <%= icon("receipt", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
              <%= t('navigation.transactions') %>
            </a>

            <a href="<%= statement_files_path %>"
               class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200 <%= 'active' if controller_name == 'statement_files' %>">
              <%= icon("file-text", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
              <%= t('navigation.statement_files') %>
            </a>

            <!-- Goals Section -->
            <div class="pt-6">
              <div class="px-2 mb-2">
                <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider"><%= t('navigation.goals') %></h3>
              </div>

              <a href="<%= goals_path %>"
                 class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200 <%= 'active' if controller_name == 'goals' %>">
                <%= icon("target", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
                <%= t('navigation.goals') %>
              </a>

              <a href="<%= savings_path %>"
                 class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200 <%= 'active' if controller_name == 'savings' %>">
                <%= icon("piggy-bank", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
                <%= t('navigation.savings') %>
              </a>

              <a href="<%= debts_path %>"
                 class="sidebar-nav-item group flex items-center px-2 py-2 text-sm font-medium rounded-md transition-colors duration-200 <%= 'active' if controller_name == 'debts' %>">
                <%= icon("wallet", library: "lucide", variant: "outline", class: "sidebar-nav-icon mr-3 h-5 w-5") %>
                <%= t('navigation.debts') %>
              </a>
            </div>
          </nav>

          <!-- User Section -->
          <% if current_user %>
            <div class="flex-shrink-0 border-t border-slate-200 dark:border-slate-700 p-3">
              <%= link_to profile_path,
                  class: "flex items-center gap-2 w-full p-1 rounded-lg hover:bg-slate-50 transition-colors group" do %>
                <img src="<%= user_avatar_url(current_user) %>"
                     alt="<%= current_user.full_name %>"
                     class="w-8 h-8 rounded-full object-cover flex-shrink-0">
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-slate-900 dark:text-slate-100 truncate group-hover:text-indigo-600"><%= current_user.full_name %></p>
                  <p class="text-xs text-slate-400 dark:text-slate-500 truncate"><%= t("profile.edit_profile") %></p>
                </div>
              <% end %>
              <div class="flex items-center justify-between mt-2 px-1">
                <%= render 'shared/language_switcher' %>
                <div class="flex items-center gap-1">
                  <div data-controller="dark-mode">
                    <button data-action="click->dark-mode#toggle"
                            class="p-1 text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 transition-colors"
                            title="Toggle dark mode">
                      <span data-dark-mode-moon>🌙</span>
                      <span data-dark-mode-sun style="display:none">☀️</span>
                    </button>
                  </div>
                  <form action="/session" method="post" class="inline">
                    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                    <input type="hidden" name="_method" value="delete" />
                    <button type="submit" class="p-1 text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 transition-colors" title="<%= t('session.sign_out') %>">
                      <%= icon("log-out", library: "lucide", variant: "outline", class: "w-4 h-4") %>
                    </button>
                  </form>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </aside>

      <!-- Main Content Area -->
      <div class="flex flex-col flex-1 md:ml-56 w-full min-w-0">
        <!-- Mobile Header -->
        <header class="md:hidden bg-white dark:bg-slate-900 shadow-sm border-b border-slate-200 dark:border-slate-700">
          <div class="px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center py-4">
              <div class="flex items-center">
                <button type="button"
                        data-action="click->mobile-menu#open"
                        class="p-2 rounded-md text-slate-400 hover:text-slate-500 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-blue-500">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                  </svg>
                </button>
                <a href="<%= root_path %>" class="ml-3 flex items-center hover:opacity-80 transition-opacity">
                  <%= render "shared/logo", image_class: "h-6 w-auto" %>
                </a>
              </div>
            </div>
          </div>
        </header>

        <!-- Main Content -->
        <main class="flex-1 overflow-y-auto overflow-x-hidden w-full pb-20 md:pb-0">
          <%= yield %>
        </main>
      </div>
    </div>

    <!-- Mobile Menu Overlay -->
    <div data-mobile-menu-target="overlay"
         class="fixed inset-0 z-[9999] hidden mobile-menu-overlay lg:hidden"
         style="pointer-events: auto;">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-black bg-opacity-60"
             data-action="click->mobile-menu#close"></div>

        <!-- Menu Panel -->
        <div data-mobile-menu-target="panel"
             class="fixed top-0 left-0 h-full w-80 bg-white dark:bg-slate-900 shadow-2xl mobile-menu-panel transform -translate-x-full transition-transform duration-300 ease-in-out z-[10000] flex flex-col overflow-hidden">

          <!-- Menu Header -->
          <div class="mobile-menu-header flex items-center justify-between bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 p-6">
            <div class="flex items-center">
              <%= render "shared/logo", image_class: "h-8 w-auto" %>
            </div>
            <button type="button"
                    data-action="click->mobile-menu#close"
                    class="mobile-menu-close-btn p-2 rounded-lg hover:bg-slate-100 transition-colors">
              <svg class="w-6 h-6 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>

          <!-- Menu Items -->
          <nav class="mobile-menu-nav p-4 space-y-2 flex-1 overflow-y-auto">
            <a href="<%= dashboard_path %>"
               class="mobile-menu-item flex items-center px-4 py-4 rounded-xl text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200">
              <%= icon("layout-dashboard", library: "lucide", variant: "outline", class: "w-5 h-5 mr-3") %>
              <span><%= t('navigation.dashboard') %></span>
            </a>

            <a href="<%= bank_accounts_path %>"
               class="mobile-menu-item flex items-center px-4 py-4 rounded-xl text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200">
              <%= icon("credit-card", library: "lucide", variant: "outline", class: "w-5 h-5 mr-3") %>
              <span><%= t('navigation.bank_accounts') %></span>
            </a>

            <a href="<%= categories_path %>"
               class="mobile-menu-item flex items-center px-4 py-4 rounded-xl text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200">
              <%= icon("folder", library: "lucide", variant: "outline", class: "w-5 h-5 mr-3") %>
              <span><%= t('navigation.categories') %></span>
            </a>

            <a href="<%= transactions_path %>"
               class="mobile-menu-item flex items-center px-4 py-4 rounded-xl text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200">
              <%= icon("receipt", library: "lucide", variant: "outline", class: "w-5 h-5 mr-3") %>
              <span><%= t('navigation.transactions') %></span>
            </a>

            <a href="<%= statement_files_path %>"
               class="mobile-menu-item flex items-center px-4 py-4 rounded-xl text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200">
              <%= icon("file-text", library: "lucide", variant: "outline", class: "w-5 h-5 mr-3") %>
              <span><%= t('navigation.statement_files') %></span>
            </a>

            <a href="<%= goals_path %>"
               class="mobile-menu-item flex items-center px-4 py-4 rounded-xl text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200">
              <%= icon("target", library: "lucide", variant: "outline", class: "w-5 h-5 mr-3") %>
              <span><%= t('navigation.goals') %></span>
            </a>

            <a href="<%= savings_path %>"
               class="mobile-menu-item flex items-center px-4 py-4 rounded-xl text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200">
              <%= icon("piggy-bank", library: "lucide", variant: "outline", class: "w-5 h-5 mr-3") %>
              <span><%= t('navigation.savings') %></span>
            </a>

            <a href="<%= debts_path %>"
               class="mobile-menu-item flex items-center px-4 py-4 rounded-xl text-slate-700 hover:text-red-600 hover:bg-red-50 transition-all duration-200">
              <%= icon("wallet", library: "lucide", variant: "outline", class: "w-5 h-5 mr-3") %>
              <span><%= t('navigation.debts') %></span>
            </a>
          </nav>

          <!-- Mobile User Section -->
          <% if current_user %>
            <div class="flex-shrink-0 border-t border-slate-200 p-4">
              <%= link_to profile_path,
                  class: "flex items-center gap-3 mb-3 group",
                  data: { action: "click->mobile-menu#close" } do %>
                <img src="<%= user_avatar_url(current_user) %>"
                     alt="<%= current_user.full_name %>"
                     class="w-10 h-10 rounded-full object-cover flex-shrink-0">
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-slate-900 truncate group-hover:text-indigo-600"><%= current_user.full_name %></p>
                  <p class="text-xs text-slate-400"><%= t("profile.edit_profile") %></p>
                </div>
                <%= icon("chevron-right", library: "lucide", variant: "outline", class: "w-4 h-4 text-slate-400 flex-shrink-0") %>
              <% end %>
              <div class="flex items-center gap-3">
                <%= render 'shared/language_switcher' %>
                <div data-controller="dark-mode">
                  <button data-action="click->dark-mode#toggle"
                          class="flex items-center gap-1.5 px-3 py-1.5 text-sm text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg transition-colors">
                    <span data-dark-mode-moon>🌙</span>
                    <span data-dark-mode-sun style="display:none">☀️</span>
                  </button>
                </div>
                <form action="/session" method="post" class="ml-auto">
                  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                  <input type="hidden" name="_method" value="delete" />
                  <button type="submit"
                          class="flex items-center gap-1.5 px-3 py-1.5 text-sm text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-colors"
                          title="<%= t('session.sign_out') %>">
                    <%= icon("log-out", library: "lucide", variant: "outline", class: "w-4 h-4") %>
                    <%= t("session.sign_out") %>
                  </button>
                </form>
              </div>
            </div>
          <% end %>
        </div>
      </div>

    <script>
      document.addEventListener('vittio:celebration', function() {
        if (typeof confetti !== 'undefined') {
          confetti({
            particleCount: 80,
            spread: 70,
            origin: { x: 0.5, y: 0.8 },
            colors: ['#4f46e5', '#10b981', '#f59e0b', '#e11d48', '#ffffff']
          });
        }
      });
    </script>

    <!-- Mobile Bottom Navigation -->
    <% if current_user %>
      <nav class="mobile-bottom-nav md:hidden">
        <%= link_to dashboard_path, class: "mobile-nav-item #{'mobile-nav-item-active' if controller_name == 'dashboard'}" do %>
          <div class="mobile-nav-icon">
            <%= icon("layout-dashboard", library: "lucide", variant: "outline", class: "w-6 h-6") %>
          </div>
          <span class="mobile-nav-label"><%= t('navigation.dashboard') %></span>
        <% end %>

        <%= link_to transactions_path, class: "mobile-nav-item #{'mobile-nav-item-active' if controller_name == 'transactions'}" do %>
          <div class="mobile-nav-icon">
            <%= icon("receipt", library: "lucide", variant: "outline", class: "w-6 h-6") %>
          </div>
          <span class="mobile-nav-label"><%= t('navigation.transactions') %></span>
        <% end %>

        <!-- Center FAB Button (hidden when a view sets content_for :hide_fab) -->
        <% unless content_for?(:hide_fab) %>
          <%= link_to new_transaction_path, class: "mobile-nav-fab-item", data: { turbo_frame: "_top" } do %>
            <div class="mobile-nav-fab-button">
              <%= icon("plus", library: "lucide", variant: "outline", class: "w-7 h-7") %>
            </div>
          <% end %>
        <% end %>

        <%= link_to statement_files_path, class: "mobile-nav-item #{'mobile-nav-item-active' if controller_name == 'statement_files'}" do %>
          <div class="mobile-nav-icon">
            <%= icon("file-text", library: "lucide", variant: "outline", class: "w-6 h-6") %>
          </div>
          <span class="mobile-nav-label"><%= t('navigation.statement_files') %></span>
        <% end %>

        <%= link_to bank_accounts_path, class: "mobile-nav-item #{'mobile-nav-item-active' if controller_name == 'bank_accounts'}" do %>
          <div class="mobile-nav-icon">
            <%= icon("credit-card", library: "lucide", variant: "outline", class: "w-6 h-6") %>
          </div>
          <span class="mobile-nav-label"><%= t('navigation.bank_accounts') %></span>
        <% end %>
      </nav>
    <% end %>
  </body>
</html>
