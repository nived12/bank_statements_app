<div class="saving-show-page">
  <div class="saving-main">
    <!-- Mobile View -->
    <div class="block md:hidden min-h-screen bg-slate-50 pb-24">
      <!-- Mobile Header -->
      <header class="bg-white border-b border-slate-200 px-4 py-4 sticky top-0 z-10">
        <div class="flex items-center justify-between mb-3">
          <%= link_to savings_path, class: "text-slate-600 hover:text-slate-900" do %>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
          <% end %>
          <h1 class="text-xl font-bold text-slate-900 flex-1 text-center"><%= @saving.name %></h1>
          <%= link_to edit_saving_path(@saving), class: "text-blue-600 hover:text-blue-700" do %>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
          <% end %>
        </div>
        <div class="flex items-center justify-center space-x-2">
          <span class="text-xs px-2 py-1 rounded-full bg-green-100 text-green-800">
            <%= t('savings.savings_goal') %>
          </span>
          <span class="text-xs px-2 py-1 rounded-full <%=
            case @saving.status
            when 'active' then 'bg-blue-100 text-blue-800'
            when 'completed' then 'bg-green-100 text-green-800'
            when 'paused' then 'bg-slate-100 text-slate-800'
            when 'archived' then 'bg-slate-100 text-slate-800'
            end
          %>">
            <%= t("savings.statuses.#{@saving.status}") %>
          </span>
        </div>
      </header>

      <!-- Mobile Content -->
      <div class="px-4 py-4 space-y-4">
        <!-- Icon & Progress -->
        <div class="bg-white rounded-xl border border-slate-200 p-4">
          <div class="flex justify-center mb-4">
            <div class="w-20 h-20 rounded-xl flex items-center justify-center"
                 style="background-color: <%= @saving.color %>20">
              <%= icon_svg(@saving.icon, css_classes: "w-12 h-12") %>
            </div>
          </div>

          <!-- Progress Bar -->
          <div class="mb-4">
            <div class="flex justify-between text-sm text-slate-600 mb-2">
              <span><%= number_to_currency(@saving.current_amount) %></span>
              <span><%= number_to_currency(@saving.target_amount) %></span>
            </div>
            <div class="w-full bg-slate-200 rounded-full h-3 overflow-hidden">
              <div class="h-full rounded-full transition-all duration-500"
                   style="width: <%= [@saving.progress_percentage, 100].min %>%; background-color: <%= @saving.color %>">
              </div>
            </div>
            <div class="mt-2 text-center text-2xl font-bold" style="color: <%= @saving.color %>">
              <%= @saving.progress_percentage %>%
            </div>
          </div>

          <!-- Stats Grid -->
          <div class="grid grid-cols-2 gap-3">
            <div class="text-center p-3 bg-slate-50 rounded-lg">
              <div class="text-xl font-bold text-slate-900"><%= number_to_currency(@saving.current_amount) %></div>
              <div class="text-xs text-slate-600"><%= t('savings.current_amount') %></div>
            </div>
            <div class="text-center p-3 bg-slate-50 rounded-lg">
              <div class="text-xl font-bold text-slate-900"><%= number_to_currency(@saving.amount_remaining) %></div>
              <div class="text-xs text-slate-600"><%= t('savings.remaining') %></div>
            </div>
            <div class="text-center p-3 bg-slate-50 rounded-lg">
              <div class="text-lg font-bold text-slate-900"><%= number_to_currency(@saving.target_amount) %></div>
              <div class="text-xs text-slate-600"><%= t('savings.target_amount') %></div>
            </div>
            <div class="text-center p-3 bg-slate-50 rounded-lg">
              <div class="text-lg font-bold text-slate-900"><%= @saving.goals.count %></div>
              <div class="text-xs text-slate-600"><%= t('savings.associated_goals') %></div>
            </div>
          </div>
        </div>

        <!-- Quick Actions -->
        <% unless @saving.status_completed? %>
          <div class="flex gap-2">
            <%= button_to saving_path(@saving), method: :patch, params: { status_action: "complete" }, class: "flex-1 inline-flex items-center justify-center px-4 py-3 bg-green-600 text-white rounded-lg font-medium hover:bg-green-700 transition-colors" do %>
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <%= t('savings.actions.complete') %>
            <% end %>
            <%= button_to saving_path(@saving), method: :delete,
                data: { turbo_confirm: t('savings.delete_confirm', name: @saving.name) },
                class: "inline-flex items-center justify-center px-4 py-3 bg-red-600 text-white rounded-lg font-medium hover:bg-red-700 transition-colors" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
            <% end %>
          </div>
        <% end %>

        <!-- Details -->
        <div class="bg-white rounded-xl border border-slate-200 p-4">
          <h3 class="text-lg font-semibold text-slate-900 mb-3"><%= t('savings.actions.view_details') %></h3>
          <dl class="space-y-3">
            <div>
              <dt class="text-sm text-slate-600"><%= t('savings.target_amount') %></dt>
              <dd class="text-base font-medium text-slate-900"><%= number_to_currency(@saving.target_amount) %></dd>
            </div>
            <div>
              <dt class="text-sm text-slate-600"><%= t('savings.current_amount') %></dt>
              <dd class="text-base font-medium text-slate-900"><%= number_to_currency(@saving.current_amount) %></dd>
            </div>
            <div>
              <dt class="text-sm text-slate-600"><%= t('savings.remaining') %></dt>
              <dd class="text-base font-medium text-slate-900"><%= number_to_currency(@saving.amount_remaining) %></dd>
            </div>
            <% if @saving.categories.any? %>
              <div>
                <dt class="text-sm text-slate-600"><%= t('savings.categories') %></dt>
                <dd class="text-base font-medium text-slate-900">
                  <div class="flex flex-wrap gap-1">
                    <% @saving.categories.each do |category| %>
                      <span class="inline-flex items-center px-2 py-1 rounded-md bg-blue-100 text-blue-800 text-xs font-medium">
                        <%= category.name %>
                      </span>
                    <% end %>
                  </div>
                </dd>
              </div>
            <% end %>
            <% if @saving.bank_accounts.any? %>
              <div>
                <dt class="text-sm text-slate-600"><%= t('savings.bank_accounts') %></dt>
                <dd class="text-base font-medium text-slate-900">
                  <div class="flex flex-wrap gap-1">
                    <% @saving.bank_accounts.each do |bank_account| %>
                      <span class="inline-flex items-center px-2 py-1 rounded-md bg-green-100 text-green-800 text-xs font-medium">
                        <%= bank_account.custom_name %>
                      </span>
                    <% end %>
                  </div>
                </dd>
              </div>
            <% end %>
            <% if @saving.notes.present? %>
              <div>
                <dt class="text-sm text-slate-600"><%= t('savings.notes') %></dt>
                <dd class="text-base text-slate-900"><%= @saving.notes %></dd>
              </div>
            <% end %>
          </dl>
        </div>

        <!-- Associated Goals -->
        <% if @saving.goals.any? %>
          <div class="bg-white rounded-xl border border-slate-200 p-4">
            <h3 class="text-lg font-semibold text-slate-900 mb-3"><%= t('savings.associated_goals') %></h3>
            <div id="saving-<%= @saving.id %>-goals-mobile" class="space-y-2">
              <% @saving.goals.each do |goal| %>
                <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg">
                  <div class="flex-1">
                    <div class="font-medium text-slate-900"><%= goal.name %></div>
                    <div class="text-xs text-slate-500">
                      <%= number_to_currency(goal.total_current_amount) %> / <%= number_to_currency(goal.total_target_amount) %>
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="font-semibold text-blue-600"><%= goal.progress_percentage.round %>%</div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Recent Transactions -->
        <div class="bg-white rounded-xl border border-slate-200 p-4">
          <h3 class="text-lg font-semibold text-slate-900 mb-3"><%= t('savings.recent_transactions') %></h3>
          <% if @saving_transactions.any? %>
            <div class="space-y-2">
              <% @saving_transactions.limit(5).each do |saving_transaction| %>
                <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg">
                  <div class="flex-1">
                    <div class="font-medium text-slate-900"><%= saving_transaction.transaction.description %></div>
                    <div class="text-xs text-slate-500">
                      <%= saving_transaction.transaction.date.strftime("%b %d, %Y") %>
                    </div>
                  </div>
                  <div class="text-sm font-semibold <%= saving_transaction.amount_applied >= 0 ? 'text-green-600' : 'text-red-600' %>">
                    <%= saving_transaction.amount_applied >= 0 ? '+' : '' %><%= number_to_currency(saving_transaction.amount_applied) %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-8">
              <div class="w-16 h-16 bg-blue-50 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                </svg>
              </div>
              <h3 class="text-sm font-medium text-slate-900 mb-2"><%= t('savings.no_transactions') %></h3>
              <p class="text-sm text-slate-600"><%= t('savings.no_transactions_description') %></p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Desktop View -->
    <div class="hidden md:block min-h-screen bg-slate-50">
      <!-- Header -->
      <header class="bg-white border-b border-slate-200 px-8 py-6">
        <div class="max-w-7xl mx-auto flex items-start justify-between">
          <div class="flex items-center space-x-4">
            <%= link_to savings_path, class: "text-slate-600 hover:text-slate-900" do %>
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
            <% end %>
            <div class="flex items-center space-x-4">
              <div class="w-16 h-16 rounded-xl flex items-center justify-center"
                   style="background-color: <%= @saving.color %>20">
                <%= icon_svg(@saving.icon, css_classes: "w-8 h-8") %>
              </div>
              <div>
                <h1 class="text-3xl font-bold text-slate-900"><%= @saving.name %></h1>
                <div class="flex items-center space-x-2 mt-1">
                  <span class="text-sm px-2 py-1 rounded-full bg-green-100 text-green-800">
                    <%= t('savings.savings_goal') %>
                  </span>
                  <span class="text-sm px-2 py-1 rounded-full <%=
                    case @saving.status
                    when 'active' then 'bg-blue-100 text-blue-800'
                    when 'completed' then 'bg-green-100 text-green-800'
                    when 'paused' then 'bg-slate-100 text-slate-800'
                    when 'archived' then 'bg-slate-100 text-slate-800'
                    end
                  %>">
                    <%= t("savings.statuses.#{@saving.status}") %>
                  </span>
                </div>
              </div>
            </div>
          </div>
          <div class="flex items-center space-x-3">
            <%= link_to edit_saving_path(@saving),
                        class: "inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition-colors shadow-sm" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              <%= t('savings.edit') %>
            <% end %>
            <%= button_to saving_path(@saving), method: :delete,
                        data: { turbo_confirm: t('savings.delete_confirm', name: @saving.name) },
                        class: "inline-flex items-center px-4 py-2 bg-red-600 text-white rounded-lg font-medium hover:bg-red-700 transition-colors shadow-sm" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
              <%= t('savings.delete') %>
            <% end %>
          </div>
        </div>
      </header>

      <!-- Main Content -->
      <div class="max-w-7xl mx-auto px-8 py-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <!-- Left Column -->
          <div class="lg:col-span-2 space-y-6">
            <!-- Progress Overview -->
            <div class="bg-white rounded-xl border border-slate-200 p-6">
              <h2 class="text-xl font-semibold text-slate-900 mb-6"><%= t('savings.progress_overview') %></h2>
              
              <div class="mb-6">
                <div class="flex justify-between text-sm text-slate-600 mb-3">
                  <span><%= number_to_currency(@saving.current_amount) %></span>
                  <span><%= number_to_currency(@saving.target_amount) %></span>
                </div>
                <div class="w-full bg-slate-200 rounded-full h-4 overflow-hidden">
                  <div class="h-full rounded-full transition-all duration-500"
                       style="width: <%= [@saving.progress_percentage, 100].min %>%; background-color: <%= @saving.color %>">
                  </div>
                </div>
                <div class="mt-3 text-center text-3xl font-bold" style="color: <%= @saving.color %>">
                  <%= @saving.progress_percentage %>%
                </div>
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div class="text-center p-4 bg-slate-50 rounded-lg">
                  <div class="text-2xl font-bold text-slate-900"><%= number_to_currency(@saving.current_amount) %></div>
                  <div class="text-sm text-slate-600"><%= t('savings.current_amount') %></div>
                </div>
                <div class="text-center p-4 bg-slate-50 rounded-lg">
                  <div class="text-2xl font-bold text-slate-900"><%= number_to_currency(@saving.amount_remaining) %></div>
                  <div class="text-sm text-slate-600"><%= t('savings.remaining') %></div>
                </div>
              </div>
            </div>

            <!-- Associated Goals -->
            <% if @saving.goals.any? %>
              <div class="bg-white rounded-xl border border-slate-200 p-6">
                <h2 class="text-xl font-semibold text-slate-900 mb-4"><%= t('savings.associated_goals') %></h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <% @saving.goals.each do |goal| %>
                    <%= link_to goal_path(goal), class: "block p-4 border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors" do %>
                      <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 rounded-lg flex items-center justify-center"
                             style="background-color: <%= goal.color %>20">
                          <%= icon_svg(goal.icon, css_classes: "w-5 h-5") %>
                        </div>
                        <div class="flex-1">
                          <div class="font-medium text-slate-900"><%= goal.name %></div>
                          <div class="text-sm text-slate-500">
                            <%= number_to_currency(goal.total_current_amount) %> / <%= number_to_currency(goal.total_target_amount) %>
                          </div>
                        </div>
                        <div class="text-right">
                          <div class="font-semibold text-blue-600"><%= goal.progress_percentage.round %>%</div>
                        </div>
                      </div>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% end %>

            <!-- Recent Transactions -->
            <div class="bg-white rounded-xl border border-slate-200 p-6">
              <div class="flex items-center justify-between mb-4">
                <h2 class="text-xl font-semibold text-slate-900"><%= t('savings.recent_transactions') %></h2>
                <%= link_to t('savings.view_all_transactions'), saving_path(@saving), 
                    class: "text-sm font-medium text-blue-600 hover:text-blue-500" %>
              </div>
              
              <% if @saving_transactions.any? %>
                <div class="space-y-3">
                  <% @saving_transactions.limit(10).each do |saving_transaction| %>
                    <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg">
                      <div class="flex items-center space-x-3">
                        <div class="text-sm font-medium text-slate-900">
                          <%= saving_transaction.transaction.description %>
                        </div>
                        <div class="text-xs text-slate-500">
                          <%= saving_transaction.transaction.date.strftime("%b %d, %Y") %>
                        </div>
                      </div>
                      <div class="text-sm font-semibold <%= saving_transaction.amount_applied >= 0 ? 'text-green-600' : 'text-red-600' %>">
                        <%= saving_transaction.amount_applied >= 0 ? '+' : '' %><%= number_to_currency(saving_transaction.amount_applied) %>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <div class="text-center py-12">
                  <div class="w-20 h-20 bg-blue-50 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-10 h-10 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                    </svg>
                  </div>
                  <h3 class="text-lg font-semibold text-slate-900 mb-2"><%= t('savings.no_transactions') %></h3>
                  <p class="text-slate-600"><%= t('savings.no_transactions_description') %></p>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Right Sidebar -->
          <div class="space-y-6">
            <!-- Details -->
            <div class="bg-white rounded-xl border border-slate-200 p-6">
              <h3 class="text-lg font-semibold text-slate-900 mb-4"><%= t('savings.details') %></h3>
              <dl class="space-y-3">
                <div>
                  <dt class="text-sm text-slate-600"><%= t('savings.target_amount') %></dt>
                  <dd class="text-base font-medium text-slate-900"><%= number_to_currency(@saving.target_amount) %></dd>
                </div>
                <div>
                  <dt class="text-sm text-slate-600"><%= t('savings.current_amount') %></dt>
                  <dd class="text-base font-medium text-slate-900"><%= number_to_currency(@saving.current_amount) %></dd>
                </div>
                <div>
                  <dt class="text-sm text-slate-600"><%= t('savings.remaining') %></dt>
                  <dd class="text-base font-medium text-slate-900"><%= number_to_currency(@saving.amount_remaining) %></dd>
                </div>
                <% if @saving.categories.any? %>
                  <div>
                    <dt class="text-sm text-slate-600"><%= t('savings.categories') %></dt>
                    <dd class="text-base font-medium text-slate-900">
                      <div class="flex flex-wrap gap-1">
                        <% @saving.categories.each do |category| %>
                          <span class="inline-flex items-center px-2 py-1 rounded-md bg-blue-100 text-blue-800 text-xs font-medium">
                            <%= category.name %>
                          </span>
                        <% end %>
                      </div>
                    </dd>
                  </div>
                <% end %>
                <% if @saving.bank_accounts.any? %>
                  <div>
                    <dt class="text-sm text-slate-600"><%= t('savings.bank_accounts') %></dt>
                    <dd class="text-base font-medium text-slate-900">
                      <div class="flex flex-wrap gap-1">
                        <% @saving.bank_accounts.each do |bank_account| %>
                          <span class="inline-flex items-center px-2 py-1 rounded-md bg-green-100 text-green-800 text-xs font-medium">
                            <%= bank_account.custom_name %>
                          </span>
                        <% end %>
                      </div>
                    </dd>
                  </div>
                <% end %>
                <% if @saving.auto_sync_transactions? %>
                  <div>
                    <dt class="text-sm text-slate-600"><%= t('savings.auto_sync_status') %></dt>
                    <dd class="text-base font-medium text-green-600"><%= t('savings.auto_sync_enabled') %></dd>
                  </div>
                <% end %>
              </dl>
            </div>

            <!-- Notes -->
            <% if @saving.notes.present? %>
              <div class="bg-white rounded-xl border border-slate-200 p-6">
                <h3 class="text-lg font-semibold text-slate-900 mb-4"><%= t('savings.notes') %></h3>
                <p class="text-sm text-slate-600"><%= simple_format(@saving.notes) %></p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
