<% content_for :title, t("savings.edit", name: @saving.name) %>

<div class="min-h-screen bg-slate-50">
  <!-- Header -->
  <div class="bg-white shadow-sm border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="py-6">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-4">
            <!-- Back Button -->
            <%= link_to saving_path(@saving), 
                class: "inline-flex items-center text-sm font-medium text-slate-500 hover:text-slate-700" do %>
              <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              <%= t("savings.back_to_saving") %>
            <% end %>
            
            <div>
              <h1 class="text-3xl font-bold text-slate-900"><%= t("savings.edit", name: @saving.name) %></h1>
              <p class="mt-2 text-slate-600"><%= t("savings.edit_description", name: @saving.name) %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Form -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="bg-white rounded-lg shadow-sm border border-slate-200">
      <%= render "form", saving: @saving %>
    </div>
  </div>
</div>
