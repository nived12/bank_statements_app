<p class="email-text">
  <%= t(".message", debt_name: @debt.name, amount: number_to_currency(@amount, unit: "$")) %>
</p>

<p class="email-text"><%= t(".action") %></p>

<p class="email-text"><%= t(".footer") %></p>
