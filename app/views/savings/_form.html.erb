<div id="saving-form" class="bg-white rounded-xl border border-slate-200 p-6" data-controller="saving-form">
  <%= form_with(model: saving, local: true, class: "space-y-6") do |f| %>

    <!-- Saving Name -->
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-slate-700 mb-2" do %>
        <%= t('savings.name') %> <span class="text-red-500">*</span>
      <% end %>
      <%= f.text_field :name,
          placeholder: t('savings.name_placeholder'),
          class: "w-full px-4 py-2 border #{saving.errors[:name].any? ? 'border-red-500' : 'border-slate-300'} rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
          required: true %>
      <% if saving.errors[:name].any? %>
        <p class="mt-1 text-sm text-red-600"><%= saving.errors[:name].first %></p>
      <% else %>
        <p class="mt-1 text-sm text-slate-500"><%= t('savings.name_help') %></p>
      <% end %>
    </div>

    <!-- Target Amount and Current Amount -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label :target_amount, class: "block text-sm font-medium text-slate-700 mb-2" do %>
          <%= t('savings.target_amount') %> <span class="text-red-500">*</span>
        <% end %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <span class="text-slate-500 sm:text-sm">$</span>
          </div>
          <%= f.text_field :target_amount,
              inputmode: "decimal",
              class: "w-full pl-7 pr-3 py-2 border #{saving.errors[:target_amount].any? ? 'border-red-500' : 'border-slate-300'} rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
              placeholder: "0.00",
              data: { action: "input->saving-form#enforceDecimalPlaces blur->saving-form#formatDecimal" },
              required: true %>
        </div>
        <% if saving.errors[:target_amount].any? %>
          <p class="mt-1 text-sm text-red-600"><%= saving.errors[:target_amount].first %></p>
        <% else %>
          <p class="mt-1 text-sm text-slate-500"><%= t('savings.target_amount_help') %></p>
        <% end %>
      </div>

      <div>
        <%= f.label :current_amount, class: "block text-sm font-medium text-slate-700 mb-2" do %>
          <%= t('savings.current_amount') %>
        <% end %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <span class="text-slate-500 sm:text-sm">$</span>
          </div>
          <%= f.text_field :current_amount,
              inputmode: "decimal",
              class: "w-full pl-7 pr-3 py-2 border #{saving.errors[:current_amount].any? ? 'border-red-500' : 'border-slate-300'} rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
              placeholder: "0.00",
              data: { action: "input->saving-form#enforceDecimalPlaces blur->saving-form#formatDecimal" } %>
        </div>
        <% if saving.errors[:current_amount].any? %>
          <p class="mt-1 text-sm text-red-600"><%= saving.errors[:current_amount].first %></p>
        <% else %>
          <p class="mt-1 text-sm text-slate-500"><%= t('savings.current_amount_help') %></p>
        <% end %>
      </div>
    </div>

    <!-- Icon Picker -->
    <div data-controller="icon-picker"
         data-icon-picker-selected-value="<%= saving.icon || 'piggy-bank' %>"
         data-action="icon-picker:changed->saving-form#iconChanged">
      <%= f.hidden_field :icon,
          data: {
            icon_picker_target: "input",
            saving_form_target: "iconInput"
          },
          value: saving.icon || 'piggy-bank' %>

      <%= f.label :icon, t('savings.icon'), class: "block text-sm font-medium text-slate-700 mb-2" %>

      <div class="flex items-center space-x-3 mb-3">
        <!-- Icon Button (click to show picker) -->
        <button type="button"
                data-action="click->icon-picker#togglePicker"
                data-icon-picker-target="iconDisplay"
                class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center border-2 border-blue-200 hover:border-blue-400 transition-colors flex-shrink-0">
          <%= icon_svg(saving.icon || 'piggy-bank', css_classes: "w-6 h-6 text-blue-600") %>
        </button>
        <p class="text-sm text-slate-500"><%= t('savings.icon_help') %></p>
      </div>

      <!-- Icon Picker (hidden by default) -->
      <div data-icon-picker-target="pickerContainer" class="hidden mb-4">
        <div class="p-3 bg-slate-50 rounded-lg border border-slate-200">
          <div class="grid grid-cols-6 gap-2 max-h-64 overflow-y-auto">
            <% IconsHelper::ICONS_LIBRARY.each do |icon_name, lucide_icon| %>
              <button type="button"
                      data-action="click->icon-picker#select"
                      data-icon-picker-icon-param="<%= icon_name %>"
                      data-icon-name="<%= icon_name %>"
                      class="p-2 rounded-lg border-2 transition-all hover:border-blue-300 flex items-center justify-center <%= icon_name == (saving.icon || 'piggy-bank') ? 'border-blue-500 bg-blue-50' : 'border-slate-200 bg-white' %>"
                      data-icon-picker-target="iconButton">
                <%= icon(lucide_icon, library: "lucide", variant: "outline", class: "w-5 h-5 #{icon_name == (saving.icon || 'piggy-bank') ? 'text-blue-600' : 'text-slate-600'}") %>
              </button>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Color Picker -->
    <div data-controller="color-picker">
      <%= f.label :color, t('savings.color'), class: "block text-sm font-medium text-slate-700 mb-2" %>
      <%= f.hidden_field :color, value: saving.color || '#3B82F6', data: { color_picker_target: "input" } %>

      <div class="flex gap-3 flex-wrap">
        <% [
          ['#EF4444', 'Red'],
          ['#F97316', 'Orange'],
          ['#F59E0B', 'Amber'],
          ['#10B981', 'Green'],
          ['#3B82F6', 'Blue'],
          ['#6366F1', 'Indigo'],
          ['#8B5CF6', 'Purple'],
          ['#EC4899', 'Pink'],
          ['#64748B', 'Slate'],
          ['#0EA5E9', 'Sky']
        ].each do |color, name| %>
          <button type="button"
                  data-action="click->color-picker#select"
                  data-color="<%= color %>"
                  data-color-picker-target="button"
                  class="w-10 h-10 rounded-full transition-all hover:scale-110 <%= (saving.color || '#3B82F6') == color ? 'ring-4 ring-offset-2' : '' %>"
                  style="background-color: <%= color %>;"
                  title="<%= name %>">
          </button>
        <% end %>
      </div>
      <p class="mt-2 text-sm text-slate-500"><%= t('savings.color_help') %></p>
    </div>

    <!-- Category Selection (Always Visible) -->
    <div data-controller="auto-link-toggle">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Category -->
        <div class="relative" data-controller="category-selector">
            <%= f.label :category_id, class: "block text-sm font-medium text-slate-700 mb-2", data: { auto_link_toggle_target: "categoryLabel" } do %>
              <%= t('savings.category') %>
              <span class="text-slate-400 text-xs optional-indicator">(<%= t('form_actions.optional') %>)</span>
              <span class="text-red-500 required-indicator hidden">*</span>
            <% end %>

            <!-- Hidden input for form submission -->
            <%= f.hidden_field :category_id, data: { category_selector_target: "hiddenInput" } %>

            <!-- Custom Dropdown Button -->
            <button type="button"
                    data-action="click->category-selector#toggle"
                    class="w-full px-4 py-2 bg-white border <%= saving.errors[:category_id].any? ? 'border-red-500' : 'border-slate-300' %> rounded-lg text-left flex items-center justify-between focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
              <span data-category-selector-target="selectedText"
                    data-placeholder="<%= t('savings.select_category') %>"
                    class="text-slate-900">
                <% if saving.category_id.present? %>
                  <%= @categories.find { |c| c.id == saving.category_id }&.name || t('savings.select_category') %>
                <% else %>
                  <%= t('savings.select_category') %>
                <% end %>
              </span>
              <svg class="w-5 h-5 text-slate-400 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>

            <!-- Dropdown Menu -->
            <div data-category-selector-target="menu"
                 class="hidden absolute z-50 top-full left-0 right-0 mt-1 bg-white rounded-lg shadow-lg border border-slate-200 max-h-80 overflow-y-auto">

              <!-- Placeholder Option -->
              <button type="button"
                      data-action="click->category-selector#clearSelection"
                      class="w-full px-4 py-2.5 flex items-center space-x-3 hover:bg-slate-50 active:bg-slate-100 transition-colors text-left border-b border-slate-100">
                <div class="w-8 h-8 bg-slate-100 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                  </svg>
                </div>
                <span class="flex-1 text-slate-400 text-sm"><%= t('savings.select_category') %></span>
              </button>

              <% current_user.categories.where(parent_id: nil).where.not(name: t('categories.uncategorized')).order(:name).each do |parent_cat| %>
                <% has_children = parent_cat.children.any? %>

                <!-- Parent Category Item -->
                <div class="relative">
                  <button type="button"
                          data-action="click->category-selector#selectCategory"
                          data-category-id="<%= parent_cat.id %>"
                          data-category-name="<%= parent_cat.name %>"
                          data-has-children="<%= has_children %>"
                          data-is-parent="true"
                          class="w-full px-4 py-2.5 flex items-center space-x-3 hover:bg-slate-50 active:bg-slate-100 transition-colors text-left border-b border-slate-100">

                    <!-- Icon -->
                    <div class="w-8 h-8 bg-slate-100 rounded-lg flex items-center justify-center flex-shrink-0">
                      <%= icon_svg(parent_cat.icon, css_classes: "w-4 h-4 text-slate-600") %>
                    </div>

                    <!-- Category Name -->
                    <span class="flex-1 text-sm font-medium text-slate-900"><%= parent_cat.name %></span>

                    <!-- Expand Arrow (only if has children) -->
                    <% if has_children %>
                      <svg data-parent-arrow="<%= parent_cat.id %>"
                           class="w-4 h-4 text-slate-400 transition-transform flex-shrink-0"
                           fill="none"
                           stroke="currentColor"
                           viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                      </svg>
                    <% end %>
                  </button>

                  <!-- Subcategories (hidden by default) -->
                  <% if has_children %>
                    <div data-parent-submenu="<%= parent_cat.id %>"
                         class="hidden bg-slate-50 border-b border-slate-100">
                      <% parent_cat.children.order(:name).each do |child_cat| %>
                        <button type="button"
                                data-action="click->category-selector#selectCategory"
                                data-category-id="<%= child_cat.id %>"
                                data-category-name="<%= child_cat.name %>"
                                data-has-children="false"
                                data-is-parent="false"
                                class="w-full px-4 py-2.5 pl-14 flex items-center space-x-3 hover:bg-slate-100 active:bg-slate-200 transition-colors text-left">

                          <!-- Icon -->
                          <div class="w-7 h-7 bg-white rounded-lg flex items-center justify-center flex-shrink-0 shadow-sm">
                            <%= icon_svg(child_cat.icon, css_classes: "w-3.5 h-3.5 text-slate-600") %>
                          </div>

                          <!-- Category Name -->
                          <span class="flex-1 text-sm text-slate-700"><%= child_cat.name %></span>
                        </button>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
            <% if saving.errors[:category_id].any? %>
              <p class="mt-1 text-sm text-red-600"><%= saving.errors[:category_id].first %></p>
            <% end %>
          </div>

        <!-- Bank Account -->
        <div>
          <%= f.label :bank_account_id, class: "block text-sm font-medium text-slate-700 mb-2", data: { auto_link_toggle_target: "bankAccountLabel" } do %>
            <%= t('savings.bank_account') %>
            <span class="text-slate-400 text-xs optional-indicator">(<%= t('form_actions.optional') %>)</span>
            <span class="text-red-500 required-indicator hidden">*</span>
          <% end %>
          <%= f.select :bank_account_id,
              options_from_collection_for_select(@bank_accounts, :id, :custom_name, saving.bank_account_id),
              { prompt: t('savings.select_bank_account') },
              { class: "w-full px-4 py-2 border #{saving.errors[:bank_account_id].any? ? 'border-red-500' : 'border-slate-300'} rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" } %>
          <% if saving.errors[:bank_account_id].any? %>
            <p class="mt-1 text-sm text-red-600"><%= saving.errors[:bank_account_id].first %></p>
          <% end %>
        </div>
      </div>

      <!-- Auto-Link Configuration -->
      <div class="border-t border-slate-200 pt-6 mt-4">
        <div class="flex items-center justify-between">
          <div>
            <%= f.label :auto_link_category, t('savings.auto_link_enable'),
                class: "text-sm font-medium text-slate-700" %>
            <p class="text-xs text-slate-500 mt-1"><%= t('savings.auto_link_description') %></p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <%= f.check_box :auto_link_category,
                class: "sr-only peer",
                data: {
                  auto_link_toggle_target: "checkbox",
                  action: "change->auto-link-toggle#toggle"
                } %>
            <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
          </label>
        </div>
      </div>
    </div>

    <!-- Calculation Settings -->
    <div data-controller="saving-calculation-settings"
         data-saving-calculation-settings-hide-text-value="<%= t('savings.hide_advanced_settings') %>"
         data-saving-calculation-settings-show-text-value="<%= t('savings.show_advanced_settings') %>">
      <!-- Toggle Button -->
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-slate-900"><%= t('savings.calculation_settings_label') %></h3>
        <button type="button" 
                class="text-sm text-blue-600 hover:text-blue-800 font-medium"
                data-saving-calculation-settings-target="toggleButton"
                data-action="click->saving-calculation-settings#toggle">
          <%= t('savings.show_advanced_settings') %>
        </button>
      </div>
      
      <p class="text-sm text-slate-500 mb-4"><%= t('savings.calculation_settings_help') %></p>

      <!-- Advanced Settings Content (hidden by default) -->
      <div class="hidden" data-saving-calculation-settings-target="content">
        <div class="space-y-6 p-4 bg-slate-50 rounded-lg border border-slate-200">
          <% %w[income expense transfer_in transfer_out].each do |type| %>
            <div class="border-b border-slate-200 pb-4 last:border-b-0 last:pb-0">
              <h4 class="text-sm font-medium text-slate-700 mb-3">
                <%= t("savings.calculation_settings.#{type}") %>
              </h4>
              <div class="flex space-x-6">
                <% %w[positive negative ignore].each do |option| %>
                  <label class="flex items-center">
                    <%= f.radio_button "calculation_settings_#{type}", option,
                        checked: saving.calculation_settings&.dig(type) == option,
                        class: "w-4 h-4 text-blue-600 border-slate-300 focus:ring-blue-500" %>
                    <span class="ml-2 text-xs text-slate-700">
                      <%= t("savings.calculation_settings.#{option}") %>
                    </span>
                  </label>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Notes -->
    <div>
      <%= f.label :notes, t('savings.notes'), class: "block text-sm font-medium text-slate-700 mb-2" %>
      <%= f.text_area :notes, rows: 3,
          class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
          placeholder: t('savings.notes_placeholder') %>
      <p class="mt-1 text-sm text-slate-500"><%= t('savings.notes_help') %></p>
    </div>

    <!-- Form Actions -->
    <div class="flex items-center justify-end space-x-3 pt-6 border-t border-slate-200">
      <%= link_to t('savings.cancel'), savings_path, 
          class: "inline-flex items-center px-4 py-2 border border-slate-300 text-sm font-medium rounded-lg text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
      <%= f.submit t('savings.save'),
          class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
    </div>
  <% end %>
</div>
