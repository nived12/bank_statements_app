<!-- TRANSACTIONS PAGE: Transaction Management -->
<div class="transactions-page">
  <div class="transactions-main">
    
    <!-- HEADER SECTION: Responsive Page Title and Actions -->
    <turbo-frame id="transactions-header" class="transactions-header-frame">
      <!-- DESKTOP HEADER -->
      <header class="transactions-header hidden md:block">
        <div class="transactions-header-actions">
          <div class="transactions-header-left">
            <h1 class="transactions-header-title"><%= t('navigation.transactions') %></h1>
            <p class="transactions-header-subtitle"><%= t('transactions.description') %></p>
          </div>
          <div class="transactions-header-right">
            <div class="flex space-x-3">
              <button id="duplicatesButton" onclick="checkForDuplicates()" class="transactions-button transactions-button-warning hidden">
                <svg class="transactions-button-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                </svg>
                <%= t('transactions.review_duplicates') %>
                <span id="duplicatesBadge" class="absolute -top-2 -right-2 bg-red-500 text-white text-xs rounded-full h-5 w-5 flex items-center justify-center hidden">0</span>
              </button>
              <%= link_to new_transaction_path, class: "transactions-button transactions-button-secondary", data: { turbo_frame: "_top" } do %>
                <svg class="transactions-button-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
                <%= t('transactions.add_transaction') %>
              <% end %>
              <%= link_to new_statement_file_path, class: "transactions-button transactions-button-primary", data: { turbo_frame: "_top" } do %>
                <svg class="transactions-button-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
                </svg>
                <%= t('quick_actions.upload_statement') %>
              <% end %>
            </div>
          </div>
        </div>
      </header>

      <!-- MOBILE HEADER -->
      <header class="mobile-transactions-header block md:hidden">
        <div class="mobile-transactions-header-content">
          <div class="mobile-transactions-header-left">
            <h1 class="mobile-transactions-title"><%= t('navigation.transactions') %></h1>
            <p class="mobile-transactions-subtitle"><%= t('transactions.description') %></p>
          </div>
          <div class="mobile-transactions-header-actions">
            <%= link_to new_transaction_path, class: "mobile-transactions-add-btn", data: { turbo_frame: "_top" } do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
              </svg>
            <% end %>
          </div>
        </div>
      </header>
    </turbo-frame>

    <!-- FILTER SECTION: Responsive Filter Bar -->
      <!-- DESKTOP FILTERS (hidden on mobile) -->
      <section class="transactions-filters hidden md:block" data-controller="transactions-filter">
      <!-- ACTIVE FILTERS CHIPS -->
      <% total_filters_count = [params[:bank_account_id], params[:statement_file_id], params[:transaction_type], params[:from_date], params[:to_date], params[:search]].compact.length %>
      <% if total_filters_count > 0 %>
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class="text-sm font-medium text-slate-700"><%= t('transactions.active_filters') %></span>
          <% if params[:bank_account_id].present? %>
            <% bank_account = @bank_accounts.find { |ba| ba.id.to_s == params[:bank_account_id] } %>
            <div class="inline-flex items-center bg-blue-100 text-blue-800 text-sm px-3 py-1 rounded-full">
              <span><%= bank_account&.custom_name || "#{bank_account&.bank_display_name} - ••••#{bank_account&.account_number&.last(4)}" %></span>
              <button data-action="click->transactions-filter#clearFilter" data-transactions-filter-name-param="bank_account_id" class="ml-2 text-blue-600 hover:text-blue-800">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
          <% end %>

          <% if params[:statement_file_id].present? %>
            <div class="inline-flex items-center bg-green-100 text-green-800 text-sm px-3 py-1 rounded-full">
              <span><%= @statement_file&.safe_filename %></span>
              <button data-action="click->transactions-filter#clearFilter" data-transactions-filter-name-param="statement_file_id" class="ml-2 text-green-600 hover:text-green-800">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
          <% end %>

          <% if params[:transaction_type].present? %>
            <div class="inline-flex items-center bg-purple-100 text-purple-800 text-sm px-3 py-1 rounded-full">
              <span><%= t("transaction_types.#{params[:transaction_type]}") %></span>
              <button data-action="click->transactions-filter#clearFilter" data-transactions-filter-name-param="transaction_type" class="ml-2 text-purple-600 hover:text-purple-800">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
          <% end %>

          <% if params[:from_date].present? || params[:to_date].present? %>
            <div class="inline-flex items-center bg-orange-100 text-orange-800 text-sm px-3 py-1 rounded-full">
              <span>
                <% if params[:from_date].present? && params[:to_date].present? %>
                  <%= params[:from_date] %> - <%= params[:to_date] %>
                <% elsif params[:from_date].present? %>
                  <%= t('transactions.from_date_label') %> <%= params[:from_date] %>
                <% else %>
                  <%= t('transactions.to_date_label') %> <%= params[:to_date] %>
                <% end %>
              </span>
              <button data-action="click->transactions-filter#clearDateFilter" class="ml-2 text-orange-600 hover:text-orange-800">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
          <% end %>

          <% if params[:search].present? %>
            <div class="inline-flex items-center bg-indigo-100 text-indigo-800 text-sm px-3 py-1 rounded-full">
              <span><%= t('transactions.search_filter', query: params[:search]) %></span>
              <button data-action="click->transactions-filter#clearSearch" class="ml-2 text-indigo-600 hover:text-indigo-800">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
          <% end %>

          <% if total_filters_count > 0 %>
            <button data-action="click->transactions-filter#clearAllFilters" class="text-sm text-red-600 hover:text-red-800 font-medium">
              <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
              <%= t('transactions.clear_all_filters') %>
            </button>
          <% end %>
        </div>
      <% end %>

      <!-- SEARCH BAR -->
      <form data-turbo-frame="transactions-stats-and-results" data-turbo-action="advance" method="get" class="mb-4"
            data-transactions-filter-target="form">
        <!-- Hidden inputs to preserve sort parameters (synced by Stimulus after sort) -->
        <input type="hidden" name="sort" value="<%= params[:sort] %>" data-transactions-filter-target="sortInput">
        <input type="hidden" name="direction" value="<%= params[:direction] %>" data-transactions-filter-target="directionInput">

        <div class="max-w-md">
          <label for="search" class="block text-xs font-medium text-slate-600 mb-1"><%= t('transactions.search_description') %></label>
          <div class="relative">
            <input type="text"
                   id="search"
                   name="search"
                   value="<%= params[:search] %>"
                   placeholder="<%= t('transactions.search_placeholder') %>"
                   class="w-full px-3 py-2 pl-10 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                   data-transactions-filter-target="searchInput"
                   data-action="input->transactions-filter#search keydown->transactions-filter#searchKeydown">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <% if params[:search].present? %>
              <button type="button" data-action="click->transactions-filter#clearSearch" class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            <% end %>
          </div>
        </div>

        <!-- INLINE FILTER BAR -->
        <div class="flex items-center space-x-4 mb-6">
        <!-- BANK ACCOUNT FILTER -->
        <div class="flex-1 min-w-[200px]">
          <label for="bank_account_id" class="block text-xs font-medium text-slate-600 mb-1"><%= t('transactions.bank_account_filter') %></label>
          <select name="bank_account_id" id="bank_account_id" class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  data-transactions-filter-target="bankAccountSelect"
                  data-action="change->transactions-filter#bankAccountChanged">
            <option value=""><%= t('transactions.all_accounts') %></option>
            <% @bank_accounts.each do |ba| %>
              <option value="<%= ba.id %>" <%= "selected" if params[:bank_account_id].to_s == ba.id.to_s %>>
                <%= ba.custom_name || "#{ba.bank_display_name} - ••••#{ba.account_number.last(4)}" %>
              </option>
            <% end %>
          </select>
        </div>

        <!-- STATEMENT FILE FILTER -->
        <div class="flex-1 min-w-[200px]">
          <label for="statement_file_id" class="block text-xs font-medium text-slate-600 mb-1"><%= t('transactions.statement_file_filter') %></label>
          <select name="statement_file_id" id="statement_file_id" class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  data-transactions-filter-target="statementFileSelect"
                  data-action="change->transactions-filter#applyFilter">
            <option value=""><%= t('transactions.all_statement_files') %></option>
            <% @statement_files.each do |sf| %>
              <option value="<%= sf.id %>" <%= "selected" if params[:statement_file_id].to_s == sf.id.to_s %>>
                <%= sf.safe_filename %> - <%= sf.bank_account.display_name %>
              </option>
            <% end %>
          </select>
        </div>

        <!-- TRANSACTION TYPE FILTER -->
        <div class="flex-1 min-w-[150px]">
          <label for="transaction_type" class="block text-xs font-medium text-slate-600 mb-1"><%= t('transactions.transaction_type_filter') %></label>
          <select name="transaction_type" id="transaction_type" class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  data-transactions-filter-target="transactionTypeSelect"
                  data-action="change->transactions-filter#applyFilter">
            <option value=""><%= t('transactions.all_transaction_types') %></option>
            <option value="income" <%= "selected" if params[:transaction_type] == "income" %>><%= t('transaction_types.income') %></option>
            <option value="fixed_expense" <%= "selected" if params[:transaction_type] == "fixed_expense" %>><%= t('transaction_types.fixed_expense') %></option>
            <option value="variable_expense" <%= "selected" if params[:transaction_type] == "variable_expense" %>><%= t('transaction_types.variable_expense') %></option>
            <option value="transfer" <%= "selected" if params[:transaction_type] == "transfer" || params[:transaction_type] == "transfer_out" || params[:transaction_type] == "transfer_in" %>><%= t('transaction_types.transfer_out') %></option>
          </select>
        </div>

        <!-- DATE RANGE PICKER -->
        <div class="flex-1 min-w-[200px]" data-controller="date-range"
             data-date-range-from-date-value="<%= params[:from_date] %>"
             data-date-range-to-date-value="<%= params[:to_date] %>">
          <label for="date_range" class="block text-xs font-medium text-slate-600 mb-1"><%= t('transactions.date_range_filter') %></label>
          <input type="text"
                 id="date_range"
                 name="date_range"
                 placeholder="<%= t('transactions.click_to_select_range') %>"
                 class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                 data-date-range-target="input"
                 readonly>
          <input type="hidden" name="from_date" id="from_date" data-date-range-target="fromDate" data-transactions-filter-target="fromDate">
          <input type="hidden" name="to_date" id="to_date" data-date-range-target="toDate" data-transactions-filter-target="toDate">
        </div>
      </div>
      </form>
      </section>

      <!-- MOBILE FILTERS (visible only on mobile) -->
      <section class="mobile-transactions-filters block md:hidden">
        <!-- Search Bar (Always Visible) -->
        <div class="mobile-search-container" data-controller="search">
          <form data-search-target="form" data-turbo-frame="transactions-stats-and-results" data-turbo-action="advance" class="mobile-search-form" method="get">
            <!-- Hidden inputs to preserve other filter parameters -->
            <input type="hidden" name="bank_account_id" value="<%= params[:bank_account_id] %>">
            <input type="hidden" name="statement_file_id" value="<%= params[:statement_file_id] %>">
            <input type="hidden" name="transaction_type" value="<%= params[:transaction_type] %>">
            <input type="hidden" name="from_date" value="<%= params[:from_date] %>">
            <input type="hidden" name="to_date" value="<%= params[:to_date] %>">

            <div class="mobile-search-wrapper">
              <div class="mobile-search-icon-left">
                <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
              </div>

              <input type="text"
                     name="search"
                     value="<%= params[:search] %>"
                     placeholder="<%= t('transactions.search_placeholder') %>"
                     class="mobile-search-input"
                     data-search-target="input"
                     data-action="input->search#search keydown->search#search">

              <button type="button"
                      data-search-target="clearButton"
                      data-action="click->search#clear"
                      class="mobile-search-clear hidden">
                <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
          </form>
        </div>

        <!-- Filter Button and Controls -->
        <div class="mobile-filter-controls" data-controller="filter-drawer">
          <button type="button"
                  data-action="click->filter-drawer#toggle"
                  class="mobile-filter-button">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.414A1 1 0 013 6.707V4z"></path>
            </svg>
            <span><%= t('transactions.filters_title') %></span>
            <div data-filter-drawer-target="badge" class="mobile-filter-badge hidden">0</div>
          </button>

          <!-- Filter Drawer Overlay -->
          <div data-filter-drawer-target="overlay"
               class="mobile-filter-overlay opacity-0 pointer-events-none"
               data-action="click->filter-drawer#close">
          </div>

          <!-- Filter Drawer -->
          <div data-filter-drawer-target="drawer" class="mobile-filter-drawer translate-y-full">
            <form data-filter-drawer-target="form" data-turbo-frame="transactions-stats-and-results" data-turbo-action="advance" class="mobile-filter-form" method="get">
              <!-- Search is handled separately, so we include it as hidden to preserve it -->
              <input type="hidden" name="search" value="<%= params[:search] %>">

              <div class="mobile-filter-header">
                <h3><%= t('transactions.filters_title') %></h3>
                <div class="mobile-filter-actions">
                  <button type="button"
                          data-action="click->filter-drawer#clearAll"
                          class="mobile-filter-clear-all">
                    <%= t('transactions.clear_filters') %>
                  </button>
                  <button type="button"
                          data-action="click->filter-drawer#close"
                          class="mobile-filter-close">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                  </button>
                </div>
              </div>

              <div class="mobile-filter-content">
                <!-- Bank Account Filter -->
                <div class="mobile-filter-section">
                  <label class="mobile-filter-label"><%= t('transactions.bank_account_label') %></label>
                  <select name="bank_account_id"
                          data-action="change->filter-drawer#applyFilter"
                          class="mobile-filter-select">
                    <option value=""><%= t('transactions.all_accounts_option') %></option>
                    <% @bank_accounts.each do |ba| %>
                      <option value="<%= ba.id %>" <%= "selected" if params[:bank_account_id].to_s == ba.id.to_s %>>
                        <%= ba.custom_name || "#{ba.bank_display_name} - ••••#{ba.account_number.last(4)}" %>
                      </option>
                    <% end %>
                  </select>
                </div>

                <!-- Statement File Filter -->
                <div class="mobile-filter-section">
                  <label class="mobile-filter-label"><%= t('transactions.statement_file_label') %></label>
                  <select name="statement_file_id"
                          data-action="change->filter-drawer#applyFilter"
                          class="mobile-filter-select">
                    <option value=""><%= t('transactions.all_files_option') %></option>
                    <% @statement_files.each do |sf| %>
                      <option value="<%= sf.id %>" <%= "selected" if params[:statement_file_id].to_s == sf.id.to_s %>>
                        <%= sf.safe_filename %>
                      </option>
                    <% end %>
                  </select>
                </div>

                <!-- Transaction Type Filter -->
                <div class="mobile-filter-section">
                  <label class="mobile-filter-label"><%= t('transactions.transaction_type_label') %></label>
                  <div class="mobile-filter-chips">
                    <label class="mobile-filter-chip <%= 'active' if params[:transaction_type].blank? %>"
                           data-action="click->filter-drawer#selectChip">
                      <input type="radio" name="transaction_type" value=""
                             <%= "checked" if params[:transaction_type].blank? %>
                             data-action="change->filter-drawer#applyFilter">
                      <span><%= t('transactions.all_types_option') %></span>
                    </label>
                    <label class="mobile-filter-chip <%= 'active' if params[:transaction_type] == 'income' %>"
                           data-action="click->filter-drawer#selectChip">
                      <input type="radio" name="transaction_type" value="income"
                             <%= "checked" if params[:transaction_type] == 'income' %>
                             data-action="change->filter-drawer#applyFilter">
                      <span><%= t('transaction_types.income') %></span>
                    </label>
                    <label class="mobile-filter-chip <%= 'active' if params[:transaction_type] == 'fixed_expense' %>"
                           data-action="click->filter-drawer#selectChip">
                      <input type="radio" name="transaction_type" value="fixed_expense"
                             <%= "checked" if params[:transaction_type] == 'fixed_expense' %>
                             data-action="change->filter-drawer#applyFilter">
                      <span><%= t('transaction_types.fixed_expense') %></span>
                    </label>
                    <label class="mobile-filter-chip <%= 'active' if params[:transaction_type] == 'variable_expense' %>"
                           data-action="click->filter-drawer#selectChip">
                      <input type="radio" name="transaction_type" value="variable_expense"
                             <%= "checked" if params[:transaction_type] == 'variable_expense' %>
                             data-action="change->filter-drawer#applyFilter">
                      <span><%= t('transaction_types.variable_expense') %></span>
                    </label>
                  </div>
                </div>

                <!-- Date Range Filter -->
                <div class="mobile-filter-section" data-controller="date-range"
                     data-date-range-from-date-value="<%= params[:from_date] %>"
                     data-date-range-to-date-value="<%= params[:to_date] %>">
                  <label class="mobile-filter-label"><%= t('transactions.date_range_label') %></label>
                  <input type="text"
                         id="mobile_date_range"
                         placeholder="<%= t('transactions.date_range_placeholder') %>"
                         class="mobile-date-input w-full"
                         data-date-range-target="input"
                         readonly>
                  <input type="hidden" name="from_date" id="mobile_from_date" value="<%= params[:from_date] %>" data-date-range-target="fromDate">
                  <input type="hidden" name="to_date" id="mobile_to_date" value="<%= params[:to_date] %>" data-date-range-target="toDate">
                </div>
              </div>
            </form>
          </div>
        </div>
      </section>

    <!-- STATS AND RESULTS FRAME: Updates smoothly on filter/search -->
    <%= render "transactions/stats_and_results",
               transactions: @transactions,
               pagy: @pagy,
               current_sort: @current_sort,
               current_direction: @current_direction,
               filtered_transactions: @filtered_transactions,
               top_categories: @top_categories,
               filter_params_json: @filter_params_json %>
  </div>
</div>

<!-- DUPLICATES MODAL: Review and Process Duplicate Transactions -->
<div id="duplicatesModal" class="fixed inset-0 bg-slate-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-50">
  <div class="relative top-10 mx-auto p-5 border w-full max-w-6xl shadow-lg rounded-md bg-white">
    <div class="mt-3">
            <div class="flex items-center justify-between mb-6">
              <div>
                <h3 class="text-xl font-semibold text-slate-900"><%= t('transactions.review_duplicates') %></h3>
                <p class="text-sm text-slate-600 mt-1"><%= t('transactions.duplicates_description') %></p>
                <div class="mt-3 p-3 bg-amber-50 border border-amber-200 rounded-lg">
                  <div class="flex">
                    <svg class="w-5 h-5 text-amber-400 mt-0.5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                    </svg>
                    <p class="text-sm text-amber-800 font-medium"><%= t('transactions.duplicates_warning') %></p>
                  </div>
                </div>
              </div>
        <button onclick="closeDuplicatesModal()" class="text-slate-400 hover:text-slate-600 transition-colors duration-200">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      
      <!-- Statement Files List -->
      <div id="statementFilesList" class="mb-6">
        <!-- This will be populated by JavaScript -->
      </div>
      
      <!-- Duplicates Table -->
      <div id="duplicatesTable" class="hidden">
        <div class="mb-4">
          <h4 class="text-lg font-medium text-slate-900 mb-2" id="currentStatementFileTitle"></h4>
          <p class="text-sm text-slate-600" id="currentStatementFileInfo"></p>
        </div>
        
        <div class="overflow-x-auto">
          <table class="w-full border-collapse border border-slate-300">
            <thead class="bg-slate-50">
              <tr>
                <th class="border border-slate-300 px-4 py-2 text-left text-sm font-medium text-slate-700">
                  <%= t('transactions.select') %>
                </th>
                <th class="border border-slate-300 px-4 py-2 text-left text-sm font-medium text-slate-700">
                  <%= t('transactions.source') %>
                </th>
                <th class="border border-slate-300 px-4 py-2 text-left text-sm font-medium text-slate-700">
                  <%= t('table_headers.date') %>
                </th>
                <th class="border border-slate-300 px-4 py-2 text-left text-sm font-medium text-slate-700">
                  <%= t('table_headers.description') %>
                </th>
                <th class="border border-slate-300 px-4 py-2 text-right text-sm font-medium text-slate-700">
                  <%= t('table_headers.amount') %>
                </th>
              </tr>
            </thead>
            <tbody id="duplicatesTableBody">
              <!-- This will be populated by JavaScript -->
            </tbody>
          </table>
        </div>
        
        <div class="mt-6 flex justify-end space-x-3">
          <button onclick="closeDuplicatesModal()" class="px-4 py-2 border border-slate-300 text-sm font-medium rounded-lg text-slate-700 bg-white hover:bg-slate-50 transition-colors duration-200">
            <%= t('form_actions.cancel') %>
          </button>
          <button onclick="processSelectedDuplicates()" class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors duration-200">
            <%= t('transactions.process_selected') %>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>


<script>
// Keep deleteTransaction function for now (not part of Stimulus refactor)
function deleteTransaction(transactionId) {
  if (confirm('<%= t("transactions.confirm_delete") %>')) {
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = `<%= root_path %>transactions/${transactionId}`;

    const csrfToken = document.createElement('input');
    csrfToken.type = 'hidden';
    csrfToken.name = 'authenticity_token';
    csrfToken.value = '<%= form_authenticity_token %>';
    form.appendChild(csrfToken);

    const methodInput = document.createElement('input');
    methodInput.type = 'hidden';
    methodInput.name = '_method';
    methodInput.value = 'delete';
    form.appendChild(methodInput);

    document.body.appendChild(form);
    form.submit();
  }
}

// Preserve scroll position when sorting
function preserveScrollPosition() {
  sessionStorage.setItem('transactionsScrollPosition', window.scrollY);
}

// Restore scroll position after page load
function restoreScrollPosition() {
  const savedPosition = sessionStorage.getItem('transactionsScrollPosition');
  if (savedPosition) {
    requestAnimationFrame(() => {
      window.scrollTo({ top: parseInt(savedPosition), behavior: 'smooth' });
      sessionStorage.removeItem('transactionsScrollPosition');
    });
  }
}

document.addEventListener('DOMContentLoaded', restoreScrollPosition);
document.addEventListener('turbo:load', restoreScrollPosition);
document.addEventListener('turbo:render', restoreScrollPosition);
// Grouped Category Dropdown Functionality
function initializeGroupedCategoryDropdowns() {
  // Initialize both create and edit dropdowns
  initializeDropdown('create_category_id', 'create_category_dropdown');
  initializeDropdown('edit_category_id', 'edit_category_dropdown');
}

function initializeDropdown(selectId, dropdownId) {
  const select = document.getElementById(selectId);
  const dropdown = document.getElementById(dropdownId);
  
  if (!select || !dropdown) {
    return;
  }
  
  // Ensure dropdown is hidden initially (CSS should handle this, but just to be sure)
  dropdown.classList.add('hidden');
  dropdown.classList.remove('show');

  // Toggle dropdown visibility
  select.addEventListener('click', function(e) {
    e.preventDefault();
    e.stopPropagation();
    toggleDropdown(dropdown);
  });

  // Handle parent category hover
  const parentItems = dropdown.querySelectorAll('.grouped-category-item.parent[data-has-children="true"]');
  
  parentItems.forEach(parentItem => {
    const submenu = parentItem.querySelector('.grouped-category-submenu');
    
    parentItem.addEventListener('mouseenter', function(e) {
      e.stopPropagation();
      if (submenu) {
        // Close all other submenus first
        dropdown.querySelectorAll('.grouped-category-submenu.show').forEach(sm => {
          sm.classList.remove('show');
        });
        submenu.classList.add('show');
      }
    });

    parentItem.addEventListener('mouseleave', function(e) {
      e.stopPropagation();
      if (submenu) {
        // Add a small delay to prevent flickering
        setTimeout(() => {
          if (!submenu.matches(':hover')) {
            submenu.classList.remove('show');
          }
        }, 100);
      }
    });

    // Also handle submenu hover to keep it open
    if (submenu) {
      submenu.addEventListener('mouseenter', function(e) {
        e.stopPropagation();
        submenu.classList.add('show');
      });

      submenu.addEventListener('mouseleave', function(e) {
        e.stopPropagation();
        submenu.classList.remove('show');
      });
    }
  });

  // Handle parent category selection
  const allParentItems = dropdown.querySelectorAll('.grouped-category-item.parent');
  allParentItems.forEach(parentItem => {
    parentItem.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      
      const categoryId = parentItem.getAttribute('data-category-id');
      const hasChildren = parentItem.getAttribute('data-has-children') === 'true';
      
      if (!hasChildren) {
        selectCategory(select, dropdown, categoryId, parentItem);
      }
    });
  });

  // Handle child category selection
  const childItems = dropdown.querySelectorAll('.grouped-category-item.child');
  childItems.forEach(childItem => {
    const checkbox = childItem.querySelector('.grouped-category-checkbox');
    const label = childItem.querySelector('label');
    
    [checkbox, label].forEach(element => {
      if (element) {
        element.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          
          const categoryId = childItem.getAttribute('data-category-id');
          selectCategory(select, dropdown, categoryId, childItem);
        });
      }
    });
  });

  // Close dropdown when clicking outside
  document.addEventListener('click', function(e) {
    if (!select.contains(e.target) && !dropdown.contains(e.target)) {
      dropdown.classList.remove('show');
      dropdown.classList.add('hidden');
    }
  });
}

function toggleDropdown(dropdown) {
  const isVisible = dropdown.classList.contains('show');
  
  // Close all other dropdowns first
  document.querySelectorAll('.grouped-category-dropdown-content.show').forEach(d => {
    d.classList.remove('show');
    d.classList.add('hidden');
  });
  
  // Toggle current dropdown
  if (!isVisible) {
    dropdown.classList.remove('hidden');
    dropdown.classList.add('show');
  } else {
    dropdown.classList.remove('show');
    dropdown.classList.add('hidden');
  }
}

function selectCategory(select, dropdown, categoryId, selectedElement) {
  // Update the select value
  select.value = categoryId;
  
  // Update visual selection
  dropdown.querySelectorAll('.grouped-category-item').forEach(item => {
    item.classList.remove('selected');
  });
  selectedElement.classList.add('selected');
  
  // Close dropdown
  dropdown.classList.remove('show');
  dropdown.classList.add('hidden');
  
  // Trigger change event
  select.dispatchEvent(new Event('change'));
}

// Function to reset dropdown state
function resetDropdownState(dropdownId) {
  const dropdown = document.getElementById(dropdownId);
  if (dropdown) {
    dropdown.classList.add('hidden');
    dropdown.classList.remove('show');
    // Close all submenus (CSS should handle this, but just to be sure)
    dropdown.querySelectorAll('.grouped-category-submenu').forEach(submenu => {
      submenu.classList.add('hidden');
      submenu.classList.remove('show');
    });
  }
}

// Initialize dropdowns when DOM is loaded
document.addEventListener('DOMContentLoaded', function() {
  initializeGroupedCategoryDropdowns();
  // Only check for duplicates if we're actually on the transactions index page
  if (window.location.pathname === '/transactions') {
    checkForDuplicatesOnLoad();
  }
});

// Also run when Turbo loads content
document.addEventListener('turbo:load', function() {
  initializeGroupedCategoryDropdowns();
  // Only check for duplicates if we're actually on the transactions index page
  if (window.location.pathname === '/transactions') {
    checkForDuplicatesOnLoad();
  }
});

// Duplicates functionality - protect from redeclaration
if (typeof window.currentStatementFileId === 'undefined') {
  window.currentStatementFileId = null;
}
if (typeof window.duplicatesData === 'undefined') {
  window.duplicatesData = {};
}

function checkForDuplicatesOnLoad() {
  
  fetch('/transactions/check_duplicates', {
    headers: {
      'X-Requested-With': 'XMLHttpRequest',
      'Accept': 'application/json'
    }
  })
  .then(response => {
    return response.json();
  })
  .then(data => {
    if (data.has_duplicates) {
      showDuplicatesButton(data.statement_files);
    } else {
      hideDuplicatesButton();
    }
  })
  .catch(error => {
    hideDuplicatesButton(); // Hide on error
  });
}

function checkForDuplicates() {
  fetch('/transactions/check_duplicates', {
    headers: {
      'X-Requested-With': 'XMLHttpRequest',
      'Accept': 'application/json'
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.has_duplicates) {
      window.duplicatesData = data;
      showDuplicatesModal(data.statement_files);
    } else {
      hideDuplicatesButton();
    }
  })
  .catch(error => {
  });
}

function showDuplicatesButton(statementFiles) {
  const button = document.getElementById('duplicatesButton');
  const badge = document.getElementById('duplicatesBadge');
  
  if (button && badge) {
    button.classList.remove('hidden');
    badge.classList.remove('hidden');
    badge.textContent = statementFiles.length;
  } else {
  }
}

function hideDuplicatesButton() {
  const button = document.getElementById('duplicatesButton');
  const badge = document.getElementById('duplicatesBadge');
  
  if (button && badge) {
    button.classList.add('hidden');
    badge.classList.add('hidden');
  }
}

function showDuplicatesModal(statementFiles) {
  const modal = document.getElementById('duplicatesModal');
  const statementFilesList = document.getElementById('statementFilesList');
  
  // Create statement files list
  let html = '<div class="space-y-3">';
  statementFiles.forEach(file => {
    html += `
      <div class="border border-slate-300 rounded-lg p-4 cursor-pointer hover:bg-slate-50 transition-colors duration-200" onclick="selectStatementFile(${file.id})">
        <div class="flex justify-between items-center">
          <div>
            <h5 class="font-medium text-slate-900">${file.filename}</h5>
            <p class="text-sm text-slate-600">${file.bank_name} - ••••${file.account_number}</p>
          </div>
          <div class="text-right">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
              ${file.pending_duplicates_count} duplicados
            </span>
          </div>
        </div>
      </div>
    `;
  });
  html += '</div>';
  
  statementFilesList.innerHTML = html;
  modal.classList.remove('hidden');
}

function selectStatementFile(statementFileId) {
  window.currentStatementFileId = statementFileId;
  
  // Find the statement file data
  const statementFile = window.duplicatesData.statement_files.find(sf => sf.id === statementFileId);
  
  // Update the table title
  document.getElementById('currentStatementFileTitle').textContent = statementFile.filename;
  document.getElementById('currentStatementFileInfo').textContent = `${statementFile.bank_name} - ••••${statementFile.account_number}`;
  
  // Load duplicates for this statement file
  loadDuplicatesForStatementFile(statementFileId);
}

function loadDuplicatesForStatementFile(statementFileId) {
  const tableBody = document.getElementById('duplicatesTableBody');
  const duplicatesTable = document.getElementById('duplicatesTable');
  
  // Show the table
  duplicatesTable.classList.remove('hidden');
  
  // Show loading state
  tableBody.innerHTML = `
    <tr>
      <td colspan="5" class="border border-slate-300 px-4 py-8 text-center text-slate-500">
        Cargando duplicados...
      </td>
    </tr>
  `;
  
  // Fetch duplicates for this statement file
  fetch(`/transactions/get_duplicates?statement_file_id=${statementFileId}`, {
    headers: {
      'X-Requested-With': 'XMLHttpRequest',
      'Accept': 'application/json'
    }
  })
  .then(response => response.json())
  .then(data => {
    renderDuplicatesTable(data.duplicates);
  })
  .catch(error => {
    tableBody.innerHTML = `
      <tr>
        <td colspan="5" class="border border-slate-300 px-4 py-8 text-center text-red-500">
          Error al cargar duplicados. Por favor intenta de nuevo.
        </td>
      </tr>
    `;
  });
}


// Function to format date in Spanish locale (matching format_local_time helper)
// Note: transaction.date is already stored in local timezone, so no conversion needed
function formatDateForDuplicates(dateString) {
  if (!dateString) return '';
  
  try {
    // Parse the date string (already in local timezone)
    const date = new Date(dateString + 'T00:00:00'); // Add time to avoid timezone issues
    
    const options = { 
      year: 'numeric', 
      month: 'long', 
      day: 'numeric'
      // No timeZone option needed since date is already in local timezone
    };
    
    return date.toLocaleDateString('es-MX', options);
  } catch (error) {
    return dateString; // Fallback to original string
  }
}

function renderDuplicatesTable(duplicates) {
  const tableBody = document.getElementById('duplicatesTableBody');
  
  if (duplicates.length === 0) {
    tableBody.innerHTML = `
      <tr>
        <td colspan="5" class="border border-slate-300 px-4 py-8 text-center text-slate-500">
          No se encontraron duplicados para este estado de cuenta.
        </td>
      </tr>
    `;
    return;
  }
  
  let html = '';
  
  duplicates.forEach(group => {
    group.transactions.forEach((transaction, index) => {
      const isManual = transaction.source === 'manual';
      const isFirstInGroup = index === 0;
      
      html += `
        <tr class="${isFirstInGroup ? 'border-t-2 border-slate-400' : ''}">
          <td class="border border-slate-300 px-4 py-2 text-center">
            <input type="checkbox" 
                   value="${transaction.id}" 
                   ${isManual ? 'checked' : ''}
                   class="duplicate-checkbox rounded border-slate-300 text-blue-600 focus:ring-blue-500">
          </td>
          <td class="border border-slate-300 px-4 py-2">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${isManual ? 'bg-blue-100 text-blue-800' : 'bg-green-100 text-green-800'}">
              ${isManual ? 'Manual' : 'Estado de Cuenta'}
            </span>
          </td>
          <td class="border border-slate-300 px-4 py-2 text-sm">
            ${formatDateForDuplicates(transaction.date)}
          </td>
          <td class="border border-slate-300 px-4 py-2 text-sm">
            <div>
              <div class="font-medium">${transaction.description}</div>
              <div class="text-xs text-slate-500">${transaction.category_name}</div>
            </div>
          </td>
          <td class="border border-slate-300 px-4 py-2 text-right text-sm font-medium ${transaction.amount >= 0 ? 'text-green-600' : 'text-red-600'}">
            $${Math.abs(transaction.amount).toFixed(2)}
          </td>
        </tr>
      `;
    });
  });
  
  tableBody.innerHTML = html;
}

function processSelectedDuplicates() {
  const checkboxes = document.querySelectorAll('#duplicatesTableBody input[type="checkbox"]:checked');
  const selectedIds = Array.from(checkboxes).map(cb => cb.value);
  
  if (selectedIds.length === 0) {
    alert('Por favor selecciona al menos una transacción para procesar.');
    return;
  }
  
  // Process the selected duplicates
  fetch('/transactions/process_duplicates', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-Requested-With': 'XMLHttpRequest',
      'Accept': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
    },
    body: JSON.stringify({
      statement_file_id: window.currentStatementFileId,
      selected_transaction_ids: selectedIds
    })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      alert(`Se procesaron ${data.processed_count} transacciones exitosamente.`);
      closeDuplicatesModal();
      // Refresh the page to show updated data
      window.location.reload();
    } else {
      alert('Error al procesar duplicados: ' + data.error);
    }
  })
  .catch(error => {
    alert('Error al procesar duplicados. Por favor intenta de nuevo.');
  });
}

function closeDuplicatesModal() {
  const modal = document.getElementById('duplicatesModal');
  modal.classList.add('hidden');
  
  // Reset state
  window.currentStatementFileId = null;
  document.getElementById('duplicatesTable').classList.add('hidden');
}

// Close modal when clicking outside
document.getElementById('duplicatesModal').addEventListener('click', function(e) {
  if (e.target === this) {
    closeDuplicatesModal();
  }
});

// Mobile-specific functions

// Toggle date group expansion/collapse
function toggleDateGroup(dateString) {
  const transactionsContainer = document.getElementById(`transactions-${dateString}`);
  const chevron = document.querySelector(`[onclick="toggleDateGroup('${dateString}')"] .mobile-date-chevron`);

  if (transactionsContainer && chevron) {
    if (transactionsContainer.style.display === 'none') {
      transactionsContainer.style.display = 'block';
      chevron.style.transform = 'rotate(0deg)';
    } else {
      transactionsContainer.style.display = 'none';
      chevron.style.transform = 'rotate(-90deg)';
    }
  }
}

// Open transaction details modal/overlay
function openTransactionDetails(transactionId) {

  // Store transaction ID for saving
  window.currentMobileTransactionId = transactionId;

  // Get transaction data
  const transactionData = getTransactionData(transactionId);
  if (!transactionData) {
    return;
  }

  // Test if modal exists
  const modal = document.getElementById('mobileTransactionDetailsModal');
  const content = document.getElementById('mobileDetailsContent');

  if (!modal || !content) {
    return;
  }

  // Populate modal with real data
  populateMobileTransactionDetails(transactionData);

  // Show modal and animate content
  modal.style.display = 'block';
  content.style.transform = 'translateY(100%)';

  setTimeout(() => {
    content.style.transform = 'translateY(0)';
  }, 10);
}

// Initialize mobile interactions on page load
document.addEventListener('DOMContentLoaded', function() {
  initializeMobileSwipeGestures();
});

document.addEventListener('turbo:load', function() {
  initializeMobileSwipeGestures();
});

// Initialize swipe-to-delete gestures for mobile transaction cards
function initializeMobileSwipeGestures() {
  const swipeableCards = document.querySelectorAll('[data-swipeable="true"]');

  swipeableCards.forEach(card => {
    let startX = 0;
    let currentX = 0;
    let isDragging = false;
    const threshold = 100; // Minimum swipe distance to trigger delete

    // Touch start
    card.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      isDragging = true;
      card.style.transition = 'none';
    });

    // Touch move
    card.addEventListener('touchmove', (e) => {
      if (!isDragging) return;

      currentX = e.touches[0].clientX;
      const deltaX = currentX - startX;

      // Only allow left swipes (negative deltaX)
      if (deltaX < 0) {
        const translateX = Math.max(deltaX, -150); // Max swipe distance
        card.style.transform = `translateX(${translateX}px)`;

        // Show delete action when swiped enough
        const deleteAction = card.querySelector('.mobile-transaction-delete-action');
        if (deleteAction) {
          deleteAction.style.opacity = Math.min(Math.abs(deltaX) / threshold, 1);
        }
      }
    });

    // Touch end
    card.addEventListener('touchend', (e) => {
      if (!isDragging) return;
      isDragging = false;

      const deltaX = currentX - startX;
      card.style.transition = 'transform 0.3s ease, opacity 0.3s ease';

      if (Math.abs(deltaX) > threshold) {
        // Swipe was far enough - keep showing delete option
        card.style.transform = 'translateX(-80px)';
        const deleteAction = card.querySelector('.mobile-transaction-delete-action');
        if (deleteAction) {
          deleteAction.style.opacity = '1';
        }
      } else {
        // Snap back to original position
        card.style.transform = 'translateX(0)';
        const deleteAction = card.querySelector('.mobile-transaction-delete-action');
        if (deleteAction) {
          deleteAction.style.opacity = '0';
        }
      }
    });

    // Reset card position when clicking elsewhere
    document.addEventListener('click', (e) => {
      if (!card.contains(e.target)) {
        card.style.transition = 'transform 0.3s ease, opacity 0.3s ease';
        card.style.transform = 'translateX(0)';
        const deleteAction = card.querySelector('.mobile-transaction-delete-action');
        if (deleteAction) {
          deleteAction.style.opacity = '0';
        }
      }
    });
  });
}
</script>
