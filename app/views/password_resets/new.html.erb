<!-- AUTHENTICATION PAGE: Forgot Password Form -->
<main class="auth-page">

  <!-- LANGUAGE SWITCHER: Top Right Corner -->
  <aside class="auth-language-switcher">
    <%= render 'shared/language_switcher', fixed_position: true %>
  </aside>

  <!-- BRAND SECTION: Left Side Logo and Title -->
  <section class="auth-brand-section">
    <div class="auth-brand-container">
      <div class="auth-brand-logo">
        <%= render "shared/logo", image_class: "auth-brand-logo-icon" %>
      </div>
      <p class="auth-brand-subtitle"><%= t('brand.tagline') %></p>
    </div>
  </section>

  <!-- FORM SECTION: Center Password Reset Form -->
  <section class="auth-form-section">
    <div class="auth-form-container">

      <!-- LOGO: Above Form Card (Mobile Only) -->
      <div class="auth-brand-logo md:hidden" style="margin-bottom: 2rem; text-align: center;">
        <%= render "shared/logo", image_class: "auth-brand-logo-icon" %>
      </div>

      <!-- FORM CARD: Main Container -->
      <div class="auth-form-card">

        <!-- FORM HEADER: Title and Subtitle -->
        <header class="auth-form-header">
          <h2 class="auth-form-title"><%= t('password_resets.new.title') %></h2>
          <p class="text-sm text-slate-600 mt-2">
            <%= t('password_resets.new.description') %>
          </p>
        </header>

        <!-- FORM CONTENT: Email Input -->
        <div class="auth-form">

          <!-- PASSWORD RESET FORM -->
          <%= form_with url: password_resets_path, method: :post, class: "auth-form-field" do |form| %>

            <!-- EMAIL FIELD -->
            <div class="auth-field-group">
              <label for="email" class="auth-field-label">
                <%= t('password_resets.new.email_label') %>
              </label>
              <%= email_field_tag :email, params[:email],
                  id: "email",
                  autocomplete: "email",
                  required: true,
                  class: "auth-field-input",
                  placeholder: t('password_resets.new.email_placeholder') %>
            </div>

            <!-- SUBMIT BUTTON: Send Reset Instructions -->
            <div class="auth-submit-container">
              <%= button_tag type: "submit", class: "auth-submit-button" do %>
                <%= t('password_resets.new.submit_button') %>
              <% end %>
            </div>
          <% end %>

          <!-- ACCOUNT LINKS: Back to Sign In -->
          <div class="auth-account-links">
            <p class="auth-account-text">
              <%= t('password_resets.new.remember_password') %>
              <%= link_to t('password_resets.new.sign_in_link'), new_session_path, class: "auth-account-link" %>
            </p>
          </div>
        </div>

        <!-- FOOTER: Terms and Privacy -->
        <footer class="auth-footer">
          <p class="auth-footer-text">
            <%= t('session.terms_privacy') %>
          </p>
        </footer>
      </div>
    </div>
  </section>

  <!-- PLACEHOLDER SECTION: Right Side Image and Text -->
  <section class="auth-placeholder-section">
    <div class="auth-placeholder-container">
      <div class="auth-placeholder-image">
        <svg class="auth-placeholder-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
        </svg>
      </div>
      <h3 class="auth-placeholder-title"><%= t('password_resets.new.security_title') %></h3>
      <p class="auth-placeholder-description"><%= t('password_resets.new.security_description') %></p>
    </div>
  </section>
</main>
