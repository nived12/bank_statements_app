<!-- Profile Edit Page -->
<div class="max-w-2xl mx-auto px-4 sm:px-6 py-8">
  <!-- Header -->
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100"><%= t("profile.title") %></h1>
    <p class="text-sm text-slate-500 dark:text-slate-400 mt-1"><%= t("profile.subtitle") %></p>
  </div>

  <%= form_with(model: current_user,
                url: profile_path,
                method: :patch,
                multipart: true,
                class: "space-y-6") do |f| %>

    <!-- Avatar Section -->
    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6">
      <h2 class="text-base font-semibold text-slate-800 dark:text-slate-200 mb-4"><%= t("profile.avatar_section") %></h2>

      <div class="flex items-center gap-5">
        <!-- Current avatar preview -->
        <div class="relative">
          <img id="avatar-preview"
               src="<%= user_avatar_url(current_user) %>"
               alt="<%= current_user.full_name %>"
               class="w-20 h-20 rounded-full object-cover border-2 border-slate-200 dark:border-slate-700">
        </div>

        <div>
          <label class="cursor-pointer inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors">
            <%= icon("upload", library: "lucide", variant: "outline", class: "w-4 h-4") %>
            <span id="avatar-upload-label"><%= t("profile.upload_avatar") %></span>
            <%= f.file_field :avatar_image,
                accept: "image/*",
                class: "hidden",
                data: { action: "change->profile#previewAvatar", profile_target: "avatarInput" } %>
          </label>
          <p class="text-xs text-slate-400 mt-2"><%= t("profile.avatar_hint") %></p>
        </div>
      </div>
    </div>

    <!-- Personal Info -->
    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6">
      <h2 class="text-base font-semibold text-slate-800 dark:text-slate-200 mb-4"><%= t("profile.personal_info") %></h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- First Name -->
        <div>
          <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">
            <%= t("profile.first_name") %>
            <span class="text-red-500">*</span>
          </label>
          <%= f.text_field :first_name,
              required: true,
              autocomplete: "given-name",
              class: "w-full px-3 py-2 border #{ current_user.errors[:first_name].any? ? 'border-red-400 bg-red-50' : 'border-slate-300 dark:border-slate-600' } rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          <% if current_user.errors[:first_name].any? %>
            <p class="text-xs text-red-600 mt-1"><%= current_user.errors[:first_name].first %></p>
          <% end %>
        </div>

        <!-- Last Name -->
        <div>
          <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">
            <%= t("profile.last_name") %>
            <span class="text-red-500">*</span>
          </label>
          <%= f.text_field :last_name,
              required: true,
              autocomplete: "family-name",
              class: "w-full px-3 py-2 border #{ current_user.errors[:last_name].any? ? 'border-red-400 bg-red-50' : 'border-slate-300 dark:border-slate-600' } rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          <% if current_user.errors[:last_name].any? %>
            <p class="text-xs text-red-600 mt-1"><%= current_user.errors[:last_name].first %></p>
          <% end %>
        </div>
      </div>

      <!-- Email (read-only) -->
      <div class="mt-4">
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">
          <%= t("profile.email") %>
        </label>
        <div class="w-full px-3 py-2 border border-slate-200 dark:border-slate-700 rounded-lg text-sm text-slate-500 dark:text-slate-400 bg-slate-50 dark:bg-slate-900">
          <%= current_user.email %>
        </div>
        <p class="text-xs text-slate-400 mt-1"><%= t("profile.email_hint") %></p>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center justify-between">
      <%= link_to t("form_actions.cancel"), root_path,
          class: "px-5 py-2 border border-slate-300 dark:border-slate-600 text-sm font-medium text-slate-700 dark:text-slate-300 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-700 dark:bg-slate-900 transition-colors" %>
      <%= f.submit t("profile.save_button"),
          class: "px-5 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors" %>
    </div>
  <% end %>

  <div class="mt-10 border border-red-200 rounded-lg p-5 bg-white">
    <h3 class="text-xs font-semibold uppercase tracking-wider text-red-500 mb-3">
      <%= t("profile.delete.danger_zone") %>
    </h3>
    <%= link_to confirm_delete_profile_path,
        class: "inline-flex items-center text-sm text-red-500 hover:text-red-700 font-medium" do %>
      <%= t("profile.delete.delete_account") %>
      <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    <% end %>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
function initAvatarPreview() {
  const fileInput = document.querySelector('input[type="file"][name="user[avatar_image]"]');
  const preview = document.getElementById("avatar-preview");
  const uploadLabel = document.getElementById("avatar-upload-label");
  if (!fileInput || !preview) return;
  fileInput.addEventListener("change", function(e) {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (evt) => {
      preview.src = evt.target.result;
      preview.classList.add("ring-2", "ring-indigo-500", "ring-offset-2");
      if (uploadLabel) uploadLabel.textContent = "✓ " + file.name.substring(0, 24);
    };
    reader.readAsDataURL(file);
  });
}
document.addEventListener("DOMContentLoaded", initAvatarPreview);
document.addEventListener("turbo:load", initAvatarPreview);
</script>
