<!-- BANK ACCOUNT FORM: Create/Edit Account -->
<%= form_with model: @bank_account, local: true, class: "space-y-6", data: { bank_account_form_target: "form" } do |f| %>

  <!-- ACCOUNT TYPE FIELD: Type of Bank Account -->
  <div>
    <%= required_field_label(f, :account_type, t('bank_accounts.account_type')) %>
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 003 3v8a3 3 0 003 3z"></path>
        </svg>
      </div>
      <%= f.select :account_type,
          options_for_select([
            [t('account_type.debit'), 'debit'],
            [t('account_type.credit'), 'credit'],
            [t('account_type.cash'), 'cash']
          ], @bank_account.account_type),
          { prompt: t('bank_account_forms.select_account_type') },
          { required: true,
            data: { action: "change->bank-account-form#accountTypeChanged" },
            class: "w-full pl-10 pr-4 py-2 border #{@bank_account.errors[:account_type].any? ? 'border-red-500' : 'border-slate-300 dark:border-slate-600'} rounded-lg focus:ring-2 focus:ring-blue-500 focus:bg-white dark:bg-slate-800 transition-colors" } %>
    </div>
    <% if @bank_account.errors[:account_type].any? %>
      <p class="mt-1 text-sm text-red-600"><%= @bank_account.errors[:account_type].first %></p>
    <% else %>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= t('bank_account_forms.account_type_help') %></p>
    <% end %>
  </div>

  <!-- CASH ACCOUNT EXPLANATION (hidden by default) -->
  <div class="<%= @bank_account.cash? ? '' : 'hidden' %> p-4 bg-amber-50 border border-amber-200 rounded-xl" data-bank-account-form-target="cashExplanation">
    <div class="flex items-start">
      <svg class="w-5 h-5 text-amber-600 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <div>
        <p class="text-sm font-medium text-amber-800"><%= t('bank_account_forms.cash_explanation_title') %></p>
        <p class="text-sm text-amber-700 mt-1"><%= t('bank_account_forms.cash_explanation') %></p>
      </div>
    </div>
  </div>

  <!-- CREDIT ACCOUNT EXPLANATION (hidden by default) -->
  <div class="<%= f.object.credit? ? '' : 'hidden' %> p-4 bg-blue-50 border border-blue-200 rounded-xl" data-bank-account-form-target="creditExplanation">
    <div class="flex items-start">
      <svg class="w-5 h-5 text-blue-600 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <div>
        <p class="text-sm font-medium text-blue-800"><%= t('bank_account_forms.credit_explanation_title') %></p>
        <p class="text-sm text-blue-700 mt-1"><%= t('bank_account_forms.credit_explanation') %></p>
      </div>
    </div>
  </div>

  <!-- BANK SELECTION FIELD: Choose from Supported Banks -->
  <div data-bank-account-form-target="bankField" class="<%= @bank_account.cash? ? 'hidden' : '' %>">
    <%= required_field_label(f, :bank_id, t('bank_accounts.bank')) %>
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
        </svg>
      </div>
      <%= f.select :bank_id,
          options_from_collection_for_select(@supported_banks, :id, :name, @bank_account.bank_id),
          { prompt: t('bank_account_forms.select_bank') },
          { required: !@bank_account.cash?,
            data: { action: "change->bank-account-form#checkChanges" },
            class: "w-full pl-10 pr-4 py-2 border #{@bank_account.errors[:bank_id].any? ? 'border-red-500' : 'border-slate-300 dark:border-slate-600'} rounded-lg focus:ring-2 focus:ring-blue-500 focus:bg-white dark:bg-slate-800 transition-colors" } %>
    </div>
    <% if @bank_account.errors[:bank_id].any? %>
      <p class="mt-1 text-sm text-red-600"><%= @bank_account.errors[:bank_id].first %></p>
    <% else %>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= t('bank_account_forms.bank_selection_help') %></p>
    <% end %>
  </div>

  <!-- CUSTOM NAME FIELD: Optional Custom Bank Name/Alias -->
  <div>
    <%= optional_field_label(f, :custom_name, t('bank_account_forms.custom_name')) %>
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
        </svg>
      </div>
      <%= f.text_field :custom_name,
          placeholder: t('bank_account_forms.custom_name_placeholder'),
          data: { action: "input->bank-account-form#checkChanges" },
          class: "w-full pl-10 pr-4 py-2 border #{@bank_account.errors[:custom_name].any? ? 'border-red-500' : 'border-slate-300 dark:border-slate-600'} rounded-lg focus:ring-2 focus:ring-blue-500 focus:bg-white dark:bg-slate-800 transition-colors" %>
    </div>
    <% if @bank_account.errors[:custom_name].any? %>
      <p class="mt-1 text-sm text-red-600"><%= @bank_account.errors[:custom_name].first %></p>
    <% else %>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= t('bank_account_forms.custom_name_help') %></p>
    <% end %>
  </div>

  <!-- ACCOUNT NUMBER FIELD: Account Identifier -->
  <div data-bank-account-form-target="accountNumberField" class="<%= @bank_account.cash? ? 'hidden' : '' %>">
    <%= required_field_label(f, :account_number, t('bank_account_forms.account_number')) %>
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 003 3v8a3 3 0 003 3z"></path>
        </svg>
      </div>
      <%= f.text_field :account_number,
          placeholder: t('bank_account_forms.account_number_placeholder'),
          required: !@bank_account.cash?,
          data: { action: "input->bank-account-form#checkChanges" },
          class: "w-full pl-10 pr-4 py-2 border #{@bank_account.errors[:account_number].any? ? 'border-red-500' : 'border-slate-300 dark:border-slate-600'} rounded-lg focus:ring-2 focus:ring-blue-500 focus:bg-white dark:bg-slate-800 transition-colors" %>
    </div>
    <% if @bank_account.errors[:account_number].any? %>
      <p class="mt-1 text-sm text-red-600"><%= @bank_account.errors[:account_number].first %></p>
    <% end %>
  </div>

  <!-- CURRENCY FIELD: Account Currency -->
  <div>
    <%= optional_field_label(f, :currency, t('bank_account_forms.currency')) %>
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 003 3v8a3 3 0 003 3z"></path>
        </svg>
      </div>
      <%= f.text_field :currency,
          placeholder: t('bank_account_forms.currency_placeholder'),
          value: @bank_account.currency || "MXN",
          data: { action: "input->bank-account-form#checkChanges" },
          class: "w-full pl-10 pr-4 py-2 border #{@bank_account.errors[:currency].any? ? 'border-red-500' : 'border-slate-300 dark:border-slate-600'} rounded-lg focus:ring-2 focus:ring-blue-500 focus:bg-white dark:bg-slate-800 transition-colors" %>
    </div>
    <% if @bank_account.errors[:currency].any? %>
      <p class="mt-1 text-sm text-red-600"><%= @bank_account.errors[:currency].first %></p>
    <% else %>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= t('bank_account_forms.common_currencies') %></p>
    <% end %>
  </div>

  <!-- OPENING BALANCE DATE FIELD: Date for Opening Balance -->
  <div>
    <%= required_field_label(f, :opening_balance_date, t('bank_account_forms.opening_balance_date')) %>
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
      </div>
      <%= local_date_field(f, :opening_balance_date,
          required: true,
          data: { action: "change->bank-account-form#checkChanges" },
          class: "w-full pl-10 pr-4 py-2 border #{@bank_account.errors[:opening_balance_date].any? ? 'border-red-500' : 'border-slate-300 dark:border-slate-600'} rounded-lg focus:ring-2 focus:ring-blue-500 focus:bg-white dark:bg-slate-800 transition-colors") %>
    </div>
    <% if @bank_account.errors[:opening_balance_date].any? %>
      <p class="mt-1 text-sm text-red-600"><%= @bank_account.errors[:opening_balance_date].first %></p>
    <% else %>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= t('bank_account_forms.opening_balance_date_help') %></p>
    <% end %>
  </div>

  <!-- OPENING BALANCE FIELD: Initial Account Balance -->
  <div>
    <%= required_field_label(f, :opening_balance, t('bank_account_forms.opening_balance')) %>
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <span class="text-slate-500 dark:text-slate-400 sm:text-sm">$</span>
      </div>
      <%= f.text_field :opening_balance,
          inputmode: "decimal",
          placeholder: t('bank_account_forms.balance_placeholder'),
          required: true,
          data: {
            controller: "currency-input",
            action: "input->bank-account-form#checkChanges change->bank-account-form#checkChanges"
          },
          class: "w-full pl-7 pr-4 py-2 border #{@bank_account.errors[:opening_balance].any? ? 'border-red-500' : 'border-slate-300 dark:border-slate-600'} rounded-lg focus:ring-2 focus:ring-blue-500 focus:bg-white dark:bg-slate-800 transition-colors" %>
    </div>
    <% if @bank_account.errors[:opening_balance].any? %>
      <p class="mt-1 text-sm text-red-600"><%= @bank_account.errors[:opening_balance].first %></p>
    <% else %>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= t('bank_account_forms.opening_balance_help') %></p>
    <% end %>
  </div>

  <!-- FORM ACTIONS: Desktop only (mobile uses header buttons) -->
  <div class="hidden md:flex items-center justify-end space-x-3 pt-6 border-t border-slate-200 dark:border-slate-700">
    <%= link_to (@bank_account.persisted? ? bank_account_path(@bank_account) : bank_accounts_path), class: "px-6 py-2 border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 rounded-lg font-medium hover:bg-slate-50 dark:hover:bg-slate-700 dark:bg-slate-900 transition-colors inline-flex items-center" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      <%= t('form_actions.cancel') %>
    <% end %>

    <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition-colors inline-flex items-center">
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
      <%= @bank_account.persisted? ? t('bank_account_forms.update') : t('bank_account_forms.create') %>
    </button>
  </div>
<% end %>
