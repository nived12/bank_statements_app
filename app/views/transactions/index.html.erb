// Handle transfer field visibility for create modal
function handleCreateTransferFieldVisibility(transactionType) {
  const transferField = document.getElementById('create_transfer_account_field');
  const transferAccountSelect = document.getElementById('create_transfer_account_id');
  const bankAccountLabel = document.getElementById('create_bank_account_label');
  const bankAccountHelp = document.getElementById('create_bank_account_help');

  if (transactionType === 'transfer_out') {
    transferField.classList.remove('hidden');
    transferAccountSelect.required = true;
    bankAccountLabel.textContent = '<%= t("transactions.transfer_from") %>';
    bankAccountHelp.textContent = '<%= t("transactions.select_source_account_help") %>';
  } else {
    transferField.classList.add('hidden');
    transferAccountSelect.required = false;
    transferAccountSelect.value = ''; // Clear selection
    bankAccountLabel.textContent = '<%= t("transactions.select_bank_account") %>';
    bankAccountHelp.textContent = '<%= t("transactions.select_bank_account_help") %>';
  }
}

// Handle amount sign based on transaction type
function handleAmountSign() {
  const transactionType = document.getElementById('create_transaction_type').value;
  const amountInput = document.getElementById('create_amount');
  let amount = parseFloat(amountInput.value);

  // Show/hide transfer account field and update labels
  handleCreateTransferFieldVisibility(transactionType);

  if (isNaN(amount) || amount === 0) return;

  if (transactionType === 'income') {
    // Income should be positive
    if (amount < 0) {
      amountInput.value = Math.abs(amount);
    }
  } else if (transactionType === 'fixed_expense' || transactionType === 'variable_expense') {
    // Expenses should be negative
    if (amount > 0) {
      amountInput.value = -amount;
    }
  } else if (transactionType === 'transfer_out') {
    // Transfers should always be positive (service handles the sign)
    if (amount < 0) {
      amountInput.value = Math.abs(amount);
    }
  }
}

