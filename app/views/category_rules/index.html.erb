<div class="min-h-screen bg-slate-50">
  <!-- Shared header (title only — tabs live inside the frame so active state updates correctly) -->
  <header class="bg-white px-4 md:px-8 pt-4 md:pt-6 pb-0">
    <div class="max-w-7xl mx-auto">
      <h1 class="text-2xl md:text-3xl font-bold text-slate-900"><%= t("categories.manage") %></h1>
      <p class="text-slate-600 mt-1 text-sm md:text-base"><%= t("categories.organize_spending") %></p>
    </div>
  </header>

  <turbo-frame id="tab-content">
    <!-- Tabs (inside frame so active state re-renders correctly on each swap) -->
    <div class="bg-white border-b border-slate-200 px-4 md:px-8">
      <div class="max-w-7xl mx-auto flex">
        <%= link_to t("categories.tabs.categories"), categories_path,
            class: "px-4 py-3 text-sm font-medium border-b-2 border-transparent text-slate-600 hover:text-slate-800",
            data: { turbo_frame: "tab-content", turbo_action: "advance" } %>
        <%= link_to t("categories.tabs.rules"), category_rules_path,
            class: "px-4 py-3 text-sm font-medium border-b-2 border-indigo-600 text-indigo-600",
            data: { turbo_frame: "tab-content", turbo_action: "advance" } %>
      </div>
    </div>
    <div class="max-w-7xl mx-auto px-4 md:px-8 py-6">
      <!-- Toolbar: subtitle + New Rule button -->
      <div class="flex items-center justify-between mb-6">
        <p class="text-sm text-slate-500"><%= t("category_rules.index.subtitle") %></p>
        <button type="button"
                data-controller="toggle-panel"
                data-action="click->toggle-panel#toggle"
                data-toggle-panel-target-value="new-rule-form"
                class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition-colors shadow-sm text-sm flex-shrink-0">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
          </svg>
          <%= t("category_rules.index.new_rule") %>
        </button>
      </div>

      <!-- New Rule Form (hidden by default) -->
      <div id="new-rule-form" class="hidden mb-6">
        <div class="bg-white rounded-xl border border-slate-200 p-6">
          <%= render partial: "category_rules/new_rule_form", locals: { category_rule: CategoryRule.new, categories: @categories } %>
        </div>
      </div>

      <!-- Rules List -->
      <% if @category_rules.any? %>
        <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
          <!-- Desktop Table -->
          <div class="hidden md:block overflow-x-auto">
            <table class="w-full">
              <thead class="bg-slate-50 border-b border-slate-200">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider"><%= t("category_rules.table.pattern") %></th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider"><%= t("category_rules.table.match_type") %></th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider"><%= t("category_rules.table.category") %></th>
                  <th class="px-4 py-3 text-center text-xs font-semibold text-slate-600 uppercase tracking-wider"><%= t("category_rules.table.hits") %></th>
                  <th class="px-4 py-3 text-center text-xs font-semibold text-slate-600 uppercase tracking-wider"><%= t("category_rules.table.active") %></th>
                  <th class="px-4 py-3 text-right text-xs font-semibold text-slate-600 uppercase tracking-wider"><%= t("category_rules.table.actions") %></th>
                </tr>
              </thead>
              <tbody id="category-rules-list" class="divide-y divide-slate-200">
                <% @category_rules.each do |rule| %>
                  <%= render partial: "category_rules/rule_row", locals: { rule: rule, categories: @categories } %>
                <% end %>
              </tbody>
            </table>
          </div>

          <!-- Mobile Cards -->
          <div class="block md:hidden divide-y divide-slate-200" id="category-rules-list-mobile">
            <% @category_rules.each do |rule| %>
              <%= render partial: "category_rules/rule_card", locals: { rule: rule } %>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="bg-white rounded-xl border border-slate-200 p-12 text-center">
          <svg class="w-16 h-16 text-slate-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
          </svg>
          <h3 class="text-lg font-semibold text-slate-700 mb-2"><%= t("category_rules.index.no_rules") %></h3>
          <p class="text-sm text-slate-500"><%= t("category_rules.index.no_rules_help") %></p>
        </div>
      <% end %>
    </div>
  </turbo-frame>
</div>
