<div id="debt-form" class="bg-white rounded-xl border border-slate-200 p-6" data-controller="debt-form">
  <%= form_with(model: debt, local: true, class: "space-y-6") do |f| %>
    <% if debt.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <div class="flex">
          <svg class="w-5 h-5 text-red-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414l8.586 10l-1.293 1.293a1 1 0 101.414 1.414L11 7.586 8.707 7.293z" clip-rule="evenodd"></path>
          </svg>
          <div>
            <h3 class="text-sm font-medium text-red-800">
              <%= t('errors.messages.form_errors', count: debt.errors.count) %>
            </h3>
            <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
              <% debt.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Debt Name -->
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-slate-700 mb-2" do %>
        <%= t('debts.name') %> <span class="text-red-500">*</span>
      <% end %>
      <%= f.text_field :name,
          placeholder: t('debts.name_placeholder'),
          class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500",
          required: true %>
      <p class="mt-1 text-sm text-slate-500"><%= t('debts.name_help') %></p>
    </div>

    <!-- Original Amount and Current Balance -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label :original_amount, class: "block text-sm font-medium text-slate-700 mb-2" do %>
          <%= t('debts.original_amount') %> <span class="text-red-500">*</span>
        <% end %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <span class="text-slate-500 sm:text-sm">$</span>
          </div>
          <%= f.text_field :original_amount,
              inputmode: "decimal",
              placeholder: "0.00",
              class: "w-full pl-7 pr-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500",
              data: { action: "input->debt-form#enforceDecimalPlaces blur->debt-form#formatDecimal" },
              required: true %>
        </div>
        <p class="mt-1 text-sm text-slate-500"><%= t('debts.original_amount_help') %></p>
      </div>

      <div>
        <%= f.label :current_balance, class: "block text-sm font-medium text-slate-700 mb-2" do %>
          <%= t('debts.current_balance') %>
        <% end %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <span class="text-slate-500 sm:text-sm">$</span>
          </div>
          <%= f.text_field :current_balance,
              inputmode: "decimal",
              placeholder: "0.00",
              class: "w-full pl-7 pr-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500",
              data: { action: "input->debt-form#enforceDecimalPlaces blur->debt-form#formatDecimal" } %>
        </div>
        <p class="mt-1 text-sm text-slate-500"><%= t('debts.current_balance_help') %></p>
      </div>
    </div>

    <!-- Interest Rate and Minimum Payment -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label :interest_rate, class: "block text-sm font-medium text-slate-700 mb-2" do %>
          <%= t('debts.interest_rate') %>
        <% end %>
        <%= f.text_field :interest_rate,
            inputmode: "decimal",
            placeholder: t('debts.interest_rate_placeholder'),
            class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500",
            data: { action: "input->debt-form#enforceDecimalPlaces blur->debt-form#formatDecimal" } %>
        <p class="mt-1 text-sm text-slate-500"><%= t('debts.interest_rate_help') %></p>
      </div>

      <div>
        <%= f.label :minimum_payment, class: "block text-sm font-medium text-slate-700 mb-2" do %>
          <%= t('debts.minimum_payment') %>
        <% end %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <span class="text-slate-500 sm:text-sm">$</span>
          </div>
          <%= f.text_field :minimum_payment,
              inputmode: "decimal",
              placeholder: "0.00",
              class: "w-full pl-7 pr-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500",
              data: { action: "input->debt-form#enforceDecimalPlaces blur->debt-form#formatDecimal" } %>
        </div>
        <p class="mt-1 text-sm text-slate-500"><%= t('debts.minimum_payment_help') %></p>
      </div>
    </div>

    <!-- Icon Picker -->
    <div data-controller="icon-picker"
         data-icon-picker-selected-value="<%= debt.icon || 'credit-card' %>"
         data-action="icon-picker:changed->debt-form#iconChanged">
      <%= f.hidden_field :icon,
          data: {
            icon_picker_target: "input",
            debt_form_target: "iconInput"
          },
          value: debt.icon || 'credit-card' %>

      <%= f.label :icon, t('debts.icon'), class: "block text-sm font-medium text-slate-700 mb-2" %>

      <div class="flex items-center space-x-3 mb-3">
        <!-- Icon Button (click to show picker) -->
        <button type="button"
                data-action="click->icon-picker#togglePicker"
                data-icon-picker-target="iconDisplay"
                class="w-12 h-12 bg-red-50 rounded-lg flex items-center justify-center border-2 border-red-200 hover:border-red-400 transition-colors flex-shrink-0">
          <%= icon_svg(debt.icon || 'credit-card', css_classes: "w-6 h-6 text-red-600") %>
        </button>
        <p class="text-sm text-slate-500"><%= t('debts.icon_help') %></p>
      </div>

      <!-- Icon Picker (hidden by default) -->
      <div data-icon-picker-target="pickerContainer" class="hidden mb-4">
        <div class="p-3 bg-slate-50 rounded-lg border border-slate-200">
          <div class="grid grid-cols-6 gap-2 max-h-64 overflow-y-auto">
            <% IconsHelper::ICONS_LIBRARY.each do |icon_name, lucide_icon| %>
              <button type="button"
                      data-action="click->icon-picker#select"
                      data-icon-picker-icon-param="<%= icon_name %>"
                      data-icon-name="<%= icon_name %>"
                      class="p-2 rounded-lg border-2 transition-all hover:border-red-300 flex items-center justify-center <%= icon_name == (debt.icon || 'credit-card') ? 'border-red-500 bg-red-50' : 'border-slate-200 bg-white' %>"
                      data-icon-picker-target="iconButton">
                <%= icon(lucide_icon, library: "lucide", variant: "outline", class: "w-5 h-5 #{icon_name == (debt.icon || 'credit-card') ? 'text-red-600' : 'text-slate-600'}") %>
              </button>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Color Picker -->
    <div data-controller="color-picker">
      <%= f.label :color, t('debts.color'), class: "block text-sm font-medium text-slate-700 mb-2" %>
      <%= f.hidden_field :color, value: debt.color || '#EF4444', data: { color_picker_target: "input" } %>

      <div class="flex gap-3 flex-wrap">
        <% [
          ['#EF4444', 'Red'],
          ['#F97316', 'Orange'],
          ['#F59E0B', 'Amber'],
          ['#10B981', 'Green'],
          ['#3B82F6', 'Blue'],
          ['#6366F1', 'Indigo'],
          ['#8B5CF6', 'Purple'],
          ['#EC4899', 'Pink'],
          ['#64748B', 'Slate'],
          ['#0EA5E9', 'Sky']
        ].each do |color, name| %>
          <button type="button"
                  data-action="click->color-picker#select"
                  data-color="<%= color %>"
                  data-color-picker-target="button"
                  class="w-10 h-10 rounded-full transition-all hover:scale-110 <%= (debt.color || '#EF4444') == color ? 'ring-4 ring-offset-2' : '' %>"
                  style="background-color: <%= color %>;"
                  title="<%= name %>">
          </button>
        <% end %>
      </div>
      <p class="mt-2 text-sm text-slate-500"><%= t('debts.color_help') %></p>
    </div>

    <!-- Auto-Link Settings -->
    <div class="border-t border-slate-200 pt-6" data-controller="auto-link-toggle">
      <div class="flex items-start">
        <div class="flex items-center h-5">
          <%= f.check_box :auto_link_category,
              class: "h-4 w-4 text-red-600 focus:ring-red-500 border-slate-300 rounded",
              data: {
                auto_link_toggle_target: "checkbox",
                action: "change->auto-link-toggle#toggle"
              } %>
        </div>
        <div class="ml-3 text-sm">
          <%= f.label :auto_link_category, t('debts.auto_link_enable'),
              class: "font-medium text-slate-700" %>
          <p class="text-slate-500"><%= t('debts.auto_link_description') %></p>
        </div>
      </div>

      <!-- Auto-link Fields (shown when enabled) -->
      <div class="mt-4 space-y-4 pl-7 <%= 'hidden' unless debt.auto_link_category? %>"
           data-auto-link-toggle-target="fields">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="relative" data-controller="category-selector">
          <%= f.label :category_id, t('debts.category'),
              class: "block text-sm font-medium text-slate-700 mb-2" %>

          <!-- Hidden input for form submission -->
          <%= f.hidden_field :category_id, data: { category_selector_target: "hiddenInput" } %>

          <!-- Custom Dropdown Button -->
          <button type="button"
                  data-action="click->category-selector#toggle"
                  class="w-full px-4 py-2 bg-white border border-slate-300 rounded-lg text-left flex items-center justify-between focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-colors">
            <span data-category-selector-target="selectedText"
                  data-placeholder="<%= t('debts.select_category') %>"
                  class="text-slate-900">
              <% if debt.category_id.present? %>
                <%= @categories.find { |c| c.id == debt.category_id }&.name || t('debts.select_category') %>
              <% else %>
                <%= t('debts.select_category') %>
              <% end %>
            </span>
            <svg class="w-5 h-5 text-slate-400 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>

          <!-- Dropdown Menu -->
          <div data-category-selector-target="menu"
               class="hidden absolute z-50 top-full left-0 right-0 mt-1 bg-white rounded-lg shadow-lg border border-slate-200 max-h-80 overflow-y-auto">

            <!-- Placeholder Option -->
            <button type="button"
                    data-action="click->category-selector#clearSelection"
                    class="w-full px-4 py-2.5 flex items-center space-x-3 hover:bg-slate-50 active:bg-slate-100 transition-colors text-left border-b border-slate-100">
              <div class="w-8 h-8 bg-slate-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                </svg>
              </div>
              <span class="flex-1 text-slate-400 text-sm"><%= t('debts.select_category') %></span>
            </button>

            <% current_user.categories.where(parent_id: nil).where.not(name: t('categories.uncategorized')).order(:name).each do |parent_cat| %>
              <% has_children = parent_cat.children.any? %>

              <!-- Parent Category Item -->
              <div class="relative">
                <button type="button"
                        data-action="click->category-selector#selectCategory"
                        data-category-id="<%= parent_cat.id %>"
                        data-category-name="<%= parent_cat.name %>"
                        data-has-children="<%= has_children %>"
                        data-is-parent="true"
                        class="w-full px-4 py-2.5 flex items-center space-x-3 hover:bg-slate-50 active:bg-slate-100 transition-colors text-left border-b border-slate-100">

                  <!-- Icon -->
                  <div class="w-8 h-8 bg-slate-100 rounded-lg flex items-center justify-center flex-shrink-0">
                    <%= icon_svg(parent_cat.icon, css_classes: "w-4 h-4 text-slate-600") %>
                  </div>

                  <!-- Category Name -->
                  <span class="flex-1 text-sm font-medium text-slate-900"><%= parent_cat.name %></span>

                  <!-- Expand Arrow (only if has children) -->
                  <% if has_children %>
                    <svg data-parent-arrow="<%= parent_cat.id %>"
                         class="w-4 h-4 text-slate-400 transition-transform flex-shrink-0"
                         fill="none"
                         stroke="currentColor"
                         viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  <% end %>
                </button>

                <!-- Subcategories (hidden by default) -->
                <% if has_children %>
                  <div data-parent-submenu="<%= parent_cat.id %>"
                       class="hidden bg-slate-50 border-b border-slate-100">
                    <% parent_cat.children.order(:name).each do |child_cat| %>
                      <button type="button"
                              data-action="click->category-selector#selectCategory"
                              data-category-id="<%= child_cat.id %>"
                              data-category-name="<%= child_cat.name %>"
                              data-has-children="false"
                              data-is-parent="false"
                              class="w-full px-4 py-2.5 pl-14 flex items-center space-x-3 hover:bg-slate-100 active:bg-slate-200 transition-colors text-left">

                        <!-- Icon -->
                        <div class="w-7 h-7 bg-white rounded-lg flex items-center justify-center flex-shrink-0 shadow-sm">
                          <%= icon_svg(child_cat.icon, css_classes: "w-3.5 h-3.5 text-slate-600") %>
                        </div>

                        <!-- Category Name -->
                        <span class="flex-1 text-sm text-slate-700"><%= child_cat.name %></span>
                      </button>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <div>
          <%= f.label :bank_account_id, t('debts.bank_account'), 
              class: "block text-sm font-medium text-slate-700 mb-2" %>
          <%= f.select :bank_account_id,
              options_from_collection_for_select(@bank_accounts, :id, :custom_name, debt.bank_account_id),
              { prompt: t('debts.select_bank_account') },
              class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500" %>
        </div>
        </div>
      </div>
    </div>

    <!-- Calculation Settings -->
    <div class="border-t border-slate-200 pt-6"
         data-controller="debt-calculation-settings"
         data-debt-calculation-settings-hide-text-value="<%= t('debts.hide_advanced_settings') %>"
         data-debt-calculation-settings-show-text-value="<%= t('debts.show_advanced_settings') %>">
      <!-- Toggle Button -->
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-slate-900"><%= t('debts.calculation_settings_label') %></h3>
        <button type="button" 
                class="text-sm text-red-600 hover:text-red-800 font-medium"
                data-debt-calculation-settings-target="toggleButton"
                data-action="click->debt-calculation-settings#toggle">
          <%= t('debts.show_advanced_settings') %>
        </button>
      </div>
      
      <p class="text-sm text-slate-500 mb-4"><%= t('debts.calculation_settings_help') %></p>

      <!-- Advanced Settings Content (hidden by default) -->
      <div class="hidden" data-debt-calculation-settings-target="content">
        <div class="space-y-6 p-4 bg-slate-50 rounded-lg border border-slate-200">
          <% %w[income expense transfer_in transfer_out].each do |type| %>
            <div class="border-b border-slate-200 pb-4 last:border-b-0 last:pb-0">
              <h4 class="text-sm font-medium text-slate-700 mb-3">
                <%= t("debts.calculation_settings.#{type}") %>
              </h4>
              <div class="flex space-x-6">
                <% %w[positive negative ignore].each do |option| %>
                  <label class="flex items-center">
                    <%= f.radio_button "calculation_settings_#{type}", option,
                        checked: debt.calculation_settings&.dig(type) == option,
                        class: "w-4 h-4 text-red-600 border-slate-300 focus:ring-red-500" %>
                    <span class="ml-2 text-xs text-slate-700">
                      <%= t("debts.calculation_settings.#{option}") %>
                    </span>
                  </label>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Notes -->
    <div>
      <%= f.label :notes, t('debts.notes'), class: "block text-sm font-medium text-slate-700 mb-2" %>
      <%= f.text_area :notes,
          placeholder: t('debts.notes_placeholder'),
          rows: 3,
          class: "w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500" %>
      <p class="mt-1 text-sm text-slate-500"><%= t('debts.notes_help') %></p>
    </div>

    <!-- Form Actions -->
    <div class="flex items-center justify-end space-x-4 pt-4 border-t border-slate-200">
      <%= link_to t('debts.cancel'), debts_path,
          class: "px-6 py-2 border border-slate-300 rounded-lg font-medium text-slate-700 hover:bg-slate-50 transition-colors" %>
      <%= f.submit debt.persisted? ? t('debts.update_debt') : t('debts.create_debt'),
          class: "px-6 py-2 bg-red-600 text-white rounded-lg font-medium hover:bg-red-700 transition-colors cursor-pointer" %>
    </div>
  <% end %>
</div>
