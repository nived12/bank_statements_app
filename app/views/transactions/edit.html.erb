<% content_for :title, t('transactions.edit_transaction') %>
<% content_for :hide_fab, true %>
<% content_for :hide_mobile_header, true %>

<!-- Mobile View -->
<div class="block md:hidden mobile-form-page" data-controller="transaction-form">
  <header class="mobile-form-header">
    <%= link_to transactions_return_path(@return_to), class: "mobile-form-header-btn" do %>
      <%= icon("chevron-left", library: "lucide", variant: "outline", class: "w-6 h-6") %>
    <% end %>

    <h1 class="mobile-form-header-title"><%= t('transactions.edit_transaction') %></h1>

    <%= button_to transaction_path(@transaction),
          method: :delete,
          params: { return_to: @return_to },
          form: { data: { turbo_confirm: t("transactions.confirm_delete") }, class: "mobile-form-header-btn-form" },
          class: "mobile-form-header-btn text-red-500",
          title: t("transactions.delete_transaction") do %>
      <%= icon("trash-2", library: "lucide", variant: "outline", class: "w-5 h-5") %>
    <% end %>
  </header>

  <div class="mobile-form-body">
    <% if flash[:alert] %>
      <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-xl">
        <p class="text-sm text-red-800"><%= flash[:alert] %></p>
      </div>
    <% end %>

    <%= render "transaction_form_mobile", transaction: @transaction, bank_accounts: @bank_accounts, return_to: @return_to %>
  </div>

  <%= render "shared/mobile_form_footer",
      form_id: "transaction_form",
      controller_name: "transaction-form",
      label: t("form_actions.save", default: "Guardar") %>
</div>

<!-- Desktop View: unchanged -->
<div class="hidden md:block min-h-screen bg-slate-50 dark:bg-slate-900" data-controller="transaction-form">
  <header class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 px-8 py-6">
    <div class="max-w-3xl mx-auto">
      <div class="flex items-center justify-between mb-4">
        <%= link_to transactions_return_path(@return_to), class: "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:text-slate-100 flex items-center" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          <%= t('transactions.back_to_transactions') %>
        <% end %>
      </div>
      <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100"><%= t('transactions.edit_transaction') %></h1>
      <p class="text-slate-600 dark:text-slate-400 mt-2"><%= @transaction.description %></p>
    </div>
  </header>

  <div class="max-w-3xl mx-auto px-8 py-8">
    <% if flash[:alert] %>
      <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
        <p class="text-sm text-red-800"><%= flash[:alert] %></p>
      </div>
    <% end %>

    <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm ring-1 ring-slate-900/5 p-6 md:p-8">
      <%= render 'transaction_form', transaction: @transaction, bank_accounts: @bank_accounts, return_to: @return_to %>
    </div>

    <div class="mt-6 pt-6 border-t border-slate-200 dark:border-slate-700">
      <%= button_to transaction_path(@transaction),
            method: :delete,
            params: { return_to: @return_to },
            form: { data: { turbo_confirm: t("transactions.confirm_delete") } },
            class: "flex items-center gap-2 px-4 py-2 text-sm font-medium text-red-600 hover:text-red-700 hover:bg-red-50 border border-red-200 rounded-lg transition-colors" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
        </svg>
        <%= t("transactions.delete_transaction") %>
      <% end %>
    </div>
  </div>
</div>
