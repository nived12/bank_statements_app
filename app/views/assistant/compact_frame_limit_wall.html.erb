<%#
  Limit-wall response for the Vittbot FAB panel.
  Must be wrapped in the `vittbot_fab_frame` turbo-frame so Turbo can swap it
  into the FAB panel — otherwise the page shows "Content missing".
%>
<%= turbo_frame_tag "vittbot_fab_frame", class: "flex-1 flex flex-col min-h-0 h-full" do %>
  <%= render "assistant/limit_wall" %>
<% end %>
