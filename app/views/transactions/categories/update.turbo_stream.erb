<%= turbo_stream.replace "transaction-category-desktop-#{@transaction.id}" do %>
  <%= render partial: "transactions/inline_category_cell", locals: { transaction: @transaction, categories: @categories } %>
<% end %>

<%= turbo_stream.replace "transaction-category-mobile-#{@transaction.id}" do %>
  <%= render partial: "transactions/inline_category_mobile", locals: { transaction: @transaction, categories: @categories } %>
<% end %>
