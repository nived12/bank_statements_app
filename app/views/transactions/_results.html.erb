<% if transactions.any? %>
  <!-- DESKTOP TABLE -->
  <section class="transactions-table-container hidden md:block">
    <div class="overflow-x-auto cursor-grab" data-controller="drag-scroll">
      <table class="transactions-table">
        <thead class="transactions-table-header">
          <tr>
            <th class="transactions-table-header-row">
              <span class="text-slate-700 dark:text-slate-300 font-medium">#</span>
            </th>
            <th class="transactions-table-header-row">
              <a class="transactions-table-header-sortable" data-turbo-frame="transactions-stats-and-results" data-turbo-action="advance" href="/transactions?sort=date&direction=<%= current_sort == 'date' && current_direction == 'desc' ? 'asc' : 'desc' %>&bank_account_id=<%= params[:bank_account_id] %>&statement_file_id=<%= params[:statement_file_id] %>&transaction_type=<%= params[:transaction_type] %>&from_date=<%= params[:from_date] %>&to_date=<%= params[:to_date] %>&search=<%= params[:search] %>" onclick="preserveScrollPosition()">
                <%= t('table_headers.date') %>
                <%= render_sort_indicator('date', current_sort, current_direction) %>
              </a>
            </th>
            <th class="transactions-table-header-row">
              <a class="transactions-table-header-sortable" data-turbo-frame="transactions-stats-and-results" data-turbo-action="advance" href="/transactions?sort=bank_account&direction=<%= current_sort == 'bank_account' && current_direction == 'desc' ? 'asc' : 'desc' %>&bank_account_id=<%= params[:bank_account_id] %>&statement_file_id=<%= params[:statement_file_id] %>&transaction_type=<%= params[:transaction_type] %>&from_date=<%= params[:from_date] %>&to_date=<%= params[:to_date] %>&search=<%= params[:search] %>" onclick="preserveScrollPosition()">
                <%= t('table_headers.account') %>
                <%= render_sort_indicator('bank_account', current_sort, current_direction) %>
              </a>
            </th>
            <th class="transactions-table-header-row">
              <a class="transactions-table-header-sortable" data-turbo-frame="transactions-stats-and-results" data-turbo-action="advance" href="/transactions?sort=description&direction=<%= current_sort == 'description' && current_direction == 'desc' ? 'asc' : 'desc' %>&bank_account_id=<%= params[:bank_account_id] %>&statement_file_id=<%= params[:statement_file_id] %>&transaction_type=<%= params[:transaction_type] %>&from_date=<%= params[:from_date] %>&to_date=<%= params[:to_date] %>&search=<%= params[:search] %>" onclick="preserveScrollPosition()">
                <%= t('table_headers.description') %>
                <%= render_sort_indicator('description', current_sort, current_direction) %>
              </a>
            </th>
            <th class="transactions-table-header-row">
              <a class="transactions-table-header-sortable" data-turbo-frame="transactions-stats-and-results" data-turbo-action="advance" href="/transactions?sort=amount&direction=<%= current_sort == 'amount' && current_direction == 'desc' ? 'asc' : 'desc' %>&bank_account_id=<%= params[:bank_account_id] %>&statement_file_id=<%= params[:statement_file_id] %>&transaction_type=<%= params[:transaction_type] %>&from_date=<%= params[:from_date] %>&to_date=<%= params[:to_date] %>&search=<%= params[:search] %>" onclick="preserveScrollPosition()">
                <%= t('table_headers.amount') %>
                <%= render_sort_indicator('amount', current_sort, current_direction) %>
              </a>
            </th>
            <th class="transactions-table-header-row">
              <a class="transactions-table-header-sortable" data-turbo-frame="transactions-stats-and-results" data-turbo-action="advance" href="/transactions?sort=transaction_type&direction=<%= current_sort == 'transaction_type' && current_direction == 'desc' ? 'asc' : 'desc' %>&bank_account_id=<%= params[:bank_account_id] %>&statement_file_id=<%= params[:statement_file_id] %>&transaction_type=<%= params[:transaction_type] %>&from_date=<%= params[:from_date] %>&to_date=<%= params[:to_date] %>&search=<%= params[:search] %>" onclick="preserveScrollPosition()">
                <%= t('table_headers.transaction_type') %>
                <%= render_sort_indicator('transaction_type', current_sort, current_direction) %>
              </a>
            </th>
            <th class="transactions-table-header-row">
              <a class="transactions-table-header-sortable" data-turbo-frame="transactions-stats-and-results" data-turbo-action="advance" href="/transactions?sort=category&direction=<%= current_sort == 'category' && current_direction == 'desc' ? 'asc' : 'desc' %>&bank_account_id=<%= params[:bank_account_id] %>&statement_file_id=<%= params[:statement_file_id] %>&transaction_type=<%= params[:transaction_type] %>&from_date=<%= params[:from_date] %>&to_date=<%= params[:to_date] %>&search=<%= params[:search] %>" onclick="preserveScrollPosition()">
                <%= t('table_headers.category') %>
                <%= render_sort_indicator('category', current_sort, current_direction) %>
              </a>
            </th>
            <th class="transactions-table-header-row"><%= t('table_headers.actions') %></th>
          </tr>
        </thead>
        <tbody class="transactions-table-body" id="transactions-tbody" data-transactions-tbody>
          <% transactions.each.with_index(1) do |transaction, index| %>
            <%= render partial: "transactions/transaction_row",
                       locals: { transaction: transaction, index: index, filter_params: filter_params } %>
          <% end %>
        </tbody>
      </table>
    </div>
    
    <!-- Desktop Pagination Info -->
    <div class="mt-4 px-4 infinite-scroll-container"
         data-controller="infinite-scroll"
         data-infinite-scroll-next-page-value="<%= pagy&.next || 0 %>"
         data-infinite-scroll-total-pages-value="<%= pagy ? pagy.pages : 1 %>"
         data-infinite-scroll-total-count-value="<%= pagy ? pagy.count : 0 %>"
         data-filter-params="<%= filter_params.to_json %>">
      <div class="text-sm text-slate-500 dark:text-slate-400 text-center">
        <%= t('transactions.total') %>: <span class="transactions-loaded-count"><%= transactions.count %></span> /
        <%= pagy ? pagy.count : 0 %>
      </div>
      <% if pagy && pagy.next %>
        <div class="scroll-trigger text-xs text-slate-400 py-4 text-center">
          <%= t('transactions.scroll_for_more') %>
        </div>
      <% end %>
      <div class="infinite-scroll-indicator hidden text-center py-4">
        <div class="inline-flex items-center px-4 py-2 text-sm text-slate-600 dark:text-slate-400">
          <svg class="animate-spin -ml-1 mr-3 h-4 w-4 text-slate-600 dark:text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <%= t('transactions.loading_more') %>
        </div>
      </div>
    </div>
  </section>

  <!-- MOBILE TRANSACTIONS -->
  <section class="mobile-app-screen block md:hidden pb-4">
    <% if transactions.any? %>
      <div data-mobile-transactions-list>
        <%= render "transactions/mobile_transaction_list", transactions: transactions %>
      </div>

      <div class="px-4 pt-4 infinite-scroll-container"
           data-controller="infinite-scroll"
           data-infinite-scroll-next-page-value="<%= pagy&.next || 0 %>"
           data-infinite-scroll-total-pages-value="<%= pagy ? pagy.pages : 1 %>"
           data-infinite-scroll-total-count-value="<%= pagy ? pagy.count : 0 %>"
           data-filter-params="<%= filter_params.to_json %>">
        <% if pagy && pagy.next %>
          <div class="scroll-trigger text-xs text-slate-400 py-4 text-center">
            <%= t('transactions.scroll_for_more') %>
          </div>
        <% else %>
          <p class="text-xs text-slate-400 text-center py-4"><%= t("mobile.all_caught_up") %></p>
        <% end %>
        <div class="infinite-scroll-indicator hidden text-center py-4">
          <div class="inline-flex items-center px-4 py-2 text-sm text-indigo-600">
            <svg class="animate-spin -ml-1 mr-3 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <%= t('transactions.loading_more') %>
          </div>
        </div>
      </div>
    <% end %>
  </section>

  <%# Singleton category dropdown — shared by every row's inline-category controller.
      Rendered once here instead of inside each transaction row to avoid an N×categories payload explosion. %>
  <div id="shared-category-panel-host" data-controller="category-panel" class="hidden">
    <%= render partial: "transactions/inline_category_dropdown", locals: { categories: @categories || [] } %>
  </div>

<% else %>
  <% active_filters = filter_params.except(:sort, :direction).any? { |_, v| v.present? } %>
  <% if active_filters %>
    <section class="transactions-empty">
      <div class="transactions-empty-icon">
        <svg class="w-16 h-16 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.414A1 1 0 013 6.707V4z"/>
        </svg>
      </div>
      <h3 class="transactions-empty-title"><%= t('transactions.no_transactions_found') %></h3>
      <p class="transactions-empty-description"><%= t('transactions.no_results_for_filters') %></p>
      <%= link_to t('transactions.clear_all_filters'), transactions_path, class: "transactions-empty-action" %>
    </section>
  <% else %>
    <section class="transactions-empty">
      <div class="transactions-empty-icon">
        <svg class="w-16 h-16 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
      </div>
      <h3 class="transactions-empty-title"><%= t('empty_states.no_transactions_yet') %></h3>
      <p class="transactions-empty-description"><%= t('bank_accounts.upload_statement_help') %></p>
      <%= link_to new_statement_file_path, class: "transactions-empty-action" do %>
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
        </svg>
        <%= t('quick_actions.upload_statement') %>
      <% end %>
    </section>
  <% end %>
<% end %>
