<h1 class="email-title"><%= t(".header", debt_name: @debt.name) %></h1>

<p class="email-text"><%= t(".greeting", name: @user.first_name) %></p>

<p class="email-text">
  <%= t(".message",
         debt_name: @debt.name,
         amount: number_to_currency(@amount, unit: "$"),
         due_date: l(@due_date, format: :long),
         days: @days_until_due) %>
</p>

<% if @recommendation.present? %>
  <div class="email-notice">
    <p class="email-notice-title"><%= t(".recommendation_header") %></p>
    <p class="email-notice-text"><%= @recommendation[:reason] %></p>
    <p class="email-notice-text"><%= t(".strategy", strategy: @recommendation[:strategy].humanize) %></p>
  </div>
<% end %>

<p class="email-text"><%= t(".footer") %></p>
