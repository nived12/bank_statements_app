<!-- MOBILE BANK ACCOUNTS PAGE: Mobile-Optimized Bank Account Management -->
<main class="mobile-bank-accounts-page">
  <div class="mobile-bank-accounts-container">
    
    <!-- MOBILE HEADER: Page Title and Quick Actions -->
    <header class="mobile-bank-accounts-header">
      <div class="mobile-bank-accounts-header-content">
        <div class="mobile-bank-accounts-header-left">
          <h1 class="mobile-bank-accounts-title"><%= t('navigation.bank_accounts') %></h1>
          <p class="mobile-bank-accounts-subtitle"><%= t('bank_accounts.subtitle') %></p>
        </div>
        <div class="mobile-bank-accounts-header-actions">
          <a href="/bank_accounts/new" class="mobile-bank-accounts-add-btn">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
          </a>
        </div>
      </div>
    </header>

    <!-- MOBILE STATS: Quick Overview Cards -->
    <section class="mobile-bank-accounts-stats">
      <div class="mobile-stats-grid">
        <!-- Total Balance -->
        <div class="mobile-stat-card mobile-stat-card-primary">
          <div class="mobile-stat-icon mobile-stat-icon-balance">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
            </svg>
          </div>
          <div class="mobile-stat-content">
            <p class="mobile-stat-label"><%= t('bank_accounts.total_balance') %></p>
            <p class="mobile-stat-value mobile-stat-value-large">
              <%= number_to_currency(@mobile_bank_accounts_data[:total_balance], unit: "$") %>
            </p>
          </div>
        </div>

        <!-- Total Accounts -->
        <div class="mobile-stat-card">
          <div class="mobile-stat-icon mobile-stat-icon-accounts">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 003 3v8a3 3 0 003 3z"></path>
            </svg>
          </div>
          <div class="mobile-stat-content">
            <p class="mobile-stat-label"><%= t('bank_accounts.total_accounts') %></p>
            <p class="mobile-stat-value"><%= @mobile_bank_accounts_data[:total_accounts] %></p>
          </div>
        </div>

        <!-- Supported Accounts -->
        <div class="mobile-stat-card">
          <div class="mobile-stat-icon mobile-stat-icon-supported">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="mobile-stat-content">
            <p class="mobile-stat-label"><%= t('bank_accounts.supported') %></p>
            <p class="mobile-stat-value"><%= @mobile_bank_accounts_data[:supported_accounts] %></p>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="mobile-stat-card mobile-stat-card-action">
          <div class="mobile-stat-icon mobile-stat-icon-action">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
          </div>
          <div class="mobile-stat-content">
            <p class="mobile-stat-label"><%= t('bank_accounts.quick_actions') %></p>
            <a href="/bank_accounts/new" class="mobile-stat-action-btn">
              <%= t('bank_accounts.add') %>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- MOBILE BANK ACCOUNTS LIST: Card-based Account Display -->
    <% if @mobile_bank_accounts_data[:accounts].any? %>
      <section class="mobile-bank-accounts-list">
        <div class="mobile-bank-accounts-header-bar">
          <h3 class="mobile-bank-accounts-list-title">
            <%= t('bank_accounts.your_accounts') %>
            <span class="mobile-bank-accounts-count">(<%= @mobile_bank_accounts_data[:total_accounts] %>)</span>
          </h3>
        </div>

        <div class="mobile-bank-accounts-cards">
          <% @mobile_bank_accounts_data[:accounts].each do |account| %>
            <div class="mobile-bank-account-card" data-account-id="<%= account[:id] %>">
              <div class="mobile-bank-account-main">
                <div class="mobile-bank-account-info">
                  <div class="mobile-bank-account-icon">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 003 3v8a3 3 0 003 3z"></path>
                    </svg>
                  </div>
                  <div class="mobile-bank-account-details">
                    <h4 class="mobile-bank-account-name"><%= account[:display_name] %></h4>
                    <p class="mobile-bank-account-bank"><%= account[:bank_name] %></p>
                    <p class="mobile-bank-account-number">••••<%= account[:account_number].last(4) %></p>
                  </div>
                </div>
                
                <div class="mobile-bank-account-balance">
                  <p class="mobile-bank-account-balance-value">
                    <%= number_to_currency(account[:effective_balance], unit: account[:currency] || "$") %>
                  </p>
                  <p class="mobile-bank-account-balance-label"><%= t('bank_accounts.current_balance') %></p>
                </div>
              </div>

              <!-- Account Details -->
              <div class="mobile-bank-account-details-section">
                <div class="mobile-bank-account-detail-row">
                  <span class="mobile-bank-account-detail-label"><%= t('bank_account_forms.currency') %>:</span>
                  <span class="mobile-bank-account-detail-value"><%= account[:currency] %></span>
                </div>
                
                <% if account[:opening_balance].present? %>
                  <div class="mobile-bank-account-detail-row">
                    <span class="mobile-bank-account-detail-label"><%= t('bank_account_forms.opening_balance') %>:</span>
                    <span class="mobile-bank-account-detail-value">
                      <%= number_to_currency(account[:opening_balance], unit: account[:currency] || "$") %>
                    </span>
                  </div>
                <% end %>

                <div class="mobile-bank-account-detail-row">
                  <span class="mobile-bank-account-detail-label"><%= t('bank_accounts.parsing_support') %>:</span>
                  <span class="mobile-bank-account-detail-value <%= account[:supported_for_parsing] ? 'text-green-600' : 'text-slate-500' %>">
                    <%= account[:supported_for_parsing] ? t('bank_accounts.supported') : t('bank_accounts.generic_parsing') %>
                  </span>
                </div>

                <div class="mobile-bank-account-detail-row">
                  <span class="mobile-bank-account-detail-label"><%= t('bank_accounts.account_type') %>:</span>
                  <span class="mobile-bank-account-detail-value">
                    <%= t("bank_account_types.#{account[:account_type]}") %>
                  </span>
                </div>
              </div>

              <!-- Account Stats -->
              <div class="mobile-bank-account-stats">
                <div class="mobile-bank-account-stat">
                  <span class="mobile-bank-account-stat-value"><%= account[:statement_files_count] %></span>
                  <span class="mobile-bank-account-stat-label"><%= t('statement_files.overview') %></span>
                </div>
                <div class="mobile-bank-account-stat">
                  <span class="mobile-bank-account-stat-value"><%= account[:transactions_count] %></span>
                  <span class="mobile-bank-account-stat-label"><%= t('table_headers.transactions') %></span>
                </div>
              </div>

              <!-- Account Actions -->
              <div class="mobile-bank-account-actions">
                <a href="/bank_accounts/<%= account[:id] %>" class="mobile-bank-account-action-btn mobile-bank-account-view-btn">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                  <%= t('bank_accounts.view') %>
                </a>
                <a href="/bank_accounts/<%= account[:id] %>/edit" class="mobile-bank-account-action-btn mobile-bank-account-edit-btn">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                  </svg>
                  <%= t('bank_accounts.edit') %>
                </a>
                <%= button_to bank_account_path(account[:id]),
                              method: :delete,
                              class: "mobile-bank-account-action-btn mobile-bank-account-delete-btn",
                              data: {
                                "turbo-confirm": t('bank_accounts.delete_confirmation',
                                                 account_name: account[:display_name],
                                                 statement_files_count: account[:statement_files_count],
                                                 transactions_count: account[:transactions_count])
                              } do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                  <%= t('bank_accounts.delete') %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% else %>
      <!-- EMPTY STATE: No Bank Accounts -->
      <section class="mobile-bank-accounts-empty">
        <div class="mobile-empty-icon">
          <svg class="w-16 h-16 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 003 3v8a3 3 0 003 3z"></path>
          </svg>
        </div>
        <h3 class="mobile-empty-title"><%= t('bank_accounts.no_accounts_yet') %></h3>
        <p class="mobile-empty-description"><%= t('bank_accounts.no_accounts_description') %></p>
        <div class="mobile-empty-actions">
          <a href="/bank_accounts/new" class="mobile-empty-action-btn">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            <%= t('bank_accounts.add_first_account') %>
          </a>
        </div>
      </section>
    <% end %>
  </div>
</main>
