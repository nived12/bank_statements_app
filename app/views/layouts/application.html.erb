<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title>Bank Statements App</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="csrf-token" content="<%= form_authenticity_token %>">
    <meta name="view-transition" content="same-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/icon.svg">
  </head>

  <body class="font-sans antialiased h-screen w-full overflow-x-hidden" data-controller="mobile-menu sidebar">
    <div class="flex h-screen w-full overflow-x-hidden">
      <%= render 'common/desktop_top_nav' %>
      <%= render 'common/desktop_sidebar' %>
      <%= render 'common/mobile_sidebar' %>
      <%= render 'common/mobile_header' %>
      <%= render 'common/mobile_bottom_nav' %>
      <%= render 'common/toast_notifications' %>

      <main class="w-full min-w-0 w-full overflow-y-auto overflow-x-hidden">
        <div class="w-full bg-white rounded-tl-lg shadow-lg shadow-slate-200 flex flex-col md:mt-20">
          <%= yield %>
        </div>
      </main>
    </div>
  </body>
</html>
