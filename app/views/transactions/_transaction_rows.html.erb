<% transactions.each.with_index(1) do |transaction, index| %>
  <tr class="transactions-table-row" data-transaction-id="<%= transaction.id %>">
    <td class="transactions-table-cell">
      <span class="transactions-table-cell-text text-slate-500 font-medium">
        <%= (page_offset || 0) + index %>
      </span>
    </td>
    <td class="transactions-table-cell">
      <span class="transactions-table-cell-text" data-date="<%= transaction.date.strftime('%Y-%m-%d') %>">
        <%= format_local_time(transaction.date, format: 'short_date') %>
      </span>
    </td>
    <td class="transactions-table-cell">
      <div>
        <div class="transactions-table-cell-text" title="<%= transaction.description %>" data-description="<%= transaction.description %>">
          <%= short_description(transaction.description) %>
        </div>
        <% if transaction.merchant.present? %>
          <div class="transactions-table-cell-merchant" data-merchant="<%= transaction.merchant %>">
            <span class="text-xs text-slate-500">Merchant: <%= transaction.merchant %></span>
          </div>
        <% end %>
        <% if transaction.reference.present? %>
          <div class="transactions-table-cell-reference" data-reference="<%= transaction.reference %>">
            <span class="text-xs text-slate-500">Ref: <%= transaction.reference %></span>
          </div>
        <% end %>
        <% if transaction.bank_account %>
          <div class="transactions-table-cell-account">
            <%= transaction.bank_account.custom_name %>
          </div>
        <% end %>
      </div>
    </td>
    <td class="transactions-table-cell transactions-table-cell-amount">
      <span class="<%= transaction.transaction_type == 'income' ? 'transactions-table-cell-amount-credit' : 'transactions-table-cell-amount-debit' %>" data-amount="<%= transaction.amount %>">
        <%= format_currency(transaction.amount) %>
      </span>
    </td>
    <td class="transactions-table-cell">
      <span class="transactions-category" data-transaction-type="<%= t("transaction_types.#{transaction.transaction_type}") %>">
        <%= t("transaction_types.#{transaction.transaction_type}") %>
      </span>
    </td>
    <td class="transactions-table-cell">
      <% if transaction.category %>
        <div class="flex flex-col" data-category-id="<%= transaction.category.id %>">
          <% if transaction.category.parent %>
            <!-- Parent category -->
            <span class="transactions-category transactions-category-parent">
              <%= transaction.category.parent.name %>
            </span>
            <!-- Child category -->
            <span class="transactions-category transactions-category-child">
              <%= transaction.category.name %>
            </span>
          <% else %>
            <!-- Parent category only (no subcategory) -->
            <span class="transactions-category transactions-category-parent">
              <%= transaction.category.name %>
            </span>
          <% end %>
        </div>
      <% else %>
        <span class="transactions-category-empty" data-category-id=""><%= t('transactions.no_category') %></span>
      <% end %>
    </td>
    <td class="transactions-table-cell">
      <div class="transactions-actions">
        <button onclick="openEditModal('<%= transaction.id %>')" class="transactions-action-btn transactions-action-btn-edit" title="<%= t('transactions.edit_transaction') %>">
          <svg class="transactions-table-action-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
        </button>
        <% if transaction.statement_file %>
          <div class="relative group">
            <a href="/statement_files/<%= transaction.statement_file.id %>" class="block">
              <div class="w-6 h-6 bg-blue-100 rounded-full flex items-center justify-center cursor-pointer hover:bg-blue-200 transition-colors duration-200">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
              </div>
            </a>
            <!-- Tooltip -->
            <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-2 bg-slate-900 text-white text-xs rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none whitespace-nowrap z-10">
              <div class="text-center">
                <div class="font-medium mb-1"><%= t('transactions.statement_file') %></div>
                <div class="text-slate-200"><%= transaction.statement_file.file.filename.to_s %></div>
                <div class="text-slate-300 text-xs mt-1"><%= t('statement_files.click_to_view_details') %></div>
              </div>
              <!-- Tooltip arrow -->
              <div class="absolute top-full left-1/2 transform -translate-x-1/2 w-0 h-0 border-l-4 border-r-4 border-t-4 border-transparent border-t-slate-900"></div>
            </div>
          </div>
        <% end %>
      </div>
    </td>
  </tr>
<% end %>
