<!-- BANK ACCOUNT SHOW PAGE: Account Details -->
<main class="bank-accounts-page">

  <!-- DESKTOP HEADER (hidden on mobile) -->
  <div class="hidden md:block">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <header class="bank-account-show-header">
        <div class="flex items-center justify-between">
          <div class="flex items-center">
            <a href="/bank_accounts" class="mr-4 p-2 text-gray-400 hover:text-gray-600 transition-colors duration-200">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
              </svg>
            </a>
            <div>
              <h1 class="bank-account-show-title"><%= @bank_account.custom_name %></h1>
              <p class="bank-account-show-subtitle"><%= t('bank_accounts.details') %></p>
            </div>
          </div>

          <div class="bank-account-show-actions">
            <a href="/bank_accounts/<%= @bank_account.id %>/edit" class="bank-accounts-button bank-accounts-button-secondary">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              <%= t('form_actions.edit') %>
            </a>
            <a href="/statement_files/new?bank_account_id=<%= @bank_account.id %>" class="bank-accounts-button bank-accounts-button-primary">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
              </svg>
              <%= t('quick_actions.upload_statement') %>
            </a>
          </div>
        </div>
      </header>
    </div>
  </div>

  <!-- MOBILE HEADER (visible only on mobile) -->
  <div class="block md:hidden">
    <header class="mobile-bank-account-header">
      <div class="mobile-bank-account-header-content">
        <div class="mobile-bank-account-header-left">
          <a href="/bank_accounts" class="mobile-back-button">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
          </a>
          <div class="mobile-bank-account-title-section">
            <h1 class="mobile-bank-account-title"><%= @bank_account.custom_name %></h1>
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2">
                <p class="mobile-bank-account-subtitle">••••<%= @bank_account.account_number.last(4) %></p>
                <% if @bank_account.account_type.present? %>
                  <span class="text-slate-300">•</span>
                  <p class="mobile-bank-account-type"><%= t("mobile.bank_accounts.#{@bank_account.account_type}") %></p>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>
  </div>

  <!-- DESKTOP CONTENT -->
  <div class="hidden md:block max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- ACCOUNT OVERVIEW: Main Account Information -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
      
      <!-- MAIN ACCOUNT CARD: Account Summary -->
      <div class="lg:col-span-2 dashboard-card">
        <div class="flex items-center justify-between mb-6">
          <div class="flex items-center">
            <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 003 3v8a3 3 0 003 3z"></path>
              </svg>
            </div>
            <div class="ml-4">
              <h2 class="text-2xl font-bold text-slate-900"><%= @bank_account.bank_display_name %></h2>
              <p class="text-slate-500">••••<%= @bank_account.account_number.last(4) %></p>
            </div>
          </div>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
            <%= @bank_account.currency %>
          </span>
        </div>
        
        <div class="text-center py-6">
          <p class="dashboard-metric-label"><%= t('bank_accounts.current_balance') %></p>
          <p class="dashboard-metric-value dashboard-metric-value-income">
            <% if @bank_account.effective_balance.present? %>
              <%= number_to_currency(@bank_account.effective_balance, unit: @bank_account.currency || "$") %>
            <% else %>
              <%= t('bank_accounts.no_balance_set') %>
            <% end %>
          </p>
        </div>
      </div>

      <!-- QUICK STATS: Account Details and Actions -->
      <div class="space-y-6">
        
        <!-- ACCOUNT DETAILS CARD -->
        <div class="dashboard-card">
          <h3 class="dashboard-card-title"><%= t('bank_accounts.details_header') %></h3>
          <div class="space-y-3">
            <div class="flex justify-between">
              <span class="text-slate-600"><%= t('bank_accounts.bank') %></span>
              <span class="font-medium text-slate-900"><%= @bank_account.bank_display_name %></span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-600"><%= t('bank_accounts.account_hash') %></span>
              <span class="font-medium text-slate-900"><%= @bank_account.account_number %></span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-600"><%= t('bank_account_forms.currency') %></span>
              <span class="font-medium text-slate-900"><%= @bank_account.currency %></span>
            </div>
            <% if @bank_account.account_type.present? %>
              <div class="flex justify-between">
                <span class="text-slate-600"><%= t('bank_account_forms.account_type') %></span>
                <span class="font-medium text-slate-900"><%= t("bank_accounts.#{@bank_account.account_type}") %></span>
              </div>
            <% end %>
          </div>
        </div>

        <!-- QUICK ACTIONS CARD -->
        <div class="dashboard-card">
          <h3 class="dashboard-card-title"><%= t('quick_actions.title') %></h3>
          <div class="space-y-3">
            <button onclick="openUploadModal()" class="w-full flex items-center justify-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors duration-200 md:hidden">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
              </svg>
              <%= t('quick_actions.upload_statement') %>
            </button>
            <a href="/transactions" class="w-full flex items-center justify-center px-4 py-2 border border-slate-300 text-slate-700 text-sm font-medium rounded-lg hover:bg-slate-50 transition-colors duration-200">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
              <%= t('statement_files.view_transactions') %>
            </a>
            <button onclick="openBankAccountEditModal()" class="w-full flex items-center justify-center px-4 py-2 border border-slate-300 text-slate-700 text-sm font-medium rounded-lg hover:bg-slate-50 transition-colors duration-200 md:hidden">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              <%= t('mobile.bank_accounts.edit_account') %>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- RECENT ACTIVITY SECTION: Recent Statement Files -->
    <section class="dashboard-card">
      <h3 class="dashboard-card-title"><%= t('bank_accounts.recent_activity') %></h3>

      <% if @recent_statement_files.any? %>
        <!-- Recent Statement Files List -->
        <div class="space-y-3">
          <% @recent_statement_files.each do |statement_file| %>
            <div class="recent-statement-item" onclick="window.location.href='/statement_files/<%= statement_file.id %>'">
              <div class="recent-statement-content">
                <div class="recent-statement-icon">
                  <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                </div>
                <div class="recent-statement-info">
                  <h4 class="recent-statement-title">
                    <%= statement_file.file.filename.to_s %>
                  </h4>
                  <p class="recent-statement-meta">
                    <%= statement_file.transactions.count %> <%= statement_file.transactions.count == 1 ? t('table_headers.transaction') : t('table_headers.transactions') %> •
                    <%= format_local_time(statement_file.created_at, format: 'short_date') %>
                  </p>
                </div>
                <svg class="recent-statement-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </div>
              <div class="recent-statement-status">
                <span class="status-badge status-<%= statement_file.status %>">
                  <%= t("statement_file_status.#{statement_file.status}") %>
                </span>
              </div>
            </div>
          <% end %>
        </div>

        <!-- View All Link -->
        <div class="mt-4 pt-4 border-t border-slate-200">
          <a href="/statement_files" class="view-all-link">
            <%= t('bank_accounts.view_all_statements') %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      <% else %>
        <!-- Empty State -->
        <div class="dashboard-empty-state">
          <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
          <h4 class="dashboard-empty-title"><%= t('bank_accounts.no_recent_activity') %></h4>
          <p class="dashboard-empty-description"><%= t('bank_accounts.upload_statement_help') %></p>
          <button onclick="openUploadModal()" class="dashboard-empty-action md:hidden">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
            </svg>
            <%= t('bank_accounts.upload_first_statement') %>
          </button>
        </div>
      <% end %>
    </section>
  </div>

  <!-- MOBILE CONTENT (visible only on mobile) -->
  <div class="block md:hidden">
    <div class="mobile-bank-account-container">

      <!-- ACCOUNT BALANCE CARD -->
      <turbo-frame id="mobile-account-balance" class="mobile-account-balance-frame">
        <section class="mobile-account-balance-card">
          <div class="mobile-balance-header">
            <div class="mobile-balance-icon">
              <svg class="w-8 h-8 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 003 3v8a3 3 0 003 3z"></path>
              </svg>
            </div>
            <div class="mobile-balance-info">
              <h2 class="mobile-balance-title"><%= @bank_account.bank_display_name %></h2>
              <p class="mobile-balance-subtitle"><%= t('bank_accounts.current_balance') %></p>
            </div>
            <div class="mobile-balance-currency">
              <span class="mobile-currency-badge"><%= @bank_account.currency %></span>
            </div>
          </div>
          <div class="mobile-balance-amount">
            <% if @bank_account.opening_balance.present? %>
              <%= number_to_currency(@bank_account.opening_balance, unit: @bank_account.currency || "$") %>
            <% else %>
              <%= t('bank_accounts.no_balance_set') %>
            <% end %>
          </div>
        </section>
      </turbo-frame>

      <!-- QUICK ACTIONS CARD -->
      <turbo-frame id="mobile-quick-actions" class="mobile-quick-actions-frame">
        <section class="mobile-quick-actions-card">
          <h3 class="mobile-card-title"><%= t('quick_actions.title') %></h3>
          <div class="mobile-actions-grid">
            <button onclick="openUploadModal()" class="mobile-action-button mobile-action-upload">
              <div class="mobile-action-icon">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
                </svg>
              </div>
              <div class="mobile-action-content">
                <span class="mobile-action-title"><%= t('quick_actions.upload_statement') %></span>
                <span class="mobile-action-subtitle"><%= t('mobile.bank_accounts.upload_help') %></span>
              </div>
            </button>

            <button onclick="window.location.href='/transactions?bank_account_id=<%= @bank_account.id %>'" class="mobile-action-button mobile-action-transactions">
              <div class="mobile-action-icon">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
              </div>
              <div class="mobile-action-content">
                <span class="mobile-action-title"><%= t('mobile.bank_accounts.view_transactions') %></span>
                <span class="mobile-action-subtitle"><%= t('mobile.bank_accounts.transactions_help') %></span>
              </div>
            </button>

            <button onclick="openBankAccountEditModal()" class="mobile-action-button mobile-action-edit">
              <div class="mobile-action-icon">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
              </div>
              <div class="mobile-action-content">
                <span class="mobile-action-title"><%= t('mobile.bank_accounts.edit_account') %></span>
                <span class="mobile-action-subtitle"><%= t('mobile.bank_accounts.edit_help') %></span>
              </div>
            </button>
          </div>
        </section>
      </turbo-frame>

      <!-- RECENT ACTIVITY CARD -->
      <turbo-frame id="mobile-recent-activity" class="mobile-recent-activity-frame">
        <section class="mobile-recent-activity-card">
          <div class="mobile-card-header">
            <h3 class="mobile-card-title"><%= t('bank_accounts.recent_activity') %></h3>
            <% if @recent_statement_files.any? %>
              <a href="/statement_files" class="mobile-card-link">
                <%= t('mobile.statement_files.view_all_statements') %>
              </a>
            <% end %>
          </div>

          <% if @recent_statement_files.any? %>
            <div class="space-y-3">
              <% @recent_statement_files.each do |statement_file| %>
                <div class="mobile-statement-file-group">
                  <!-- Statement File Header -->
                  <div class="mobile-statement-file-header" onclick="window.location.href='/statement_files/<%= statement_file.id %>'">
                    <div class="mobile-statement-file-info">
                      <h3 class="mobile-statement-file-title">
                        <%= statement_file.file.filename.to_s %>
                      </h3>
                      <span class="mobile-statement-file-subtitle">
                        <%= format_local_time(statement_file.created_at, format: 'short_date') %>
                      </span>
                      <div class="mobile-statement-file-status">
                        <span class="mobile-statement-status-badge <%= statement_file.status == 'completed' ? 'text-green-600' : statement_file.status == 'error' ? 'text-red-600' : 'text-yellow-600' %>">
                          <%= t("mobile.statement_files.#{statement_file.status}") %>
                        </span>
                      </div>
                    </div>
                    <div class="mobile-statement-file-right">
                      <div class="mobile-transactions-info">
                        <span class="mobile-transactions-count"><%= statement_file.transactions.count %></span>
                        <span class="mobile-transactions-label"><%= t('mobile.transactions.transactions') %></span>
                      </div>
                      <svg class="mobile-statement-chevron h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                      </svg>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="mobile-empty-state">
              <div class="mobile-empty-icon">
                <svg class="w-12 h-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2zm0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
              </div>
              <h4 class="mobile-empty-title"><%= t('bank_accounts.no_recent_activity') %></h4>
              <p class="mobile-empty-description"><%= t('bank_accounts.upload_statement_help') %></p>
              <button onclick="openUploadModal()" class="mobile-empty-action">
                <%= t('bank_accounts.upload_first_statement') %>
              </button>
            </div>
          <% end %>
        </section>
      </turbo-frame>
    </div>
  </div>
</main>

<!-- MOBILE BANK ACCOUNT EDIT MODAL: Full-Screen Overlay (Mobile Only) -->
<div id="mobileBankAccountEditModal" class="fixed inset-0 hidden md:hidden" style="z-index: 10000; display: none;">
  <!-- Blurred Backdrop -->
  <div class="absolute inset-0" style="backdrop-filter: blur(8px); background: rgba(255, 255, 255, 0.1);" onclick="closeBankAccountEditModalIfNoChanges(event)"></div>

  <!-- Modal Content -->
  <div class="relative bg-white rounded-t-3xl shadow-2xl" id="mobileEditContent" style="transform: translateY(100%); transition: transform 200ms cubic-bezier(0.25, 0.46, 0.45, 0.94); height: 85vh; max-height: 85vh; margin-top: 15vh; width: 100vw; max-width: 100vw; left: 0; right: 0; overflow-x: hidden; box-sizing: border-box;">
    <!-- Header -->
    <div class="flex items-center justify-between p-4 border-b border-slate-200 bg-white sticky top-0 z-10">
      <h2 class="text-lg font-semibold text-slate-900"><%= t('mobile.bank_accounts.edit_account') %></h2>
      <div class="flex items-center space-x-3">
        <button id="mobileSaveBankAccountButton" onclick="saveBankAccountEdit()" class="p-2 text-green-600 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </button>
        <button onclick="closeBankAccountEditModal()" class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-50 rounded-lg transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Content -->
    <div class="p-4 space-y-6 overflow-y-auto" style="height: calc(85vh - 80px); width: 100%; max-width: 100vw; box-sizing: border-box; overflow-x: hidden;">
      <!-- Bank Account Edit Form -->
      <turbo-frame id="mobile-bank-account-edit-form">
        <%= form_with model: @bank_account,
            url: bank_account_path(@bank_account),
            method: :patch,
            local: false,
            html: {
              id: "mobileBankAccountEditForm",
              class: "mobile-upload-form space-y-6",
              data: {
                turbo_frame: "mobile-bank-account-edit-form",
                controller: "mobile-bank-account-edit"
              }
            } do |f| %>

        <!-- Bank Selection -->
        <div class="mobile-form-group">
          <label for="mobile_edit_bank_id" class="mobile-form-label">
            <div class="mobile-label-content">
              <svg class="mobile-label-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
