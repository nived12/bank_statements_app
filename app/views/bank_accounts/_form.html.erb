<!-- BANK ACCOUNT FORM: Create/Edit Account -->
<%= form_with model: @bank_account, local: true, class: "bank-accounts-form-section" do |f| %>
  
  <!-- BANK SELECTION FIELD: Choose from Supported Banks -->
  <div class="bank-accounts-form-group">
    <label for="bank_account_bank_id" class="bank-accounts-form-label">
      <%= t('bank_accounts.bank') %>
    </label>
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
        </svg>
      </div>
      <%= f.select :bank_id, 
          options_from_collection_for_select(@supported_banks, :id, :display_name, @bank_account.bank_id),
          { prompt: t('bank_account_forms.select_bank') },
          { required: true, class: "bank-accounts-form-input pl-10" } %>
    </div>
    <% if @bank_account.errors[:bank_id].any? %>
      <p class="mt-1 text-sm text-red-600"><%= @bank_account.errors[:bank_id].first %></p>
    <% end %>
    <p class="mt-1 text-sm text-gray-500"><%= t('bank_account_forms.bank_selection_help') %></p>
  </div>

  <!-- ACCOUNT TYPE FIELD: Type of Bank Account -->
  <div class="bank-accounts-form-group">
    <label for="bank_account_account_type" class="bank-accounts-form-label">
      <%= t('bank_accounts.account_type') %>
    </label>
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
        </svg>
      </div>
      <%= f.select :account_type, 
          options_for_select([
            [t('account_type.debit'), 'debit'],
            [t('account_type.credit'), 'credit']
          ], @bank_account.account_type),
          { prompt: t('bank_account_forms.select_account_type') },
          { required: true, class: "bank-accounts-form-input pl-10" } %>
    </div>
    <% if @bank_account.errors[:account_type].any? %>
      <p class="mt-1 text-sm text-red-600"><%= @bank_account.errors[:account_type].first %></p>
    <% end %>
    <p class="mt-1 text-sm text-gray-500"><%= t('bank_account_forms.account_type_help') %></p>
  </div>

  <!-- CUSTOM NAME FIELD: Optional Custom Bank Name/Alias -->
  <div class="bank-accounts-form-group">
    <label for="bank_account_custom_name" class="bank-accounts-form-label">
      <%= t('bank_account_forms.custom_name') %> <span class="text-gray-500 text-sm">(<%= t('bank_account_forms.optional') %>)</span>
    </label>
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
        </svg>
      </div>
      <%= f.text_field :custom_name, 
          placeholder: t('bank_account_forms.custom_name_placeholder'),
          class: "bank-accounts-form-input pl-10" %>
    </div>
    <p class="mt-1 text-sm text-gray-500"><%= t('bank_account_forms.custom_name_help') %></p>
  </div>

  <!-- ACCOUNT NUMBER FIELD: Account Identifier -->
  <div class="bank-accounts-form-group">
    <label for="bank_account_account_number" class="bank-accounts-form-label">
      <%= t('bank_account_forms.account_number') %>
    </label>
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
        </svg>
      </div>
      <%= f.text_field :account_number, 
          placeholder: t('bank_account_forms.account_number_placeholder'),
          required: true,
          class: "bank-accounts-form-input pl-10" %>
    </div>
    <% if @bank_account.errors[:account_number].any? %>
      <p class="mt-1 text-sm text-red-600"><%= @bank_account.errors[:account_number].first %></p>
    <% end %>
  </div>

  <!-- CURRENCY FIELD: Account Currency -->
  <div class="bank-accounts-form-group">
    <label for="bank_account_currency" class="bank-accounts-form-label">
      <%= t('bank_account_forms.currency') %>
    </label>
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
        </svg>
      </div>
      <%= f.text_field :currency, 
          placeholder: t('bank_account_forms.currency_placeholder'),
          value: "MXN",
          class: "bank-accounts-form-input pl-10" %>
    </div>
    <p class="mt-1 text-sm text-gray-500"><%= t('bank_account_forms.common_currencies') %></p>
  </div>

  <!-- OPENING BALANCE DATE FIELD: Date for Opening Balance -->
  <div class="bank-accounts-form-group">
    <label for="bank_account_opening_balance_date" class="bank-accounts-form-label">
      <%= t('bank_account_forms.opening_balance_date') %>
    </label>
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
      </div>
      <%= f.date_field :opening_balance_date, 
          value: Date.current,
          max: Date.current,
          required: true,
          class: "bank-accounts-form-input pl-10" %>
    </div>
    <% if @bank_account.errors[:opening_balance_date].any? %>
      <p class="mt-1 text-sm text-red-600"><%= @bank_account.errors[:opening_balance_date].first %></p>
    <% end %>
    <p class="mt-1 text-sm text-gray-500"><%= t('bank_account_forms.opening_balance_date_help') %></p>
  </div>

  <!-- OPENING BALANCE FIELD: Initial Account Balance -->
  <div class="bank-accounts-form-group">
    <label for="bank_account_opening_balance" class="bank-accounts-form-label">
      <%= t('bank_account_forms.opening_balance') %>
    </label>
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
        </svg>
      </div>
      <%= f.number_field :opening_balance, 
          step: 0.01,
          placeholder: t('bank_account_forms.balance_placeholder'),
          class: "bank-accounts-form-input pl-10" %>
    </div>
    <% if @bank_account.errors[:opening_balance].any? %>
      <p class="mt-1 text-sm text-red-600"><%= @bank_account.errors[:opening_balance].first %></p>
    <% end %>
    <p class="mt-1 text-sm text-gray-500"><%= t('bank_account_forms.opening_balance_help') %></p>
  </div>

  <!-- FORM ACTIONS: Submit and Cancel Buttons -->
  <div class="bank-accounts-form-actions">
    <%= link_to bank_accounts_path, class: "bank-accounts-form-button bank-accounts-form-button-secondary" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      <%= t('form_actions.cancel') %>
    <% end %>
    
    <button type="submit" class="bank-accounts-form-button bank-accounts-form-button-primary">
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
      <%= @bank_account.persisted? ? t('bank_account_forms.update') : t('bank_account_forms.create') %>
    </button>
  </div>
<% end %>
