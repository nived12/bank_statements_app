<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

  <% if @active_subscription %>
    <%# ── Premium membership card ───────────────────────────────────────────── %>
    <div class="relative overflow-hidden rounded-2xl p-8 mb-6 shadow-xl" style="background: linear-gradient(135deg, #4f46e5 0%, #4338ca 50%, #5b21b6 100%); box-shadow: 0 20px 40px -12px rgba(79,70,229,0.35);">
      <%# Subtle dot-grid texture %>
      <div class="pointer-events-none absolute inset-0 opacity-[0.07]"
           style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 24px 24px;"></div>

      <%# Top row: title + badge %>
      <div class="relative flex items-start justify-between mb-6">
        <div class="flex items-center gap-2">
          <%= icon("crown", library: "lucide", variant: "outline", class: "w-5 h-5 text-indigo-200") %>
          <span class="text-indigo-200 text-xs font-bold uppercase tracking-widest">Vittio Premium</span>
        </div>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-400/20 border border-emerald-400/30 text-emerald-300 text-xs font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <%= t("subscription.membership.badge") %>
        </span>
      </div>

      <%# User name %>
      <p class="relative text-white text-2xl font-bold mb-1"><%= current_user.full_name %></p>

      <%# Plan + billing info %>
      <%# Interval and amount are both read off the subscription, so a subscriber on a
          retired price sees what they actually pay. Manually granted accounts have
          neither, and rendering a list price there would be inventing a bill. %>
      <div class="relative flex flex-wrap items-center gap-x-3 gap-y-1 mt-3">
        <% if @billing_interval.present? %>
          <span class="text-indigo-200 text-sm font-medium">
            <%= t("subscription.membership.plan_#{@billing_interval == :year ? "annual" : "monthly"}") %>
          </span>
        <% end %>
        <% if @billing_amount_cents.present? %>
          <span class="text-indigo-400 text-sm">·</span>
          <span class="text-indigo-200 text-sm font-medium">
            <%# The amount is read off the subscription but the symbol is fixed: every
                Stripe price in this account is MXN, and there is no path to another
                currency today. If one appears, read it from the price object
                (items.data[0].price.currency) rather than widening this literal. %>
            <%= t("subscription.membership.price_per_#{@billing_interval == :year ? "year" : "month"}",
                  amount: number_to_currency(@billing_amount_cents / 100.0,
                                             unit: "MX$", precision: 2, delimiter: ",", format: "%u%n")) %>
          </span>
        <% end %>
        <% if @cancels_at.present? %>
          <span class="text-indigo-400 text-sm">·</span>
          <span class="text-indigo-300 text-sm">
            <%= t("subscription.membership.cancels_on", date: l(@cancels_at, format: :long)) %>
          </span>
        <% elsif @next_billing_date.present? %>
          <span class="text-indigo-400 text-sm">·</span>
          <span class="text-indigo-300 text-sm">
            <%= t("subscription.membership.next_billing", date: l(@next_billing_date, format: :long)) %>
          </span>
        <% end %>
      </div>
    </div>

    <%# ── Benefits card ──────────────────────────────────────────────────────── %>
    <div class="rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-6 mb-6">
      <p class="text-xs font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-4">
        <%= t("subscription.membership.benefits_title") %>
      </p>
      <ul class="space-y-3">
        <% [
          ["subscription.membership.benefit_statements", "file-text"],
          ["subscription.membership.benefit_ai",         "sparkles"],
          ["subscription.membership.benefit_voice",      "mic"],
          ["subscription.membership.benefit_receipt",    "camera"],
          ["subscription.membership.benefit_recurring",  "repeat"],
        ].each do |key, icon_name| %>
          <li class="flex items-center gap-3">
            <span class="flex-shrink-0 w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center">
              <%= icon(icon_name, library: "lucide", variant: "outline", class: "w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400") %>
            </span>
            <span class="text-sm font-medium text-slate-700 dark:text-slate-300"><%= t(key) %></span>
          </li>
        <% end %>
      </ul>
    </div>

    <%# ── Actions ─────────────────────────────────────────────────────────────── %>
    <%= link_to t("subscription.membership.manage_btn"), portal_subscription_path,
        class: "flex w-full items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm transition-colors shadow-sm mb-4" %>

    <%= link_to "← #{t('navigation.back')}", :back,
        class: "block text-center text-sm text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300 transition-colors" %>

  <% else %>
    <%# ── Non-premium: header + upgrade cards (unchanged) ──────────────────── %>
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100 mb-2">
        <%= t("subscription.upgrade.title") %>
      </h1>
      <p class="text-slate-500 dark:text-slate-400">
        <%= t("subscription.upgrade.iva_note") %>
      </p>
    </div>

    <%# Trial status banner %>
    <div class="mb-8">
      <% if @trial_ends_at.present? && @trial_ends_at > Time.current %>
        <div class="rounded-xl bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700 px-5 py-4 flex items-center gap-3">
          <%= icon("clock", library: "lucide", variant: "outline", class: "w-5 h-5 text-amber-500 flex-shrink-0") %>
          <p class="text-sm font-medium text-amber-800 dark:text-amber-300">
            <%= t("subscription.upgrade.trial_ends", date: l(@trial_ends_at, format: :long)) %>
          </p>
        </div>
      <% else %>
        <div class="rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-5 py-4">
          <p class="text-sm text-slate-600 dark:text-slate-400"><%= t("subscription.upgrade.trial_expired") %></p>
        </div>
      <% end %>
    </div>

    <%# Plan cards %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
      <%= form_with url: checkout_subscription_path, method: :post, local: true, data: { turbo: false } do |f| %>
        <%= f.hidden_field :interval, value: "month" %>
        <button type="submit"
                class="w-full text-left p-6 rounded-2xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:border-indigo-400 dark:hover:border-indigo-500 hover:shadow-md transition-all group">
          <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-2">Mensual</p>
          <div class="flex items-end gap-1 mb-1">
            <span class="text-3xl font-bold text-slate-900 dark:text-slate-100">$99</span>
            <span class="text-slate-500 dark:text-slate-400 mb-0.5 text-sm">MXN/mes</span>
          </div>
          <p class="text-xs text-slate-400 dark:text-slate-500"><%= t("subscription.upgrade.iva_note") %></p>
          <div class="mt-4 flex items-center justify-between">
            <span class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 group-hover:underline">
              <%= t("subscription.upgrade.subscribe_monthly") %> →
            </span>
          </div>
        </button>
      <% end %>

      <%= form_with url: checkout_subscription_path, method: :post, local: true, data: { turbo: false } do |f| %>
        <%= f.hidden_field :interval, value: "year" %>
        <button type="submit"
                class="w-full text-left p-6 rounded-2xl border-2 border-indigo-600 bg-indigo-600 text-white hover:bg-indigo-700 hover:border-indigo-700 hover:shadow-md transition-all relative overflow-hidden group">
          <span class="absolute top-3 right-3 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-400/20 text-emerald-200">-24%</span>
          <p class="text-xs font-semibold text-indigo-200 uppercase tracking-wide mb-2">Anual</p>
          <div class="flex items-end gap-1 mb-0.5">
            <span class="text-3xl font-bold text-white">$75</span>
            <span class="text-indigo-200 mb-0.5 text-sm">MXN/mes</span>
          </div>
          <p class="text-xs text-indigo-300">$899 MXN/año · <%= t("subscription.upgrade.iva_note") %></p>
          <div class="mt-4 flex items-center justify-between">
            <span class="text-sm font-semibold text-white group-hover:underline">Ahorra $289 MXN al año →</span>
          </div>
        </button>
      <% end %>
    </div>

    <p class="text-center text-xs text-slate-400 dark:text-slate-500 mb-8">Cancela cuando quieras. Sin compromisos.</p>

    <%= link_to "← #{t('navigation.back')}", :back,
        class: "block text-center text-sm text-indigo-600 dark:text-indigo-400 hover:underline" %>
  <% end %>
</div>
