<section class="relative py-20 md:py-28 overflow-hidden" id="final-cta">
  <!-- Dark gradient background -->
  <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 -z-10"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-indigo-500/10 via-transparent to-transparent -z-10"></div>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-landing-scroll-target="section">
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
      <%= t("landing.final_cta.title") %>
    </h2>
    <p class="mt-4 text-lg text-slate-300">
      <%= t("landing.final_cta.subtitle") %>
    </p>

    <div class="mt-8 max-w-lg mx-auto" id="waitlist-form-bottom">
      <%= turbo_frame_tag "waitlist-form-bottom" do %>
        <%= form_with model: Waitlist.new, url: waitlists_path, data: { turbo_frame: "waitlist-form-bottom" }, class: "flex flex-col sm:flex-row gap-3" do |f| %>
          <div class="flex-1">
            <%= f.email_field :email,
                  placeholder: t("landing.hero.email_placeholder"),
                  required: true,
                  class: "w-full px-4 py-3.5 rounded-xl border border-slate-600 bg-slate-800/50 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500 transition-all text-base" %>
          </div>
          <%= f.submit t("landing.hero.join_button"),
                class: "px-6 py-3.5 rounded-xl text-base font-semibold text-white bg-indigo-500 hover:bg-indigo-400 shadow-lg shadow-indigo-500/25 transition-all hover:shadow-xl hover:shadow-indigo-500/30 hover:-translate-y-0.5 cursor-pointer whitespace-nowrap" %>
        <% end %>
      <% end %>
    </div>

    <p class="mt-4 text-sm text-slate-400">
      <%= t("landing.hero.disclaimer") %>
    </p>
  </div>
</section>
