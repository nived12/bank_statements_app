<div class="min-h-screen bg-slate-50">
  <!-- Header -->
  <header class="bg-white border-b border-slate-200 px-4 md:px-8 py-6">
    <div class="max-w-5xl mx-auto flex items-start justify-between">
      <div class="flex-1">
        <h1 class="text-2xl md:text-3xl font-bold text-slate-900"><%= t('category_rules.index.title') %></h1>
        <p class="text-slate-600 mt-1 text-sm md:text-base"><%= t('category_rules.index.subtitle') %></p>
      </div>
      <button type="button"
              data-controller="toggle-panel"
              data-action="click->toggle-panel#toggle"
              data-toggle-panel-target-value="new-rule-form"
              class="inline-flex items-center px-4 py-2.5 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition-colors shadow-sm text-sm">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
        </svg>
        <%= t('category_rules.index.new_rule') %>
      </button>
    </div>
  </header>

  <div class="max-w-5xl mx-auto px-4 md:px-8 py-6">
    <!-- New Rule Form (hidden by default) -->
    <div id="new-rule-form" class="hidden mb-6">
      <div class="bg-white rounded-xl border border-slate-200 p-6">
        <h3 class="text-lg font-semibold text-slate-900 mb-4"><%= t('category_rules.index.new_rule') %></h3>
        <div id="category-rule-form-errors"></div>
        <%= form_with model: CategoryRule.new, url: category_rules_path, class: "space-y-4", data: { turbo: true } do |f| %>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1"><%= t('category_rules.table.pattern') %></label>
              <%= f.text_field :pattern, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm", placeholder: t('category_rules.form.pattern_placeholder') %>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1"><%= t('category_rules.table.match_type') %></label>
              <%= f.select :match_type, options_for_select([
                [t('category_rules.match_types.contains'), 'contains'],
                [t('category_rules.match_types.exact'), 'exact'],
                [t('category_rules.match_types.starts_with'), 'starts_with']
              ], 'contains'), {}, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm" %>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1"><%= t('category_rules.table.category') %></label>
            <%= f.select :category_id, grouped_options_for_select(
              @categories.map { |parent| [parent.name, parent.children.map { |c| [c.name, c.id] }.unshift([parent.name, parent.id])] }
            ), { prompt: t('transactions.select_category') }, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm" %>
          </div>
          <div class="flex justify-end">
            <%= f.submit t('category_rules.index.new_rule'), class: "px-4 py-2 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition-colors text-sm cursor-pointer" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Rules List -->
    <% if @category_rules.any? %>
      <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
        <!-- Desktop Table -->
        <div class="hidden md:block overflow-x-auto">
          <table class="w-full">
            <thead class="bg-slate-50 border-b border-slate-200">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider"><%= t('category_rules.table.pattern') %></th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider"><%= t('category_rules.table.match_type') %></th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider"><%= t('category_rules.table.category') %></th>
                <th class="px-4 py-3 text-center text-xs font-semibold text-slate-600 uppercase tracking-wider"><%= t('category_rules.table.hits') %></th>
                <th class="px-4 py-3 text-center text-xs font-semibold text-slate-600 uppercase tracking-wider"><%= t('category_rules.table.active') %></th>
                <th class="px-4 py-3 text-right text-xs font-semibold text-slate-600 uppercase tracking-wider"><%= t('category_rules.table.actions') %></th>
              </tr>
            </thead>
            <tbody id="category-rules-list" class="divide-y divide-slate-200">
              <% @category_rules.each do |rule| %>
                <%= render partial: "category_rules/rule_row", locals: { rule: rule } %>
              <% end %>
            </tbody>
          </table>
        </div>

        <!-- Mobile Cards -->
        <div class="block md:hidden divide-y divide-slate-200" id="category-rules-list-mobile">
          <% @category_rules.each do |rule| %>
            <%= render partial: "category_rules/rule_card", locals: { rule: rule } %>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="bg-white rounded-xl border border-slate-200 p-12 text-center">
        <svg class="w-16 h-16 text-slate-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
        </svg>
        <h3 class="text-lg font-semibold text-slate-700 mb-2"><%= t('category_rules.index.no_rules') %></h3>
        <p class="text-sm text-slate-500"><%= t('category_rules.index.no_rules_help') %></p>
      </div>
    <% end %>
  </div>
</div>
